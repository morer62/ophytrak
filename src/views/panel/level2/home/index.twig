  .carrier-command-hero{background:radial-gradient(circle at 85% 15%,rgba(3,198,244,.3),transparent 35%),linear-gradient(135deg,#020a16,#083c62 58%,#087cff);}
  .carrier-email-value{background:#eef8ff;border:1px dashed #087cff;border-radius:16px;color:#073b63;font-size:1.25rem;font-weight:900;margin-top:1rem;padding:1rem;word-break:break-all;}
  .carrier-flow{display:grid;gap:1rem;grid-template-columns:repeat(4,1fr)}.carrier-flow div{background:#f8fafc;border:1px solid #e2e8f0;border-radius:16px;padding:1rem}.carrier-flow b{align-items:center;background:#087cff;border-radius:50%;color:#fff;display:flex;height:30px;justify-content:center;margin-bottom:.7rem;width:30px}.carrier-flow strong,.carrier-flow span{display:block}.carrier-flow span{color:#64748b;font-size:.85rem;margin-top:.35rem}
