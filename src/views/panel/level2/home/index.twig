  .quick-module-status { background:#fff; border:1px solid rgba(15,23,42,.1); border-radius:999px; color:#0f766e; display:inline-flex; font-size:.72rem; font-weight:900; margin-top:auto; padding:.3rem .62rem; }
  .snapshot-card,.first-step-list a,.switch-view-list a,.switch-view-list button { background:#f8fafc; border:1px solid rgba(15,23,42,.08); border-radius:16px; color:#0f172a; display:block; padding:1rem; text-align:left; text-decoration:none; width:100%; }
