{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="mt-4">
  <div class="container">

    <h2 class="mb-4 text-center">{{ trans('planner_hub.pt_tools') }}</h2>

  

    {{ macros.breadcrumb2() }}

    <div class="row g-4">

      <!-- Assigned Tasks -->
      <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_3.png') }}" alt="Orders" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">🍸 {{ trans('planner_hub.pt_cocktail_calculator') }}</h5>
          <p class="text-muted small mb-3">{{ trans('planner_hub.pt_cocktail_calculator_desc') }}</p>
          <a href="{{ path('panel/planning-tools/cocktail-calculator') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.pt_continue') }}</a>
        </div>
      </div>

      <!-- Time & Payments -->
      <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_7.png') }}" alt="Payroll" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">🪑 {{ trans('planner_hub.pt_layout_design') }}</h5>
          <p class="text-muted small mb-3">{{ trans('planner_hub.pt_layout_design_desc') }}</p>
          <a href="{{ path('panel/planning-tools/space-designer') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.pt_continue') }}</a>
        </div>
      </div>

      <!-- Internal Chat -->
      <div class="col-md-4">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_8.png') }}" alt="Chat" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">💬 {{ trans('planner_hub.pt_meal_calculator') }}</h5>
          <p class="text-muted small mb-3">{{ trans('planner_hub.pt_meal_calculator_desc') }}</p>
          <a href="{{ path('panel/planning-tools/meal-calculator') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.pt_continue') }}</a>
        </div>
      </div>

     

    </div>

  </div>
</main>
{% endblock %}
