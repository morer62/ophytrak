{% block scripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="{{ asset_for('assets/js/storeShippingLabel.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('orderItemsModal');
            if (modalEl) {
                modalEl.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;

                    const customer = button.getAttribute('data-order-customer') || '-';
                    const email = button.getAttribute('data-order-email') || '-';
                    const phone = button.getAttribute('data-order-phone') || '-';
                    const date = button.getAttribute('data-order-date') || '';
                    const orderId = button.getAttribute('data-order-id') || '';
                    const shipping = button.getAttribute('data-order-shipping') || '-';
                    const orderStatus = button.getAttribute('data-order-status') || '-';
                    const payment = button.getAttribute('data-order-payment') || '-';
                    const couponCode = button.getAttribute('data-order-coupon-code') || '';
                    const couponDiscount = button.getAttribute('data-order-coupon-discount') || '0.00';
                    const total = button.getAttribute('data-order-total') || '0.00';
                    const itemsJson = button.getAttribute('data-items') || '[]';
                    document.getElementById('orderItemsCustomer').textContent = customer;
                    document.getElementById('orderItemsEmail').textContent = email;
                    document.getElementById('orderItemsDate').textContent = date;
                    document.getElementById('orderMetaPhone').textContent = phone;
                    document.getElementById('orderMetaId').textContent = orderId;
                    document.getElementById('orderMetaShipping').textContent = shipping;
                    document.getElementById('orderMetaStatus').textContent = orderStatus;
                    document.getElementById('orderMetaPayment').textContent = payment;
                    document.getElementById('orderMetaCoupon').textContent = couponCode ? (couponCode + ' (-$' + couponDiscount + ')') : '-';
                    document.getElementById('orderMetaTotal').textContent = total;

                    let items = [];
                    try {
                        items = JSON.parse(itemsJson);
                    } catch (e) {
                        items = [];
                    }

                    const tbody = document.getElementById('orderItemsTableBody');
                    tbody.innerHTML = '';

                    if (!items.length) {
                        const tr = document.createElement('tr');
                        const td = document.createElement('td');
                        td.colSpan = 4;
                        td.className = 'text-center text-muted py-3';
                        td.textContent = '{{ trans('store_orders.no_products_found') }}';
                        tr.appendChild(td);
                        tbody.appendChild(tr);
                        return;
                    }

                    items.forEach(function (item) {
                        const tr = document.createElement('tr');

                        const tdName = document.createElement('td');
                        tdName.textContent = item.name || '-';

                        const tdQty = document.createElement('td');
                        tdQty.className = 'text-end';
                        tdQty.textContent = item.quantity ?? 0;

                        const tdUnit = document.createElement('td');
                        tdUnit.className = 'text-end';
                        tdUnit.textContent = '$' + Number(item.unit_price ?? 0).toFixed(2);

                        const tdTotal = document.createElement('td');
                        tdTotal.className = 'text-end';
                        tdTotal.textContent = '$' + Number(item.line_total ?? 0).toFixed(2);

                        tr.appendChild(tdName);
                        tr.appendChild(tdQty);
                        tr.appendChild(tdUnit);
                        tr.appendChild(tdTotal);
                        tbody.appendChild(tr);
                    });
                });
            }

            const paymentModal = document.getElementById('editPaymentModal');
            if (paymentModal) {
                const paymentSelect = document.getElementById('editPaymentSelect');
                const manualDetails = document.getElementById('manualPaymentDetails');
                const manualReference = document.getElementById('manualPaymentReference');
                const syncManualPaymentFields = function () {
                    const isPaid = paymentSelect && paymentSelect.value === 'PAID';
                    if (manualDetails) manualDetails.classList.toggle('d-none', !isPaid);
                    if (manualReference) manualReference.required = Boolean(isPaid);
                };
                if (paymentSelect) paymentSelect.addEventListener('change', syncManualPaymentFields);
                paymentModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const orderId = button.getAttribute('data-order-id') || '';
                    const status = button.getAttribute('data-payment-status') || 'PENDING';
                    const remaining = parseFloat(button.getAttribute('data-payment-remaining') || '0');
                    const idInput = document.getElementById('editPaymentOrderId');
                    const select = document.getElementById('editPaymentSelect');
                    if (idInput) idInput.value = orderId;
                    if (select) select.value = status || 'PENDING';
                    const amount = document.getElementById('manualPaymentAmount');
                    const remainingLabel = document.getElementById('manualPaymentRemaining');
                    if (amount) { amount.value = remaining.toFixed(2); amount.max = remaining.toFixed(2); }
                    if (remainingLabel) remainingLabel.textContent = remaining.toFixed(2);
                    syncManualPaymentFields();
                });
            }

            const statusModal = document.getElementById('editStatusModal');
            if (statusModal) {
                statusModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const orderId = button.getAttribute('data-order-id') || '';
                    const status = button.getAttribute('data-status') || 'NEW';
                    const idInput = document.getElementById('editStatusOrderId');
                    const select = document.getElementById('editStatusSelect');
                    if (idInput) idInput.value = orderId;
                    if (select) select.value = status || 'NEW';
                });
            }

            const manualLogisticsModal = document.getElementById('manualLogisticsModal');
            if (manualLogisticsModal) {
                const manualStatus = document.getElementById('manualLogisticsStatus');
                const manualPhoto = document.getElementById('manualDeliveryPhoto');
                const manualPhotoGroup = document.getElementById('manualDeliveryPhotoGroup');
                const manualSubmit = document.getElementById('manualLogisticsSubmit');
                const syncManualDeliveryPhoto = function () {
                    const selected = manualStatus ? manualStatus.value : '';
                    const needsPhoto = ['DELIVERED', 'RETURNED_TO_BUSINESS'].includes(selected);
                    if (manualPhoto) manualPhoto.required = needsPhoto;
                    if (manualPhotoGroup) manualPhotoGroup.classList.toggle('d-none', !needsPhoto);
                    if (manualSubmit) manualSubmit.classList.toggle('d-none', !selected);
                };
                if (manualStatus) manualStatus.addEventListener('change', syncManualDeliveryPhoto);
                manualLogisticsModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    document.getElementById('manualLogisticsOrderId').value = button.getAttribute('data-order-id') || '';
                    if (manualStatus) manualStatus.value = '';
                    if (manualPhoto) manualPhoto.value = '';
                    const feedback = document.getElementById('manualLogisticsFeedback');
                    const debugBox = document.getElementById('manualLogisticsDebug');
                    if (feedback) feedback.className = 'alert d-none';
                    if (debugBox) debugBox.classList.add('d-none');
                    syncManualDeliveryPhoto();
                });
                const manualForm = document.getElementById('manualLogisticsForm');
                if (manualForm) manualForm.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    const feedback = document.getElementById('manualLogisticsFeedback');
                    const debugBox = document.getElementById('manualLogisticsDebug');
                    const debugText = document.getElementById('manualLogisticsDebugText');
                    if (!manualStatus || !manualStatus.value) return;
                    if (manualSubmit) manualSubmit.disabled = true;
                    if (feedback) { feedback.className = 'alert alert-info'; feedback.textContent = 'Saving logistics update...'; }
                    if (debugBox) debugBox.classList.add('d-none');
                    try {
                        const response = await fetch(window.location.href, {method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:new FormData(manualForm),credentials:'same-origin'});
                        const rawResponse = await response.text();
                        let payload = null;
                        try { payload = JSON.parse(rawResponse.trim()); } catch (ignored) {
                            const start = rawResponse.lastIndexOf('{"success"');
                            if (start >= 0) try { payload = JSON.parse(rawResponse.slice(start).trim()); } catch (ignoredAgain) {}
                        }
                        if (!response.ok || !payload || !payload.success) {
                            const error = new Error(payload && payload.message ? payload.message : 'The server returned an invalid response.');
                            error.diagnostic = ['HTTP status: '+response.status+' '+response.statusText,'Response URL: '+response.url,'Content-Type: '+(response.headers.get('content-type')||'(not provided)'),payload&&payload.request_id?'Request ID: '+payload.request_id:'',payload&&payload.debug?'Server debug:\n'+JSON.stringify(payload.debug,null,2):'','Raw response:\n'+(rawResponse||'[empty response]')].filter(Boolean).join('\n\n');
                            throw error;
                        }
                        if (feedback) { feedback.className = 'alert alert-success'; feedback.textContent = payload.message; }
                        setTimeout(function(){ window.location.replace(window.location.pathname + window.location.search); }, 450);
                    } catch (error) {
                        if (feedback) { feedback.className = 'alert alert-danger'; feedback.textContent = error.message || 'Unable to update logistics status.'; }
                        if (debugBox && debugText) { debugText.textContent = error.diagnostic || String(error.stack || error); debugBox.classList.remove('d-none'); debugBox.open = true; }
                        if (manualSubmit) manualSubmit.disabled = false;
                    }
                });
            }

            const assignDeliveryModal = document.getElementById('assignDeliveryModal');
            if (assignDeliveryModal) {
                assignDeliveryModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const orderId = button.getAttribute('data-order-id') || '';
                    const deliveryId = button.getAttribute('data-delivery-user-id') || '';
                    const kitchenId = button.getAttribute('data-kitchen-user-id') || '';
                    const idInput = document.getElementById('assignDeliveryOrderId');
                    const select = document.getElementById('assignDeliveryUserSelect');
                    const kitchenSelect = document.getElementById('assignKitchenUserSelect');
                    if (idInput) idInput.value = orderId;
                    if (select) select.value = deliveryId;
                    if (kitchenSelect) kitchenSelect.value = kitchenId;
                    document.getElementById('assignAllowClose').checked = button.getAttribute('data-allow-close') === '1';
                    document.getElementById('assignAllowChat').checked = button.getAttribute('data-allow-chat') === '1';
                });
                document.getElementById('assignBothToMe')?.addEventListener('click', function () {
                    document.getElementById('assignKitchenUserSelect').value = '{{ managerUserId }}';
                    document.getElementById('assignDeliveryUserSelect').value = '{{ managerUserId }}';
                });
                const assignmentForm = document.getElementById('assignOperationsForm');
                if (assignmentForm) assignmentForm.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    const submit = document.getElementById('assignOperationsSubmit');
                    const feedback = document.getElementById('assignOperationsFeedback');
                    const debugBox = document.getElementById('assignOperationsDebug');
                    const debugText = document.getElementById('assignOperationsDebugText');
                    if (submit) submit.disabled = true;
                    if (debugBox) debugBox.classList.add('d-none');
                    if (debugText) debugText.textContent = '';
                    if (feedback) {
                        feedback.className = 'alert alert-info';
                        feedback.textContent = 'Saving responsibilities...';
                    }
                    try {
                        const response = await fetch(window.location.href, {
                            method: 'POST',
                            headers: {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'},
                            body: new FormData(assignmentForm),
                            credentials: 'same-origin'
                        });
                        const contentType = response.headers.get('content-type') || '(not provided)';
                        const rawResponse = await response.text();
                        let payload = null;
                        try {
                            payload = JSON.parse(rawResponse.trim());
                        } catch (parseError) {
                            const jsonStart = rawResponse.lastIndexOf('{"success"');
                            if (jsonStart >= 0) {
                                try { payload = JSON.parse(rawResponse.slice(jsonStart).trim()); } catch (ignored) {}
                            }
                        }
                        if (!response.ok || !payload || !payload.success) {
                            const diagnostic = [
                                'HTTP status: ' + response.status + ' ' + response.statusText,
                                'Response URL: ' + response.url,
                                'Content-Type: ' + contentType,
                                payload && payload.request_id ? 'Request ID: ' + payload.request_id : '',
                                payload && payload.debug ? 'Server debug:\n' + JSON.stringify(payload.debug, null, 2) : '',
                                'Raw response:\n' + (rawResponse || '[empty response]')
                            ].filter(Boolean).join('\n\n');
                            const requestError = new Error(payload && payload.message ? payload.message : 'The server returned a non-JSON or invalid response.');
                            requestError.diagnostic = diagnostic;
                            throw requestError;
                        }
                        if (feedback) {
                            feedback.className = 'alert alert-success';
                            feedback.textContent = payload.message;
                        }
                        setTimeout(function () {
                            window.location.replace(window.location.pathname + window.location.search);
                        }, 450);
                    } catch (error) {
                        if (feedback) {
                            feedback.className = 'alert alert-danger';
                            feedback.textContent = error.message || 'The responsibilities could not be saved.';
                        }
                        if (debugBox && debugText) {
                            debugText.textContent = error.diagnostic || String(error.stack || error);
                            debugBox.classList.remove('d-none');
                            debugBox.open = true;
                        }
                        if (submit) submit.disabled = false;
                    }
                });
                {% if assignmentRequiredOrderId %}
                const requiredButton = document.querySelector('[data-bs-target="#assignDeliveryModal"][data-order-id="{{ assignmentRequiredOrderId }}"]');
                if (requiredButton) bootstrap.Modal.getOrCreateInstance(assignDeliveryModal).show(requiredButton);
                {% endif %}
            }
            const createTaskModal = document.getElementById('createTaskModal');
            if (createTaskModal) createTaskModal.addEventListener('show.bs.modal', function (event) {
                document.getElementById('createTaskOrderId').value = event.relatedTarget.getAttribute('data-order-id') || '';
            });

            const shippingLabelText = {
                sender: {{ trans('store_orders.label_sender')|json_encode|raw }},
                recipient: {{ trans('store_orders.label_recipient')|json_encode|raw }},
                orderNumber: {{ trans('store_orders.label_order_number')|json_encode|raw }},
                orderDate: {{ trans('store_orders.label_order_date')|json_encode|raw }},
                instructions: {{ trans('store_orders.label_instructions')|json_encode|raw }},
                packageHandledBy: {{ trans('store_orders.label_package_handled_by')|json_encode|raw }},
                logistics: {{ trans('store_orders.label_logistics')|json_encode|raw }},
                customer: {{ trans('store_report.customer')|json_encode|raw }}
            };
            document.querySelectorAll('.print-store-label-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    const publicUrl = new URL(this.dataset.url || '/', window.location.origin).href;
                    const preview = document.getElementById('storeLabelPreview');
                    OphyraShippingLabel.render(preview, { ...this.dataset, url: publicUrl, recipientName: this.dataset.customer }, shippingLabelText);
                    new bootstrap.Modal(document.getElementById('storeLabelModal')).show();
                });
            });

            const printStoreLabelBtn = document.getElementById('printStoreLabelBtn');
            if (printStoreLabelBtn) {
                printStoreLabelBtn.addEventListener('click', function () {
                    OphyraShippingLabel.print(document.getElementById('storeLabelPreview'), {{ trans('store_orders.store_order_label')|json_encode|raw }});
                });
            }

        });
    </script>
{% endblock %}
