{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">{{ trans('store_attribute_values.create_title') }}</h1>
            <p class="text-muted mb-0">
                {{ trans('store_attribute_values.attribute') }}: <strong>{{ attribute.name }}</strong>
            </p>
        </div>
        <a href="{{ path('panel/planner-hub/store/attribute-values/home') }}?id_attribute={{ attribute.id }}" class="btn btn-outline-secondary">
            &larr; Back to Values
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" name="id_attribute" value="{{ attribute.id }}">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">{{ trans('store_attribute_values.value') }}</label>
                        <input
                            type="text"
                            name="value"
                            class="form-control"
                            placeholder="e.g. Red"
                            required
                        >
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ trans('store_product_form.sort_order') }}</label>
                        <input
                            type="number"
                            name="sort_order"
                            class="form-control"
                            value="0"
                            min="0"
                        >
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ trans('ui.status') }}</label>
                        <select name="status" class="form-select">
                            <option value="ACTIVE" selected>{{ trans('ui.active') }}</option>
                            <option value="INACTIVE">{{ trans('ui.inactive') }}</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-success">
                        {{ trans('store_attribute_values.save_value') }}
                    </button>
                    <a href="{{ path('panel/planner-hub/store/attribute-values/home') }}?id_attribute={{ attribute.id }}" class="btn btn-outline-secondary">
                        {{ trans('ui.cancel') }}
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
