{% extends 'templates/base.admin.twig' %}

{% block body %}

<div class="container-fluid">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <h1 class="h3 mb-1">
                        {{ trans('store_attribute_values.title') }}
                    </h1>
                    <p class="text-muted mb-0">
                        {{ trans('store_attribute_values.attribute') }}: <strong>{{ attribute.name }}</strong>
                    </p>
                </div>

                <div class="d-flex gap-2">
                    <a href="{{ path('panel/planner-hub/store/attributes/home') }}" class="btn btn-outline-secondary">
                        ← Back
                    </a>

                    <a href="{{ path('panel/planner-hub/store/attribute-values/create') }}?id_attribute={{ attribute.id }}" class="btn btn-primary">
                        + {{ trans('store_attribute_values.add_value') }}
                    </a>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('panel/planner-hub/store/attributes/home') }}" class="btn btn-outline-dark btn-sm">
                    {{ trans('store_product_form.attributes') }}
                </a>

                <a href="{{ path('panel/planner-hub/store/products/home') }}" class="btn btn-outline-secondary btn-sm">
                    {{ trans('store_product_form.products') }}
                </a>
            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            {% if values|length > 0 %}

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>{{ trans('store_attribute_values.value') }}</th>
                                <th>{{ trans('store_attribute_values.slug') }}</th>
                                <th>{{ trans('store_attribute_values.order') }}</th>
                                <th>{{ trans('ui.status') }}</th>
                                <th class="text-end">{{ trans('ui.actions') }}</th>
                            </tr>
                        </thead>

                        <tbody>

                        {% for v in values %}

                            <tr>
                                <td>#{{ v.id }}</td>

                                <td>
                                    <strong>{{ v.value }}</strong>
                                </td>

                                <td>
                                    {{ v.slug ?: '—' }}
                                </td>

                                <td>
                                    {{ v.sort_order }}
                                </td>

                                <td>
                                    {% if v.status == 'ACTIVE' %}
                                        <span class="badge bg-success">{{ trans('ui.active') }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ trans('ui.inactive') }}</span>
                                    {% endif %}
                                </td>

                                <td class="text-end">

                                    <div class="d-inline-flex gap-2">

                                        <a href="{{ path('panel/planner-hub/store/attribute-values/edit') }}?id={{ v.id }}" class="btn btn-sm btn-outline-primary">
                                            {{ trans('ui.edit') }}
                                        </a>

                                        <a href="{{ path('panel/planner-hub/store/attribute-values/delete') }}?id={{ v.id }}"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('{{ trans('store_attribute_values.delete_confirm')|e('js') }}');">
                                            {{ trans('ui.delete') }}
                                        </a>

                                    </div>

                                </td>

                            </tr>

                        {% endfor %}

                        </tbody>

                    </table>

                </div>

            {% else %}

                <div class="text-center py-5">

                    <h5 class="mb-2">{{ trans('store_attribute_values.empty_title') }}</h5>

                    <p class="text-muted mb-3">
                        {{ trans('store_attribute_values.empty_text') }}
                    </p>

                    <a href="{{ path('panel/planner-hub/store/attribute-values/create') }}?id_attribute={{ attribute.id }}" class="btn btn-primary">
                        + {{ trans('store_attribute_values.add_first_value') }}
                    </a>

                </div>

            {% endif %}

        </div>
    </div>

</div>

{% endblock %}