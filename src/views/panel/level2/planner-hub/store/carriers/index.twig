{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}
{% block body %}
<main class="container-fluid py-4" style="max-width:1100px">
  {% if isCarrierOrganization %}
  <div class="mb-4"><span class="text-uppercase text-success small fw-bold">{{ trans('carrier_ui.business_relations') }}</span><h1 class="h3 mb-1">{{ trans('carrier_ui.connected_businesses')|title }}</h1><p class="text-muted">{{ trans('carrier_ui.relations_help') }}</p></div>
  <div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">{{ trans('carrier_ui.share_email') }}</h2><div class="carrier-email-value fw-bold fs-5 p-3 bg-light rounded">{{ carrierContactEmail }}</div></div></div>
  <div class="row g-3">{% for seller in sellerRelationships %}<div class="col-md-6"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ seller.company_name }}</h2><p class="text-muted mb-1">{{ seller.email }}</p><small>{{ [seller.city,seller.state,seller.country]|filter(v=>v)|join(', ') }}</small></div></div></div>{% else %}<div class="col-12"><div class="alert alert-info">{{ trans('carrier_ui.no_relations') }}</div></div>{% endfor %}</div>
  {% else %}
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><span class="text-uppercase text-success small fw-bold">{{ trans('carrier_relations.kicker') }}</span><h1 class="h3 mb-1">{{ trans('carrier_relations.title') }}</h1><p class="text-muted mb-0">{{ trans('carrier_relations.help') }}</p></div>
    <a class="btn btn-outline-secondary" href="{{ path('panel/planner-hub/store/orders/home') }}">{{ trans('carrier_relations.back_orders') }}</a>
  </div>
  {% if not dbReady %}<div class="alert alert-warning">{{ trans('carrier_relations.db_required') }}</div>{% endif %}
  <div class="row g-4">
    <div class="col-lg-7"><section class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">{{ trans('carrier_relations.connected') }}</h2><p class="text-muted">{{ trans('carrier_relations.connected_help') }}</p>
      {% for carrier in associatedCarriers %}<div class="border rounded-3 p-3 mb-2 d-flex justify-content-between align-items-center gap-3"><div><strong>{{ carrier.company_name }}</strong><div class="small text-muted">{{ [carrier.city,carrier.state,carrier.country]|filter(v => v)|join(', ') }}</div></div><form method="post">{{ macros.csrf() }}<input type="hidden" name="action" value="remove"><input type="hidden" name="carrier_owner_id" value="{{ carrier.carrier_owner_id }}"><button class="btn btn-sm btn-outline-danger">{{ trans('carrier_relations.remove') }}</button></form></div>{% else %}<div class="alert alert-info mb-0">{{ trans('carrier_relations.none') }}</div>{% endfor %}
    </div></section></div>
    <div class="col-lg-5"><section class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">{{ trans('carrier_relations.add') }}</h2><p class="text-muted">{{ trans('carrier_relations.add_help') }}</p>
      <form method="post">{{ macros.csrf() }}<input type="hidden" name="action" value="lookup"><label class="form-label" for="carrierEmail">{{ trans('carrier_relations.email') }}</label><div class="input-group mb-3"><input class="form-control" id="carrierEmail" type="email" name="carrier_email" value="{{ lookupEmail }}" placeholder="transportadora@empresa.com" autocomplete="off" required {{ not dbReady ? 'disabled' : '' }}><button class="btn btn-outline-primary" {{ not dbReady ? 'disabled' : '' }}>{{ trans('carrier_relations.check') }}</button></div></form>
      {% if carrierLookup %}<div class="border rounded-3 p-3 bg-light"><div class="small text-success fw-bold mb-1">{{ trans('carrier_relations.found') }}</div><h3 class="h5 mb-1">{{ carrierLookup.company_name }}</h3><div class="small text-muted">{{ carrierLookup.account_email ?: carrierLookup.email }}</div>{% if carrierLookup.phone %}<div class="small text-muted">{{ carrierLookup.phone }}</div>{% endif %}<div class="small text-muted mt-1">{{ [carrierLookup.address_line1,carrierLookup.city,carrierLookup.state,carrierLookup.zip,carrierLookup.country]|filter(v => v)|join(', ') }}</div><form method="post" class="mt-3">{{ macros.csrf() }}<input type="hidden" name="action" value="add"><input type="hidden" name="carrier_email" value="{{ lookupEmail }}"><button class="btn btn-primary w-100">{{ trans('carrier_relations.add_button') }}</button></form></div>{% endif %}
    </div></section></div>
  </div>
  {% endif %}
</main>
{% endblock %}
