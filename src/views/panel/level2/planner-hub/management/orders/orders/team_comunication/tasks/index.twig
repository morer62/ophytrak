                                            <div class="card-body p-2">
                                                <small class="text-muted d-block">{{ photo.uploaded_at|date('M d, Y H:i') }}</small>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted text-center">{{ trans('planner_hub.no_photos_uploaded') }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
    {% endfor %}
{% endfor %}

{% for task in manualTasks %}
    <div class="modal fade" id="photoModal{{ task.id }}" tabindex="-1" aria-labelledby="photoModalLabel{{ task.id }}" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="photoModalLabel{{ task.id }}">📷 {{ trans('planner_hub.photos_title') }} - {{ task.task_description }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
