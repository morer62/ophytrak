{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}



<h1 class="h3">{{ trans('planner_hub.payroll') }}</h1>
{{ macros.breadcrumb2() }}

 {% if user.level == 4 %}
  
 <!-- 🔹 Highlight Block: Your Orders -->
  <section class="p-5 rounded-4 shadow-sm mb-5 text-white" style="background: linear-gradient(135deg, #00cec9, #0984e3);">
    <h2 class="fw-bold mb-2">💰 {{ trans('planner_hub.your_bank') }}</h2>
    <p class="fs-5 mb-3">{{ trans('planner_hub.personal_info_financial') }}</p>
    <a href="{{ path('panel/planner-hub/team/payroll/pending') }}" class="btn btn-light btn-lg fw-bold px-4">{{ trans('planner_hub.continue') }}</a>
  </section>
   {% endif %}




  <!-- 🔹 Repeated Tools -->
  <section>
    <h3 class="fw-bold mb-4">{{ trans('planner_hub.quick_access') }}</h3>
    <div class="row text-center g-4">

      <!-- Chat -->
      <div class="col-md-4">
        <div class="p-5 bg-white rounded-4 shadow-sm h-100">
          <img src="{{ asset_for('assets/images/icons_website/icon_1.png') }}" alt="Chat" class="mb-4" style="height: 110px;">
          <h4 class="fw-bold mb-2">⏱️ {{ trans('planner_hub.time_tracker') }}</h4>
          <p class="text-muted fs-6 mb-3">{{ trans('planner_hub.start_stop_timer') }}</p>
          <a href="{{ path(current_location ~ '/clock') }}" class="btn btn-primary btn-lg fw-bold px-4">{{ trans('planner_hub.clock') }}</a>
        </div>
      </div>


      <!-- Basic Setting -->
      <div class="col-md-4">
        <div class="p-5 bg-white rounded-4 shadow-sm h-100">
          <img src="{{ asset_for('assets/images/icons_website/icon_2.png') }}" alt="Settings" class="mb-4" style="height: 110px;">
          <h4 class="fw-bold mb-2">💼  {{ trans('planner_hub.pending_payments') }}</h4>
          <p class="text-muted fs-6 mb-3">{{ trans('planner_hub.review_logged_hours') }}</p>
          <a href="{{ path(current_location ~ '/pending') }}" class="btn btn-secondary btn-lg fw-bold px-4">{{ trans('planner_hub.go') }}</a>
        </div>
      </div>

     

      <!-- Essential Tools -->
      <div class="col-md-4">
        <div class="p-5 bg-white rounded-4 shadow-sm h-100">
          <img src="{{ asset_for('assets/images/icons_website/icon_4.png') }}" alt="Tools" class="mb-4" style="height: 110px;">
          <h4 class="fw-bold mb-2">🧰 {{ trans('planner_hub.received_payments') }}</h4>
          <p class="text-muted fs-6 mb-3">{{ trans('planner_hub.incoming_payments_record') }}</p>
          <a href="{{ path(current_location ~ '/paid') }}"  class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.explore') }}</a>
        </div>
      </div>

    </div>
  </section>

</main>
</div>
{% endblock %}