{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h2 class="mb-4">🏦 {{ trans('planner_hub.banking') }}</h2>
{{ macros.breadcrumb2() }}

<div class="row">
    <div class="col-md-6 mx-auto">

        <div class="card text-center p-4 mb-4 shadow-sm"> 
            <strong class="mb-2">{{ trans('planner_hub.payout_schedule') }}</strong> <em>{{ trans('planner_hub.automatic_processed') }}</em>


            <h2 class="text-success fw-bold mb-1">
                💰 {{ trans('planner_hub.in_transit') }} {{ currency }} {{ pending | number_format(2) }}
            </h2>

            <hr>

           <!-- <form method="post" id="withdrawForm">
                <input type="hidden" name="action" value="withdraw">
                <input type="hidden" name="payout_type" id="payoutTypeInput" value="">

                {% if instant_enabled %}
                    <button type="button" onclick="showExpressModal({{ available | number_format(2, '.', '') }})" class="btn btn-outline-danger">
                        Withdraw Express
                    </button>
                {% else %}
                    <p class="text-muted">⚠️ Instant payouts are currently unavailable for your account.</p>
                {% endif %}
            </form> -->
        </div>

        <div class="card p-4 shadow-sm">
            <h6 class="mb-3">🔌 {{ trans('planner_hub.stripe_account_details') }}</h6>

            {% if account %}
                <p class="mb-1"><strong>{{ trans('planner_hub.account_id') }}</strong> <code>{{ account.stripe_account_id }}</code></p>
                <p class="mb-1"><strong>{{ trans('planner_hub.charges_enabled') }}</strong> {{ charges_enabled ? '✅ ' ~ trans('planner_hub.yes') : '❌ ' ~ trans('planner_hub.no') }}</p>
                <p class="mb-1"><strong>{{ trans('planner_hub.payouts_enabled') }}</strong> {{ payouts_enabled ? '✅ ' ~ trans('planner_hub.yes') : '❌ ' ~ trans('planner_hub.no') }}</p>
                <p class="mb-1"><strong>{{ trans('planner_hub.details_submitted') }}</strong> {{ details_submitted ? '✅ ' ~ trans('planner_hub.yes') : '❌ ' ~ trans('planner_hub.no') }}</p>

                {% if account.is_verified %}
                    <div class="alert alert-success mt-3 text-center">
                        ✅ {{ trans('planner_hub.account_fully_verified') }}
                    </div>
                {% else %}
                    <div class="alert alert-warning text-center mt-2">
                        ⚠️ {{ trans('planner_hub.stripe_account_not_verified') }}
                        <a href="{{ login_link }}" class="btn btn-dark">🔐 {{ trans('planner_hub.open_stripe_dashboard') }}</a>
                    </div>
                {% endif %}

                <div class="d-grid gap-2 mt-3">
                    {% if onboarding_link %}
                        <a href="{{ onboarding_link }}" class="btn btn-warning">
                            {{ (charges_enabled and payouts_enabled and details_submitted) ? '✅ ' ~ trans('planner_hub.account_verified') : '⚠️ ' ~ trans('planner_hub.fix_complete_account_info') }}
                        </a>
                    {% endif %}
                    {% if login_link %}
                        <a href="{{ login_link }}" class="btn btn-dark">🔐 {{ trans('planner_hub.open_stripe_dashboard') }}</a>
                    {% endif %}
                </div>
            {% else %}
                <div class="alert alert-warning">{{ trans('planner_hub.no_stripe_account_connected') }}</div>
                <a href="{{ path('panel/planner-hub/team/payments/create-account-link') }}"
                   class="btn btn-outline-primary mt-3">
                   {{ trans('planner_hub.connect_stripe') }}
                </a>
            {% endif %}
        </div>

    </div>
</div>

<!-- Modal Express -->
<div class="modal fade" id="expressModal" tabindex="-1" aria-labelledby="expressModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title" id="expressModalLabel">💸 {{ trans('planner_hub.express_withdrawal_confirmation') }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-start">
        <p>
          {{ trans('planner_hub.express_withdrawals_fee') }}<br>
          {{ trans('planner_hub.from_balance') }} <strong>USD <span id="express-amount"></span></strong>,
          {{ trans('planner_hub.fee_will_be_applied') }} <strong>USD <span id="express-fee"></span></strong> {{ trans('planner_hub.will_be_applied') }}
        </p>
        <p>
          {{ trans('planner_hub.you_will_receive') }} <strong>USD <span id="express-net"></span></strong> {{ trans('planner_hub.to_bank_account') }}
        </p>
        <p class="mb-0">{{ trans('planner_hub.continue_express_withdrawal') }}</p>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.cancel') }}</button>
        <button type="button" class="btn btn-primary" onclick="submitPayout('instant')">{{ trans('planner_hub.confirm_express_withdrawal') }}</button>
      </div>
    </div>
  </div>
</div>

<script>
function showExpressModal(amount) {
    const fee = (amount * 0.01 + 0.50).toFixed(2);
    const net = (amount - fee).toFixed(2);
    document.getElementById('express-amount').textContent = amount.toFixed(2);
    document.getElementById('express-fee').textContent = fee;
    document.getElementById('express-net').textContent = net;

    const modal = new bootstrap.Modal(document.getElementById('expressModal'));
    modal.show();
}

function submitPayout(type) {
    document.getElementById('payoutTypeInput').value = type;
    document.getElementById('withdrawForm').submit();
}
</script>
{% endblock %}
