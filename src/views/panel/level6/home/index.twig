{% extends 'templates/base.admin.twig' %}
{% set _i18n_ready = trans('common.language') %}

{% block body %}
<main class="container mt-5" style="max-width:640px;">
    <section class="text-center mb-5">
        <h1 class="fw-bold mb-3">🎯 Marketing Tools Access</h1>
        <p class="text-muted fs-5">
            Welcome! This profile is focused on the marketing toolkit. Go straight to the Mark Tools workspace to start using the available assistants.
        </p>
    </section>

    <section class="card shadow-sm border-0">
        <div class="card-body p-5 text-center">
            <img src="{{ asset_for('assets/images/icons_website/icon_3.png') }}" alt="Mark Tools" class="mb-4" style="height:120px;">
            <h2 class="fw-bold mb-3">Mark Tools</h2>
            <p class="text-muted mb-4">
                Access text humanizer, voice generator and lead finder—everything you need to support marketing campaigns.
            </p>
            <a href="{{ path('panel/mark-tools') }}" class="btn btn-success btn-lg fw-bold px-5">
                Open Mark Tools
            </a>
        </div>
    </section>
</main>
{% endblock %}

