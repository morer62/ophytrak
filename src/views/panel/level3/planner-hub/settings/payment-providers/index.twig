document.addEventListener('DOMContentLoaded', function() {
    // Function to show/hide provider-specific fields
    function toggleProviderFields(selectedValue) {
        // Hide all provider fields
        document.querySelectorAll('.provider-fields').forEach(el => {
            el.style.display = 'none';
            // Disable all inputs in hidden fields to prevent them from being submitted
            el.querySelectorAll('input, select, textarea').forEach(input => {
                input.disabled = true;
            });
        });
        
        // Show selected provider fields
        let targetField = null;
        if (selectedValue === 'stripe') {
            targetField = document.getElementById('stripeFields');
        } else if (selectedValue === 'square') {
            targetField = document.getElementById('squareFields');
        } else if (selectedValue === 'paypal') {
            targetField = document.getElementById('paypalFields');
        }
        
        if (targetField) {
            targetField.style.display = 'block';
            // Enable inputs in visible fields
            targetField.querySelectorAll('input, select, textarea').forEach(input => {
                input.disabled = false;
            });
        }
    }
    
    // Show/hide provider-specific fields
    const providerType = document.getElementById('providerType');
    if (providerType) {
        // Initialize fields on page load if a provider is already selected
        if (providerType.value) {
            toggleProviderFields(providerType.value);
        }
        
        providerType.addEventListener('change', function() {
            toggleProviderFields(this.value);
        });
    }
    
    // Also handle when the add modal is opened
    const addModal = document.getElementById('addProviderModal');
    if (addModal) {
        addModal.addEventListener('show.bs.modal', function() {
            // Reset form
            const form = addModal.querySelector('form');
            if (form) {
                form.reset();
            }
            
            // Reset provider type dropdown
            const providerTypeSelect = document.getElementById('providerType');
            if (providerTypeSelect) {
                providerTypeSelect.value = '';
                // Hide all fields initially
                toggleProviderFields('');
            }
        });
        
        // Also handle when provider type changes in the modal
        const providerTypeSelect = document.getElementById('providerType');
        if (providerTypeSelect) {
            providerTypeSelect.addEventListener('change', function() {
                toggleProviderFields(this.value);
            });
        }
    }
    
    // Test modal handler
    const testModal = document.getElementById('testProviderModal');
    if (testModal) {
        testModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const providerId = button.getAttribute('data-provider-id');
            const providerName = button.getAttribute('data-provider-name');
            
            document.getElementById('testProviderId').value = providerId;
            document.getElementById('testProviderName').textContent = providerName;
        });
    }
    
    // Edit modal handler
    const editModal = document.getElementById('editProviderModal');
    if (editModal) {
        editModal.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            const providerType = button.getAttribute('data-provider-type');
            
            document.getElementById('editProviderId').value = button.getAttribute('data-provider-id');
            document.getElementById('editProviderType').value = providerType.charAt(0).toUpperCase() + providerType.slice(1);
            document.getElementById('editProviderName').value = button.getAttribute('data-provider-name');
            document.getElementById('editEnvironment').value = button.getAttribute('data-environment');
            document.getElementById('editCurrency').value = button.getAttribute('data-currency');
            document.getElementById('editApiKey').value = '';
            document.getElementById('editApiSecret').value = '';
            document.getElementById('editPublicKey').value = '';
            document.getElementById('editWebhookSecret').value = '';
            document.getElementById('editMerchantEmail').value = button.getAttribute('data-merchant-email') || '';
            document.getElementById('editLocationId').value = button.getAttribute('data-location-id') || '';
            
            // Show/hide fields based on provider type
            const apiSecretContainer = document.getElementById('editApiSecretContainer');
            const publicKeyContainer = document.getElementById('editPublicKeyContainer');
            const webhookSecretContainer = document.getElementById('editWebhookSecretContainer');
            const locationIdContainer = document.getElementById('editLocationIdContainer');
            
            // Update labels and help text based on provider type
            const apiKeyLabel = document.getElementById('editApiKeyLabel');
            const apiKeyHelp = document.getElementById('editApiKeyHelp');
            const publicKeyLabel = document.getElementById('editPublicKeyLabel');
            const publicKeyHelp = document.getElementById('editPublicKeyHelp');
            
            if (providerType === 'paypal') {
                apiKeyLabel.textContent = window.i18nPaymentProviders.paypal_client_id;
                apiKeyHelp.textContent = window.i18nPaymentProviders.paypal_client_id_edit_help;
                apiSecretContainer.style.display = 'block';
                publicKeyContainer.style.display = 'none';
                webhookSecretContainer.style.display = 'none';
                locationIdContainer.style.display = 'none';
            } else if (providerType === 'square') {
                apiKeyLabel.textContent = window.i18nPaymentProviders.square_access_token;
                apiKeyHelp.textContent = window.i18nPaymentProviders.square_access_token_edit_help;
                publicKeyLabel.textContent = window.i18nPaymentProviders.square_application_id;
                publicKeyHelp.textContent = window.i18nPaymentProviders.square_application_id_edit_help;
                apiSecretContainer.style.display = 'none';
                publicKeyContainer.style.display = 'block';
                webhookSecretContainer.style.display = 'none';
                locationIdContainer.style.display = 'block';
            } else if (providerType === 'stripe') {
                apiKeyLabel.textContent = window.i18nPaymentProviders.stripe_secret_key;
                apiKeyHelp.textContent = window.i18nPaymentProviders.stripe_secret_key_edit_help;
                publicKeyLabel.textContent = window.i18nPaymentProviders.stripe_publishable_key;
                publicKeyHelp.textContent = window.i18nPaymentProviders.stripe_publishable_key_edit_help;
                apiSecretContainer.style.display = 'none';
                publicKeyContainer.style.display = 'block';
                webhookSecretContainer.style.display = 'block';
                locationIdContainer.style.display = 'none';
            }
        });
    }
    
    // Initialize Feather icons
    if (typeof feather !== 'undefined') {
        feather.replace();
    }
});

function confirmDelete(providerId, providerName) {
    var msg = (window.i18nPaymentProviders.confirm_delete || 'Are you sure you want to delete "{name}"? This action cannot be undone.').replace('{name}', providerName);
    if (confirm(msg)) {
        document.getElementById('deleteProviderId').value = providerId;
        document.getElementById('deleteForm').submit();
    }
}

