// Load Square.js - Make sure we use the correct environment
(function() {
    // Remove any existing Square script
    const existingScript = document.querySelector('script[src*="squarecdn.com"]');
    if (existingScript) {
        existingScript.remove();
    }
    
    // Determine environment based on provider settings
    const isProduction = '{{ activeProvider.environment }}' === 'production';
    const squareUrl = isProduction 
        ? 'https://web.squarecdn.com/v1/square.js'
        : 'https://sandbox.web.squarecdn.com/v1/square.js';
    
    const squareScript = document.createElement('script');
    squareScript.src = squareUrl;
    squareScript.async = true;
    
    squareScript.onload = function() {
        // Wait a bit for Square to be fully available
        setTimeout(function() {
            const applicationId = '{{ activeProvider.public_key }}';
            const locationId = '{{ activeProvider.location_id }}';
            
            if (!window.Square) {
                console.error('Square.js failed to load');
                const errorDiv = document.getElementById('square-card-errors');
                if (errorDiv) {
                    errorDiv.textContent = 'Unable to load Square payment form. Please refresh the page.';
                }
                return;
            }
            
            // Check if sq-card element exists
            const sqCardElement = document.getElementById('sq-card');
            if (!sqCardElement) {
                console.error('Square card element not found');
                return;
            }
            
            const payments = window.Square.payments(applicationId, locationId);
            let card;
            
            async function initializeCard() {
                try {
                    card = await payments.card();
                    await card.attach('#sq-card');
                    console.log('Square card initialized successfully');
                } catch (e) {
                    console.error('Initializing Card failed', e);
                    const errorDiv = document.getElementById('square-card-errors');
                    if (errorDiv) {
                        errorDiv.textContent = (window.i18nPaymentProviders.unable_init_payment_form || 'Unable to initialize payment form: ') + (e.message || 'Unknown error');
                    }
                }
            }
            
            initializeCard();
            
            const form = document.getElementById('testPaymentForm');
            if (form) {
                form.addEventListener('submit', async function(event) {
                    event.preventDefault();
                    
                    if (!card) {
                        const errorDiv = document.getElementById('square-card-errors');
                        if (errorDiv) {
                            errorDiv.textContent = 'Payment form not ready. Please wait a moment and try again.';
                        }
                        return;
                    }
                    
                    const submitBtn = document.getElementById('testPaymentBtn');
                    const resultDiv = document.getElementById('testPaymentResult');
                    const errorDiv = document.getElementById('square-card-errors');
                    const amount = document.getElementById('testAmount').value;
                    const description = document.getElementById('testDescription').value;
                    
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>' + (window.i18nPaymentProviders.processing || 'Processing...');
                    resultDiv.innerHTML = '';
                    if (errorDiv) errorDiv.textContent = '';
                    
                    try {
                        const tokenResult = await card.tokenize();
                        if (tokenResult.status === 'OK') {
                            // Submit form with token
                            const formData = new FormData();
                            formData.append('action', 'test_payment');
                            formData.append('amount', amount);
                            formData.append('description', description);
                            formData.append('token', tokenResult.token);
                            
                            const response = await fetch(window.location.href, {
                                method: 'POST',
                                body: formData,
                                redirect: 'manual'
                            });
                            
                            if (response.type === 'opaqueredirect' || (response.redirected && response.url)) {
                                if (response.url) {
                                    window.location.href = response.url;
                                } else {
                                    resultDiv.innerHTML = '<div class="alert alert-danger">' + (window.i18nPaymentProviders.payment_failed_please_retry || 'Payment failed. Please try again.') + '</div>';
                                    submitBtn.disabled = false;
                                    submitBtn.innerHTML = '<i class="bi bi-credit-card me-2"></i>' + (window.i18nPaymentProviders.process_test_payment || 'Process Test Payment');
                                }
                                return;
                            }
                            
                            if (!response.ok) {
                                resultDiv.innerHTML = '<div class="alert alert-danger">' + (window.i18nPaymentProviders.payment_failed_please_retry || 'Payment failed. Please try again.') + '</div>';
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = '<i class="bi bi-credit-card me-2"></i>' + (window.i18nPaymentProviders.process_test_payment || 'Process Test Payment');
                                return;
                            }
                            
                            resultDiv.innerHTML = '<div class="alert alert-success">' + (window.i18nPaymentProviders.payment_processed_successfully || 'Payment processed successfully!') + '</div>';
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-credit-card me-2"></i>' + (window.i18nPaymentProviders.process_test_payment || 'Process Test Payment');
                        } else {
                            let errorMessage = window.i18nPaymentProviders.payment_failed_please_retry || 'Payment failed. Please try again.';
                            if (tokenResult.errors && tokenResult.errors.length > 0) {
                                errorMessage = tokenResult.errors[0].detail || errorMessage;
                            }
                            if (errorDiv) errorDiv.textContent = errorMessage;
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = '<i class="bi bi-credit-card me-2"></i>' + (window.i18nPaymentProviders.process_test_payment || 'Process Test Payment');
                        }
                    } catch (err) {
                        console.error('Error:', err);
                        if (errorDiv) {
                            errorDiv.textContent = (window.i18nPaymentProviders.unable_init_payment_form || 'An error occurred: ') + (err.message || '');
                        }
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-credit-card me-2"></i>' + (window.i18nPaymentProviders.process_test_payment || 'Process Test Payment');
                    }
                });
            }
        }, 500); // Wait 500ms for Square to be fully ready
    };
    
    squareScript.onerror = function() {
        console.error('Failed to load Square.js');
        const errorDiv = document.getElementById('square-card-errors');
        if (errorDiv) {
            errorDiv.textContent = window.i18nPaymentProviders.failed_load_square_library || 'Failed to load Square payment library. Please refresh the page.';
        }
    };
    
    document.head.appendChild(squareScript);
})();
