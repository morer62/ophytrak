// Load PayPal.js SDK
(function() {
    // Remove any existing PayPal script
    const existingScript = document.querySelector('script[src*="paypal.com"]');
    if (existingScript) {
        existingScript.remove();
    }
    
    // Determine environment
    const isProduction = '{{ activeProvider.environment }}' === 'production';
    // PayPal Client ID is stored in api_key field
    const clientId = '{{ activeProvider.api_key }}';
    
    // PayPal SDK URL
    const paypalScript = document.createElement('script');
    paypalScript.src = 'https://www.paypal.com/sdk/js?client-id=' + clientId + '&currency={{ activeProvider.currency }}';
    paypalScript.async = true;
    
    paypalScript.onload = function() {
        setTimeout(function() {
            if (!window.paypal) {
                console.error('PayPal.js failed to load');
                const errorDiv = document.getElementById('paypal-errors');
                if (errorDiv) {
                    errorDiv.textContent = 'Unable to load PayPal SDK. Please refresh the page.';
                }
                return;
            }
            
            const buttonContainer = document.getElementById('paypal-button-container');
            if (!buttonContainer) {
                console.error('PayPal button container not found');
                return;
            }
            
            const amountInput = document.getElementById('testAmount');
            const descriptionInput = document.getElementById('testDescription');
            const resultDiv = document.getElementById('testPaymentResult');
            
            // Render PayPal button
            window.paypal.Buttons({
                createOrder: function(data, actions) {
                    const amount = parseFloat(amountInput.value) || 1.00;
                    const description = descriptionInput.value || 'Test Payment';
                    
                    return actions.order.create({
                        purchase_units: [{
                            amount: {
                                value: amount.toFixed(2),
                                currency_code: '{{ activeProvider.currency }}'
                            },
                            description: description
                        }]
                    });
                },
                onApprove: function(data, actions) {
                    // The SDK automatically captures the order, so we just need to verify it
                    return actions.order.get().then(function(orderDetails) {
                        // Submit to server to verify and process the payment
                        const formData = new FormData();
                        formData.append('action', 'test_payment');
                        formData.append('amount', amountInput.value);
                        formData.append('description', descriptionInput.value || 'Test Payment');
                        formData.append('token', data.orderID); // PayPal order ID
                        
                        fetch(window.location.href, {
                            method: 'POST',
                            body: formData
                        }).then(function(response) {
                            if (response.redirected) {
                                window.location.href = response.url;
                            } else {
                                return response.text().then(function(text) {
                                    if (resultDiv) {
                                        // Check if order was already captured
                                        const order = orderDetails;
                                        const capture = order.purchase_units?.[0]?.payments?.captures?.[0];
                                        
                                        if (capture && capture.status === 'COMPLETED') {
                                            resultDiv.innerHTML = '<div class="alert alert-success">✅ Payment completed! Capture ID: ' + capture.id + '</div>';
                                        } else {
                                            resultDiv.innerHTML = '<div class="alert alert-success">✅ Payment approved! Order ID: ' + data.orderID + '</div>';
                                        }
                                    }
                                });
                            }
                        }).catch(function(err) {
                            console.error('Error:', err);
                            if (resultDiv) {
                                resultDiv.innerHTML = '<div class="alert alert-danger">Error processing payment. Please try again.</div>';
                            }
                        });
                    });
                },
                onError: function(err) {
                    console.error('PayPal error:', err);
                    const errorDiv = document.getElementById('paypal-errors');
                    if (errorDiv) {
                        errorDiv.textContent = 'PayPal error: ' + (err.message || 'Unknown error');
                    }
                },
                onCancel: function(data) {
                    const resultDiv = document.getElementById('testPaymentResult');
                    if (resultDiv) {
                        resultDiv.innerHTML = '<div class="alert alert-warning">Payment cancelled.</div>';
                    }
                }
            }).render('#paypal-button-container');
        }, 500);
    };
    
    paypalScript.onerror = function() {
        console.error('Failed to load PayPal.js');
        const errorDiv = document.getElementById('paypal-errors');
        if (errorDiv) {
            errorDiv.textContent = 'Failed to load PayPal SDK. Please refresh the page.';
        }
    };
    
    document.head.appendChild(paypalScript);
})();
