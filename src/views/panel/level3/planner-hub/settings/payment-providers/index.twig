{% extends 'templates/base.admin.twig' %}

{% block body %}
    <h1 class="h3 mb-4">💳 {{ trans('planner_hub.payment_providers_config') }}</h1>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0">
            {{ trans('planner_hub.payment_providers_desc') }}
        </p>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProviderModal">
            ➕ {{ trans('planner_hub.add_payment_provider') }}
        </button>
    </div>

    {% if providers is empty %}
        <div class="alert alert-info">
            <h5 class="alert-heading">💳 {{ trans('planner_hub.no_payment_provider') }}</h5>
            <p class="mb-2">{{ trans('planner_hub.no_payment_provider_desc') }}</p>
            <p class="mb-0">
                <strong>{{ trans('planner_hub.need_payment_provider') }}</strong>
                {{ trans('planner_hub.click_add_provider') }}
            </p>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>{{ trans('planner_hub.provider') }}</th>
                        <th>{{ trans('planner_hub.name') }}</th>
                        <th>{{ trans('planner_hub.environment') }}</th>
                        <th>{{ trans('planner_hub.currency') }}</th>
                        <th>{{ trans('planner_hub.status') }}</th>
                        <th>{{ trans('planner_hub.last_used') }}</th>
                        <th class="text-center">{{ trans('planner_hub.actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for provider in providers %}
                        <tr class="{% if provider.is_default %}table-primary{% endif %} {% if provider.is_active %}table-success{% endif %}">
                            <td>
                                <strong>
                                    {% if provider.provider_type == 'stripe' %}💳 Stripe
                                    {% elseif provider.provider_type == 'square' %}🔲 Square
                                    {% elseif provider.provider_type == 'paypal' %}🅿️ PayPal
                                    {% else %}{{ provider.provider_type|upper }}
                                    {% endif %}
                                </strong>
                                {% if provider.is_default %}
                                    <span class="badge bg-primary ms-2">{{ trans('planner_hub.default') }}</span>
                                {% endif %}
                                {% if provider.is_active %}
                                    <span class="badge bg-success ms-2">{{ trans('planner_hub.active') }}</span>
                                {% else %}
                                    <span class="badge bg-secondary ms-2">{{ trans('planner_hub.inactive') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div>{{ provider.provider_name }}</div>
                                {% if provider.merchant_email %}
                                    <small class="text-muted">{{ provider.merchant_email }}</small>
                                {% endif %}
                            </td>
                            <td>
                                {% if provider.environment == 'production' %}
                                    <span class="badge bg-success">{{ trans('planner_hub.production') }}</span>
                                {% else %}
                                    <span class="badge bg-warning">{{ trans('planner_hub.sandbox') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <strong>{{ provider.currency }}</strong>
                            </td>
                            <td>
                                {% if provider.is_verified %}
                                    <span class="badge bg-success">✓ {{ trans('planner_hub.verified') }}</span>
                                {% else %}
                                    <span class="badge bg-warning">⚠ {{ trans('planner_hub.not_verified') }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if provider.last_used_at %}
                                    <small>{{ provider.last_used_at|date('M j, Y g:i A') }}</small>
                                {% else %}
                                    <small class="text-muted">{{ trans('planner_hub.never_used') }}</small>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    {% if not provider.is_default %}
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="action" value="set_default">
                                            <input type="hidden" name="provider_id" value="{{ provider.id }}">
                                            <button type="submit" class="btn btn-outline-primary" data-bs-toggle="tooltip" title="{{ trans('planner_hub.set_as_default') }}">
                                                <i data-feather="star"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                    
                                    <button type="button" class="btn btn-outline-info" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#testProviderModal"
                                            data-provider-id="{{ provider.id }}"
                                            data-provider-name="{{ provider.provider_name }}"
                                            data-provider-type="{{ provider.provider_type }}"
                                            title="{{ trans('planner_hub.test_credentials') }}">
                                        <i data-feather="check-circle"></i>
                                    </button>
                                    
                                    <button type="button" class="btn btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editProviderModal"
                                            data-provider-id="{{ provider.id }}"
                                            data-provider-type="{{ provider.provider_type }}"
                                            data-provider-name="{{ provider.provider_name }}"
                                            data-api-key="{{ provider.api_key }}"
                                            data-api-secret="{{ provider.api_secret }}"
                                            data-public-key="{{ provider.public_key }}"
                                            data-webhook-secret="{{ provider.webhook_secret }}"
                                            data-environment="{{ provider.environment }}"
                                            data-currency="{{ provider.currency }}"
                                            data-merchant-email="{{ provider.merchant_email }}"
                                            data-location-id="{{ provider.location_id }}"
                                            title="{{ trans('planner_hub.edit') }}">
                                        <i data-feather="edit"></i>
                                    </button>
                                    
                                    {% if provider.is_active %}
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="action" value="deactivate">
                                            <input type="hidden" name="provider_id" value="{{ provider.id }}">
                                            <button type="submit" class="btn btn-outline-warning" title="{{ trans('planner_hub.deactivate') }}">
                                                <i data-feather="pause"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="action" value="activate">
                                            <input type="hidden" name="provider_id" value="{{ provider.id }}">
                                            <button type="submit" class="btn btn-outline-success" title="{{ trans('planner_hub.activate') }}">
                                                <i data-feather="play"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                    
                                    {% if not provider.is_default %}
                                        <button type="button" class="btn btn-outline-danger" 
                                                onclick="confirmDelete({{ provider.id }}, '{{ provider.provider_name|e('js') }}')"
                                                title="{{ trans('planner_hub.delete') }}">
                                            <i data-feather="trash-2"></i>
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <!-- Hidden delete form -->
    <form method="post" id="deleteForm" class="d-none">
        <input type="hidden" name="action" value="delete">
        <input type="hidden" name="provider_id" id="deleteProviderId">
    </form>

    <!-- Test Payment Section -->
    {% if activeProvider %}
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-credit-card me-2"></i>{{ trans('planner_hub.test_payment') }}
            </h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                {{ trans('planner_hub.test_payment_with_provider') }} <strong>{{ activeProvider.provider_name }}</strong> ({{ activeProvider.provider_type|upper }})
            </p>
            
            <form id="testPaymentForm">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">{{ trans('planner_hub.amount') }} <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">{{ activeProvider.currency }}</span>
                            <input type="number" class="form-control" id="testAmount" name="amount" 
                                   step="0.01" min="0.50" value="1.00" required>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">{{ trans('planner_hub.description') }}</label>
                        <input type="text" class="form-control" id="testDescription" name="description" 
                               placeholder="{{ trans('planner_hub.test_payment') }}" value="{{ trans('planner_hub.test_payment') }}">
                    </div>
                </div>

                <!-- Stripe Card Element -->
                {% if activeProvider.provider_type == 'stripe' %}
                <div id="stripe-card-element" class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.card_details') }} <span class="text-danger">*</span></label>
                    <div id="card-element" class="form-control" style="height: 40px; padding: 10px;"></div>
                    <div id="card-errors" class="text-danger mt-2" role="alert"></div>
                </div>
                {% endif %}

                <!-- Square Card Element -->
                {% if activeProvider.provider_type == 'square' %}
                <div id="square-card-element" class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.card_details') }} <span class="text-danger">*</span></label>
                    <div id="sq-card" style="min-height: 40px;"></div>
                    <div id="square-card-errors" class="text-danger mt-2" role="alert"></div>
                </div>
                {% endif %}

                <!-- PayPal Button -->
                {% if activeProvider.provider_type == 'paypal' %}
                <div id="paypal-button-container" class="mb-3"></div>
                <div id="paypal-errors" class="text-danger mt-2" role="alert"></div>
                {% endif %}

                <div class="d-flex justify-content-between align-items-center">
                    <div id="testPaymentResult" class="mb-0"></div>
                    <button type="submit" class="btn btn-primary" id="testPaymentBtn" 
                            {% if activeProvider.provider_type == 'paypal' %}style="display: none;"{% endif %}>
                        <i class="bi bi-credit-card me-2"></i>{{ trans('planner_hub.process_test_payment') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
    {% else %}
    <div class="card mt-4">
        <div class="card-body">
            <div class="alert alert-warning mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>{{ trans('planner_hub.no_active_provider_activate_to_test') }}</strong>
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block aside %}
    <!-- Add Provider Modal -->
    <div class="modal fade" id="addProviderModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post">
                    <input type="hidden" name="action" value="add">
                    
                    <div class="modal-header">
                        <h5 class="modal-title">➕ {{ trans('planner_hub.add_payment_provider') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.provider_type') }} <span class="text-danger">*</span></label>
                            <select name="provider_type" id="providerType" class="form-select" required>
                                <option value="">{{ trans('planner_hub.select_provider') }}</option>
                                <option value="stripe">💳 Stripe</option>
                                <option value="square">🔲 Square</option>
                                <option value="paypal">🅿️ PayPal</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.provider_name') }} <span class="text-danger">*</span></label>
                            <input type="text" name="provider_name" class="form-control" required 
                                   placeholder="{{ trans('planner_hub.provider_name_placeholder') }}">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.environment') }}</label>
                            <select name="environment" class="form-select">
                                <option value="sandbox">{{ trans('planner_hub.sandbox_testing') }}</option>
                                <option value="production">{{ trans('planner_hub.production_live') }}</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.currency') }}</label>
                            <select name="currency" class="form-select">
                                <option value="USD">{{ trans('planner_hub.currency_usd') }}</option>
                                <option value="EUR">{{ trans('planner_hub.currency_eur') }}</option>
                                <option value="GBP">{{ trans('planner_hub.currency_gbp') }}</option>
                                <option value="CAD">{{ trans('planner_hub.currency_cad') }}</option>
                                <option value="MXN">{{ trans('planner_hub.currency_mxn') }}</option>
                                <option value="BRL">{{ trans('planner_hub.currency_brl') }}</option>
                                <option value="CLP">{{ trans('planner_hub.currency_clp') }}</option>
                                <option value="COP">{{ trans('planner_hub.currency_cop') }}</option>
                            </select>
                        </div>
                        
                        <hr>
                        <h6 class="mb-3">{{ trans('planner_hub.credentials') }}</h6>
                        
                        <!-- Stripe Fields -->
                        <div id="stripeFields" class="provider-fields" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.stripe_secret_key') }} <span class="text-danger">*</span></label>
                                <input type="text" name="api_key" class="form-control" 
                                       placeholder="{{ trans('planner_hub.stripe_secret_key_placeholder') }}">
                                <small class="text-muted">{{ trans('planner_hub.stripe_secret_key_help') }}</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.stripe_publishable_key') }} <span class="text-danger">*</span></label>
                                <input type="text" name="public_key" class="form-control" 
                                       placeholder="{{ trans('planner_hub.stripe_publishable_key_placeholder') }}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.webhook_secret_optional') }}</label>
                                <input type="text" name="webhook_secret" class="form-control" 
                                       placeholder="{{ trans('planner_hub.webhook_secret_placeholder') }}">
                            </div>
                        </div>
                        
                        <!-- Square Fields -->
                        <div id="squareFields" class="provider-fields" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.square_access_token') }} <span class="text-danger">*</span></label>
                                <input type="text" name="api_key" class="form-control" 
                                       placeholder="{{ trans('planner_hub.square_access_token_placeholder') }}">
                                <small class="text-muted">{{ trans('planner_hub.square_access_token_help') }}</small>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.square_application_id') }} <span class="text-danger">*</span></label>
                                <input type="text" name="public_key" class="form-control" 
                                       placeholder="{{ trans('planner_hub.square_application_id_placeholder') }}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.location_id') }} <span class="text-danger">*</span></label>
                                <input type="text" name="location_id" class="form-control" 
                                       placeholder="{{ trans('planner_hub.location_id_placeholder') }}">
                            </div>
                        </div>
                        
                        <!-- PayPal Fields -->
                        <div id="paypalFields" class="provider-fields" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.paypal_client_id') }} <span class="text-danger">*</span></label>
                                <input type="text" name="api_key" class="form-control" 
                                       placeholder="{{ trans('planner_hub.paypal_client_id_placeholder') }}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.paypal_client_secret') }} <span class="text-danger">*</span></label>
                                <input type="password" name="api_secret" class="form-control" 
                                       placeholder="{{ trans('planner_hub.paypal_client_secret_placeholder') }}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ trans('planner_hub.merchant_email_optional') }}</label>
                                <input type="email" name="merchant_email" class="form-control" 
                                       placeholder="{{ trans('planner_hub.merchant_email_placeholder') }}">
                            </div>
                        </div>
                        
                        <div class="mb-3 form-check">
                            <input type="checkbox" name="is_active" class="form-check-input" id="isActiveCheck" checked>
                            <label class="form-check-label" for="isActiveCheck">
                                {{ trans('planner_hub.activate_this_provider') }}
                            </label>
                        </div>
                        
                        <div class="alert alert-warning">
                            <small>
                                {{ trans('planner_hub.credentials_encrypted_note') }}
                            </small>
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.cancel') }}</button>
                        <button type="submit" class="btn btn-primary">💾 {{ trans('planner_hub.save_provider') }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Test Provider Modal -->
    <div class="modal fade" id="testProviderModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post">
                    <input type="hidden" name="action" value="test">
                    <input type="hidden" name="provider_id" id="testProviderId">
                    
                    <div class="modal-header">
                        <h5 class="modal-title">🧪 {{ trans('planner_hub.test_payment_provider_modal') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body">
                        <p>{{ trans('planner_hub.test_credentials_for') }} <strong id="testProviderName"></strong></p>
                        <p class="text-muted">{{ trans('planner_hub.test_verify_api_keys') }}</p>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.cancel') }}</button>
                        <button type="submit" class="btn btn-primary">🧪 {{ trans('planner_hub.test_credentials_btn') }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Provider Modal -->
    <div class="modal fade" id="editProviderModal" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form method="post">
                    <input type="hidden" name="action" value="update">
                    <input type="hidden" name="provider_id" id="editProviderId">
                    
                    <div class="modal-header">
                        <h5 class="modal-title">✏️ {{ trans('planner_hub.edit_payment_provider') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.provider_type') }}</label>
                            <input type="text" id="editProviderType" class="form-control" readonly>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.provider_name') }}</label>
                            <input type="text" name="provider_name" id="editProviderName" class="form-control" required>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.environment') }}</label>
                            <select name="environment" id="editEnvironment" class="form-select">
                                <option value="sandbox">{{ trans('planner_hub.sandbox_testing') }}</option>
                                <option value="production">{{ trans('planner_hub.production_live') }}</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.currency') }}</label>
                            <select name="currency" id="editCurrency" class="form-select">
                                <option value="USD">{{ trans('planner_hub.currency_usd') }}</option>
                                <option value="EUR">{{ trans('planner_hub.currency_eur') }}</option>
                                <option value="GBP">{{ trans('planner_hub.currency_gbp') }}</option>
                                <option value="CAD">{{ trans('planner_hub.currency_cad') }}</option>
                                <option value="MXN">{{ trans('planner_hub.currency_mxn') }}</option>
                                <option value="BRL">{{ trans('planner_hub.currency_brl') }}</option>
                                <option value="CLP">{{ trans('planner_hub.currency_clp') }}</option>
                                <option value="COP">{{ trans('planner_hub.currency_cop') }}</option>
                            </select>
                        </div>
                        
                        <hr>
                        <h6 class="mb-3">{{ trans('planner_hub.credentials') }}</h6>
                        <p class="text-muted small">{{ trans('planner_hub.leave_empty_keep_current') }}</p>
                        
                        <!-- Stripe/Square/PayPal API Key -->
                        <div class="mb-3">
                            <label class="form-label" id="editApiKeyLabel">{{ trans('planner_hub.api_key') }}</label>
                            <input type="text" name="api_key" id="editApiKey" class="form-control" 
                                   placeholder="{{ trans('planner_hub.leave_empty_placeholder') }}">
                            <small class="text-muted" id="editApiKeyHelp"></small>
                        </div>
                        
                        <div class="mb-3" id="editApiSecretContainer">
                            <label class="form-label">{{ trans('planner_hub.api_secret') }}</label>
                            <input type="password" name="api_secret" id="editApiSecret" class="form-control" 
                                   placeholder="{{ trans('planner_hub.leave_empty_placeholder') }}">
                        </div>
                        
                        <div class="mb-3" id="editPublicKeyContainer">
                            <label class="form-label" id="editPublicKeyLabel">{{ trans('planner_hub.public_key') }}</label>
                            <input type="text" name="public_key" id="editPublicKey" class="form-control" 
                                   placeholder="{{ trans('planner_hub.leave_empty_placeholder') }}">
                            <small class="text-muted" id="editPublicKeyHelp"></small>
                        </div>
                        
                        <div class="mb-3" id="editWebhookSecretContainer">
                            <label class="form-label">{{ trans('planner_hub.webhook_secret') }}</label>
                            <input type="text" name="webhook_secret" id="editWebhookSecret" class="form-control" 
                                   placeholder="{{ trans('planner_hub.leave_empty_placeholder') }}">
                        </div>
                        
                        <div class="mb-3" id="editLocationIdContainer">
                            <label class="form-label">{{ trans('planner_hub.location_id') }}</label>
                            <input type="text" name="location_id" id="editLocationId" class="form-control" 
                                   placeholder="{{ trans('planner_hub.leave_empty_placeholder') }}">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">{{ trans('planner_hub.merchant_email') }}</label>
                            <input type="email" name="merchant_email" id="editMerchantEmail" class="form-control" 
                                   placeholder="{{ trans('planner_hub.merchant_email_placeholder') }}">
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.cancel') }}</button>
                        <button type="submit" class="btn btn-primary">💾 {{ trans('planner_hub.update_provider') }}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
<script>
window.i18nPaymentProviders = {
    confirm_delete: '{{ trans('planner_hub.confirm_delete_provider')|e('js') }}',
    processing: '{{ trans('planner_hub.processing')|e('js') }}',
    process_test_payment: '{{ trans('planner_hub.process_test_payment')|e('js') }}',
    payment_processed_successfully: '{{ trans('planner_hub.payment_processed_successfully')|e('js') }}',
    payment_failed_please_retry: '{{ trans('planner_hub.payment_failed_please_retry')|e('js') }}',
    error_occurred_retry: '{{ trans('planner_hub.error_occurred_retry')|e('js') }}',
    unable_load_square_form: '{{ trans('planner_hub.unable_load_square_form')|e('js') }}',
    unable_init_payment_form: '{{ trans('planner_hub.unable_init_payment_form')|e('js') }}',
    payment_form_not_ready: '{{ trans('planner_hub.payment_form_not_ready')|e('js') }}',
    failed_load_square_library: '{{ trans('planner_hub.failed_load_square_library')|e('js') }}',
