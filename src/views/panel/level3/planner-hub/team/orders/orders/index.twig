{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

<h2 class="mb-4">📦 {{ trans('planner_hub.orders_dashboard') }}</h2>
{{ macros.breadcrumb2() }}

<section class="card">
    <div class="card-body">

        <!--<a class="btn btn-dark mb-3" href="{{ path(current_location ~ '/create') }}">
            <i data-feather="plus"></i> Create new order
        </a>-->

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle text-center" style="min-width: 1000px;">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>{{ trans('planner_hub.institution') }}</th>
                        <th>{{ trans('planner_hub.event_date') }}</th>
                        <th>{{ trans('planner_hub.start_end') }}</th>
                        <th>{{ trans('planner_hub.address') }}</th>
                        <th>{{ trans('planner_hub.actions') }}</th>
                        <th>{{ trans('planner_hub.confirmation') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td>vnv-341{{ order.id }}</td>
                            <td>
                                <span class="badge bg-primary">🏢 {{ order.institution_name|default('Unknown') }}</span>
                            </td>
                            <td style="min-inline-size: 160px;">{{ order.event_date|date("l, M j - Y" ) }}</td>
                            <td style="min-inline-size: 160px;">{{ order.start_time|date("g:i A") }} - {{ order.end_time|date("g:i A") }}</td>
                            <td style="min-inline-size: 160px;">{{ order.address }}</td>
                            <td style="min-inline-size: 160px;">
                                <div class="btn-group" role="group">
                                    <a href="{{ path(current_location ~ '/tasks') }}?id={{ order.id }}" class="btn btn-sm btn-info">👷 {{ trans('planner_hub.task') }}</a>
                                    <a href="{{ path(current_location ~ '/print') }}?id={{ order.id }}" class="btn btn-sm btn-dark">🖨 {{ trans('planner_hub.print') }}</a>
                                    {% if order.is_confirmed == 1 %}
                                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#photoModal{{ order.id }}">
                                        📷 {{ trans('planner_hub.photos') }}
                                        {% if order.photos|length > 0 %}
                                        <span class="badge bg-light text-dark">{{ order.photos|length }}</span>
                                        {% endif %}
                                    </button>
                                    {% endif %}
                                </div>
                            </td>
                            <td style="min-width: 220px;">
                                {% if order.is_confirmed is null %}
                                    <form method="post" action="?id={{ order.id }}" class="d-flex gap-1 justify-content-center">
                                        <input type="hidden" name="id_order" value="{{ order.id }}">
                                        <select name="is_confirmed" required>
                                            <option value="">{{ trans('planner_hub.please_confirm_or_reject') }}</option>
                                            <option value="1">✅ {{ trans('planner_hub.accept') }}</option>
                                            <option value="0">❌ {{ trans('planner_hub.decline') }}</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-success">{{ trans('planner_hub.continue') }}</button>
                                    </form>
                                {% elseif order.is_confirmed == 1 %}
                                    <span class="badge bg-success">{{ trans('planner_hub.accepted') }}</span>
                                    <form method="post" action="?id={{ order.id }}" class="mt-1 cancel-form" data-event-timestamp="{{ order.event_timestamp }}">
                                        <input type="hidden" name="id_order" value="{{ order.id }}">
                                        <input type="hidden" name="is_confirmed" value="0">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">{{ trans('planner_hub.cancel') }}</button>
                                    </form>
                                {% elseif order.is_confirmed == 0 %}
                                    <span class="badge bg-danger">{{ trans('planner_hub.declined') }}</span>
                                    <form method="post" action="?id={{ order.id }}" class="mt-1">
                                        <input type="hidden" name="id_order" value="{{ order.id }}">
                                        <input type="hidden" name="is_confirmed" value="1">
                                        <button type="submit" class="btn btn-sm btn-outline-success">{{ trans('planner_hub.re_accept') }}</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</section>

{% for order in orders %}
{% if order.is_confirmed == 1 %}
<div class="modal fade" id="photoModal{{ order.id }}" tabindex="-1" aria-labelledby="photoModalLabel{{ order.id }}" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="photoModalLabel{{ order.id }}">📷 {{ trans('planner_hub.photos_title') }} - vnv-341{{ order.id }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" enctype="multipart/form-data" id="uploadForm{{ order.id }}" class="mb-4">
                    <input type="hidden" name="form_type" value="upload_photo">
                    <input type="hidden" name="id_order" value="{{ order.id }}">
                    <div class="input-group">
                        <input type="file" name="photos[]" accept="image/*" class="form-control" multiple required>
                        <button type="submit" class="btn btn-primary">{{ trans('planner_hub.upload_photos') }}</button>
                    </div>
                    <small class="text-muted">{{ trans('planner_hub.accepted_formats') }}</small>
                </form>

                <div id="photosContainer{{ order.id }}">
                    {% if order.photos|length > 0 %}
                    <div class="row g-3">
                        {% for photo in order.photos %}
                        <div class="col-md-4">
                            <div class="card">
                                <img src="{{ photo.photo_url }}" class="card-img-top" alt="Order photo" style="height: 200px; object-fit: cover; cursor: pointer;" onclick="window.open('{{ photo.photo_url }}', '_blank')">
                                <div class="card-body p-2">
                                    <small class="text-muted d-block">{{ photo.uploaded_at|date('M d, Y H:i') }}</small>
                                    <form method="post" style="display: inline;" onsubmit="return confirm('{{ trans('planner_hub.confirm_delete_photo')|e('js') }}');">
                                        <input type="hidden" name="form_type" value="delete_photo">
                                        <input type="hidden" name="photo_id" value="{{ photo.id }}">
                                        <button type="submit" class="btn btn-sm btn-danger mt-2">{{ trans('planner_hub.delete') }}</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center text-muted py-5">
                        <p>{{ trans('planner_hub.no_photos_uploaded_yet') }}</p>
                        <p>{{ trans('planner_hub.upload_first_photo') }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.close') }}</button>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endfor %}

<div class="modal fade" id="uploadingPhotosModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-body text-center py-5 px-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="mb-4 position-relative" style="display: inline-block;">
                    <div class="spinner-border text-white" role="status" style="width: 4rem; height: 4rem; border-width: 4px;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="position-absolute top-50 start-50 translate-middle" style="margin-top: -2px;">
                        <i class="bi bi-camera-fill text-white" style="font-size: 1.5rem;"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-white mb-2" style="font-size: 1.25rem;">Subiendo fotos...</h5>
                <p class="text-white mb-0 opacity-90" style="font-size: 0.9rem;">Por favor espera, esto puede tomar unos segundos.</p>
                <div class="mt-3">
                    <div class="progress" style="height: 4px; background-color: rgba(255,255,255,0.3); border-radius: 10px;">
                        <div class="progress-bar bg-white" role="progressbar" style="width: 0%; animation: progressAnimation 2s ease-in-out infinite;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes progressAnimation {
    0% { width: 0%; }
    50% { width: 70%; }
    100% { width: 100%; }
}
</style>

<script>
const cancelTranslations = {
    confirmCancel: "{{ trans('planner_hub.confirm_cancel')|e('js') }}",
    avoidCanceling48h: "⚠️ {{ trans('planner_hub.avoid_canceling_48h')|e('js') }}"
};

document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.cancel-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            const eventTimestamp = parseInt(this.dataset.eventTimestamp);
            const now = new Date();
            const eventDate = new Date(eventTimestamp * 1000);
            const diffHours = (eventDate - now) / (1000 * 60 * 60);

            let message = cancelTranslations.confirmCancel;
            if (diffHours < 48) {
                message = cancelTranslations.avoidCanceling48h;
            }

            if (!confirm(message)) {
                e.preventDefault();
            }
        });
    });

    document.querySelectorAll('form[id^="uploadForm"]').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            const fileInput = form.querySelector('input[type="file"]');
            if (fileInput && fileInput.files.length > 0) {
                var uploadingModal = new bootstrap.Modal(document.getElementById('uploadingPhotosModal'));
                uploadingModal.show();
                var submitBtn = form.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Subiendo...';
                }
            }
        });
    });
});
</script>

{% endblock %}
