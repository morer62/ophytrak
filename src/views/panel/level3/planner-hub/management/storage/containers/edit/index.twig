{% extends "templates/base.admin.twig" %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
    <h1 class="h3 mb-4">📦 {{ trans('planner_hub.edit_container_title') }}</h1>

    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.container_name') }}</label>
                    <input type="text" name="name" class="form-control" required value="{{ container.name }}">
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.reference_image') }} <small class="text-muted">({{ trans('planner_hub.optional')|lower }})</small></label>
                    {% if container.img_reference %}
                        <div class="mb-2">
                            <img src="/{{ container.img_reference }}" alt="{{ trans('planner_hub.reference_image_title') }}" style="max-width: 200px; height: auto;">
                        </div>
                    {% endif %}
                    <input type="file" name="img_reference" class="form-control" accept="image/*">
                </div>

                <button class="btn btn-primary">{{ trans('planner_hub.update_container') }}</button>
                <a href="{{ path('panel/planner-hub/management/storage/containers') }}" class="btn btn-danger">{{ trans('planner_hub.cancel') }}</a>
            </form>
        </div>
    </section>
{% endblock %}
