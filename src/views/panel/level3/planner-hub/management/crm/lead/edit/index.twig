{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

    <h1 class="h3 mb-4 text-gray-800">
        {{ trans('planner_hub.edit_lead') }}
    </h1>

    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">
            <form method="POST">
                <input type="hidden" name="id" value="{{ lead.id }}">

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">{{ trans('planner_hub.name') }}</label>
                        <input type="text" name="name" class="form-control" value="{{ lead.name }}" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{{ trans('planner_hub.email') }}</label>
                        <input type="email" name="email" class="form-control" value="{{ lead.email }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{{ trans('planner_hub.phone') }}</label>
                        <input type="text" name="phone" class="form-control" value="{{ lead.phone }}">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.address') }}</label>
                    <input type="text" class="form-control" name="address" value="{{ lead.address }}" placeholder="{{ trans('planner_hub.enter_address') }}" data-places />
                </div>

                {# NUEVO: Languaje #}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">{{ trans('planner_hub.language') }}</label>
                        <select name="languaje" class="form-select">
                            {% set lang = (lead.languaje|default('english'))|lower %}
                            <option value="english" {{ lang == 'english' ? 'selected' : '' }}>{{ trans('common.english') }}</option>
                            <option value="spanish" {{ lang == 'spanish' ? 'selected' : '' }}>{{ trans('common.spanish') }}</option>
                            <option value="portuguese" {{ lang == 'portuguese' ? 'selected' : '' }}>{{ trans('common.portuguese') }}</option>
                            <option value="french" {{ lang == 'french' ? 'selected' : '' }}>{{ trans('common.french') }}</option>
                            <option value="other" {{ lang == 'other' ? 'selected' : '' }}>Other</option>
                        </select>
                        <div class="form-text">{{ trans('planner_hub.default_english') }}</div>
                    </div>

                    {# NUEVO: Comments #}
                    <div class="col-md-6">
                        <label class="form-label">{{ trans('planner_hub.comments') }}</label>
                        <textarea class="form-control" name="comments" rows="3" maxlength="240" placeholder="{{ trans('planner_hub.short_note_max') }}">{{ lead.comments }}</textarea>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">{{ trans('planner_hub.categories') }}</label>
                        <select name="id_category" class="form-select">
                            <option value="">{{ trans('planner_hub.select_category_edit') }}</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}" {{ category.id == (lead.id_category|default(0)) ? 'selected' : '' }}>{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="mb-4 text-end">
                    <button class="btn btn-primary">{{ trans('planner_hub.save_changes') }}</button>
                    <a href="{{ path('panel/planner-hub/management/crm/lead') }}" class="btn btn-secondary">{{ trans('planner_hub.cancel') }}</a>
                </div>
            </form>
        </div>
    </section>

{% endblock %}
