{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/ui/trumbowyg.min.css">
{% endblock %}

{% block body %}

    <h2 class="mb-4">📜 {{ trans('planner_hub.contracts') }}</h2>

    {{ macros.breadcrumb2() }}

    <section class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">📋 {{ trans('planner_hub.order_acceptance_contract_template') }}</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">{{ trans('planner_hub.contract_text_clients_sign') }}</p>
            
            <form method="POST">
                <input type="hidden" name="action" value="update_acceptance_template">
                <div class="mb-3">
                    <label class="form-label fw-bold">{{ trans('planner_hub.contract_content') }}</label>
                    <textarea name="content" id="acceptance-contract-editor" class="form-control" rows="12" required>{{ acceptanceTemplate.content|default('') }}</textarea>
                    <small class="text-muted d-block mt-2">💡 {{ trans('planner_hub.placeholder_order_id') }}</small>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i data-feather="save"></i> {{ trans('planner_hub.save_acceptance_contract_template') }}
                </button>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="card-header">
            <h5 class="mb-0">📄 {{ trans('planner_hub.order_contracts') }}</h5>
        </div>
        <div class="card-body">
            <a href="{{ path(current_location ~ '/create') }}" class="btn btn-primary mb-3">
                <i data-feather="plus"></i> {{ trans('planner_hub.add_new_contract') }}
            </a>

            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle" style="min-width: 500px;">
                    <thead>
                    <tr>
                        <th>{{ trans('planner_hub.title') }}</th>
                        <th>{{ trans('planner_hub.actions') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for contract in contracts %}
                        <tr>
                            <td>{{ contract.title }}</td>
                            <td class="d-flex justify-content-center gap-2">
                                <a href="{{ path(current_location ~ '/edit') }}?id={{ contract.id }}" class="btn btn-warning">✏️ {{ trans('planner_hub.edit') }}</a>
                                {{ macros.delete_form(contract.id) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-muted">{{ trans('planner_hub.no_contracts_found') }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

{% endblock %}

{% block scripts %}
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/trumbowyg.min.js"></script>
  <script>
    $(document).ready(function () {
      $('#acceptance-contract-editor').trumbowyg({
        btns: [
          ['formatting'],
          ['strong', 'em'],
          ['fontsize'],
          ['unorderedList', 'orderedList'],
          ['horizontalRule'],
          ['removeformat']
        ],
        autogrow: true
      });
    });
  </script>
{% endblock %}
