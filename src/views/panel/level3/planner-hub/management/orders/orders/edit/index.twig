{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h2 class="mb-4">✏️ {{ trans('planner_hub.edit_order') }}</h2>
{{ macros.breadcrumb2() }}

<section class="card">
    <div class="card-body">
    {% if canClose %}
<div class="alert alert-success mt-4">
  ✅ {{ trans('planner_hub.client_already_paid') }} {{ split.first_amount | number_format(2) }}.<br>
  {{ trans('planner_hub.mark_fully_paid') }}
  <button name="mark_as_paid" value="1" class="btn btn-sm btn-outline-dark mt-2">
    {{ trans('planner_hub.mark_as_fully_paid') }}
  </button>
</div>
{% endif %}

{% if limitedEdit %}
<div class="alert alert-warning mt-4">
  <h5>⚠️ {{ trans('planner_hub.order_modification_restricted') }}</h5>
  <p>{{ modificationMessage }}</p>
  <div class="mt-3">
    <a href="{{ path('panel/planner-hub/management/orders/orders/create') }}?parent_order={{ order.id }}" class="btn btn-primary">
      📋 {{ trans('planner_hub.create_sub_order') }}
    </a>
    <a href="{{ path('panel/planner-hub/management/orders/orders') }}" class="btn btn-secondary">
      ← {{ trans('planner_hub.back_to_orders') }}
    </a>
  </div>
</div>
{% endif %}

        <form method="POST">
            <input type="hidden" name="id" value="{{ order.id }}">

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">{{ trans('planner_hub.client') }}</label>
                    <input type="text" class="form-control" value="{% for client in clients %}{% if client.id == order.id_client %}{{ client.name }} {{ client.lastname }}{% endif %}{% endfor %}" readonly>

                    <input type="hidden" name="id_client" value="{{ order.id_client }}">

                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.date') }}</label>
                    <input type="date" name="event_date" value="{{ order.event_date|date("Y-m-d") }}" class="form-control" required  min="{{ "now"|date("Y-m-d") }}">
                </div>

            
                    
                        <input type="hidden" name="total_team_needed" class="form-control" value="{{ order.total_team_needed }}"  >
                    

                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.address') }}</label>
                    <input type="text" name="address" value="{{ order.address }}" class="form-control" id="autocomplete-address"  required data-places >
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.start_time') }}</label>
                    <input type="time" name="start_time" value="{{ order.start_time }}" class="form-control">
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.end_time') }}</label>
                    <input type="time" name="end_time" value="{{ order.end_time }}" class="form-control">
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.contract') }}</label>
                    <select name="id_contract" class="form-select" {% if limitedEdit or not contractEditable %}disabled{% endif %}>
                        {% for contract in contracts %}
                            <option value="{{ contract.id }}" {% if contract.id == order.id_contract %}selected{% endif %}>
                                {{ contract.title }}
                            </option>
                        {% endfor %}
                    </select>
                    {% if contractSigned %}
                        <small class="text-muted">⚠️ {{ trans('planner_hub.contract_signed_cannot_change') }}</small>
                    {% endif %}
                </div>
                 
            </div>

            <h4 class="mb-3 mt-4">🛠 {{ trans('planner_hub.services') }}</h4>
            <div class="alert alert-info mb-3">
                <i data-feather="info"></i>
                <strong>{{ trans('planner_hub.tip_start_typing') }}</strong>
            </div>
            <div id="servicesTable" class="mb-4" {% if limitedEdit %}style="pointer-events:none; opacity:0.6;"{% endif %}>
                <input type="hidden" name="selectedServices" id="selectedServices" value="" />
                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle" style="width: 100%; min-width: 600px;">
                        <thead>
                            <tr>
                                <th style="min-width: 200px;">{{ trans('planner_hub.service') }}</th>
                                <th style="min-width: 100px;">{{ trans('planner_hub.qty') }}</th>
                                <th style="min-width: 120px;">{{ trans('planner_hub.subtotal') }}</th>
                                <th style="min-width: 80px;">{{ trans('planner_hub.actions') }}</th>
                            </tr>
                        </thead>
                        <tbody id="serviceRows">
                            {% for item in assigned %}
                                <tr class="service-row" data-service-id="{{ item.id_service }}">
                                    <td>
                                        <div class="position-relative">
                                            <input type="text" class="form-control service-input" 
                                                   value="{% for s in services %}{% if s.id == item.id_service %}{{ s.name }} (${{ item.unit_price|default(item.is_variable == 'YES' ? item.variable_price : s.price) }}){% endif %}{% endfor %}" 
                                                   data-service-id="{{ item.id_service }}" 
                                                   data-price="{{ item.unit_price|default(item.is_variable == 'YES' ? item.variable_price : item.subtotal / item.quantity) }}"
                                                   data-is-variable="{{ item.is_variable }}"
                                                   data-variable-price="{% if item.is_variable == 'YES' %}{{ item.variable_price }}{% else %}{% endif %}"
                                                   name="services[{{ loop.index0 }}][service_name]"
                                                   readonly>
                                            <div class="service-dropdown"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="number" class="form-control qty-input" 
                                               value="{{ item.quantity }}" min="1" 
                                               name="services[{{ loop.index0 }}][quantity]">
                                    </td>
                                    <td>
                                        <input class="form-control subtotal-input" 
                                               value="{{ item.subtotal }}" readonly
                                               name="services[{{ loop.index0 }}][subtotal]">
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-sm remove-service-btn" 
                                                onclick="removeServiceRow(this)">❌</button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if not limitedEdit %}
                <button type="button" class="btn btn-outline-primary" onclick="addServiceRow()">
                    <i data-feather="plus"></i> {{ trans('planner_hub.add_service') }}
                </button>
                {% endif %}
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.discount_type') }}</label>
                    <select name="discount_type" class="form-select" {% if limitedEdit %}disabled{% endif %}>
                        <option value="amount" {% if order.discount_type == 'amount' %}selected{% endif %}>{{ trans('planner_hub.amount') }}</option>
                        <option value="percent" {% if order.discount_type == 'percent' %}selected{% endif %}>{{ trans('planner_hub.percentage') }}</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.discount_value') }}</label>
                    <input type="number" step="0.01" name="discount_value" class="form-control" value="{{ order.discount_value }}" {% if limitedEdit %}disabled{% endif %}>
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.tax_processing_fee') }}</label>
                    <input type="number" step="0.01" name="tax_percentage" required class="form-control" value="{{ order.tax_percentage ?? 0 }}" {% if limitedEdit %}disabled{% endif %}>
                   <!-- <small class="text-danger d-block mb-2">Stripe charges 2.9% + $0.30 per transaction. You can choose to absorb this fee or pass it on to your client.</small> -->
                </div>
                <div class="col-md-3">
                    <label class="form-label">{{ trans('planner_hub.total') }}</label>
                    <input type="text" id="totalAmount" class="form-control" readonly>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label">💵 {{ trans('planner_hub.tip_optional') }}</label>
                    <select name="id_tip" class="form-select" id="tipSelect">
                        <option value="">{{ trans('planner_hub.no_tip') }}</option>
                        {% for tip in tips %}
                            {% if tip.is_active == 1 %}
                                <option value="{{ tip.id }}" data-percentage="{{ tip.percentage }}" {% if order.id_tip == tip.id %}selected{% endif %}>{{ tip.percentage }}%</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </div>

            {# Método de Pago #}
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label">{{ trans('planner_hub.payment_type') }}</label>
                    <select name="payment_split_type" class="form-select" id="paymentSplitSelect" {% if limitedEdit %}disabled{% endif %}>
                        <option value="1" {% if order.payment_split_type == 1 %}selected{% endif %}>{{ trans('planner_hub.one_time_payment') }}</option>
                        <option value="2" {% if order.payment_split_type == 2 %}selected{% endif %}>{{ trans('planner_hub.split_payment') }}</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <div id="splitFields" style="display: none;">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label">{{ trans('planner_hub.first_payment') }} (%)</label>
                                <input type="number" name="payment_split_percent_1" value="{{ order.payment_split_percent_1 ?? 50 }}" class="form-control" min="1" max="99" {% if limitedEdit %}disabled{% endif %}>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">{{ trans('planner_hub.second_payment') }} (%)</label>
                                <input type="number" name="payment_split_percent_2" id="secondPaymentPercent" value="{{ order.payment_split_percent_2 ?? 50 }}" class="form-control" readonly {% if limitedEdit %}disabled{% endif %}>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">📝 {{ trans('planner_hub.notes_playlist') }}</label>
                <textarea name="notes" class="form-control" rows="6" style="min-height: 200px">{{ order.notes }}</textarea>
            </div>

            <div>
                <button class="btn btn-primary">💾 {{ trans('planner_hub.save') }}</button>
                <a href="{{ path("panel/planner-hub/management/orders/orders") }}" class="btn btn-warning">{{ trans('planner_hub.cancel') }}</a>
            </div>
        </form>
    </div>
</section>

<!-- Modal para precio variable -->
<div class="modal fade" id="priceModal" tabindex="-1" aria-labelledby="priceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="priceModalLabel">{{ trans('planner_hub.set_service_price') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ trans('planner_hub.close') }}"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.service_name') }}</label>
                    <input type="text" id="modalServiceName" class="form-control" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.price') }}</label>
                    <input type="number" id="modalPrice" class="form-control" step="0.01" min="0.01" placeholder="0.00">
                    <div class="invalid-feedback" id="priceError">
                        {{ trans('planner_hub.enter_valid_price') }}
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.cancel') }}</button>
                <button type="button" class="btn btn-primary" id="confirmPrice">{{ trans('planner_hub.confirm_price') }}</button>
            </div>
        </div>
    </div>
</div>
<style>


    .service-dropdown {
        border: 1px solid #dee2e6;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        border-radius: 0.375rem;
        background: white;
        max-height: 200px;
        overflow-y: auto;
        display: none;
        position: absolute;
        z-index: 9999;
        width: 100%;
        top: 100%;
        left: 0;
        margin-top: 2px;
    }

    .service-dropdown .dropdown-item {
        transition: background-color 0.15s ease-in-out;
        border-bottom: 1px solid #f8f9fa;
        padding: 0.5rem 0.75rem;
        cursor: pointer;
    }

    .service-dropdown .dropdown-item:hover {
        background-color: #f8f9fa !important;
    }

    .service-dropdown .dropdown-item:last-child {
        border-bottom: none !important;
    }

    .position-relative {
        position: relative !important;
    }
    


    .modal-backdrop {
        z-index: 1040;
    }

    .modal {
        z-index: 1050;
    }

    #priceModal .modal-dialog {
        max-width: 500px;
    }

    #priceModal .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
    }

    #priceModal .btn-primary {
        background-color: #198754;
        border-color: #198754;
    }

    #priceModal .btn-primary:hover {
        background-color: #157347;
        border-color: #146c43;
    }

    #priceModal.show {
        display: block !important;
    }

    .modal-backdrop.show {
        opacity: 0.5;
    }

    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1040;
    }

    #priceModal.show + .modal-backdrop {
        display: block;
    }
</style>
{% endblock %}

{% block scripts %}
<script>
    const translations = {
        type_service_name: "{{ trans('planner_hub.type_service_name') }}",
        no_services_match: "{{ trans('planner_hub.no_services_match_edit') }}",
        variable_price: "{{ trans('planner_hub.variable_price') }}",
        no_description: "{{ trans('planner_hub.no_description') }}"
    };

    let selectedServices = [];
    let services = {{ services|json_encode|raw }}.sort((a, b) => a.name.localeCompare(b.name));
    let nextServiceIndex = {{ assigned|length }};

    const num = (v) => parseFloat(String(v).replace(',', '.')) || 0;

    function addServiceRow() {
        const row = document.createElement("tr");
        row.className = "service-row";
        row.setAttribute("data-service-id", "");

        const serviceContainer = document.createElement("div");
        serviceContainer.className = "position-relative";

        const serviceInput = document.createElement("input");
        serviceInput.type = "text";
        serviceInput.className = "form-control service-input";
        serviceInput.name = `services[${nextServiceIndex}][service_name]`;
        serviceInput.placeholder = translations.type_service_name;
        serviceInput.setAttribute("data-service-id", "");
        serviceInput.setAttribute("data-price", "");
        
        serviceInput.addEventListener("input", function() { 
            handleServiceSearch(this); 
        });
        serviceInput.addEventListener("focus", function() { 
            showServiceDropdown(this); 
        });
        serviceInput.addEventListener("blur", function() { 
            setTimeout(() => hideServiceDropdown(this), 200); 
        });

        const dropdown = document.createElement("div");
        dropdown.className = "service-dropdown";
        dropdown.style.display = "none";

        serviceContainer.appendChild(serviceInput);
        serviceContainer.appendChild(dropdown);

        const qtyInput = document.createElement("input");
        qtyInput.type = "number";
        qtyInput.name = `services[${nextServiceIndex}][quantity]`;
        qtyInput.className = "form-control qty-input";
        qtyInput.value = 1;
        qtyInput.min = 1;
        qtyInput.addEventListener("input", updateSubtotal);

        const subtotalInput = document.createElement("input");
        subtotalInput.name = `services[${nextServiceIndex}][subtotal]`;
        subtotalInput.className = "form-control subtotal-input";
        subtotalInput.readOnly = true;
        subtotalInput.value = "0.00";

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "btn btn-danger btn-sm remove-service-btn";
        removeBtn.innerHTML = "❌";
        removeBtn.addEventListener("click", function() { 
            row.remove(); 
            updateSubtotal(); 
        });

        const sCell = document.createElement("td"); 
        sCell.appendChild(serviceContainer);
        const qCell = document.createElement("td"); 
        qCell.appendChild(qtyInput);
        const stCell = document.createElement("td"); 
        stCell.appendChild(subtotalInput);
        const rCell = document.createElement("td"); 
        rCell.appendChild(removeBtn);

        row.append(sCell, qCell, stCell, rCell);
        document.getElementById("serviceRows").appendChild(row);

        nextServiceIndex++;
        
        updateSubtotal();
        serviceInput.focus();
    }

    function handleServiceSearch(input) {
        const searchTerm = input.value.toLowerCase();
        const dropdown = input.parentNode.querySelector('.service-dropdown');
        
        if (searchTerm.length < 1) {
            hideServiceDropdown(input);
            return;
        }

        const filteredServices = services.filter(service => 
            service.name.toLowerCase().includes(searchTerm)
        );

        showServiceDropdown(input, filteredServices);
    }

    function showServiceDropdown(input, filteredServices = null) {
        const dropdown = input.parentNode.querySelector('.service-dropdown');
        const searchTerm = input.value.toLowerCase();
        
        if (!filteredServices) {
            filteredServices = services.filter(service => 
                service.name.toLowerCase().includes(searchTerm)
            );
        }

        if (filteredServices.length === 0) {
            dropdown.innerHTML = '<div class="dropdown-item p-2 text-muted">' + translations.no_services_match + ' "' + searchTerm + '"</div>';
            dropdown.style.display = "block";
            return;
        }

        dropdown.innerHTML = '';
        filteredServices.forEach(service => {
            const item = document.createElement("div");
            item.className = "dropdown-item p-2 border-bottom";
            item.style.cursor = "pointer";
            
            const priceDisplay = service.is_variable === 'YES' 
                ? `<span class="text-warning">${translations.variable_price}</span>` 
                : `$${service.price}`;
                
            item.innerHTML = `
                <div class="fw-bold">${service.name}</div>
                <small class="text-muted">${priceDisplay} - ${service.description || translations.no_description}</small>
            `;
            
            item.addEventListener("click", function(e) {
                e.preventDefault();
                e.stopPropagation();
                selectService(input, service);
            });
            
            item.addEventListener("mouseenter", function() {
                this.style.backgroundColor = "#f8f9fa";
            });
            
            item.addEventListener("mouseleave", function() {
                this.style.backgroundColor = "white";
            });
            
            dropdown.appendChild(item);
        });
        
        dropdown.style.display = "block";
    }

    function hideServiceDropdown(input) {
        const dropdown = input.parentNode.querySelector('.service-dropdown');
        if (dropdown) {
            dropdown.style.display = "none";
        }
    }

    let currentServiceInput = null;
    let currentService = null;

    function selectService(input, service) {
        if (service.is_variable === 'YES') {
            currentServiceInput = input;
            currentService = service;
            
            document.getElementById('modalServiceName').value = service.name;
            document.getElementById('modalPrice').value = '';
            document.getElementById('modalPrice').classList.remove('is-invalid');
            
            try {
                const modal = new bootstrap.Modal(document.getElementById('priceModal'));
                modal.show();
            } catch (error) {
                console.error('Error opening modal:', error);
                const modalElement = document.getElementById('priceModal');
                if (modalElement) {
                    modalElement.classList.add('show');
                    modalElement.style.display = 'block';
                    modalElement.setAttribute('aria-hidden', 'false');
                }
            }
        } else {
            input.value = `${service.name} ($${service.price})`;
            input.setAttribute("data-service-id", service.id);
            input.setAttribute("data-price", service.price);
            input.setAttribute("data-is-variable", "NO");
            input.setAttribute("data-variable-price", "");
            input.readOnly = true;
            
            input.style.borderColor = "#198754";
            hideServiceDropdown(input);
            updateSubtotal();
        }
    }

    function confirmVariablePrice() {
        const priceInput = document.getElementById('modalPrice');
        const price = parseFloat(priceInput.value) || 0;
        
        if (price <= 0) {
            priceInput.classList.add('is-invalid');
            return;
        }
        
        if (isNaN(price)) {
            priceInput.classList.add('is-invalid');
            return;
        }
        
        priceInput.classList.remove('is-invalid');
        
        if (currentServiceInput && currentService) {
            currentServiceInput.value = `${currentService.name} ($${price})`;
            currentServiceInput.setAttribute("data-service-id", currentService.id);
            currentServiceInput.setAttribute("data-price", price);
            currentServiceInput.setAttribute("data-is-variable", "YES");
            currentServiceInput.setAttribute("data-variable-price", price);
            currentServiceInput.readOnly = true;
            
            currentServiceInput.style.borderColor = "#198754";
            hideServiceDropdown(currentServiceInput);
            updateSubtotal();
        }
        
        try {
            const modal = bootstrap.Modal.getInstance(document.getElementById('priceModal'));
            if (modal) {
                modal.hide();
            } else {
                closeModal();
            }
        } catch (error) {
            closeModal();
        }
        
        currentServiceInput = null;
        currentService = null;
    }

    function closeModal() {
        const modalElement = document.getElementById('priceModal');
        modalElement.classList.remove('show');
        modalElement.style.display = 'none';
        modalElement.setAttribute('aria-hidden', 'true');
        
        const priceInput = document.getElementById('modalPrice');
        priceInput.classList.remove('is-invalid');
        
        currentServiceInput = null;
        currentService = null;
    }

    function updateSubtotal() {
        let subtotalServicios = 0;
        selectedServices = [];

        document.querySelectorAll("#serviceRows tr").forEach((row, index) => {
            const serviceInput = row.querySelector(".service-input");
            const serviceId = serviceInput?.getAttribute("data-service-id");
            const price = num(serviceInput?.getAttribute("data-price") || 0);
            const qty = parseInt(row.querySelector(".qty-input")?.value) || 0;
            const subtotalInput = row.querySelector(".subtotal-input");
            const isVariable = serviceInput?.getAttribute("data-is-variable") === "YES";
            const variablePrice = num(serviceInput?.getAttribute("data-variable-price") || 0);

            if (!serviceId || !price) {
                if (subtotalInput) {
                    subtotalInput.value = "0.00";
                }
                return;
            }

            const subtotal = qty * price;
            if (subtotalInput) {
                subtotalInput.value = subtotal.toFixed(2);
            }
            subtotalServicios += subtotal;

            selectedServices.push({ 
                service: serviceId, 
                qty, 
                subtotal,
                is_variable: isVariable ? "YES" : "NO",
                variable_price: isVariable ? variablePrice : null
            });
        });

        const discountType = document.querySelector('select[name="discount_type"]')?.value || "amount";
        const discountValue = num(document.querySelector('input[name="discount_value"]')?.value || 0);
        const descuento = (discountType === 'amount')
            ? discountValue
            : subtotalServicios * (discountValue / 100);

        const base = Math.max(subtotalServicios - descuento, 0);

        const taxRate = num(document.querySelector('input[name="tax_percentage"]')?.value || 0);
        const tax = base * (taxRate / 100);

        const tipSelect = document.getElementById("tipSelect");
        const tipPercentage = tipSelect?.options[tipSelect.selectedIndex]?.getAttribute("data-percentage") || 0;
        const tipAmount = base * (num(tipPercentage) / 100);

        const grandTotal = base + tax + tipAmount;

        const totalElement = document.getElementById("totalAmount");
        if (totalElement) {
            totalElement.value = "$" + grandTotal.toFixed(2);
        }
        
        const selectedServicesElement = document.getElementById("selectedServices");
        if (selectedServicesElement) {
            selectedServicesElement.value = JSON.stringify(selectedServices);
        }
    }

    function removeServiceRow(button) {
        const row = button.closest('tr');
        row.remove();
        updateSubtotal();
    }

    function setupEventListeners() {
        const discountType = document.querySelector('select[name="discount_type"]');
        const discountValue = document.querySelector('input[name="discount_value"]');
        const taxPercentage = document.querySelector('input[name="tax_percentage"]');
        const tipSelect = document.getElementById("tipSelect");
        
        if (discountType) discountType.addEventListener("change", updateSubtotal);
        if (discountValue) discountValue.addEventListener("input", updateSubtotal);
        if (taxPercentage) taxPercentage.addEventListener("input", updateSubtotal);
        if (tipSelect) tipSelect.addEventListener("change", updateSubtotal);

        document.querySelectorAll(".qty-input").forEach(input => {
            input.addEventListener("input", updateSubtotal);
        });

        document.querySelectorAll(".service-input").forEach(input => {
            if (!input.readOnly) {
                input.addEventListener("input", function() { 
                    handleServiceSearch(this); 
                });
                input.addEventListener("focus", function() { 
                    showServiceDropdown(this); 
                });
                input.addEventListener("blur", function() { 
                    setTimeout(() => hideServiceDropdown(this), 200); 
                });
            }
        });
    }

    function setupModalEventListeners() {
        document.getElementById('confirmPrice').addEventListener('click', confirmVariablePrice);
        
        document.getElementById('modalPrice').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                confirmVariablePrice();
            }
        });
        
        document.getElementById('modalPrice').addEventListener('input', function() {
            this.classList.remove('is-invalid');
        });

        document.querySelectorAll('[data-bs-dismiss="modal"]').forEach(button => {
            button.addEventListener('click', function() {
                closeModal();
            });
        });

        document.getElementById('priceModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
    }

    function setupPaymentSplit() {
        const paymentSplit = document.getElementById("paymentSplitSelect");
        const splitFields = document.getElementById("splitFields");
        const firstInput = document.querySelector('input[name="payment_split_percent_1"]');
        const secondInput = document.getElementById("secondPaymentPercent");

        function toggleSplit() {
            if (paymentSplit.value === "2") {
                splitFields.style.display = "block";
                if (firstInput) firstInput.disabled = false;
                if (secondInput) secondInput.disabled = false;
                // Ensure valid split range (1..99). If coming from one-time (100), reset to 50.
                let firstValue = parseInt(firstInput?.value || "0", 10);
                if (!firstValue || firstValue <= 0 || firstValue >= 100) {
                    firstValue = 50;
                    if (firstInput) firstInput.value = 50;
                }
                if (secondInput) {
                    secondInput.value = 100 - firstValue;
                }
            } else {
                // One-time payment: keep a deterministic state.
                if (firstInput) firstInput.value = 100;
                if (secondInput) secondInput.value = 0;
                // Prevent browser validation on hidden split controls.
                if (firstInput) firstInput.disabled = true;
                if (secondInput) secondInput.disabled = true;
                splitFields.style.display = "none";
            }
        }

        function updateSecondInput() {
            let firstValue = parseInt(firstInput.value) || 0;
            if (paymentSplit.value === "2") {
                if (firstValue < 1) firstValue = 1;
                if (firstValue > 99) firstValue = 99;
                firstInput.value = firstValue;
            }
            const secondValue = 100 - firstValue;
            secondInput.value = (secondValue >= 0 && secondValue <= 100) ? secondValue : 0;
        }

        if (paymentSplit) {
            paymentSplit.addEventListener("change", toggleSplit);
        }
        if (firstInput) {
            firstInput.addEventListener("input", updateSecondInput);
        }

        toggleSplit();
    }

    document.addEventListener("DOMContentLoaded", function () {
        setupEventListeners();
        setupModalEventListeners();
        setupPaymentSplit();
        
        // JS-only responsive table scroll for mobile
        function setupTableScroll() {
            const tableContainer = document.querySelector('#servicesTable .table-responsive');
            if (tableContainer) {
                // Force horizontal scroll
                tableContainer.style.overflowX = 'auto';
                tableContainer.style.overflowY = 'visible';
                tableContainer.style.webkitOverflowScrolling = 'touch';
                tableContainer.style.display = 'block';
                tableContainer.style.width = '100%';
                
                const table = tableContainer.querySelector('table');
                if (table) {
                    table.style.minWidth = '1000px';
                    table.style.whiteSpace = 'nowrap';
                    table.style.width = 'auto';
                    
                    // Force column widths for better mobile UX
                    const headers = table.querySelectorAll('th');
                    const cells = table.querySelectorAll('td');
                    
                    headers.forEach((th, idx) => {
                        if (idx === 0) th.style.minWidth = '300px'; // Service
                        if (idx === 1) th.style.minWidth = '100px'; // Qty
                        if (idx === 2) th.style.minWidth = '150px'; // Subtotal
                        if (idx === 3) th.style.minWidth = '120px'; // Actions
                    });
                    
                    cells.forEach((td, idx) => {
                        const colIdx = idx % 4;
                        if (colIdx === 0) { 
                            td.style.minWidth = '300px';
                            td.style.position = 'relative'; // For dropdowns
                        }
                        if (colIdx === 1) td.style.minWidth = '100px';
                        if (colIdx === 2) td.style.minWidth = '150px';
                        if (colIdx === 3) td.style.minWidth = '120px';
                    });
                }
            }
        }

        setupTableScroll();
        
        // Re-apply when rows change
        const observer = new MutationObserver(setupTableScroll);
        const serviceRows = document.getElementById('serviceRows');
        if (serviceRows) {
            observer.observe(serviceRows, { childList: true, subtree: true });
        }
        
        setTimeout(() => {
            updateSubtotal();
        }, 500);
    });

    window.addServiceRow = addServiceRow;
    window.removeServiceRow = removeServiceRow;
</script>
{% endblock %}