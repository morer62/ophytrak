{% extends 'templates/base.admin.twig' %}

{% block body %}
	<main class="mt-4 container">

		{% if isMobileApp == false %}
			<!-- 🔹 Profile Switcher -->
			<div class="d-flex justify-content-end mb-4">
				<div class="dropdown">
					<button class="btn btn-outline-primary dropdown-toggle fw-bold" type="button" id="roleSwitcher" data-bs-toggle="dropdown" aria-expanded="false">
						🔄 {{ trans('panel_home.change_profile') }}
					</button>
					<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="roleSwitcher">
						<li>
							<button class="dropdown-item" data-switch="5" data-label="{{ trans('panel_home.role_client') }}" data-bs-toggle="modal" data-bs-target="#confirmRoleChange">👤 {{ trans('panel_home.role_client') }}</button>
						</li>
						<li>
							<button class="dropdown-item" data-switch="4" data-label="{{ trans('panel_home.role_team') }}" data-bs-toggle="modal" data-bs-target="#confirmRoleChange">👥 {{ trans('panel_home.role_team') }}</button>
						</li>
						<li>
							<button class="dropdown-item" data-switch="2" data-label="{{ trans('panel_home.role_venue') }}" data-bs-toggle="modal" data-bs-target="#confirmRoleChange">🏢 {{ trans('panel_home.role_venue') }}</button>
						</li>
					</ul>
				</div>
			</div>
		{% endif %}

		{# ===================== MODAL NUDGE ===================== #}
		{% set n = profile_nudge ?? null %}
		{% if n and n.should_show %}
			<div class="modal fade" id="profileNudgeModal" tabindex="-1" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered">
					<div class="modal-content border-0 rounded-4 shadow-lg">
						<div class="modal-body p-4">
							<div class="d-flex align-items-center gap-3">
								{% set icon = (n.type == 'venue') ? 'icon_2.png' : 'icon_3.png' %}
								<img src="{{ asset_for('assets/images/icons_website/' ~ icon) }}" alt="icon" style="width:72px;height:72px">
								<div>
									{% if n.reason == 'no_profile' %}
										<h5 class="mb-1 fw-bold">{{ n.type == 'venue' ? 'Create your Venue profile' : 'Create your Vendor profile' }}</h5>
										<p class="mb-2 text-muted">
											Get discovered, receive leads and look professional — all for just
											<strong>${{ n.price|number_format(2, '.', ',') }}</strong>
											per month.
										</p>
									{% elseif n.reason == 'not_active' %}
										<h5 class="mb-1 fw-bold">Almost there!</h5>
										<p class="mb-2 text-muted">
											Your profile isn’t active yet (needs approval or renewal).<br>
											Add quality photos for faster approval.
										</p>
									{% elseif n.reason == 'no_photos' %}
										<h5 class="mb-1 fw-bold">Add photos to shine ✨</h5>
										<p class="mb-2 text-muted">Your profile is live but has no photos. Upload a few images to attract more clients.</p>
									{% endif %}
								</div>
							</div>

							<div class="d-flex gap-2 mt-4">
								<a href="{{ path('panel/service/home') }}" class="btn btn-success btn-lg w-100 rounded-3 fw-bold">
									{{ n.reason == 'no_profile' ? trans('panel_home.promote_service') : trans('panel_home.go_to_vendor') }}
								</a>
								<button class="btn btn-outline-secondary btn-lg rounded-3" data-bs-dismiss="modal">{{ trans('panel_home.later') }}</button>
							</div>
						</div>
					</div>
				</div>
			</div>
			<script>
				document.addEventListener('DOMContentLoaded', function () {
var el = document.getElementById('profileNudgeModal');
if (el) 
new bootstrap.Modal(el, {backdrop: 'static'}).show();

});
			</script>
		{% endif %}
		{# =================== / MODAL NUDGE ===================== #}

		<!-- 🔹 Membership Status -->
		<section class="mb-5">
			{% if user.hasActivePaidMembership() %}
				<div class="p-4 bg-white rounded-4 shadow-sm" style="border-left: 5px solid #00b894;">
					<div class="row align-items-center">
						<div class="col-md-8">
							<div class="d-flex align-items-center">
								<span class="me-3" style="font-size: 2.5rem;">✅</span>
								<div>
									<h4 class="fw-bold mb-1">{{ trans('panel_home.active_membership') }}</h4>
									<p class="text-muted mb-0">
										{{ trans('panel_home.membership_expires') }}
										<strong>{{ user.getMembershipDueDate() }}</strong>
									</p>
								</div>
							</div>
						</div>
						<div class="col-md-4 text-end">
							<a href="{{ path('panel/membership/pay') }}" class="btn btn-outline-success btn-lg fw-bold px-4">{{ trans('panel_home.renew_membership') }}</a>
						</div>
					</div>
				</div>
			{% elseif isFreeTrial %}
				<div class="p-4 bg-white rounded-4 shadow-sm" style="border-left: 5px solid #fdcb6e;">
					<div class="row align-items-center">
						<div class="col-md-8">
							<div class="d-flex align-items-center">
								<span class="me-3" style="font-size: 2.5rem;">🎁</span>
								<div>
									<h4 class="fw-bold mb-1" style="color: #e17055;">{{ trans('panel_home.free_trial') }}</h4>
									<p class="text-muted mb-0">
										{{ trans('panel_home.trial_expires') }} <strong>{{ trialExpirationDate }}</strong>
										{% if trialDaysRemaining > 0 %}
											<br><small>({{ trialDaysRemaining }} {{ trans('panel_home.days_remaining') }})</small>
										{% endif %}
									</p>
								</div>
							</div>
						</div>
						<div class="col-md-4 text-end">
							<a href="{{ path('panel/membership/manage') }}" class="btn btn-warning btn-lg fw-bold px-4">{{ trans('panel_home.upgrade_now') }}</a>
						</div>
					</div>
				</div>
			{% else %}
				<div class="p-4 bg-white rounded-4 shadow-sm" style="border-left: 5px solid #d63031;">
					<div class="row align-items-center">
						<div class="col-md-8">
							<div class="d-flex align-items-center">
								<span class="me-3" style="font-size: 2.5rem;">⚠️</span>
								<div>
									<h4 class="fw-bold mb-1 text-danger">{{ trans('panel_home.membership_expired') }}</h4>
									<p class="text-muted mb-0">
										{{ trans('panel_home.renew_to_continue') }}
									</p>
								</div>
							</div>
						</div>
						<div class="col-md-4 text-end">
							<a href="{{ path('panel/membership/manage') }}" class="btn btn-danger btn-lg fw-bold px-4">{{ trans('panel_home.renew_now') }}</a>
						</div>
					</div>
				</div>
			{% endif %}
		</section>

		<!-- 🔹 Highlight Block -->
		<section class="p-5 rounded-4 shadow-sm mb-5 text-white" style="background: linear-gradient(135deg, #00b894, #55efc4);">
			<h2 class="fw-bold mb-2">🧩 {{ trans('panel_home.service_profile') }}</h2>
			<p class="fs-5 mb-3">{{ trans('panel_home.increase_visibility') }}</p>
			<a href="{{ path('panel/service/home') }}" class="btn btn-light btn-lg fw-bold px-4">{{ trans('panel_home.vendor_profile') }}</a>
		</section>

		<!-- 🔹 Core Tools -->
		<section class="mb-5">
			<h3 class="fw-bold mb-4">{{ trans('panel_home.main_tools') }}</h3>
			<div
				class="row text-center g-4">

				<!-- Team Management -->
				<div class="col-md-4">
					<div class="p-5 bg-white rounded-4 shadow-sm h-100">
						<img src="{{ asset_for('assets/images/icons_website/icon_2.png') }}" alt="Team" class="mb-4" style="height: 110px;">
						<h4 class="fw-bold mb-2">👥 {{ trans('panel_home.team_management') }}</h4>
						<p class="text-muted fs-6 mb-3">{{ trans('panel_home.team_management_desc') }}</p>
						<a href="{{ path('panel/planner-hub/management/users') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('panel_home.open') }}</a>
					</div>
				</div>

				<!-- Job Schedule -->
				<div class="col-md-4">
					<div class="p-5 bg-white rounded-4 shadow-sm h-100">
						<img src="{{ asset_for('assets/images/icons_website/icon_3.png') }}" alt="Schedule" class="mb-4" style="height: 110px;">
						<h4 class="fw-bold mb-2">📅 {{ trans('panel_home.job_schedule') }}</h4>
						<p class="text-muted fs-6 mb-3">{{ trans('panel_home.assign_services_tasks') }}</p>
						<a href="{{ path('panel/planner-hub/management/orders') }}" class="btn btn-primary btn-lg fw-bold px-4">{{ trans('panel_home.view') }}</a>
					</div>
				</div>

				<!-- Payroll -->
				<div class="col-md-4">
					<div class="p-5 bg-white rounded-4 shadow-sm h-100">
						<img src="{{ asset_for('assets/images/icons_website/icon_4.png') }}" alt="Payroll" class="mb-4" style="height: 110px;">
						<h4 class="fw-bold mb-2">💰 {{ trans('panel_home.payroll') }}</h4>
						<p class="text-muted fs-6 mb-3">{{ trans('panel_home.track_employee_hours') }}</p>
						<a href="{{ path('panel/planner-hub/management/payroll') }}" class="btn btn-primary btn-lg fw-bold px-4">{{ trans('panel_home.go') }}</a>
					</div>
				</div>

			</div>
		</section>

		<!-- 🔹 Explore More -->
		<section>
			<h3 class="fw-bold mb-4">{{ trans('panel_home.explore_more') }}</h3>
			<div class="d-flex overflow-auto gap-4 pb-3">

				<a href="{{ path('panel/planner-hub/management/storage') }}" class="text-decoration-none text-dark">
					<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
						<img src="{{ asset_for('assets/images/icons_website/icon_5.png') }}" style="height: 110px;" class="mb-3">
						<p class="fw-bold fs-5 mb-0">📦 {{ trans('panel_home.inventory') }}</p>
					</div>
				</a>

				<a href="{{ path('panel/planner-hub/management/crm') }}" class="text-decoration-none text-dark">
					<div class="flex-shrink-0" style="min-width: 200px;">
						<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
							<img src="{{ asset_for('assets/images/icons_website/icon_6.png') }}" style="height: 110px;" class="mb-3">
							<p class="fw-bold fs-5 mb-0">🗂️ {{ trans('panel_home.crm') }}</p>
						</div>
					</div>
				</a>

				<a href="{{ path('panel/planner-hub/team/chat') }}" class="text-decoration-none text-dark">
					<div class="flex-shrink-0" style="min-width: 200px;">
						<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
							<img src="{{ asset_for('assets/images/icons_website/icon_7.png') }}" style="height: 110px;" class="mb-3">
							<p class="fw-bold fs-5 mb-0">💬 {{ trans('panel_home.chat') }}</p>
						</div>
					</div>
				</a>

				<a href="{{ path('panel/cards') }}" class="text-decoration-none text-dark">
					<div class="flex-shrink-0" style="min-width: 200px;">
						<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
							<img src="{{ asset_for('assets/images/icons_website/icon_8.png') }}" style="height: 110px;" class="mb-3">
							<p class="fw-bold fs-5 mb-0">💳 {{ trans('panel_home.payment_methods') }}</p>
						</div>
					</div>
				</a>

				<a href="{{ path('panel/payments') }}" class="text-decoration-none text-dark">
					<div class="flex-shrink-0" style="min-width: 200px;">
						<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
							<img src="{{ asset_for('assets/images/icons_website/icon_9.png') }}" style="height: 110px;" class="mb-3">
							<p class="fw-bold fs-5 mb-0">📄 {{ trans('panel_home.subscriptions') }}</p>
						</div>
					</div>
				</a>

				<a href="{{ path('panel/planning-tools') }}" class="text-decoration-none text-dark">
					<div class="flex-shrink-0" style="min-width: 200px;">
						<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
							<img src="{{ asset_for('assets/images/icons_website/icon_12.png') }}" style="height: 110px;" class="mb-3">
							<p class="fw-bold fs-5 mb-0">🧰 {{ trans('panel_home.planning_tools') }}</p>
						</div>
					</div>
				</a>

				<a href="{{ path('panel/settings') }}" class="text-decoration-none text-dark">
					<div class="flex-shrink-0" style="min-width: 200px;">
						<div class="p-3 bg-white rounded-4 shadow-sm text-center h-100">
							<img src="{{ asset_for('assets/images/icons_website/icon_10.png') }}" style="height: 110px;" class="mb-3">
							<p class="fw-bold fs-5 mb-0">⚙️ {{ trans('panel_home.basic_setting') }}</p>
						</div>
					</div>
				</a>

			</div>
		</section>

	</main>

	<!-- 🔹 Modal Confirm Change -->
	<div class="modal fade" id="confirmRoleChange" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content rounded-4">
				<form method="POST" action="{{ path('panel/home') }}">
					<div class="modal-header">
						<h5 class="modal-title fw-bold">{{ trans('panel_home.confirm_profile_change') }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						{{ trans('panel_home.confirm_switch_text') }}
						<span id="selectedRoleText" class="fw-bold"></span>?
						<p class="mt-2 text-muted small">{{ trans('panel_home.reload_dashboard') }}</p>
						<input type="hidden" name="level" id="selectedRoleValue">
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ trans('panel_home.cancel') }}</button>
						<button type="submit" class="btn btn-primary">{{ trans('panel_home.yes_switch') }}</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener("DOMContentLoaded", () => {
document.querySelectorAll("[data-switch]").forEach(btn => {
btn.addEventListener("click", () => {
const level = btn.getAttribute("data-switch");
const label = btn.getAttribute("data-label");
document.getElementById("selectedRoleValue").value = level;
document.getElementById("selectedRoleText").innerText = label;
});
});
});
	</script>
{% endblock %}
