{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="container-fluid">
    <h1 class="h3 mb-4">💳 {{ trans('planner_hub.payment_history') }}</h1>

    <div class="card">
        <div class="card-body">
            {% if payments is empty %}
                <div class="alert alert-info">{{ trans('planner_hub.no_payment_history_found') }}</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-bordered table-striped text-center" style="min-width: 900px;">
                        <thead>
                            <tr>
                                <th>{{ trans('planner_hub.payment_date') }}</th>
                                <th>{{ trans('planner_hub.concept') }}</th>
                                <th>{{ trans('planner_hub.renewal_date') }}</th>
                                <th>{{ trans('planner_hub.amount') }}</th>
                                <th>{{ trans('planner_hub.status') }}</th>
                                <th>{{ trans('planner_hub.action') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payments %}
                                <tr>
                                    <td>{{ payment.payment_date ? payment.payment_date|date("l, M j, Y") : '—' }}</td>
                                    <td>
                                        {% if payment.concept == 'Venue' %}
                                            🏛 {{ trans('planner_hub.venues') }}
                                        {% elseif payment.concept == 'Membership' %}
                                            🎟 {{ trans('planner_hub.memberships') }}
                                        {% elseif payment.concept == 'Service' %}
                                            🧩 {{ trans('planner_hub.services') }}
                                        {% else %}
                                            {{ payment.concept }}
                                        {% endif %}
                                    </td>
                                    <td>{{ payment.renewal ? payment.renewal|date("l, M j, Y") : '—' }}</td>
                                    <td>${{ payment.total|number_format(2) }}</td>
                                    <td>
                                        {% if payment.status == 'ACTIVE' %}
                                            <span class="badge bg-success">{{ trans('planner_hub.active') }}</span>
                                        {% elseif payment.status == 'PENDING' %}
                                            <span class="badge bg-warning text-dark">{{ trans('planner_hub.pending') }}</span>
                                        {% else %}
                                            <span class="badge bg-danger">{{ trans('planner_hub.expired') }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('panel/payments/details') }}?id={{ payment.id }}" class="btn btn-sm btn-outline-primary">🔍 {{ trans('planner_hub.view') }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
