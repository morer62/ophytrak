{% extends 'templates/base.admin.twig' %}{% block body %}<main class="hygiene-page"><section class="hygiene-hero"><span>User Hygiene</span><h1>Spam cleanup and signup abuse review</h1><p>Review suspicious signups, inactive accounts, disposable email patterns and CAPTCHA health without hard-deleting financial data.</p></section><section class="health-grid"><article><span>CAPTCHA enabled</span><strong>{{ health.enabled?'Yes':'No' }}</strong></article><article><span>Server verification</span><strong>{{ health.server_verification?'Yes':'No' }}</strong></article><article><span>Protected routes</span><strong>{{ health.protected_routes_count }}</strong></article><article><span>Suspicious signups</span><strong>{{ health.suspicious_last_24h }}</strong></article></section>{% if health.unprotected_routes|length %}<section class="warning-panel"><strong>Routes/config needing review:</strong> {{ health.unprotected_routes|join(', ') }}</section>{% endif %}<section class="hygiene-panel"><form method="get" class="hygiene-filters"><input type="search" name="search" value="{{ filters.search }}" placeholder="Search email, name, business, user ID"><select name="filter">{% for f in ['suspicious','email_not_verified','no_business_profile','no_payment_method','marked_spam'] %}<option value="{{ f }}" {{ filters.filter==f?'selected':'' }}>{{ f|replace({'_':' '})|title }}</option>{% endfor %}</select><button class="btn btn-dark">Filter</button></form></section><section class="hygiene-panel"><div class="table-responsive"><table class="hygiene-table"><thead><tr><th>User</th><th>Email</th><th>Business</th><th>Created</th><th>Signals</th><th>Risk</th><th>Safe delete?</th><th>Actions</th></tr></thead><tbody>{% for row in hygiene.rows %}<tr><td><strong>{{ row.name }}</strong><small>Level {{ row.level }} · User #{{ row.id }}</small></td><td>{{ row.email }}</td><td>{{ row.business ?: 'No business profile' }}</td><td>{{ row.created_at ?: '-' }}</td><td>{{ row.reason }}</td><td><span class="risk {{ row.risk_score|lower }}">{{ row.risk_score }}</span></td><td>{{ row.can_delete_safely?'Preview allowed':'Preserve records' }}</td><td><form method="post" class="inline-form"><input type="hidden" name="user_id" value="{{ row.id }}"><select name="action"><option value="marked_spam">Mark spam</option><option value="quarantine">Quarantine</option><option value="suspend">Suspend</option><option value="whitelist">Whitelist</option></select><input name="reason" required placeholder="Reason"><button class="btn btn-sm btn-outline-dark">Save</button></form></td></tr>{% else %}<tr><td colspan="8" class="text-center py-5 text-muted">No records.</td></tr>{% endfor %}</tbody></table></div></section></main><style>.hygiene-page{display:grid;gap:1.25rem}.hygiene-hero{background:linear-gradient(135deg,#0f172a,#7f1d1d);border-radius:28px;color:#fff;padding:2rem}.hygiene-hero h1{color:#fff!important;font-weight:950}.hygiene-hero span{color:#fecaca;font-size:.78rem;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.health-grid{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.health-grid article,.hygiene-panel,.warning-panel{background:#fff;border:1px solid rgba(15,23,42,.1);border-radius:22px;box-shadow:0 18px 48px rgba(15,23,42,.08);padding:1rem}.warning-panel{background:#fffbeb;color:#92400e}.health-grid span{color:#64748b;font-size:.75rem;font-weight:900;text-transform:uppercase}.health-grid strong{display:block;font-size:1.45rem}.hygiene-filters{display:grid;gap:.75rem;grid-template-columns:1fr 240px auto}.hygiene-filters input,.hygiene-filters select,.inline-form input,.inline-form select{border:1px solid #dbe4ee;border-radius:12px;padding:.7rem}.hygiene-table{min-width:1050px;width:100%}.hygiene-table th{background:#f8fafc;font-size:.73rem;font-weight:950;letter-spacing:.08em;padding:.85rem;text-transform:uppercase}.hygiene-table td{border-top:1px solid rgba(15,23,42,.1);padding:.85rem}.hygiene-table small{color:#64748b;display:block}.inline-form{display:flex;gap:.4rem}.risk{border-radius:999px;font-size:.75rem;font-weight:900;padding:.35rem .6rem}.risk.low{background:#dcfce7;color:#166534}.risk.medium{background:#fef3c7;color:#92400e}.risk.high{background:#fee2e2;color:#991b1b}@media(max-width:900px){.hygiene-filters{grid-template-columns:1fr}.inline-form{flex-direction:column}}</style>{% endblock %}
