      setValue('[name="service_or_product"]', '');
      setValue('[name="competitor_name"]', '');
      setValue('[name="competitor_domain"]', '');
      setValue('[name="source_reason"]', button.dataset.reason || '');
      setValue('[name="research_sources"]', 'own_data_serp_reddit_images_map');
      setValue('[name="faq_count"]', '5');
      const keyword = button.dataset.keyword || '';
      const location = button.dataset.location || '';
      setValue('[name="provided_data"]', [
        'Write a polished public page for people searching for ' + (keyword || 'this service') + (location ? ' in ' + location : '') + '.',
        'The visitor likely wants to compare options, understand scope and know the next step without reading a generic SEO page.',
        'Use a warm, specific tone. Avoid mentioning Search Console, rankings, CTR, impressions or internal validation.',
        'Include useful sections, buyer questions, a clear CTA and a natural local/service angle.'
      ].filter(Boolean).join('\n'));
      const context = preview('context');
      if (context) {
        context.textContent = 'Source context: Search Console opportunity. Compare against existing pages before publishing a new route.';
      }
      showStep('3');
      builder.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelectorAll('[data-use-existing-content]').forEach(function (button) {
    button.addEventListener('click', function () {
      setValue('[name="title"]', button.dataset.title ? button.dataset.title + ' - updated' : '');
      setValue('[name="content_type"]', button.dataset.contentType || 'page');
      setValue('[name="primary_keyword"]', button.dataset.keyword || '');
      setValue('[name="target_location"]', button.dataset.location || '');
      setValue('[name="provided_data"]', [
        'Use this existing CMS item as a base for a new improved draft.',
        button.dataset.summary || '',
        'Improve structure, SEO, image plan, FAQ, template fit and route clarity.'
      ].filter(Boolean).join('\n'));
      showStep('3');
      builder.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelectorAll('[data-confirm-submit]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm(form.dataset.confirmSubmit || 'Continue?')) {
        event.preventDefault();
      }
    });
  });

  document.querySelectorAll('[data-content-editor-form]').forEach(function (form) {
    const source = form.querySelector('[data-editor-source]');
    const rich = form.querySelector('[data-editor-rich]');
    const previewFrame = form.querySelector('[data-editor-preview]');
    const modeButtons = form.querySelectorAll('[data-editor-mode]');
    if (!source || !rich || !previewFrame || !modeButtons.length) return;

    let styleBlocks = '';
    const templateKey = form.dataset.templateKey || 'service-landing';
    const templateCss = form.dataset.templateCss || '';
    const editorStyleId = 'growth-content-editor-template-css';
    const ensureEditorTemplateCss = function () {
      let style = document.getElementById(editorStyleId);
      if (!style) {
        style = document.createElement('style');
        style.id = editorStyleId;
        document.head.appendChild(style);
      }
      style.textContent = templateCss;
    };
    const extractStyleBlocks = function (html) {
      const matches = String(html || '').match(/<style[\s\S]*?<\/style>/gi);
      return matches ? matches.join('\n') : '';
    };
    const stripStyleBlocks = function (html) {
      return String(html || '').replace(/<style[\s\S]*?<\/style>/gi, '').trim();
    };
    const normalizeBodyHtml = function (html) {
      const value = String(html || '').trim();
      if (value === '') return '<p></p>';
      if (/<[a-z][\s\S]*>/i.test(value)) return value;
      return value.split(/\n{2,}/).map(function (paragraph) {
        return '<p>' + paragraph.replace(/\n/g, '<br>') + '</p>';
      }).join('\n');
    };
    const syncRichFromSource = function () {
      styleBlocks = extractStyleBlocks(source.value);
      ensureEditorTemplateCss();
      rich.innerHTML = '<article class="cms-preview-document cms-preview-template-' + templateKey + '">' + normalizeBodyHtml(stripStyleBlocks(source.value)) + '</article>';
    };
    const syncSourceFromRich = function () {
      const wrapper = rich.querySelector('.cms-preview-document');
      const bodyHtml = wrapper ? wrapper.innerHTML.trim() : rich.innerHTML.trim();
      source.value = [styleBlocks, bodyHtml].filter(Boolean).join('\n');
    };
    const updatePreview = function () {
      const html = source.value.trim();
      const pageTitle = form.dataset.pageTitle || 'CMS preview';
      const documentBody = /cms-preview-document/i.test(html)
        ? html
        : '<article class="cms-preview-document cms-preview-template-' + templateKey + '">' + normalizeBodyHtml(html) + '</article>';
      const previewBaseCss = 'body{margin:0;background:#eef2f7;font-family:Inter,Arial,sans-serif;color:#172033;line-height:1.65}.cms-preview-document{max-width:1180px;margin:0 auto}img{max-width:100%;height:auto}.cms-image-placeholder div{align-items:center;aspect-ratio:4/3;background:linear-gradient(135deg,#e2e8f0,#f8fafc);border:1px dashed rgba(15,23,42,.22);color:#475569;display:flex;justify-content:center;min-height:180px}.cms-image-placeholder span{background:rgba(255,255,255,.82);border-radius:999px;font-size:.78rem;font-weight:800;padding:.45rem .8rem;text-transform:uppercase}.cms-media-text-grid{display:grid;gap:1.25rem}.cms-media-text-row{align-items:center;display:grid;gap:1.25rem;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.cms-media-text-row figure{margin:0}.cms-media-text-row img{border-radius:8px;display:block;height:auto;width:100%}.cms-image-copy h3{font-size:1.35rem;margin:0 0 .5rem}@media(max-width:760px){.cms-media-text-row{grid-template-columns:1fr}}';
      previewFrame.srcdoc = /<html[\s>]/i.test(html)
        ? html
        : '<!doctype html><html><head><base target="_blank"><meta charset="utf-8"><title>' + pageTitle.replace(/</g, '&lt;') + '</title><style>' + previewBaseCss + '</style><style>' + templateCss + '</style></head><body>' + documentBody + '</body></html>';
    };
    const setEditorMode = function (mode) {
      if (mode === 'visual') {
        syncRichFromSource();
      }
      if (mode === 'preview') {
        updatePreview();
      }
      source.classList.toggle('active', mode === 'html');
      rich.classList.toggle('active', mode === 'visual');
      previewFrame.classList.toggle('active', mode === 'preview');
      modeButtons.forEach(function (button) {
        button.classList.toggle('active', button.dataset.editorMode === mode);
      });
    };

    modeButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        if (rich.classList.contains('active')) {
          syncSourceFromRich();
        }
        setEditorMode(button.dataset.editorMode || 'html');
      });
    });
    form.addEventListener('submit', function () {
      if (rich.classList.contains('active')) {
        syncSourceFromRich();
      }
    });
    source.addEventListener('input', function () {
      if (previewFrame.classList.contains('active')) {
        updatePreview();
      }
    });

    setEditorMode('html');
  });

  const progressOverlay = document.querySelector('[data-generation-progress]');
  const progressTitle = document.querySelector('[data-generation-progress-title]');
  const progressLabel = document.querySelector('[data-generation-progress-label]');
  const progressBar = document.querySelector('[data-generation-progress-bar]');
  const progressSteps = Array.from(document.querySelectorAll('[data-generation-step]'));
  const progressMessages = [
    'Reading selected opportunity and brief...',
    'Finding keyword gaps from internal market signals...',
    'Writing the public page copy with IA...',
    'Reading web references, preparing images and adding internal links...',
    'Saving route, schema, metadata and preview...'
  ];
  const locationInput = builder ? builder.querySelector('[name="target_location"]') : null;
  const includeMapInput = builder ? builder.querySelector('[name="include_map"]') : null;
  const templateInput = builder ? builder.querySelector('[name="template_key"]') : null;
  const contentTypeInput = builder ? builder.querySelector('[name="content_type"]') : null;
  const mapHelp = builder ? builder.querySelector('[data-map-location-help]') : null;
  const mapOption = builder ? builder.querySelector('[data-map-option]') : null;
  const sourceImagesOption = builder ? builder.querySelector('[data-location-source-images-option]') : null;
  const sourceImagesInput = builder ? builder.querySelector('[name="use_source_images"]') : null;
  const selectedTemplateType = function () {
    if (!templateInput || !templateInput.selectedOptions || !templateInput.selectedOptions.length) return '';
    return templateInput.selectedOptions[0].dataset.templateType || '';
  };
  const syncLocationMode = function () {
    if (!locationInput) return;
    const isLocationTemplate = selectedTemplateType() === 'location' || (templateInput && templateInput.value === 'local-location-page');
    if (isLocationTemplate) {
      if (includeMapInput) includeMapInput.checked = true;
      if (contentTypeInput && contentTypeInput.value === 'landing') {
        contentTypeInput.value = 'location';
        contentTypeInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
    const isLocationContent = contentTypeInput && contentTypeInput.value === 'location';
    const requiresMap = isLocationTemplate || isLocationContent;
    if (includeMapInput) {
      includeMapInput.checked = !!requiresMap;
    }
    if (mapOption) {
      mapOption.hidden = !requiresMap;
    }
    if (sourceImagesOption) {
      sourceImagesOption.hidden = !requiresMap;
    }
    if (sourceImagesInput && !requiresMap) {
      sourceImagesInput.checked = false;
    }
    const required = requiresMap;
    locationInput.required = !!required;
    locationInput.classList.toggle('is-invalid', required && locationInput.value.trim() === '');
    if (mapHelp) {
      mapHelp.textContent = required
        ? 'Required for location pages. This location is used by the idea generator and the map block.'
        : 'Optional context for non-location pages.';
    }
  };
  if (templateInput) templateInput.addEventListener('change', syncLocationMode);
  if (contentTypeInput) contentTypeInput.addEventListener('change', syncLocationMode);
  if (includeMapInput) includeMapInput.addEventListener('change', syncLocationMode);
  if (locationInput) locationInput.addEventListener('input', syncLocationMode);
  const setProgressStep = function (index) {
    if (!progressOverlay) return;
    const clamped = Math.max(0, Math.min(progressMessages.length - 1, index));
    if (progressLabel) progressLabel.textContent = progressMessages[clamped];
    if (progressBar) progressBar.style.width = (12 + clamped * 20) + '%';
    progressSteps.forEach(function (step, stepIndex) {
      step.classList.toggle('done', stepIndex < clamped);
      step.classList.toggle('active', stepIndex === clamped);
    });
  };
  document.querySelectorAll('form.cms-builder-grid').forEach(function (form) {
    const completeActions = document.querySelector('[data-generation-complete-actions]');
    const completeMessage = document.querySelector('[data-generation-complete-message]');
    const completeViewPage = document.querySelector('[data-generation-view-page]');
    const completeViewDrafts = document.querySelector('[data-generation-view-drafts]');
    const completeViewList = document.querySelector('[data-generation-view-list]');
    const closeProgress = document.querySelector('[data-generation-close-progress]');
    const contentListUrl = form.dataset.contentListUrl || '';
    const draftListUrl = form.dataset.draftListUrl || '';

    if (completeViewList && contentListUrl) {
      completeViewList.setAttribute('href', contentListUrl);
    }
    if (completeViewDrafts && draftListUrl) {
      completeViewDrafts.setAttribute('href', draftListUrl);
    }
    if (closeProgress) {
      closeProgress.addEventListener('click', function () {
        if (progressOverlay) {
          progressOverlay.classList.remove('active');
          progressOverlay.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('modal-open');
        }
        if (completeActions) {
          completeActions.hidden = true;
        }
      });
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      syncLocationMode();
      if (locationInput && locationInput.required && locationInput.value.trim() === '') {
        locationInput.focus();
        locationInput.reportValidity();
        return;
      }
      if (createPageResult) createPageResult.hidden = true;
      if (completeActions) {
        completeActions.hidden = true;
      }
      if (completeViewPage) {
        completeViewPage.style.display = '';
        completeViewPage.setAttribute('href', '#');
      }
      if (progressOverlay) {
        progressOverlay.classList.add('active');
        progressOverlay.classList.remove('complete');
        progressOverlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      }
      if (progressTitle) progressTitle.textContent = 'Creating page';
      const submitButton = form.querySelector('[type="submit"]');
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.dataset.originalText = submitButton.dataset.originalText || submitButton.textContent;
        submitButton.textContent = 'Generating page...';
      }
      if (createPageSubmitButton) createPageSubmitButton.disabled = true;
      setProgressStep(0);
      const timers = [1, 2, 3, 4].map(function (step, index) {
        window.setTimeout(function () {
          setProgressStep(step);
        }, 1100 + index * 1300);
      });
      postBuilderAction('create_planned_draft', {
        as_json: '1',
        allow_related_previews: '1'
      }).then(function (payload) {
        timers.forEach(function (timer) { window.clearTimeout(timer); });
        setProgressStep(4);
        if (progressBar) progressBar.style.width = '100%';
        if (progressOverlay) {
          progressOverlay.classList.add('active');
          progressOverlay.classList.add('complete');
          progressOverlay.setAttribute('aria-hidden', 'false');
          document.body.classList.add('modal-open');
        }
        if (progressTitle) {
          progressTitle.textContent = 'Página creada';
        }
        if (progressLabel) {
          progressLabel.textContent = 'La página fue creada. Puedes verla ahora o cerrar para hacer otra.';
        }
        if (completeViewPage) {
          const url = payload.preview_url || '';
          if (url) {
            completeViewPage.setAttribute('href', url);
            completeViewPage.style.display = '';
          } else {
            completeViewPage.style.display = 'none';
          }
        }
        if (completeMessage) {
          completeMessage.textContent = 'Borrador #' + (payload.id_content || '') + ' creado. Revisa el contenido, abre el inventario o cierra para generar otro.';
        }
        if (completeActions) {
          completeActions.hidden = false;
          completeActions.removeAttribute('hidden');
          completeActions.style.display = 'block';
        }
        if (titleIdeaStatus) titleIdeaStatus.textContent = 'Page generated. Review it in the popup or close and start another generation.';
        if (createPageResult) {
          const url = payload.preview_url || '';
          createPageResult.hidden = false;
          const listUrl = contentListUrl || '#';
          const draftUrl = draftListUrl || '';
          const listText = listUrl ? ' <a href="' + escapeHtml(listUrl) + '">Ver páginas</a>.' : '';
          const draftText = draftUrl ? ' <a href="' + escapeHtml(draftUrl) + '">Ver borradores</a>.' : '';
          createPageResult.innerHTML = 'Created draft #' + escapeHtml(payload.id_content || '') + (url ? ' <a href="' + escapeHtml(url) + '">Ver previsualización</a>' : '') + '.' + draftText + listText + ' Keep the form open if you want to generate another draft.';
        }
      }).catch(function (error) {
        timers.forEach(function (timer) { window.clearTimeout(timer); });
        if (progressOverlay) {
          progressOverlay.classList.add('active');
          progressOverlay.classList.add('complete');
          progressOverlay.setAttribute('aria-hidden', 'false');
          document.body.classList.add('modal-open');
        }
        if (progressTitle) {
          progressTitle.textContent = 'Revisa el inventario';
        }
        if (progressLabel) {
          progressLabel.textContent = 'El proceso terminó, pero Ophyra no pudo confirmar la respuesta final en esta pantalla.';
        }
        if (completeMessage) {
          completeMessage.textContent = (error.message || 'No se pudo confirmar el resultado.') + ' Abre el inventario para verificar si el borrador fue creado.';
        }
        if (completeViewPage) {
          completeViewPage.style.display = 'none';
        }
        if (completeActions) {
          completeActions.hidden = false;
          completeActions.removeAttribute('hidden');
          completeActions.style.display = 'block';
        }
        if (titleIdeaStatus) titleIdeaStatus.textContent = error.message || 'Could not confirm the generated page.';
      }).finally(function () {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = submitButton.dataset.originalText || 'Generate page';
        }
        syncGeneratePageState();
      });
    });
  });
  syncLocationMode();
  update();
});
</script>
{% endblock %}
