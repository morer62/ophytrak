{% extends 'templates/base.admin.twig' %}

{% block body %}
{% set site = growthHub.site %}
{% set activeStep = growthHub.active_step|default('1') %}
{% set previewContent = growthHub.preview_content|default(null) %}
{% set sampleTitle = site and site.site_key == 'avomeal' ? 'Miami catering menu for a busy work week' : (site and site.site_key == 'jonnysmedia' ? 'Creative production for South Florida brands' : 'Wedding planning in Miami') %}
{% set sampleKeyword = site and site.site_key == 'avomeal' ? 'catering miami' : (site and site.site_key == 'jonnysmedia' ? 'creative production miami' : 'wedding planner miami') %}
{% set sampleLocation = site and site.site_key == 'avomeal' ? 'Miami' : (site and site.site_key == 'jonnysmedia' ? 'Miami' : 'Miami, Florida, United States') %}
<main class="container-fluid py-4 growth-hub">
  <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3 mb-4">
    <div>
      <p class="text-uppercase fw-bold text-muted mb-1">Level 1 command center</p>
      <h1 class="h2 fw-bold mb-1">Ophyra Growth Hub</h1>
      <p class="text-muted mb-0">Central CMS, SEO, routes and Cloudinary media for VNV Events, Avomeal and Jonnys Media.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a class="btn btn-outline-secondary" href="{{ path('panel/growth-hub/content?site_key=' ~ growthHub.selected_site_key|url_encode) }}">Pages & articles</a>
      <a class="btn btn-outline-dark" href="{{ path('panel/growth-hub?site_key=' ~ growthHub.selected_site_key|url_encode ~ '&step=3#template-library') }}" data-jump-template-library>Templates</a>
      <a class="btn btn-dark" href="#manual-content">Create draft</a>
    </div>
    <form method="get" action="{{ path('panel/growth-hub') }}" class="d-flex gap-2 align-items-center">
      <label class="form-label mb-0 fw-bold" for="site_key">Working on</label>
      <select class="form-select" id="site_key" name="site_key" onchange="this.form.submit()">
        {% for option in growthHub.sites %}
          <option value="{{ option.site_key }}" {{ option.site_key == growthHub.selected_site_key ? 'selected' : '' }}>
            {{ option.site_name }}
          </option>
        {% endfor %}
      </select>
    </form>
  </div>

  {% if not site %}
    <div class="alert alert-warning">Growth Hub tables are not ready yet. Run <code>db/ophyra_growth_hub_level1_required.sql</code>.</div>
  {% else %}
    <section class="row g-3 mb-4">
      {% for project in growthHub.sites %}
        <div class="col-xl-4">
          <a class="project-card {{ project.site_key == site.site_key ? 'active' : '' }}" href="{{ path('panel/growth-hub?site_key=' ~ project.site_key|url_encode) }}">
            <span>{{ project.site_key }}</span>
            <strong>{{ project.site_name }}</strong>
            <small>{{ project.domain ?: project.public_base_url }}</small>
          </a>
        </div>
      {% endfor %}
    </section>

    <section class="row g-3 mb-4">
      <div class="col-xxl-2 col-xl-4 col-md-6">
        <div class="hub-card">
          <span>Site key</span>
          <strong>{{ site.site_key }}</strong>
          <small>{{ site.domain ?: site.public_base_url }}</small>
        </div>
      </div>
      <div class="col-xxl-2 col-xl-4 col-md-6">
        <div class="hub-card">
          <span>Owner</span>
          <strong>#{{ site.id_owner }}</strong>
          <small>Scope: id_owner + site_key</small>
        </div>
      </div>
      <div class="col-xxl-2 col-xl-4 col-md-6">
        <div class="hub-card">
          <span>CMS contents</span>
          <strong>{{ growthHub.content_count }}</strong>
          <small>Drafts and published pages</small>
        </div>
      </div>
      <div class="col-xxl-2 col-xl-4 col-md-6">
        <div class="hub-card">
          <span>Cloudinary media</span>
          <strong>{{ growthHub.media_count }}</strong>
          <small>{{ site.cloudinary_folder }}</small>
        </div>
      </div>
      <div class="col-xxl-2 col-xl-4 col-md-6">
        <div class="hub-card">
          <span>Tracked keywords</span>
          <strong>{{ growthHub.keyword_count }}</strong>
          <small>GSC, Trends and SERP queue</small>
        </div>
      </div>
      <div class="col-xxl-2 col-xl-4 col-md-6">
        <div class="hub-card">
          <span>Competitors</span>
          <strong>{{ growthHub.competitor_count }}</strong>
          <small>By county, city and service</small>
        </div>
      </div>
    </section>

    <section class="hub-panel mb-4">
      {% set sitemapSettings = growthHub.sitemap_settings|default({}) %}
      {% set publishingEnvironment = sitemapSettings.environment|default('development') %}
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
        <div>
          <h2 class="h5 fw-bold mb-1">Public rendering URL</h2>
          <p class="text-muted mb-0">This controls canonical URLs and whether Ophyra asks the brand site to refresh its sitemap after publication.</p>
        </div>
        <span class="badge {{ publishingEnvironment == 'production' ? 'bg-success' : 'bg-secondary' }} align-self-start">
          {{ publishingEnvironment == 'production' ? 'Production sitemap refresh active' : 'Development mode' }}
        </span>
      </div>
      <form method="post" action="{{ path('panel/growth-hub') }}" class="row g-3 align-items-end">
        <input type="hidden" name="action" value="update_site_settings">
        <input type="hidden" name="site_key" value="{{ site.site_key }}">
        <div class="col-lg-5">
          <label class="form-label">Public base URL</label>
          <input class="form-control" name="public_base_url" value="{{ site.public_base_url }}" placeholder="https://vnvevents.com" required>
        </div>
        <div class="col-lg-3">
          <label class="form-label">Domain</label>
          <input class="form-control" name="domain" value="{{ site.domain }}" placeholder="vnvevents.com">
        </div>
        <div class="col-lg-2">
          <label class="form-label">Environment</label>
          <select class="form-select" name="publishing_environment">
            <option value="development" {{ publishingEnvironment != 'production' ? 'selected' : '' }}>Development</option>
            <option value="production" {{ publishingEnvironment == 'production' ? 'selected' : '' }}>Production</option>
          </select>
        </div>
        <div class="col-lg-2 d-grid">
          <button class="btn btn-dark fw-bold" type="submit">Save</button>
        </div>
        <div class="col-lg-7">
          <label class="form-label">Receiver sitemap refresh endpoint</label>
          <input class="form-control" name="receiver_sitemap_endpoint" value="{{ sitemapSettings.receiver_sitemap_endpoint|default('') }}" placeholder="https://vnvevents.com/api/ophyra/growth-hub/sitemap-refresh">
          <small class="text-muted">Called only in production after publish/update/archive. Development skips remote sitemap refresh.</small>
        </div>
        <div class="col-lg-3">
          <label class="form-label">Receiver token</label>
          <input class="form-control" name="receiver_sitemap_token" type="password" placeholder="{{ sitemapSettings.receiver_sitemap_token|default('') ? 'Token saved; leave blank to keep it' : 'Shared secret token' }}">
        </div>
        <div class="col-lg-2 d-grid">
          <button class="btn btn-outline-secondary fw-bold" type="submit" formaction="{{ path('panel/growth-hub') }}" name="action" value="refresh_receiver_sitemap">Refresh sitemap</button>
        </div>
      </form>
    </section>

    {% set editing = growthHub.editing_content %}
    {% if editing %}
      <section class="hub-panel mb-4" id="edit-content">
        <div class="d-flex justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h5 fw-bold mb-1">Modify content draft</h2>
            <p class="text-muted mb-0">Edit the full page HTML, switch to a visual view, preview it, then publish or delete it.</p>
          </div>
          <div class="d-flex flex-wrap gap-2 align-self-start">
            <form method="post" action="{{ path('panel/growth-hub') }}" data-confirm-submit="Delete this page and archive its public route?">
              <input type="hidden" name="action" value="archive_content">
              <input type="hidden" name="site_key" value="{{ site.site_key }}">
              <input type="hidden" name="id_content" value="{{ editing.id }}">
              <button class="btn btn-outline-danger btn-sm" type="submit">Delete page</button>
            </form>
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('panel/growth-hub?site_key=' ~ site.site_key|url_encode) }}">Close editor</a>
          </div>
        </div>
        <form method="post" action="{{ path('panel/growth-hub') }}" class="row g-3 content-html-editor-form" data-content-editor-form data-template-key="{{ editing.template_key|default(editing.metadata.template_key|default('service-landing'))|e('html_attr') }}" data-template-css="{{ editing.template_css_text|default('')|e('html_attr') }}" data-page-title="{{ editing.title|e('html_attr') }}">
          <input type="hidden" name="action" value="update_content">
          <input type="hidden" name="site_key" value="{{ site.site_key }}">
          <input type="hidden" name="id_content" value="{{ editing.id }}">
          <input type="hidden" name="schema_json" value="{{ editing.schema_json|e('html_attr') }}">
          <input type="hidden" name="metadata_json" value="{{ editing.metadata_json|e('html_attr') }}">
          <div class="col-md-3">
            <label class="form-label">Type</label>
            <select class="form-select" name="content_type">
              {% for type in ['page','location','blog'] %}
                <option value="{{ type }}" {{ editing.content_type == type ? 'selected' : '' }}>{{ type|replace({'_':' '})|title }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-5">
            <label class="form-label">Title</label>
            <input class="form-control" name="title" value="{{ editing.title }}" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">Slug</label>
            <input class="form-control" name="slug" value="{{ editing.slug }}">
          </div>
          <div class="col-md-6">
            <label class="form-label">Keyword</label>
            <input class="form-control" name="primary_keyword" value="{{ editing.primary_keyword }}">
          </div>
          <div class="col-md-6">
            <label class="form-label">Location / map address</label>
            <input class="form-control" name="target_location" value="{{ editing.target_location }}" list="growth-locations" autocomplete="off" data-growth-place>
          </div>
          <div class="col-12">
            <label class="form-label">Meta description</label>
            <textarea class="form-control" name="meta_description" rows="2">{{ editing.meta_description }}</textarea>
          </div>
          <div class="col-12">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-2">
              <div>
                <label class="form-label mb-1">Page HTML / article body</label>
                <p class="text-muted mb-0 small">Paste full HTML here, including inline <code>&lt;style&gt;</code> when you want ChatGPT or another editor to improve the page.</p>
              </div>
              <div class="content-editor-tabs" role="tablist">
                <button class="active" type="button" data-editor-mode="html">HTML</button>
                <button type="button" data-editor-mode="visual">Visual</button>
                <button type="button" data-editor-mode="preview">Preview</button>
              </div>
            </div>
            <div class="content-editor-shell">
              <textarea class="form-control content-html-source active" name="body" rows="16" data-editor-source>{{ editing.body }}</textarea>
              <div class="content-rich-editor" contenteditable="true" data-editor-rich aria-label="Visual content editor"></div>
              <iframe class="content-preview-frame" data-editor-preview title="Page preview"></iframe>
            </div>
          </div>
          <div class="col-12">
            <button class="btn btn-dark fw-bold" type="submit">Save content changes</button>
          </div>
        </form>
        {% if editing.status != 'PUBLISHED' %}
          <form method="post" action="{{ path('panel/growth-hub') }}" class="mt-3">
            <input type="hidden" name="action" value="approve_publish_content">
            <input type="hidden" name="site_key" value="{{ site.site_key }}">
            <input type="hidden" name="id_content" value="{{ editing.id }}">
            <button class="btn btn-success fw-bold" type="submit">Approve & publish now</button>
            <small class="text-muted ms-2">Publishes immediately.</small>
          </form>
        {% endif %}
      </section>
    {% endif %}

    <section class="growth-workflow mb-4" aria-label="Growth Hub workflow">
      <button class="workflow-step {{ activeStep == '1' ? 'active' : '' }}" type="button" data-growth-step="1">
        <span>Step 1</span>
        <strong>Opportunity Discovery</strong>
        <small>Services, Search Console and SERP signals</small>
      </button>
      <button class="workflow-step {{ activeStep == '2' ? 'active' : '' }}" type="button" data-growth-step="2">
        <span>Step 2</span>
        <strong>Opportunities</strong>
        <small>Choose what deserves a page</small>
      </button>
      <button class="workflow-step {{ activeStep == '3' ? 'active' : '' }}" type="button" data-growth-step="3">
        <span>Step 3</span>
        <strong>Templates & Builder</strong>
        <small>Preview templates, edit CSS and create drafts</small>
      </button>
    </section>

    <section class="growth-step-panel {{ activeStep == '1' ? 'active' : '' }}" data-growth-step-panel="1">
      <div class="step-heading mb-3">
        <span>Step 1</span>
        <div>
          <h2>Opportunity Discovery</h2>
          <p>Define the services you sell, add competitor URLs manually, then generate keyword candidates from Search Console, IA or SERP.</p>
        </div>
      </div>

      {% set research = growthHub.research_lab %}
      <section class="hub-panel mb-4">
        <div class="service-offer-layout">
          <div class="service-offer-intro">
            <h2 class="h5 fw-bold mb-1">Services / offers to grow</h2>
            <p class="text-muted mb-0">These services define the opportunity engine. Ophyra uses them first, then Search Console and SERP generate keyword proposals from them.</p>
          </div>
          <form method="post" action="{{ path('panel/growth-hub') }}" class="service-offer-form">
            <input type="hidden" name="action" value="update_site_offers">
            <input type="hidden" name="site_key" value="{{ site.site_key }}">
            <div class="service-offer-editor-grid">
              <div class="service-offer-card primary">
                <div class="service-offer-card-head">
                  <div>
                    <strong>Priority services</strong>
                    <span>Each service can include a backlink URL for internal linking.</span>
                  </div>
                  <span class="offer-count">{{ growthHub.site_services|length }}</span>
                </div>
                <div class="offer-chip-list">
                  {% for service in growthHub.site_service_offers|default([]) %}
                    <button class="offer-chip" type="button" data-service-chip="{{ service.label|e('html_attr') }}" data-service-url="{{ service.url|default('')|e('html_attr') }}">{{ service.label }}</button>
                  {% else %}
                    <span class="text-muted">No services configured.</span>
                  {% endfor %}
                </div>
                <label class="form-label">Edit services</label>
                <div class="offer-row-list" data-offer-list="services" data-offer-page-size="5">
                  {% for service in growthHub.site_service_offers|default([]) %}
                    <div class="offer-row" data-offer-row>
                      <input class="form-control" name="main_services_label[]" value="{{ service.label }}" placeholder="Service name">
                      <input class="form-control" name="main_services_url[]" value="{{ service.url|default('') }}" placeholder="Backlink URL: /service-url/">
                      <button class="btn btn-outline-danger" type="button" data-remove-offer-row>Remove</button>
                    </div>
                  {% else %}
                    <div class="offer-row" data-offer-row>
                      <input class="form-control" name="main_services_label[]" placeholder="Wedding planning">
                      <input class="form-control" name="main_services_url[]" placeholder="Backlink URL: /wedding-planning/">
                      <button class="btn btn-outline-danger" type="button" data-remove-offer-row>Remove</button>
                    </div>
                  {% endfor %}
                </div>
                <div class="offer-list-footer">
                  <button class="btn btn-sm btn-outline-dark" type="button" data-add-offer-row="services">Add service backlink</button>
                  <div class="offer-pager" data-offer-pager="services"></div>
                </div>
              </div>
              <div class="service-offer-card">
                <div class="service-offer-card-head">
                  <div>
                    <strong>Products / bundles</strong>
                    <span>Optional add-ons that can support a service page.</span>
                  </div>
                  <span class="offer-count">{{ growthHub.site_products|length }}</span>
                </div>
                <div class="offer-chip-list muted">
                  {% for product in growthHub.site_product_offers|default([]) %}
                    <button class="offer-chip passive" type="button" data-service-chip="{{ product.label|e('html_attr') }}" data-service-url="{{ product.url|default('')|e('html_attr') }}">{{ product.label }}</button>
                  {% else %}
                    <span class="text-muted">No products configured.</span>
                  {% endfor %}
                </div>
                <label class="form-label">Edit products / bundles</label>
                <div class="offer-row-list" data-offer-list="products" data-offer-page-size="5">
                  {% for product in growthHub.site_product_offers|default([]) %}
                    <div class="offer-row" data-offer-row>
                      <input class="form-control" name="main_products_label[]" value="{{ product.label }}" placeholder="Product or bundle">
                      <input class="form-control" name="main_products_url[]" value="{{ product.url|default('') }}" placeholder="Backlink URL: /product-url/">
                      <button class="btn btn-outline-danger" type="button" data-remove-offer-row>Remove</button>
                    </div>
                  {% else %}
                    <div class="offer-row" data-offer-row>
                      <input class="form-control" name="main_products_label[]" placeholder="Event rentals">
                      <input class="form-control" name="main_products_url[]" placeholder="Backlink URL: /event-rentals/">
                      <button class="btn btn-outline-danger" type="button" data-remove-offer-row>Remove</button>
                    </div>
                  {% endfor %}
                </div>
                <div class="offer-list-footer">
                  <button class="btn btn-sm btn-outline-dark" type="button" data-add-offer-row="products">Add product backlink</button>
                  <div class="offer-pager" data-offer-pager="products"></div>
                </div>
              </div>
              <div class="service-offer-actions">
                <button class="btn btn-dark fw-bold" type="submit">Save services</button>
                <span>Click a chip to analyze keyword candidates. Backlink URLs are sent to the article generator for natural internal linking.</span>
              </div>
            </div>
          </form>
        </div>
      </section>

      <datalist id="growth-services">
        {% for service in growthHub.site_services %}
          <option value="{{ service }}">
        {% endfor %}
        {% for product in growthHub.site_products %}
          <option value="{{ product }}">
        {% endfor %}
      </datalist>

      <section class="hub-panel mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
          <div>
            <h2 class="h5 fw-bold mb-1">Manual competitor URLs</h2>
            <p class="text-muted mb-0">Add the competitors you want Ophyra to study. IA can read public titles, meta descriptions and headings from these URLs when SERP is unavailable.</p>
          </div>
          <span class="badge bg-dark align-self-start">{{ growthHub.competitors|length }} tracked</span>
        </div>
        <form method="post" action="{{ path('panel/growth-hub') }}" class="row g-3 mb-3">
          <input type="hidden" name="action" value="create_competitor">
          <input type="hidden" name="site_key" value="{{ site.site_key }}">
          <div class="col-md-3">
            <label class="form-label">Name</label>
            <input class="form-control" name="competitor_name" placeholder="Competitor name" required>
          </div>
          <div class="col-md-4">
            <label class="form-label">URL</label>
            <input class="form-control" name="competitor_url" placeholder="https://competitor.com" required>
          </div>
          <div class="col-md-2">
            <label class="form-label">City / county / state</label>
            <input class="form-control" name="city" placeholder="Search market" autocomplete="off" data-growth-place>
          </div>
          <div class="col-md-2">
            <label class="form-label">Service</label>
            <select class="form-select" name="service_or_product">
              {% for service in growthHub.site_services %}
                <option value="{{ service }}">{{ service }}</option>
              {% else %}
                <option value="">Save services first</option>
              {% endfor %}
            </select>
          </div>
          <div class="col-md-1 d-grid align-items-end">
            <button class="btn btn-dark fw-bold" type="submit">Add</button>
          </div>
        </form>
        <div class="table-responsive">
          <table class="table table-sm align-middle research-table mb-0">
            <thead>
              <tr>
                <th>Competitor</th>
                <th>URL</th>
                <th>Market</th>
                <th>Service</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {% for competitor in growthHub.competitors %}
                {% set competitorService = competitor.service_or_product ?: '' %}
                {% set competitorMarket = competitor.city ?: competitor.county ?: competitor.state ?: '' %}
                <tr>
                  <td><strong>{{ competitor.competitor_name }}</strong><small>{{ competitor.competitor_domain }}</small></td>
                  <td><small>{{ competitor.competitor_url }}</small></td>
                  <td>{{ competitor.city ?: competitor.county ?: 'All' }}</td>
                  <td>{{ competitor.service_or_product ?: '-' }}</td>
                  <td><span class="badge bg-secondary">{{ competitor.scan_status }}</span></td>
                  <td class="text-end">
                    <a class="btn btn-sm btn-outline-dark fw-bold" href="{{ path('panel/growth-hub?site_key=' ~ (site.site_key|url_encode) ~ '&step=1&analysis_competitor=' ~ competitor.id ~ '&analysis_service=' ~ (competitorService|url_encode) ~ '&analysis_location=' ~ (competitorMarket|url_encode)) }}">Analyze</a>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="6" class="text-muted">No competitors yet. Add at least one URL before using competitor IA fallback.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <section class="hub-panel mb-4">
        <div class="d-flex flex-column flex-xl-row justify-content-between gap-3 align-items-xl-end">
          <div>
            <h2 class="h5 fw-bold mb-1">Search Console - {{ site.site_name }}</h2>
            <p class="text-muted mb-0">Update real queries, pages, clicks, impressions and average position for this site. These rows feed Step 2 Table 1.</p>
          </div>
          <div class="d-flex flex-column flex-lg-row gap-2 align-items-lg-end">
            <a class="btn btn-outline-dark fw-bold" href="{{ path('panel/growth-hub/search-console-auth?site_key=' ~ site.site_key|url_encode) }}">Connect Google</a>
            <form method="post" action="{{ path('panel/growth-hub') }}" class="row g-2 align-items-end search-console-import">
              <input type="hidden" name="action" value="import_search_console">
              <input type="hidden" name="site_key" value="{{ site.site_key }}">
              <div class="col-sm-auto">
                <label class="form-label">From</label>
                <input class="form-control" type="date" name="date_from">
              </div>
              <div class="col-sm-auto">
                <label class="form-label">To</label>
                <input class="form-control" type="date" name="date_to">
              </div>
              <div class="col-sm-auto d-grid">
                <button class="btn btn-dark fw-bold" type="submit">Import Search Console</button>
              </div>
            </form>
          </div>
        </div>
        {% if growthHub.search_console_statuses is defined and growthHub.search_console_statuses|length %}
          <div class="table-responsive mt-3">
            <table class="table table-sm align-middle research-table mb-0">
              <thead>
                <tr>
                  <th>Domain</th>
                  <th>Status</th>
                  <th>Last successful import</th>
                  <th>Rows</th>
                  <th>Last error</th>
                </tr>
              </thead>
              <tbody>
                {% for status in growthHub.search_console_statuses %}
                  <tr>
                    <td><strong>{{ status.domain }}</strong><small>{{ status.property_url }}</small></td>
                    <td>
                      {% if status.connection_status == 'connected' %}
                        <span class="badge bg-success">Connected</span>
                      {% else %}
                        <span class="badge bg-warning text-dark">Not connected</span>
                      {% endif %}
                    </td>
                    <td>{{ status.last_successful_import ?: '-' }}</td>
                    <td>
                      {{ status.rows_imported }}
                      {% if status.connection_status == 'connected' and status.rows_imported == 0 %}
                        <small>No rows returned</small>
                      {% endif %}
                    </td>
                    <td>{{ status.last_error ?: '-' }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

        <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mt-4 mb-3">
            <div>
              <h2 class="h5 fw-bold mb-1">From Search Console</h2>
              <p class="text-muted mb-0">Queries with real impressions that can become dedicated pages or improved existing pages.</p>
            </div>
            <span class="badge bg-success align-self-start">{{ growthHub.gsc_page_opportunities|length }} GSC opportunities</span>
          </div>
          <div class="table-responsive">
            <table class="table table-sm align-middle research-table mb-0">
              <thead>
                <tr>
                  <th>Service / offer</th>
                  <th>Main keyword</th>
                  <th>Current page</th>
                  <th>Impressions</th>
                  <th>Clicks</th>
                  <th>CTR</th>
                  <th>Avg position</th>
                  <th>Recommended type</th>
                  <th>Priority</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for opportunity in growthHub.gsc_page_opportunities %}
                  <tr>
                    <td><strong>{{ opportunity.service }}</strong><small>{{ opportunity.location ?: 'Market to define' }}  /  {{ opportunity.intent }}</small></td>
                    <td>{{ opportunity.main_keyword }}</td>
                    <td><small>{{ opportunity.current_page ?: '-' }}</small></td>
                    <td>{{ opportunity.impressions }}</td>
                    <td>{{ opportunity.clicks }}</td>
                    <td>{{ (opportunity.ctr * 100)|number_format(2) }}%</td>
                    <td>{{ opportunity.average_position|number_format(1) }}</td>
                    <td>{{ opportunity.recommended_content_type }}</td>
                    <td><span class="priority-pill">{{ opportunity.priority }}</span></td>
                    <td><small>Brief actions live in Step 2 Table 1</small></td>
                  </tr>
                {% else %}
                  <tr><td colspan="10" class="text-muted">No Search Console opportunity rows yet. Import Search Console for this site.</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
      </section>

        <section class="hub-panel mb-4">
          <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
            <div>
              <h2 class="h5 fw-bold mb-1">Competitor keyword analysis</h2>
              <p class="text-muted mb-0">Choose a competitor first. Ophyra reads that URL with IA, or validates with SERP when available, then returns keyword angles you can turn into Step 2 opportunities.</p>
            </div>
            <span class="badge align-self-start {{ growthHub.serp_health.status == 'connected' ? 'bg-success' : 'bg-warning text-dark' }}">{{ growthHub.serp_health.label }}</span>
          </div>
          <div class="alert {{ growthHub.serp_health.status == 'connected' ? 'alert-success' : 'alert-warning' }} py-2">
            {{ growthHub.serp_health.status == 'connected'
              ? 'SERP can validate current ranking patterns for the selected service.'
              : 'SERP is not fully available. The competitor analysis can still run with IA using the URLs you added manually.' }}
            {% if growthHub.serp_health.last_error %}
              <small class="d-block mt-1">{{ growthHub.serp_health.last_error }}</small>
            {% endif %}
          </div>
          <form method="get" action="{{ path('panel/growth-hub') }}" class="row g-3 mb-3">
            <input type="hidden" name="site_key" value="{{ site.site_key }}">
            <input type="hidden" name="step" value="1">
            <div class="col-md-4">
              <label class="form-label">Competitor to analyze</label>
              <select class="form-select" name="analysis_competitor">
                {% for competitor in growthHub.competitors %}
                  <option value="{{ competitor.id }}" {{ growthHub.analysis_competitor == competitor.id ? 'selected' : '' }}>{{ competitor.competitor_name }}{% if competitor.service_or_product %} - {{ competitor.service_or_product }}{% endif %}</option>
                {% else %}
                  <option value="">Add a competitor first</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Service context</label>
              <select class="form-select" name="analysis_service">
                {% for service in growthHub.site_services %}
                  <option value="{{ service }}" {{ growthHub.analysis_service == service ? 'selected' : '' }}>{{ service }}</option>
                {% else %}
                  <option value="">Save services first</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Market</label>
              <input class="form-control" name="analysis_location" value="{{ growthHub.analysis_location }}" placeholder="Search city, county or state" autocomplete="off" data-growth-place>
            </div>
            <div class="col-md-2 d-grid align-items-end">
              <button class="btn btn-outline-dark fw-bold" type="submit">Update table</button>
            </div>
          </form>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <form method="post" action="{{ path('panel/growth-hub') }}">
              <input type="hidden" name="action" value="generate_competitor_ai_opportunities">
              <input type="hidden" name="site_key" value="{{ site.site_key }}">
              <input type="hidden" name="analysis_competitor" value="{{ growthHub.analysis_competitor }}">
              <input type="hidden" name="analysis_service" value="{{ growthHub.analysis_service }}">
              <input type="hidden" name="analysis_location" value="{{ growthHub.analysis_location }}">
              <button class="btn btn-dark fw-bold" type="submit" {{ growthHub.competitors is empty ? 'disabled' : '' }}>Analyze competitor with IA</button>
            </form>
            <form method="post" action="{{ path('panel/growth-hub') }}">
              <input type="hidden" name="action" value="run_serp_research">
              <input type="hidden" name="site_key" value="{{ site.site_key }}">
              <input type="hidden" name="keyword_text" value="{{ growthHub.analysis_service }}">
              <input type="hidden" name="location_name" value="{{ growthHub.analysis_location ?: 'Miami, Florida, United States' }}">
              <input type="hidden" name="language_code" value="en">
              <input type="hidden" name="device" value="desktop">
              <input type="hidden" name="depth" value="5">
              <button class="btn btn-outline-dark fw-bold" type="submit" {{ growthHub.analysis_service is empty ? 'disabled' : '' }}>Validate service with SERP</button>
            </form>
          </div>
          <div class="table-responsive">
            <table class="table table-sm align-middle research-table mb-0">
              <thead>
                <tr>
                  <th>Competitor</th>
                  <th>Keyword / angle</th>
                  <th>Service</th>
                  <th>Market</th>
                  <th>Analysis source</th>
                  <th>Notes</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for opportunity in growthHub.competitor_ai_opportunities %}
                  <tr>
                    <td><strong>{{ opportunity.competitor_name ?: growthHub.analysis_competitor_row.competitor_name|default('Selected competitor') }}</strong><small>{{ opportunity.competitor_domain ?: opportunity.competitors|default([])|join(', ') }}</small></td>
                    <td><strong>{{ opportunity.keyword }}</strong><small>{{ opportunity.title }}</small></td>
                    <td>{{ opportunity.service ?: growthHub.analysis_service ?: '-' }}</td>
                    <td>{{ opportunity.location ?: growthHub.analysis_location ?: '-' }}</td>
                    <td><span class="badge bg-warning text-dark">IA over competitors</span></td>
                    <td>{{ opportunity.reason }}</td>
                    <td class="text-end">
                      <form method="post" action="{{ path('panel/growth-hub') }}">
                        <input type="hidden" name="action" value="create_opportunity">
                        <input type="hidden" name="site_key" value="{{ site.site_key }}">
                        <input type="hidden" name="analysis_competitor" value="{{ opportunity.competitor_id ?: growthHub.analysis_competitor }}">
                        <input type="hidden" name="analysis_service" value="{{ opportunity.service ?: growthHub.analysis_service }}">
                        <input type="hidden" name="analysis_location" value="{{ opportunity.location ?: growthHub.analysis_location }}">
                        <input type="hidden" name="opportunity_type" value="competitor_keyword_angle">
                        <input type="hidden" name="source" value="competitor_keyword_analysis">
                        <input type="hidden" name="opportunity_key" value="{{ opportunity.opportunity_key }}">
                        <input type="hidden" name="competitor_name" value="{{ (opportunity.competitor_name ?: growthHub.analysis_competitor_row.competitor_name|default(''))|e('html_attr') }}">
                        <input type="hidden" name="competitor_domain" value="{{ opportunity.competitor_domain|e('html_attr') }}">
                        <input type="hidden" name="title" value="{{ opportunity.title|e('html_attr') }}">
                        <input type="hidden" name="keyword_text" value="{{ opportunity.keyword|e('html_attr') }}">
                        <input type="hidden" name="location_name" value="{{ (opportunity.location ?: growthHub.analysis_location)|e('html_attr') }}">
                        <input type="hidden" name="service_or_product" value="{{ (opportunity.service ?: growthHub.analysis_service)|e('html_attr') }}">
                        <input type="hidden" name="score" value="{{ opportunity.score ?: 65 }}">
                        <input type="hidden" name="reason_summary" value="{{ ('Competitor: ' ~ (opportunity.competitor_name ?: growthHub.analysis_competitor_row.competitor_name|default('')) ~ '. ' ~ opportunity.reason)|e('html_attr') }}">
                        <input type="hidden" name="recommended_content_type" value="{{ opportunity.recommended_content_type|default('landing') }}">
                        <button class="btn btn-sm btn-dark fw-bold" type="submit">Generate opportunity</button>
                      </form>
                    </td>
                  </tr>
                {% endfor %}
                {% set analysisServiceLower = growthHub.analysis_service|lower %}
                {% for status in growthHub.serp_statuses %}
                  {% if growthHub.analysis_service is empty or analysisServiceLower in (status.keyword_text|lower) %}
                    <tr>
                      <td><strong>SERP validation</strong><small>{{ status.provider }}  /  {{ status.device }}</small></td>
                      <td><strong>{{ status.keyword_text }}</strong><small>{{ status.connection_status|replace({'_':' '})|title }}</small></td>
                      <td>{{ growthHub.analysis_service ?: '-' }}</td>
                      <td>{{ status.location_name }}</td>
                      <td><span class="badge bg-secondary">{{ status.connection_status|replace({'_':' '})|title }}</span></td>
                      <td>{{ status.last_error ?: '-' }}</td>
                      <td></td>
                    </tr>
                  {% endif %}
                {% else %}
                  {% if growthHub.competitor_ai_opportunities is empty %}
                    <tr><td colspan="7" class="text-muted">No competitor analysis yet. Select a competitor and run IA, or validate the service with SERP.</td></tr>
                  {% endif %}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </section>

      <section class="row g-4 mb-4 d-none">
        <div class="col-xl-7">
          <div class="hub-panel h-100">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
              <div>
                <h2 class="h5 fw-bold mb-1">Keyword candidates from services and competitors</h2>
                <p class="text-muted mb-0">These are candidate keywords to track. Step 2 decides which ones deserve a page and explains why.</p>
              </div>
              <span class="badge bg-dark align-self-start">{{ research.keyword_recommendations|length }} candidates</span>
            </div>
            <div class="table-responsive">
              <table class="table table-sm align-middle research-table">
                <thead>
                  <tr>
                    <th>Service / keyword candidate</th>
                    <th>Location</th>
                    <th>Demand</th>
                    <th>Source</th>
                    <th>Priority</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in research.keyword_recommendations %}
                    <tr>
                      <td><strong>{{ row.keyword }}</strong><small>{{ row.intent }}  /  {{ row.reason }}</small></td>
                      <td>{{ row.location ?: research.seed_location ?: '-' }}</td>
                      <td>{{ row.volume ?: 'Estimate' }}</td>
                      <td>{{ research.source == 'ai_estimate' ? 'AI suggested' : research.source|replace({'_':' '})|title }}</td>
                      <td><span class="priority-pill">{{ row.priority }}</span></td>
                      <td class="text-end">
                        <form method="post" action="{{ path('panel/growth-hub') }}">
                          <input type="hidden" name="action" value="create_keyword">
                          <input type="hidden" name="site_key" value="{{ site.site_key }}">
                          <input type="hidden" name="keyword_text" value="{{ row.keyword }}">
                          <input type="hidden" name="location" value="{{ row.location ?: research.seed_location }}">
                          <input type="hidden" name="service_or_product" value="{{ research.seed_keyword }}">
                          <input type="hidden" name="avg_monthly_searches" value="{{ row.volume }}">
                          <input type="hidden" name="competition" value="{{ row.competition }}">
                          <input type="hidden" name="intent" value="{{ row.intent }}">
                          <input type="hidden" name="priority_score" value="{{ row.priority }}">
                          <input type="hidden" name="notes" value="Added from Growth Hub research preview ({{ research.source }}). {{ row.reason|e('html_attr') }}">
                          <button class="btn btn-sm btn-dark" type="submit">Add to list</button>
                        </form>
                      </td>
                    </tr>
                  {% else %}
                    <tr><td colspan="6" class="text-muted">Choose a service above after adding competitors to generate keyword candidates.</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="col-xl-5">
          <div class="hub-panel h-100">
            <h2 class="h5 fw-bold mb-3">IA / SERP competitor signals</h2>
            <div class="competitor-suggestion-list">
              {% for competitor in research.competitor_recommendations %}
                <article>
                  <div>
                    <strong>{{ competitor.name }}</strong>
                    <span>{{ competitor.domain ?: 'Domain pending' }}  /  {{ competitor.location ?: research.seed_location ?: 'Market pending' }}</span>
                    <small>{{ competitor.reason }}</small>
                  </div>
                  {% if competitor.domain %}
                    <form method="post" action="{{ path('panel/growth-hub') }}">
                      <input type="hidden" name="action" value="create_competitor">
                      <input type="hidden" name="site_key" value="{{ site.site_key }}">
                      <input type="hidden" name="competitor_name" value="{{ competitor.name }}">
                      <input type="hidden" name="competitor_url" value="{{ competitor.domain starts with 'http' ? competitor.domain : 'https://' ~ competitor.domain }}">
                      <input type="hidden" name="city" value="{{ competitor.location ?: research.seed_location }}">
                      <input type="hidden" name="service_or_product" value="{{ research.seed_keyword }}">
                      <input type="hidden" name="notes" value="Added from Growth Hub research preview ({{ research.source }}). {{ competitor.reason|e('html_attr') }}">
                      <button class="btn btn-sm btn-outline-dark" type="submit">Track</button>
                    </form>
                  {% endif %}
                </article>
              {% else %}
                <p class="text-muted mb-0">Competitor signals appear after service analysis. If SERP is unavailable, IA uses the manual competitor URLs you added above.</p>
              {% endfor %}
            </div>
          </div>
        </div>
      </section>

      <section class="row g-4 mb-4 d-none">
