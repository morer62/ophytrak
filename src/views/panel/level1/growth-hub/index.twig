                    <span class="badge bg-warning text-dark">Possible match</span>
                    <small>{{ opportunity.existing_content.title }}</small>
                  {% else %}
                    <span class="badge bg-success">Clear</span>
                  {% endif %}
                </td>
                <td class="text-end">
                  <button
                    class="btn btn-sm btn-dark"
                    type="button"
                    data-use-gsc-opportunity
                    data-title="{{ opportunity.main_keyword|e('html_attr') }}"
                    data-keyword="{{ opportunity.main_keyword|e('html_attr') }}"
                    data-location="{{ opportunity.location|e('html_attr') }}"
                    data-reason="GSC opportunity: {{ opportunity.impressions }} impressions, {{ opportunity.clicks }} clicks, CTR {{ (opportunity.ctr * 100)|number_format(2) }}%, average position {{ opportunity.average_position|number_format(1) }}. Current page: {{ opportunity.current_page|e('html_attr') }}. Suggested URL: {{ opportunity.suggested_url|e('html_attr') }}."
                  >Build draft</button>
                  <form method="post" action="{{ path('panel/growth-hub') }}" class="d-inline">
                    <input type="hidden" name="action" value="dismiss_opportunity">
                    <input type="hidden" name="site_key" value="{{ site.site_key }}">
                    <input type="hidden" name="step" value="2">
                    <input type="hidden" name="opportunity_type" value="gsc_dismissed">
                    <input type="hidden" name="opportunity_key" value="{{ opportunity.opportunity_key }}">
                    <input type="hidden" name="title" value="{{ ('GSC: ' ~ opportunity.main_keyword)|e('html_attr') }}">
                    <input type="hidden" name="keyword_text" value="{{ opportunity.main_keyword|e('html_attr') }}">
                    <input type="hidden" name="location_name" value="{{ opportunity.location|e('html_attr') }}">
                    <input type="hidden" name="service_or_product" value="{{ opportunity.service|e('html_attr') }}">
