        <input type="hidden" name="opportunity_id" data-builder-source="opportunity-id" value="">
        <input type="hidden" name="service_or_product" data-builder-source="service" value="">
        <input type="hidden" name="competitor_name" data-builder-source="competitor-name" value="">
        <input type="hidden" name="competitor_domain" data-builder-source="competitor-domain" value="">
        <input type="hidden" name="source_reason" data-builder-source="source-reason" value="">

        <div class="cms-builder-column cms-builder-main">
          <h3>Brief</h3>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Content type</label>
              <select class="form-select" name="content_type" data-builder-source="type">
                {% for type in ['page','location','blog'] %}
                  <option value="{{ type }}">{{ type|replace({'_':' '})|title }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Category</label>
              <select class="form-select" name="content_category" data-builder-source="category">
                {% for category in growthHub.cms_categories %}
                  <option value="{{ category.slug }}">{{ category.name }}</option>
                {% else %}
                  <option value="articles">Articles</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Template</label>
              <select class="form-select" name="template_key" data-builder-source="template">
                {% for template in growthHub.cms_templates %}
                  <option value="{{ template.template_key }}" data-template-name="{{ template.name|e('html_attr') }}" data-template-key="{{ template.template_key|e('html_attr') }}" data-template-type="{{ template.type|default('general')|e('html_attr') }}">{{ template.name }}</option>
                {% else %}
                  <option value="service-landing" data-template-name="Service Landing" data-template-key="service-landing" data-template-type="landing">Service Landing</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-12">
              <div class="selected-template-card">
                <div>
                  <span>Template selected for this page</span>
                  <strong data-builder-preview="template-name">Template</strong>
                  <small data-builder-preview="template-meta">The page will use this visual skin by default.</small>
                </div>
                <button class="btn btn-sm btn-outline-dark" type="button" data-jump-template-library>Change / manage</button>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label">Primary search phrase</label>
              <input class="form-control" name="primary_keyword" data-builder-source="keyword" list="growth-keywords" placeholder="wedding planner doral">
              <datalist id="growth-keywords">
                {% for keyword in growthHub.keywords %}
                  <option value="{{ keyword.keyword_text }}">
                {% endfor %}
              </datalist>
              <small class="text-muted">Start here with the keyword or search phrase. Ophyra will turn it into one editable title, extract and page direction.</small>
            </div>
            <div class="col-md-4">
              <label class="form-label">Location / map address</label>
              <input class="form-control" name="target_location" data-builder-source="location" list="growth-locations" placeholder="Optional city, county or address" autocomplete="off" data-growth-place data-map-location>
              <datalist id="growth-locations">
                {% for location in growthHub.target_locations %}
                  <option value="{{ location.location_name }}">
                {% endfor %}
              </datalist>
              <small class="text-muted" data-map-location-help>Used when this is a location page.</small>
            </div>
            <div class="col-md-2">
              <label class="form-label">Intent</label>
              <select class="form-select" name="content_intent">
                <option value="brand_informational" selected>Brand info</option>
                <option value="provocative_story">Provocative story</option>
                <option value="local_countdown">Countdown</option>
                <option value="editorial_rewrite">Editorial rewrite</option>
                <option value="tutorial_learning">Tutorial</option>
              </select>
              <small class="text-muted">Controls title angle and article structure.</small>
            </div>
            <div class="col-md-8">
              <label class="form-label">Source URL to rewrite</label>
              <input class="form-control" name="approved_source_urls_manual" placeholder="Paste an article or YouTube URL before generating the idea">
              <small class="text-muted">Optional. If provided, the idea and brief will be based on this URL plus your keyword, service and observations.</small>
            </div>
            <div class="col-12" data-location-source-images-option hidden>
              <div class="form-check builder-check">
                <input class="form-check-input" type="checkbox" name="use_source_images" value="1" id="use_source_images">
                <label class="form-check-label" for="use_source_images">Reference images from the original location source</label>
              </div>
              <small class="text-muted">Only for location pages. Ophyra will use images found in the source URL instead of generating AI images.</small>
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button class="btn btn-outline-primary fw-bold w-100" type="button" data-generate-title-ideas>Generate idea</button>
            </div>
            <div class="col-12">
              <small class="text-muted" data-title-idea-status>Enter a primary search phrase, optionally add a location, then generate one editable idea.</small>
            </div>
            <div class="col-md-7" data-idea-field hidden>
              <label class="form-label">Generated title</label>
              <input class="form-control" name="title" data-builder-source="title" placeholder="Generate an idea, then edit the title before creating the page">
              <small class="text-muted">Editable. Use Generate idea again if you want a new angle, then adjust the title by hand if needed.</small>
            </div>
            <div class="col-md-5" data-idea-field hidden>
              <label class="form-label">Focus keyphrase</label>
              <input class="form-control" name="focus_keyphrase_display" data-focus-keyphrase-display placeholder="Generated from the primary search phrase" autocomplete="off">
              <small class="text-muted">Editable helper. This syncs into the primary search phrase used by the page.</small>
            </div>
            <div class="col-12" data-idea-field hidden>
              <label class="form-label">Extract / page brief</label>
              <input type="hidden" name="excerpt" data-builder-source="excerpt">
              <textarea class="form-control cms-brief-textarea" name="provided_data" data-builder-source="brief" rows="7" placeholder="Generate an idea, then edit the customer-facing extract and article direction here."></textarea>
              <div class="title-idea-list" data-title-idea-list hidden></div>
            </div>
            <div class="col-12" data-idea-field hidden>
              <label class="form-label">Editorial observations</label>
              <textarea class="form-control cms-brief-textarea" name="editor_observations" rows="4" placeholder="Add what you want the rewrite to emphasize, avoid, challenge, localize or make more persuasive."></textarea>
              <small class="text-muted">These notes are treated as mandatory direction. You can paste extra article or YouTube URLs here too.</small>
            </div>
            <div class="col-md-6" data-idea-field hidden>
              <label class="form-label">Generation basis</label>
              <select class="form-select" name="generation_basis">
                <option value="approved_sources" selected>Rewrite approved sources</option>
                <option value="edited_brief">Use edited brief</option>
                <option value="sources_and_brief">Sources + edited brief</option>
              </select>
              <small class="text-muted">Approved sources are the default path for stronger articles.</small>
            </div>
            <div class="col-md-3" data-idea-field hidden>
              <label class="form-label">CTA label</label>
              <input class="form-control" name="selected_cta_label" value="{{ site.default_cta_label|default('Request a Quote') }}" placeholder="Request a Quote">
              <small class="text-muted">Use your real popup/action wording instead of AI-written CTA copy.</small>
            </div>
            <div class="col-md-3" data-idea-field hidden>
              <label class="form-label">CTA URL or action</label>
              <input class="form-control" name="selected_cta_url" value="{{ site.default_cta_url|default('/contact') }}" placeholder="#request-quote">
              <small class="text-muted">This is the exact href/action used in generated CTA buttons.</small>
            </div>
            <div class="col-12">
              <div class="builder-context-note" data-builder-preview="context">Use an opportunity from Step 2, or write a brief manually. Competitor and service context will be stored with the draft when available.</div>
            </div>
          </div>
        </div>

        <div class="cms-builder-column">
          <h3>Generator recipe</h3>
          <div class="builder-recipe">
            <label>
              <span>Research package</span>
              <select class="form-select" name="research_sources">
                <option value="own_data">Own data only</option>
                <option value="own_data_serp" selected>Own data + SERP</option>
                <option value="own_data_serp_reddit">SERP + web citations</option>
                <option value="own_data_serp_reddit_images_map">SERP + web citations + images + map</option>
              </select>
            </label>
            <label>
              <span>Generation depth</span>
              <select class="form-select" name="generation_mode">
                <option value="page_review">Page review</option>
                <option value="short_article">Short article</option>
                <option value="seo_standard" selected>SEO standard</option>
                <option value="deep_article">Deep article</option>
              </select>
            </label>
            <label>
              <span>Target words</span>
              <input class="form-control" name="target_word_count" type="number" min="600" max="3000" step="100" value="1200">
            </label>
            <label>
              <span>Real citations to fetch</span>
              <input class="form-control" name="reddit_citations_count" type="number" min="0" max="12" value="0">
            </label>
            <label>
              <span>Images</span>
              <input class="form-control" name="images_to_generate" type="number" min="0" max="12" value="0">
            </label>
            <label>
              <span>FAQ</span>
              <input class="form-control" name="faq_count" type="number" min="0" max="20" value="5">
            </label>
            <div class="form-check builder-check" data-map-option hidden>
              <input class="form-check-input" type="checkbox" name="include_map" value="1" id="include_map">
              <label class="form-check-label" for="include_map">Map block included for location pages</label>
            </div>
          </div>

          <div class="builder-output-list">
            <strong>Ophyra will create</strong>
            <span>Hyphen route + canonical URL</span>
            <span>SEO title and meta description</span>
            <span>Evidence blocks from GSC and SERP</span>
            <span>Schema, FAQ, CTA and quality checks</span>
          </div>
        </div>

        <div class="cms-builder-column">
          <h3>Preview shape</h3>
          <div class="builder-preview">
            <span class="preview-pill" data-builder-preview="type">Page</span>
            <strong data-builder-preview="title">New CMS draft</strong>
            <p data-builder-preview="summary">Choose a category and template, then describe the page you want Ophyra to generate.</p>
            <div class="preview-route">
              <small>Public route</small>
              <code data-builder-preview="route">/{slug}</code>
            </div>
            <div class="preview-blocks">
              <span>Hero</span>
              <span>Why this page</span>
              <span>GSC evidence</span>
              <span>SERP notes</span>
              <span>Page plan</span>
              <span>Media plan</span>
              <span>Internal links</span>
              <span>CTA</span>
              <span>FAQ</span>
            </div>
            <div class="preview-research">
              <small>Research context</small>
              <span>{{ growthHub.keyword_count }} keywords, {{ growthHub.competitor_count }} competitors, {{ growthHub.target_locations|length }} locations</span>
            </div>
          </div>
          <button class="btn btn-primary fw-bold w-100 mt-3" type="submit" data-create-page-submit disabled>Generate page</button>
          <div class="builder-context-note mt-3" data-create-page-result hidden></div>
        </div>
      </form>
      <div class="generation-progress" data-generation-progress aria-hidden="true">
        <div class="generation-progress-card">
          <strong data-generation-progress-title>Creating page</strong>
          <p data-generation-progress-label>Preparing the research package...</p>
          <div class="generation-progress-bar"><span data-generation-progress-bar></span></div>
          <ol>
            <li data-generation-step="0">Reading selected opportunity and brief</li>
            <li data-generation-step="1">Finding keyword gaps</li>
            <li data-generation-step="2">Writing the page with IA</li>
            <li data-generation-step="3">Reading web references, images and internal links</li>
            <li data-generation-step="4">Saving route, schema and preview</li>
          </ol>
          <div class="generation-progress-actions" data-generation-complete-actions hidden>
            <p data-generation-complete-message class="mb-2"></p>
              <div class="generation-progress-buttons">
                <a class="btn btn-primary fw-bold" data-generation-view-page href="#" target="_blank" rel="noopener">Ver página</a>
                <a class="btn btn-outline-dark" data-generation-view-drafts href="#" target="_blank" rel="noopener">Ver borradores</a>
                <a class="btn btn-outline-dark" data-generation-view-list href="#" target="_blank" rel="noopener">Ver todos</a>
                <button class="btn btn-outline-secondary" type="button" data-generation-close-progress>Cerrar y hacer otra</button>
              </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hub-panel mb-4 template-css-editor" id="template-css-editor" aria-hidden="true">
      <div class="d-flex flex-column flex-xl-row justify-content-between gap-3 mb-3">
        <div>
          <p class="text-uppercase fw-bold text-muted mb-1">Template CSS</p>
          <h2 class="h5 fw-bold mb-1">Edit the visual skin used by generated drafts</h2>
          <p class="text-muted mb-0">Templates keep the brand CSS outside the article prompt. The generator writes content blocks; this CSS controls how those blocks look in preview and on the consuming site.</p>
        </div>
        <button class="btn btn-outline-secondary align-self-xl-start" type="button" data-template-css-close>Close</button>
      </div>
      <div class="template-css-grid">
        {% for template in growthHub.cms_templates %}
          <form method="post" action="{{ path('panel/growth-hub') }}" class="template-css-card" id="template-css-{{ template.id }}">
            <input type="hidden" name="action" value="update_template_css">
            <input type="hidden" name="site_key" value="{{ site.site_key }}">
            <input type="hidden" name="id_template" value="{{ template.id }}">
            <div class="template-css-card-head">
              <div>
                <strong>{{ template.name }}</strong>
                <span>{{ template.template_key }} / {{ template.type|default('general') }}</span>
              </div>
              <button class="btn btn-sm btn-dark" type="submit">Save CSS</button>
            </div>
            <textarea class="form-control template-css-textarea" name="css_text" rows="12" spellcheck="false">{{ template.css_text }}</textarea>
          </form>
        {% else %}
          <p class="text-muted mb-0">No templates configured for this site yet.</p>
        {% endfor %}
      </div>
    </section>

    {% if previewContent %}
      <section class="hub-panel mb-4 article-preview-panel" id="article-preview">
        <div class="d-flex flex-column flex-xl-row justify-content-between gap-3 mb-3">
          <div>
            <p class="text-uppercase fw-bold text-muted mb-1">Live draft preview</p>
            <h2 class="h4 fw-bold mb-1">{{ previewContent.title }}</h2>
            <p class="text-muted mb-0">Rendered from the CMS blocks saved for this draft. It is still private until approved and published.</p>
          </div>
          <div class="d-flex flex-wrap gap-2 align-self-xl-start">
            <a class="btn btn-outline-dark" href="{{ path('panel/growth-hub?site_key=' ~ site.site_key|url_encode ~ '&edit_content_id=' ~ previewContent.id ~ '#edit-content') }}">Edit fields</a>
            <a class="btn btn-outline-secondary" href="{{ path('panel/growth-hub/content?site_key=' ~ site.site_key|url_encode) }}">Open inventory</a>
          </div>
        </div>

        <div class="preview-meta-grid mb-3">
          <div>
            <span>Route</span>
            <code>{{ previewContent.route ?: '/' ~ previewContent.slug }}</code>
          </div>
          <div>
            <span>Canonical</span>
            <code>{{ previewContent.canonical_url }}</code>
          </div>
          <div>
            <span>SEO title</span>
            <strong>{{ previewContent.seo.title }}</strong>
          </div>
          <div>
            <span>Quality</span>
            <strong>{{ previewContent.quality.score }}%</strong>
          </div>
        </div>

        <div class="preview-browser">
          <div class="preview-browser-bar">
            <span></span>
            <span></span>
            <span></span>
            <code>{{ previewContent.canonical_url }}</code>
          </div>
          {% if previewContent.template.css_text|default('') %}
            <style>{{ previewContent.template.css_text|raw }}</style>
          {% endif %}
          <article class="cms-preview-document cms-preview-template-{{ previewContent.template.key|default(previewContent.metadata.template_key|default('service-landing')) }}">
            {% if previewContent.body|default('') %}
              {{ previewContent.body|raw }}
            {% else %}
              {% include 'templates/cms/render-blocks.twig' with { blocks: previewContent.blocks } %}
            {% endif %}
          </article>
        </div>

        <div class="preview-quality-grid mt-3">
          {% for key, passed in previewContent.quality.checks %}
            <span class="{{ passed ? 'passed' : 'missing' }}">{{ key|replace({'_':' '})|title }}</span>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="hub-panel mb-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
        <div>
          <h2 class="h5 fw-bold mb-1">Drafts and recent content</h2>
          <p class="text-muted mb-0">Use an existing item as the base for a new draft, or open the full inventory to review status, route and publishing state.</p>
        </div>
        <a class="btn btn-outline-secondary align-self-lg-start" href="{{ path('panel/growth-hub/content?site_key=' ~ site.site_key|url_encode) }}">Open full inventory</a>
      </div>
      <div class="article-seed-list">
        {% for content in growthHub.contents|slice(0, 6) %}
          <article>
            <div>
              <strong>{{ content.title }}</strong>
              <span>{{ content.content_type|replace({'_':' '})|title }}  /  {{ content.status }}  /  {{ content.route ?: '/' ~ content.slug }}</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <button
                class="btn btn-sm btn-outline-dark"
                type="button"
                data-use-existing-content
                data-title="{{ content.title|e('html_attr') }}"
                data-content-type="{{ content.content_type|e('html_attr') }}"
                data-keyword="{{ content.primary_keyword|e('html_attr') }}"
                data-location="{{ content.target_location|e('html_attr') }}"
                data-summary="{{ content.excerpt|default(content.body)|striptags|slice(0, 220)|e('html_attr') }}"
              >Use as base</button>
              <a class="btn btn-sm btn-outline-secondary" href="{{ path('panel/growth-hub?site_key=' ~ site.site_key|url_encode ~ '&edit_content_id=' ~ content.id) }}#edit-content">Edit</a>
              <form method="post" action="{{ path('panel/growth-hub') }}" data-confirm-submit="Delete this page and archive its public route?">
                <input type="hidden" name="action" value="archive_content">
                <input type="hidden" name="site_key" value="{{ site.site_key }}">
                <input type="hidden" name="id_content" value="{{ content.id }}">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
              </form>
            </div>
          </article>
        {% else %}
          <p class="text-muted mb-0">No drafts yet. Create the first one from an opportunity or a brief.</p>
        {% endfor %}
      </div>
    </section>
    </section>

    <section class="row g-4 d-none">
      <div class="col-xl-5 d-none">
        <div class="hub-panel">
          <h2 class="h5 fw-bold mb-3">Create structured draft</h2>
          <form method="post" action="{{ path('panel/growth-hub') }}">
            <input type="hidden" name="action" value="create_draft">
            <input type="hidden" name="site_key" value="{{ site.site_key }}">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Content type</label>
                <select class="form-select" name="content_type">
                  {% for type in ['page','location','blog'] %}
                    <option value="{{ type }}">{{ type|replace({'_':' '})|title }}</option>
                  {% endfor %}
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Primary keyword</label>
                <input class="form-control" name="primary_keyword" placeholder="wedding planner doral">
              </div>
              <div class="col-12">
                <label class="form-label">Title</label>
                <input class="form-control" name="title" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">Slug</label>
                <input class="form-control" name="slug" placeholder="auto from title">
              </div>
              <div class="col-md-6">
                <label class="form-label">Target location</label>
                <input class="form-control" name="target_location" list="growth-locations" placeholder="Search a city, county or address" autocomplete="off" data-growth-place>
              </div>
              <div class="col-12">
                <label class="form-label">Meta description</label>
                <textarea class="form-control" name="meta_description" rows="2"></textarea>
              </div>
              <div class="col-12">
                <label class="form-label">Body / notes</label>
                <textarea class="form-control" name="body" rows="5"></textarea>
              </div>
              <div class="col-12">
                <button class="btn btn-dark fw-bold" type="submit">Create draft</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <div class="col-12">
        <div class="hub-panel">
          <h2 class="h5 fw-bold mb-3">Cloudinary media registry</h2>
          <form method="post" action="{{ path('panel/growth-hub') }}" enctype="multipart/form-data" class="row g-3 mb-4">
            <input type="hidden" name="action" value="upload_media">
            <input type="hidden" name="site_key" value="{{ site.site_key }}">
            <div class="col-md-6">
              <label class="form-label">Image</label>
              <input class="form-control" type="file" name="media_file" accept="image/*" required>
            </div>
            <div class="col-md-3">
              <label class="form-label">Source type</label>
              <select class="form-select" name="source_type">
                <option value="uploaded">Uploaded</option>
                <option value="real_photo">Real photo</option>
                <option value="ai_generated">AI generated</option>
                <option value="stock">Stock</option>
                <option value="edited">Edited</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Usage</label>
              <select class="form-select" name="usage_type">
                <option value="featured">Featured</option>
                <option value="gallery" selected>Gallery</option>
                <option value="inline">Inline</option>
                <option value="background">Background</option>
                <option value="product">Product</option>
                <option value="service">Service</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Alt text</label>
              <input class="form-control" name="alt_text">
            </div>
            <div class="col-md-6">
              <label class="form-label">Caption</label>
              <input class="form-control" name="caption">
            </div>
            <div class="col-12">
              <label class="form-label">Prompt used</label>
              <textarea class="form-control" name="prompt_used" rows="2"></textarea>
              {% if site.site_key == 'vnvevents' %}
                <small class="text-muted">AI-generated images for VNV Events remain marked as AI generated and must not be presented as real event photos.</small>
              {% endif %}
            </div>
            <div class="col-12">
              <button class="btn btn-primary fw-bold" type="submit">Upload and register media</button>
            </div>
          </form>

          <div class="media-grid">
            {% for media in growthHub.media %}
              <article class="media-tile">
                <img src="{{ media.secure_url }}" alt="{{ media.alt_text ?: media.title_text ?: 'Growth Hub media' }}">
                <div>
                  <strong>{{ media.usage_type }}</strong>
                  <span>{{ media.source_type }}</span>
                </div>
              </article>
            {% else %}
              <p class="text-muted mb-0">No Cloudinary media registered for this site yet.</p>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="hub-panel mt-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
          <h2 class="h5 fw-bold mb-1">Pages, articles and locations live in their own inventory</h2>
          <p class="text-muted mb-0">Use the table view to see drafts and published content with public URLs and edit links.</p>
        </div>
        <a class="btn btn-dark align-self-lg-start" href="{{ path('panel/growth-hub/content?site_key=' ~ site.site_key|url_encode) }}">Open content inventory</a>
      </div>
    </section>

    <section class="hub-panel mt-4 d-none">
      <h2 class="h5 fw-bold mb-3">Recent content</h2>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Title</th>
              <th>Type</th>
              <th>Status</th>
              <th>Route</th>
              <th>Updated</th>
            </tr>
          </thead>
          <tbody>
            {% for content in growthHub.contents %}
              <tr>
                <td class="fw-bold">{{ content.title }}</td>
                <td>{{ content.content_type }}</td>
                <td><span class="badge bg-secondary">{{ content.status }}</span></td>
                <td><code>{{ content.route ?: '/' ~ content.slug }}</code></td>
                <td>
                  {{ content.updated_at ?: content.created_at }}
                  <br><a href="{{ path('panel/growth-hub?site_key=' ~ site.site_key|url_encode ~ '&edit_content_id=' ~ content.id) }}#edit-content">Modify</a>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="5" class="text-muted">No content yet for this site.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

  {% endif %}
</main>

