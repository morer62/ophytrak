                <td><span class="priority-pill">{{ opportunity.score ?: 0 }}</span></td>
                <td>
                  {% if opportunity.existing_content %}
                    <span class="badge bg-warning text-dark">Possible match</span>
                    <small>{{ opportunity.existing_content.title }}</small>
                  {% else %}
                    <span class="badge bg-success">Clear</span>
                  {% endif %}
                </td>
                <td><span class="badge bg-secondary">Saved competitor</span></td>
                <td class="text-end">
                  {% if opportunity.existing_content %}
                    <span class="text-muted small d-block mb-1">Existing page found</span>
                  {% else %}
                    <button
                      class="btn btn-sm btn-outline-dark"
                      type="button"
                      data-use-opportunity
                      data-opportunity-id="{{ opportunity.id }}"
                      data-title="{{ opportunity.title|e('html_attr') }}"
                      data-content-type="{{ opportunity.recommended_content_type|default('page')|e('html_attr') }}"
                      data-keyword="{{ opportunity.keyword_text|e('html_attr') }}"
                      data-location="{{ opportunity.location_name|e('html_attr') }}"
                      data-service="{{ opportunity.service_or_product|e('html_attr') }}"
                      data-competitor-name="{{ opportunity.competitor_name|e('html_attr') }}"
