                <td><strong>{{ snapshot.keyword_text }}</strong><small>{{ snapshot.provider ?: 'serp' }} / {{ snapshot.device ?: 'desktop' }}</small></td>
                <td>{{ snapshot.location_name ?: snapshot.county ?: '-' }}</td>
