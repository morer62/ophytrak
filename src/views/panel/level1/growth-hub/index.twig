                    data-location="{{ snapshot.location_name|e('html_attr') }}"
                    data-reason="SERP snapshot from {{ snapshot.provider|default('provider') }}. Own best position: {{ snapshot.own_best_position ?: 'not found' }}. Top competitor: {{ snapshot.top_competitor_domain ?: 'pending' }}."
