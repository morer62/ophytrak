</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const stepButtons = Array.from(document.querySelectorAll('[data-growth-step]'));
  const stepPanels = Array.from(document.querySelectorAll('[data-growth-step-panel]'));
  const initGrowthHubPlaces = function () {
    if (!window.google || !google.maps || !google.maps.places) return false;

    document.querySelectorAll('[data-growth-place]').forEach(function (input) {
      if (input.dataset.growthPlaceReady === '1') return;
      input.dataset.growthPlaceReady = '1';

      const autocomplete = new google.maps.places.Autocomplete(input, {
        componentRestrictions: { country: ['us'] },
        fields: ['address_components', 'formatted_address', 'geometry', 'name', 'place_id'],
        types: ['geocode']
      });

      autocomplete.addListener('place_changed', function () {
        const place = autocomplete.getPlace();
        const label = place.formatted_address || place.name || input.value;
        input.value = label;
        input.setCustomValidity('');
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));

        const placeIdTarget = input.dataset.placeIdTarget ? document.getElementById(input.dataset.placeIdTarget) : null;
        const latTarget = input.dataset.placeLatTarget ? document.getElementById(input.dataset.placeLatTarget) : null;
        const lngTarget = input.dataset.placeLngTarget ? document.getElementById(input.dataset.placeLngTarget) : null;

        if (placeIdTarget) placeIdTarget.value = place.place_id || '';
        if (place.geometry && place.geometry.location) {
          if (latTarget) latTarget.value = place.geometry.location.lat();
          if (lngTarget) lngTarget.value = place.geometry.location.lng();
        }
      });
    });

    return true;
  };

  if (!initGrowthHubPlaces()) {
    let attempts = 0;
    const placesTimer = window.setInterval(function () {
      attempts++;
      if (initGrowthHubPlaces() || attempts >= 20) {
        window.clearInterval(placesTimer);
      }
    }, 300);
  }

  document.querySelectorAll('form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      const requiredPlace = form.querySelector('[data-require-place="1"]');
      if (!requiredPlace || !requiredPlace.value.trim()) return;
      if (!window.google || !google.maps || !google.maps.places) return;

      const target = requiredPlace.dataset.placeIdTarget ? document.getElementById(requiredPlace.dataset.placeIdTarget) : null;
      if (target && !target.value) {
        requiredPlace.setCustomValidity('Choose a location from the Google suggestions.');
        requiredPlace.reportValidity();
        event.preventDefault();
      }
    });
  });

  const showStep = function (step) {
    stepButtons.forEach(function (button) {
      button.classList.toggle('active', button.dataset.growthStep === step);
    });
    stepPanels.forEach(function (panel) {
      panel.classList.toggle('active', panel.dataset.growthStepPanel === step);
    });
  };
  stepButtons.forEach(function (button) {
    button.addEventListener('click', function () {
      showStep(button.dataset.growthStep);
    });
  });

  document.querySelectorAll('[data-service-chip]').forEach(function (button) {
    button.addEventListener('click', function () {
      const serviceInput = document.querySelector('[name="research_keyword"]');
      if (!serviceInput) return;
      serviceInput.value = button.dataset.serviceChip || '';
      serviceInput.dispatchEvent(new Event('input', { bubbles: true }));
      serviceInput.focus();
    });
  });

  const offerRowTemplate = function (kind) {
    const isProduct = kind === 'products';
    const labelName = isProduct ? 'main_products_label[]' : 'main_services_label[]';
    const urlName = isProduct ? 'main_products_url[]' : 'main_services_url[]';
    const labelPlaceholder = isProduct ? 'Product or bundle' : 'Service name';
    const urlPlaceholder = isProduct ? 'Backlink URL: /product-url/' : 'Backlink URL: /service-url/';
    const row = document.createElement('div');
    row.className = 'offer-row';
    row.setAttribute('data-offer-row', '');
    row.innerHTML = '<input class="form-control" name="' + labelName + '" placeholder="' + labelPlaceholder + '">'
      + '<input class="form-control" name="' + urlName + '" placeholder="' + urlPlaceholder + '">'
      + '<button class="btn btn-outline-danger" type="button" data-remove-offer-row>Remove</button>';
    return row;
  };
  const updateOfferPager = function (kind, targetPage) {
    const list = document.querySelector('[data-offer-list="' + kind + '"]');
    const pager = document.querySelector('[data-offer-pager="' + kind + '"]');
    if (!list || !pager) return;
    const rows = Array.from(list.querySelectorAll('[data-offer-row]'));
    const pageSize = Math.max(1, Number(list.dataset.offerPageSize || 5));
    const totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
    const currentPage = Math.min(Math.max(1, Number(targetPage || list.dataset.offerPage || 1)), totalPages);
    list.dataset.offerPage = String(currentPage);
    rows.forEach(function (row, index) {
      const page = Math.floor(index / pageSize) + 1;
      row.hidden = page !== currentPage;
    });
    if (rows.length <= pageSize) {
      pager.hidden = true;
      pager.innerHTML = '';
      return;
    }
    pager.hidden = false;
    const start = ((currentPage - 1) * pageSize) + 1;
    const end = Math.min(rows.length, currentPage * pageSize);
    pager.innerHTML = '<button type="button" data-offer-page-prev="' + kind + '" aria-label="Previous page">&lt;</button>'
      + '<span>' + start + '-' + end + ' of ' + rows.length + '</span>'
      + '<button type="button" data-offer-page-next="' + kind + '" aria-label="Next page">&gt;</button>';
    const prev = pager.querySelector('[data-offer-page-prev]');
    const next = pager.querySelector('[data-offer-page-next]');
    if (prev) prev.disabled = currentPage <= 1;
    if (next) next.disabled = currentPage >= totalPages;
  };
  ['services', 'products'].forEach(function (kind) {
    updateOfferPager(kind, 1);
  });
  document.querySelectorAll('[data-add-offer-row]').forEach(function (button) {
    button.addEventListener('click', function () {
      const kind = button.dataset.addOfferRow || 'services';
      const list = document.querySelector('[data-offer-list="' + kind + '"]');
      if (!list) return;
      const row = offerRowTemplate(kind);
      list.appendChild(row);
      const rows = list.querySelectorAll('[data-offer-row]').length;
      const pageSize = Math.max(1, Number(list.dataset.offerPageSize || 5));
      updateOfferPager(kind, Math.ceil(rows / pageSize));
      const input = row.querySelector('input');
      if (input) input.focus();
    });
  });
  document.addEventListener('click', function (event) {
    const prevButton = event.target.closest('[data-offer-page-prev]');
    if (prevButton) {
      const kind = prevButton.dataset.offerPagePrev || 'services';
      const list = document.querySelector('[data-offer-list="' + kind + '"]');
      updateOfferPager(kind, Number(list ? list.dataset.offerPage || 1 : 1) - 1);
      return;
    }
    const nextButton = event.target.closest('[data-offer-page-next]');
    if (nextButton) {
      const kind = nextButton.dataset.offerPageNext || 'services';
      const list = document.querySelector('[data-offer-list="' + kind + '"]');
      updateOfferPager(kind, Number(list ? list.dataset.offerPage || 1 : 1) + 1);
      return;
    }
    const removeButton = event.target.closest('[data-remove-offer-row]');
    if (!removeButton) return;
    const row = removeButton.closest('[data-offer-row]');
    const list = row ? row.parentElement : null;
    const kind = list ? list.dataset.offerList || 'services' : 'services';
    if (!row || !list) return;
    if (list.querySelectorAll('[data-offer-row]').length <= 1) {
      row.querySelectorAll('input').forEach(function (input) { input.value = ''; });
      updateOfferPager(kind);
      return;
    }
    row.remove();
    updateOfferPager(kind);
  });

  const templateModal = document.querySelector('[data-template-modal]');
  const templateCssEditor = document.getElementById('template-css-editor');
  const openTemplateModal = function () {
    showStep('3');
    if (!templateModal) return;
    templateModal.classList.add('open');
    templateModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('modal-open');
  };
  const closeTemplateModal = function () {
    if (!templateModal) return;
    templateModal.classList.remove('open');
    templateModal.setAttribute('aria-hidden', 'true');
    if (!templateCssEditor || !templateCssEditor.classList.contains('open')) {
      document.body.classList.remove('modal-open');
    }
  };
  const closeTemplateCssEditor = function () {
    if (!templateCssEditor) return;
    templateCssEditor.classList.remove('open');
    templateCssEditor.setAttribute('aria-hidden', 'true');
    if (!templateModal || !templateModal.classList.contains('open')) {
