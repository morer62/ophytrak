                      data-content-type="{{ opportunity.recommended_content_type|default('landing')|e('html_attr') }}"
                      data-keyword="{{ opportunity.keyword|e('html_attr') }}"
                      data-location="{{ opportunity.location|e('html_attr') }}"
                      data-service="{{ opportunity.service|e('html_attr') }}"
                      data-competitor-name="{{ opportunity.competitor_name|e('html_attr') }}"
                      data-competitor-domain="{{ opportunity.competitor_domain|e('html_attr') }}"
                      data-reason="{{ opportunity.reason|e('html_attr') }}"
                    >Create brief</button>
                  {% endif %}
                  <form method="post" action="{{ path('panel/growth-hub') }}" class="d-inline">
                    <input type="hidden" name="action" value="dismiss_opportunity">
                    <input type="hidden" name="site_key" value="{{ site.site_key }}">
                    <input type="hidden" name="step" value="2">
                    <input type="hidden" name="opportunity_type" value="competitor_dismissed">
                    <input type="hidden" name="opportunity_key" value="{{ opportunity.opportunity_key }}">
                    <input type="hidden" name="title" value="{{ opportunity.title|e('html_attr') }}">
                    <input type="hidden" name="keyword_text" value="{{ opportunity.keyword|e('html_attr') }}">
                    <input type="hidden" name="location_name" value="{{ opportunity.location|e('html_attr') }}">
                    <input type="hidden" name="service_or_product" value="{{ opportunity.service|e('html_attr') }}">
                    <input type="hidden" name="competitor_name" value="{{ opportunity.competitor_name|e('html_attr') }}">
                    <input type="hidden" name="competitor_domain" value="{{ opportunity.competitor_domain|e('html_attr') }}">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Dismiss</button>
                  </form>
                </td>
              </tr>
            {% endfor %}
            {% for opportunity in growthHub.market_opportunities %}
              <tr data-filter-competitor="{{ (opportunity.competitor_name ~ ' ' ~ opportunity.competitor_domain)|lower|e('html_attr') }}" data-filter-service="{{ (opportunity.service_or_product ?: '')|lower|e('html_attr') }}" data-filter-keyword="{{ (opportunity.keyword_text ~ ' ' ~ opportunity.title)|lower|e('html_attr') }}">
                <td><strong>{{ opportunity.competitor_name }}</strong><small>{{ opportunity.competitor_domain }}</small></td>
                <td><strong>{{ opportunity.service_or_product ?: 'Service to classify' }}</strong><small>{{ opportunity.title }}</small></td>
                <td>{{ opportunity.keyword_text ?: '-' }}</td>
                <td>{{ opportunity.location_name ?: '-' }}</td>
                <td><small>{{ opportunity.reason_summary ?: 'Saved data-backed opportunity.' }}</small></td>
