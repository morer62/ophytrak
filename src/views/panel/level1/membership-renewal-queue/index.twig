{% extends 'templates/base.admin.twig' %}
{% block body %}
<main class="container-fluid revops-page">
<section class="revops-hero"><div><span class="revops-kicker">Renewal Queue</span><h1>Membership renewals that need action</h1><p>Review due, expired, failed, eligible and ineligible customers before any charge attempt.</p></div><div class="revops-actions"><a class="btn btn-light fw-bold" href="{{ path('panel/membership-renewal-queue?preview=1&filter=eligible') }}">Charge eligible customers</a><a class="btn btn-outline-light fw-bold" href="{{ path('panel/membership-reports') }}">Reports</a></div></section>
<section class="revops-panel"><form method="get" class="revops-filters"><input type="search" name="search" value="{{ filters.search }}" placeholder="Search customer, email or business"><select name="filter">{% for f in ['due_or_expired','due_soon','expired_membership','past_due','failed_payment','has_payment_method','no_payment_method','eligible','courtesy_modules','spam_suspected'] %}<option value="{{ f }}" {{ filters.filter==f?'selected':'' }}>{{ f|replace({'_':' '})|title }}</option>{% endfor %}</select><select name="per_page">{% for s in [25,50,100] %}<option value="{{ s }}" {{ queue.per_page==s?'selected':'' }}>{{ s }}</option>{% endfor %}</select><button class="btn btn-dark">Filter</button></form></section>
{% if preview %}<section class="revops-panel preview"><h2>Batch preview</h2><div class="preview-grid"><div><strong>{{ preview.eligible_count }}</strong><span>Eligible</span></div><div><strong>{{ preview.ineligible_count }}</strong><span>Ineligible</span></div><div><strong>{{ preview.estimated_total_label }}</strong><span>Estimated charge</span></div></div><form method="post"><input type="hidden" name="action" value="confirm_batch_preview">{% for row in preview.eligible %}<label class="preview-row"><input type="checkbox" name="customer_ids[]" value="{{ row.id }}" checked><span>{{ row.name }} · {{ row.amount_due_label }} · {{ row.payment_method }}</span></label>{% endfor %}<label class="confirm"><input type="checkbox" name="understand" value="1"> I understand this will attempt to charge selected customers only after the safe batch worker is available.</label><input name="confirm_word" placeholder="Type CHARGE to confirm"><button class="btn btn-dark fw-bold">Confirm batch preview</button></form></section>{% endif %}
<section class="revops-panel"><div class="table-responsive"><table class="revops-table"><thead><tr><th>Customer / Business</th><th>Email</th><th>Membership</th><th>Renewal</th><th>Amount due</th><th>Payment</th><th>Auto-renew</th><th>Failed</th><th>Eligible</th><th>Action</th></tr></thead><tbody>{% for row in queue.rows %}<tr><td><strong>{{ row.name }}</strong><small>{{ row.business ?: 'No business' }}</small></td><td>{{ row.email }}</td><td>{{ row.membership_status|replace({'_':' '})|title }}</td><td>{{ row.membership_due_label ?: '-' }}</td><td><strong>{{ row.amount_due_label }}</strong></td><td>{{ row.payment_method }}</td><td>{{ row.autorenew?'ON':'OFF' }}</td><td>{{ row.failed_attempts }}</td><td><span class="risk {{ row.eligible_to_charge?'low':'medium' }}">{{ row.eligible_to_charge?'Yes':row.eligibility_reason }}</span></td><td><a class="btn btn-sm btn-dark" href="{{ path('panel/customer-billing?customer_id=' ~ row.id) }}">View billing</a></td></tr>{% else %}<tr><td colspan="10" class="text-center py-5 text-muted">No renewal records found.</td></tr>{% endfor %}</tbody></table></div></section>
</main><style>.revops-page{display:grid;gap:1.25rem}.revops-hero{align-items:flex-end;background:linear-gradient(135deg,#0f172a,#92400e);border-radius:28px;color:#fff;display:flex;justify-content:space-between;padding:2rem}.revops-hero h1{color:#fff!important;font-weight:950}.revops-kicker{color:#fde68a;font-size:.78rem;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.revops-actions{display:flex;gap:.65rem}.revops-panel{background:#fff;border:1px solid rgba(15,23,42,.1);border-radius:24px;box-shadow:0 18px 48px rgba(15,23,42,.08);padding:1rem}.revops-filters{display:grid;gap:.75rem;grid-template-columns:1fr 220px 120px auto}.revops-filters input,.revops-filters select,.preview input{border:1px solid #dbe4ee;border-radius:14px;padding:.8rem 1rem}.revops-table{min-width:1080px;width:100%}.revops-table th{background:#f8fafc;font-size:.73rem;font-weight:950;letter-spacing:.08em;padding:.85rem;text-transform:uppercase}.revops-table td{border-top:1px solid rgba(15,23,42,.1);padding:.9rem}.revops-table small{color:#64748b;display:block}.risk{border-radius:999px;font-size:.75rem;font-weight:900;padding:.35rem .6rem}.risk.low{background:#dcfce7;color:#166534}.risk.medium{background:#fef3c7;color:#92400e}.preview-grid{display:grid;gap:.8rem;grid-template-columns:repeat(3,1fr);margin-bottom:1rem}.preview-grid div,.preview-row,.confirm{background:#f8fafc;border:1px solid #e2e8f0;border-radius:16px;display:block;margin:.45rem 0;padding:.8rem}@media(max-width:900px){.revops-hero{align-items:stretch;flex-direction:column}.revops-filters,.preview-grid{grid-template-columns:1fr}}</style>{% endblock %}
