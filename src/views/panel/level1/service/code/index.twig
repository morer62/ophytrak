{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid h-100 d-flex flex-column justify-content-center p-3">
    <h1 class="h3 mb-3 text-center">{{ trans('planner_hub.vnv_certificated') }}</h1>

    <nav aria-label="breadcrumb" class="text-center">
        <ol class="breadcrumb justify-content-center">
            <li class="breadcrumb-item"><a href="{{ path('panel/home') }}">{{ trans('planner_hub.home') }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('panel/service/home') }}">{{ trans('planner_hub.my_services') }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ trans('planner_hub.edit') }}</li>
        </ol>
    </nav>

    <main class="card w-100 shadow-lg">
        <div class="card-body text-center">
            <label>
                {{ trans('planner_hub.copy_paste_code_website') }}<br><br>
                <textarea id="certCode" class="form-control" disabled>
                    <a href="{{ data.wordpress_profile }}">
                        <img src="https://vnvevents.com/wp-content/uploads/2025/03/vnv_certificated.png" style="width:250px">
                    </a>
                </textarea>
                <br>
                <button class="btn btn-dark w-100" onclick="copyCode()">{{ trans('planner_hub.click_to_copy') }}</button>
            </label>
        </div>
    </main>
</div>

<script>
    function copyCode() {
        var copyText = document.getElementById("certCode");
        copyText.select();
        copyText.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(copyText.value);
        alert('{{ trans('planner_hub.code_copied_clipboard')|e('js') }}');
    }
</script>
{% endblock %}
