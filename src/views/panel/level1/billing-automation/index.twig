{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="mt-4 container">
    <div class="ophyra-page-header">
        <div>
            <div class="ophyra-page-kicker">Billing automation</div>
            <h2 class="fw-bold mb-1">Stripe Webhook Events</h2>
            <p class="text-muted mb-0">Webhook logs, renewal processing status and dunning review queue.</p>
        </div>
        <div class="text-md-end d-flex flex-wrap gap-2 justify-content-md-end">
            <a href="{{ path('panel/module-manager') }}" class="btn btn-outline-secondary">
                <i data-feather="settings"></i>
                Module Manager
            </a>
        </div>
    </div>

    <section class="mb-4">
        <div class="row g-3">
            {% for key, value in stats %}
                <div class="col-md-2 col-6">
                    <div class="card ophyra-card h-100">
                        <div class="card-body py-3">
                            <div class="text-muted small text-uppercase">{{ key|replace({'_': ' '}) }}</div>
                            <div class="fs-4 fw-bold">{{ value }}</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            <div class="col-md-4 col-12">
                <div class="card ophyra-card h-100">
                    <div class="card-body py-3">
                        <div class="text-muted small text-uppercase">Webhook mode</div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            {% if hard_disabled %}
                                <span class="badge bg-danger">HARD DISABLED</span>
                            {% else %}
                                <span class="badge bg-success">ENABLED</span>
                            {% endif %}
                            {% if log_only %}
                                <span class="badge bg-warning text-dark">LOG ONLY</span>
                            {% endif %}
                            {% if has_secret %}
                                <span class="badge bg-success">SECRET SET</span>
                            {% else %}
                                <span class="badge bg-danger">NO SECRET</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-4">
        <div class="card ophyra-card">
            <div class="card-body">
                <form method="GET" class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label fw-bold">{{ trans('ui.search') }}</label>
                        <input type="text" name="search" class="form-control" value="{{ search }}" placeholder="Event ID, type, customer, email or company">
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label fw-bold">{{ trans('ui.status') }}</label>
                        <select name="status" class="form-select">
                            <option value="">All statuses</option>
                            {% for item in statuses %}
                                <option value="{{ item }}" {% if status == item %}selected{% endif %}>{{ item|replace({'_': ' '})|upper }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-lg-4 d-flex gap-2">
                        <button class="btn btn-primary flex-fill" type="submit">
                            <i data-feather="search"></i>
                            Search
                        </button>
                        {% if search or status %}
                            <a href="{{ path('panel/billing-automation') }}" class="btn btn-outline-secondary">Clear</a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>
    </section>

    <section>
        <div class="card ophyra-card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Stripe Events</h5>
                <span class="badge bg-dark">{{ events|length }} shown</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>{{ trans('ui.status') }}</th>
                        <th>Event</th>
                        <th>Business</th>
                        <th>Stripe refs</th>
                        <th>Message</th>
                        <th>Received</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for event in events %}
                        <tr>
                            <td>
                                {% set status_class = {
                                    'processed': 'bg-success',
                                    'failed': 'bg-danger',
                                    'pending_review': 'bg-warning text-dark',
                                    'ignored': 'bg-secondary',
                                    'duplicate': 'bg-info text-dark',
                                    'received': 'bg-light text-dark border'
                                }[event.status] ?? 'bg-light text-dark border' %}
                                <span class="badge {{ status_class }}">{{ event.status|replace({'_': ' '})|upper }}</span>
                            </td>
                            <td>
                                <strong>{{ event.event_type }}</strong>
                                <div class="small text-muted">{{ event.stripe_event_id }}</div>
                            </td>
                            <td>
                                {% if event.user_id %}
                                    <strong>{{ event.company_name ?: event.name ~ ' ' ~ event.lastname }}</strong>
                                    <div class="small text-muted">{{ event.email }} · User {{ event.user_id }}</div>
                                {% else %}
                                    <span class="text-muted small">Not matched</span>
                                {% endif %}
                            </td>
                            <td class="small">
                                {% if event.stripe_customer_id %}<div>Customer: {{ event.stripe_customer_id }}</div>{% endif %}
                                {% if event.stripe_subscription_id %}<div>Sub: {{ event.stripe_subscription_id }}</div>{% endif %}
                                {% if event.stripe_invoice_id %}<div>Invoice: {{ event.stripe_invoice_id }}</div>{% endif %}
                                {% if event.stripe_payment_intent_id %}<div>PI: {{ event.stripe_payment_intent_id }}</div>{% endif %}
                            </td>
                            <td class="small" style="max-width: 360px;">
                                {% if event.error_message %}
                                    <div class="text-danger">{{ event.error_message }}</div>
                                {% endif %}
                                {% if event.processing_notes %}
                                    <div class="text-muted">{{ event.processing_notes }}</div>
                                {% endif %}
                            </td>
                            <td class="small text-muted">
                                <div>{{ event.created_at }}</div>
                                {% if event.processed_at %}<div>Processed: {{ event.processed_at }}</div>{% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <h5 class="fw-bold">No webhook events found.</h5>
                                <p class="text-muted mb-0">Stripe events will appear here after `/api/stripe/webhook` receives them.</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</main>
{% endblock %}
