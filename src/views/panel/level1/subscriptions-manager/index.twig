{% extends 'templates/base.admin.twig' %}{% block body %}<main class="subs-page"><section class="subs-hero"><span>Ophyra Membership Operations</span><h1>Subscription Manager</h1><p>Revenue operations dashboard for renewals, paid modules, courtesy grants, failed payments and cleanup work.</p><div><a class="btn btn-light fw-bold" href="{{ path('panel/membership-renewal-queue') }}">Renewal Queue</a><a class="btn btn-outline-light fw-bold" href="{{ path('panel/module-manager') }}">Module Manager</a></div></section><section class="ops-alert {{ alert.tone }}"><div><strong>{{ alert.title }}</strong><p>{{ alert.text }} Last cron run: {{ alert.last_cron_run }}.</p><small>{{ alert.eligible_count }} eligible · {{ alert.ineligible_count }} ineligible</small></div><div><a class="btn btn-dark" href="{{ path(alert.primary_url) }}">{{ alert.primary_label }}</a><a class="btn btn-outline-dark" href="{{ path(alert.secondary_url) }}">{{ alert.secondary_label }}</a></div></section><section class="metric-grid">{% for label,value in {'Active paid memberships':reports.metrics.active_paid,'Expired memberships':reports.metrics.expired,'Failed payments':reports.metrics.failed,'Pending renewals':summary.due_count,'Courtesy modules':reports.metrics.courtesy_modules,'Paid MRR':reports.metrics.paid_mrr_label,'Courtesy value':reports.metrics.courtesy_value_label,'Outstanding balance':reports.metrics.outstanding_label} %}<article><span>{{ label }}</span><strong>{{ value }}</strong></article>{% endfor %}</section><section class="tab-grid"><a href="{{ path('panel/membership-renewal-queue') }}"><strong>Renewal Queue</strong><span>Due, expired, failed and charge-ready customers.</span></a><a href="{{ path('panel/module-manager') }}"><strong>Active Customers</strong><span>Compact customer list with billing actions.</span></a><a href="{{ path('panel/membership-reports#failed') }}"><strong>Failed Payments</strong><span>Customers needing payment attention.</span></a><a href="{{ path('panel/membership-reports#courtesy') }}"><strong>Courtesy Grants</strong><span>Gifted modules and courtesy value.</span></a><a href="{{ path('panel/user-hygiene') }}"><strong>Spam / Cleanup</strong><span>Suspicious users and safe cleanup actions.</span></a><a href="{{ path('panel/payments') }}"><strong>Platform Payments</strong><span>Payments received and transaction records.</span></a></section></main><style>.subs-page{display:grid;gap:1.25rem}.subs-hero{background:linear-gradient(135deg,#0f172a,#0f766e);border-radius:28px;color:#fff;padding:2rem}.subs-hero h1{color:#fff!important;font-weight:950}.subs-hero span{color:#99f6e4;font-size:.78rem;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.subs-hero div{display:flex;gap:.65rem;margin-top:1rem}.ops-alert,.metric-grid article,.tab-grid a{background:#fff;border:1px solid rgba(15,23,42,.1);border-radius:22px;box-shadow:0 18px 48px rgba(15,23,42,.08);padding:1rem}.ops-alert{align-items:center;display:flex;justify-content:space-between;gap:1rem}.ops-alert.warning{background:#fffbeb}.ops-alert.danger{background:#fef2f2}.ops-alert.success{background:#f0fdf4}.ops-alert p{margin:.25rem 0}.metric-grid{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.metric-grid span{color:#64748b;font-size:.75rem;font-weight:900;text-transform:uppercase}.metric-grid strong{display:block;font-size:1.45rem}.tab-grid{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.tab-grid a{color:#0f172a;text-decoration:none}.tab-grid strong{display:block;font-size:1.15rem}.tab-grid span{color:#64748b}@media(max-width:900px){.ops-alert{align-items:stretch;flex-direction:column}.subs-hero div{flex-direction:column}}</style>{% endblock %}
