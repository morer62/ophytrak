{% extends 'templates/base.admin.twig' %}{% block body %}<main class="container-fluid report-page"><section class="report-hero"><span>Membership Reports</span><h1>Ophyra membership intelligence</h1><p>Paid MRR, courtesy value, failed payments, renewals, no-card customers and module distribution.</p></section><section class="metric-grid">{% for label,value in {'Total users':reports.metrics.total_users,'Active paid':reports.metrics.active_paid,'Expired':reports.metrics.expired,'Failed payments':reports.metrics.failed,'With card':reports.metrics.with_card,'Without card':reports.metrics.without_card,'Courtesy modules':reports.metrics.courtesy_modules,'Outstanding':reports.metrics.outstanding_label,'Paid MRR':reports.metrics.paid_mrr_label,'Courtesy value':reports.metrics.courtesy_value_label,'Expected renewal':reports.metrics.expected_renewal_label} %}<article><span>{{ label }}</span><strong>{{ value }}</strong></article>{% endfor %}</section><section class="report-tabs"><a href="#renewals">Renewals</a><a href="#failed">Failed payments</a><a href="#expired">Expired</a><a href="#courtesy">Courtesy</a><a href="#no-card">No payment method</a><a href="#distribution">Module distribution</a></section>{% set groups={'renewals':'Renewals','failed':'Failed payments','expired':'Expired memberships','courtesy':'Courtesy grants','no_card':'No payment method'} %}{% for key,title in groups %}<section class="report-panel" id="{{ key|replace({'_':'-'}) }}"><h2>{{ title }}</h2><div class="table-responsive"><table class="report-table"><thead><tr><th>Customer</th><th>Email</th><th>Renewal date</th><th>Amount due</th><th>Payment method</th><th>Status</th><th>Action</th></tr></thead><tbody>{% for row in attribute(reports,key) %}<tr><td><strong>{{ row.name }}</strong><small>{{ row.business }}</small></td><td>{{ row.email }}</td><td>{{ row.membership_due_label ?: '-' }}</td><td>{{ row.amount_due_label }}</td><td>{{ row.payment_method }}</td><td>{{ row.membership_status|replace({'_':' '})|title }}</td><td><a class="btn btn-sm btn-dark" href="{{ path('panel/customer-billing?customer_id=' ~ row.id) }}">Open</a></td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">No records.</td></tr>{% endfor %}</tbody></table></div></section>{% endfor %}<section class="report-panel" id="distribution"><h2>Module distribution</h2><div class="table-responsive"><table class="report-table"><thead><tr><th>Module</th><th>Total</th><th>Active</th><th>Courtesy</th><th>Expected revenue</th></tr></thead><tbody>{% for row in reports.distribution %}<tr><td>{{ row.module }}</td><td>{{ row.total }}</td><td>{{ row.active }}</td><td>{{ row.courtesy }}</td><td>{{ row.expected_revenue }}</td></tr>{% endfor %}</tbody></table></div></section></main><style>.report-page{display:grid;gap:1.25rem}.report-hero{background:linear-gradient(135deg,#0f172a,#1d4ed8);border-radius:28px;color:#fff;padding:2rem}.report-hero h1{color:#fff!important;font-weight:950}.report-hero span{color:#bfdbfe;font-size:.78rem;font-weight:950;letter-spacing:.16em;text-transform:uppercase}.metric-grid{display:grid;gap:.8rem;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}.metric-grid article,.report-panel,.report-tabs{background:#fff;border:1px solid rgba(15,23,42,.1);border-radius:22px;box-shadow:0 18px 48px rgba(15,23,42,.08);padding:1rem}.metric-grid span{color:#64748b;font-size:.75rem;font-weight:900;text-transform:uppercase}.metric-grid strong{display:block;font-size:1.5rem}.report-tabs{display:flex;flex-wrap:wrap;gap:.5rem}.report-tabs a{background:#f8fafc;border-radius:999px;color:#0f172a;font-weight:850;padding:.65rem .9rem;text-decoration:none}.report-table{min-width:880px;width:100%}.report-table th{background:#f8fafc;font-size:.73rem;font-weight:950;letter-spacing:.08em;padding:.85rem;text-transform:uppercase}.report-table td{border-top:1px solid rgba(15,23,42,.1);padding:.85rem}.report-table small{color:#64748b;display:block}</style>{% endblock %}
