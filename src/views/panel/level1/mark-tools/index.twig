{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="mt-4">
  <div class="container">

    <h2 class="mb-4 text-center">{{ trans('planner_hub.tools') }}</h2>

    {{ macros.breadcrumb2() }}

    <div class="row g-4 justify-content-center">

      <!-- Text Humanizer -->
      <div class="col-xl-4 col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_3.png') }}" alt="Text Humanizer" class="mb-3" style="height: 100px;">
          <h5 class="fw-bold mb-2">🍸 {{ trans('planner_hub.text_humanizer') }}</h5>
          <p class="text-muted small mb-3">{{ trans('planner_hub.seo_optimizer') }}</p>
          <a href="{{ path('panel/mark-tools/text-humanizer/home') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.continue') }}</a>
        </div>
      </div>

      <!-- Voice Generator -->
      <div class="col-xl-4 col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_7.png') }}" alt="Voice Generator" class="mb-3" style="height: 100px;">
          <h5 class="fw-bold mb-2">🗣️ {{ trans('planner_hub.voice_generator') }}</h5>
          <p class="text-muted small mb-3">{{ trans('planner_hub.interactive_ai_voice') }}</p>
          <a href="{{ path('panel/mark-tools/voice-generator/') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.continue') }}</a>
        </div>
      </div>

      <!-- Google Leads -->
      <div class="col-xl-4 col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_8.png') }}" alt="Google Leads" class="mb-3" style="height: 100px;">
          <h5 class="fw-bold mb-2">📈 {{ trans('planner_hub.google_leads') }}</h5>
          <p class="text-muted small mb-3">{{ trans('planner_hub.get_leads_categories') }}</p>
          <a href="{{ path('panel/mark-tools/lead-google/') }}" class="btn btn-success btn-lg fw-bold px-4">{{ trans('planner_hub.continue') }}</a>
        </div>
      </div>

    </div>

  </div>
</main>
{% endblock %}
