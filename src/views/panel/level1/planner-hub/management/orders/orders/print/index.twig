{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="container mt-4">
    <h1 class="mb-4">📄 {{ trans('planner_hub.generate_order_documents') }}</h1>
    {{ macros.breadcrumb2() }}

    <section class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">{{ trans('planner_hub.choose_document') }}</h5>
            <p class="card-text">{{ trans('planner_hub.download_print_documents') }}</p>

            <div class="d-grid gap-3 mt-4">
                <a class="btn btn-primary" href="{{ path(current_location ~ '/order-details?id=' ~ id) }}">
                    🧾 {{ trans('planner_hub.order_details') }}
                </a>
                <a class="btn btn-secondary" href="{{ path(current_location ~ '/team-assignment?id=' ~ id) }}">
                    👷 {{ trans('planner_hub.team_task_assignment') }}
                </a>

                 <a class="btn btn-success" href="{{ path(current_location ~ '/shopping-list?id=' ~ id) }}">
                    🛒 {{ trans('planner_hub.shopping_list_service') }}
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}
