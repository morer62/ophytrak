{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h2 class="mb-4">💰 {{ trans('planner_hub.received_payments') }}</h2>
{{ macros.breadcrumb2() }}

{% if account %}
    <div class="alert alert-info">
        <strong>{{ trans('planner_hub.square_status') }}</strong> ✅ {{ trans('planner_hub.account_id') }} <code>{{ account.square_account_id }}</code><br>
        <strong>{{ trans('planner_hub.charges_enabled') }}</strong> {{ account.is_verified ? trans('planner_hub.yes') : trans('planner_hub.no') }}<br>
        <strong>{{ trans('planner_hub.details_submitted') }}</strong> {{ account.onboarded_at ? trans('planner_hub.yes') : trans('planner_hub.no') }}
    </div>
{% else %}
    <div class="alert alert-warning">
        ⚠️ {{ trans('planner_hub.no_square_account') }}
        <br><br>
        <a href="{{ path('panel/planner-hub/management/payments/') }}" class="btn btn-primary">
            👉 {{ trans('planner_hub.connect_square_account') }}
        </a>
    </div>
{% endif %}

{% if id_order and manualCharge %}
    <section class="card mb-3">
        <div class="card-body">
            <h5 class="mb-2">{{ trans('planner_hub.charge_saved_payment_method') }}</h5>
            {% if manualCharge.eligible %}
                <p class="text-muted mb-3">
                    {{ trans('planner_hub.authorized_manual_charge_ready') }}
                    <strong>${{ manualCharge.balance|number_format(2) }}</strong>
                </p>
                {% for method in manualCharge.methods %}
                    <form method="post" class="border rounded p-3 mb-2" onsubmit="return confirmAuthorizedCharge(this);">
                        <input type="hidden" name="action" value="authorized_manual_charge">
                        <input type="hidden" name="saved_payment_method_id" value="{{ method.id }}">
                        <input type="hidden" name="manual_charge_amount" value="{{ manualCharge.balance }}">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div>
                                <strong>{{ method.payment_provider|capitalize }}</strong>
                                <span class="text-muted">
                                    {{ method.brand ?: method.method_type }}{% if method.last4 %} **** {{ method.last4 }}{% endif %}
                                </span>
                                <div class="small text-success">{{ trans('planner_hub.authorization_accepted') }}</div>
                            </div>
                            <button class="btn btn-sm btn-primary">
                                {{ trans('planner_hub.confirm_charge') }}
                            </button>
                        </div>
                    </form>
                {% endfor %}
            {% else %}
                <p class="text-muted mb-0">{{ manualCharge.reason }}</p>
            {% endif %}
        </div>
    </section>
{% endif %}


<section class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped text-center align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>{{ trans('planner_hub.order') }}</th>
                        <th>{{ trans('planner_hub.amount') }}</th>
                        <th>{{ trans('planner_hub.refunded_amount') }}</th>
                        <th>{{ trans('planner_hub.method') }}</th>
                        <th>{{ trans('planner_hub.square_payment_id') }}</th>
                        <th>{{ trans('planner_hub.paid_at') }}</th>
                        <th>PDF</th>
                        <th>{{ trans('planner_hub.refund') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in payments %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>#{{ p.id_order }}</td>
                            <td>${{ p.amount }}</td>
                            <td>${{ p.refunded_amount ?? 0 }}</td>
                            <td>{{ p.method|capitalize }}</td>
                            <td>
                                {% if p.stripe_charge_id %}
                                    <code>{{ p.stripe_charge_id }}</code>
                                {% else %}
                                    <span class="text-muted">{{ trans('planner_hub.manual') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ p.paid_at|date("Y-m-d H:i") }}</td>
                            <td>
                                {% if p.id_order and p.entry_type == 'payment' %}
                                    <a href="{{ path('panel/planner-hub/management/orders/orders/payments/pdf') }}?payment_id={{ p.id }}&order_id={{ p.id_order }}" 
                                       class="btn btn-sm btn-outline-primary" 
                                       target="_blank"
                                       data-bs-toggle="tooltip"
                                       data-bs-title="{{ trans('planner_hub.download_payment_receipt_pdf') }}">
                                        📄 PDF
                                    </a>
                                {% elseif p.id_order and p.entry_type == 'advance' %}
                                    <a href="{{ path('panel/planner-hub/management/orders/orders/payments/pdf') }}?advance_id={{ p.id }}&order_id={{ p.id_order }}" 
                                       class="btn btn-sm btn-outline-primary" 
                                       target="_blank"
                                       data-bs-toggle="tooltip"
                                       data-bs-title="{{ trans('planner_hub.download_advance_receipt_pdf') }}">
                                        📄 PDF
                                    </a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                          <td>
                            {% if p.stripe_charge_id and p.refunded_amount < p.amount %}
                                <form method="post" class="d-flex gap-1 justify-content-center" onsubmit="return confirmRefund(this);">
                                    <input type="hidden" name="charge_id" value="{{ p.stripe_charge_id }}">

                                    <input
                                        type="number"
                                        name="refund_amount"
                                        min="0"
                                        max="{{ p.amount - p.refunded_amount }}"
                                        step="0.01"
                                        class="form-control form-control-sm"
                                        placeholder="{{ trans('planner_hub.refund_amount_placeholder') }}"
                                        value="0"
                                        data-bs-toggle="tooltip"
                                        data-bs-title="{{ trans('planner_hub.refund_amount_tooltip') }}"
                                    >

                                    <button
                                        class="btn btn-sm btn-outline-warning"
                                        data-bs-toggle="tooltip"
                                        data-bs-title="{{ trans('planner_hub.refund') }}"
                                    >
                                        ↩ {{ trans('planner_hub.refund') }}
                                    </button>

                                </form>
                            {% elseif p.refunded_amount == p.amount or p.refunded_amount > p.amount %}
                                <span class="text-danger">{{ trans('planner_hub.refunded') }} {{ p.refunded_at|date("Y-m-d H:i") }}</span>
                            {% else %}
                                —
                            {% endif %}
                        </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-muted">{{ trans('planner_hub.no_payments_received') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
const refundTranslations = {
    confirmFull: "⚠️ {{ trans('planner_hub.confirm_refund_full')|e('js') }}",
    confirmPartial: "⚠️ {{ trans('planner_hub.confirm_refund_partial')|e('js') }}"
};

function confirmRefund(form) {
    const amount = form.querySelector('input[name="refund_amount"]').value;

    if (parseFloat(amount) === 0 || isNaN(parseFloat(amount))) {
        return confirm(refundTranslations.confirmFull);
    }

    const confirmMsg = refundTranslations.confirmPartial.replace('${amount}', '$' + parseFloat(amount).toFixed(2));
    return confirm(confirmMsg);
}

function confirmAuthorizedCharge(form) {
    const amount = parseFloat(form.querySelector('input[name="manual_charge_amount"]').value || '0');
    return confirm("{{ trans('planner_hub.confirm_authorized_manual_charge')|e('js') }}".replace('{amount}', '$' + amount.toFixed(2)));
}
</script>
{% endblock %}

