{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

<style>
.fixed-textarea {
  min-height: 160px;
  max-height: 400px;
  resize: none;
  overflow-y: auto; 
  line-height: 2;
  font-size: 13px;
}
</style>

<h1 class="h3 mb-4">📝 {{ trans('planner_hub.sub_order') }} #{{ id }} — {{ trans('planner_hub.service_notes') }}</h1>

<a href="{{ path('panel/planner-hub/management/orders/orders/suborders/team_comunication') }}?id={{ id }}" class="btn btn-outline-secondary mb-3">  
  ← {{ trans('planner_hub.back_to_team_area') }}
</a>

<button type="button" class="btn btn-outline-primary mb-3 d-block" data-bs-toggle="modal" data-bs-target="#bulkTimesModalSub">
  ⏱️ {{ trans('planner_hub.set_times_all_services') }}
</button>

<div class="alert alert-info mb-4">
  <h5>📋 {{ trans('planner_hub.suborder_info') }}</h5>
  <p><strong>{{ trans('planner_hub.sub_order') }}:</strong> Sub-{{ suborder.id }}</p>
  <p><strong>{{ trans('planner_hub.parent_order') }}:</strong> VNV 341{{ order.id }}</p>
  <p><strong>{{ trans('planner_hub.event_date') }}:</strong> {{ order.event_date|date("l, M j, Y") }}</p>
  <p><strong>{{ trans('planner_hub.time') }}:</strong> {{ order.start_time|date("g:i A") }} - {{ order.end_time|date("g:i A") }}</p>
</div>

<form method="post">
  <input type="hidden" name="suborder_id" value="{{ id }}">

  <div class="modal fade" id="bulkTimesModalSub" tabindex="-1" aria-labelledby="bulkTimesModalSubLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="bulkTimesModalSubLabel">{{ trans('planner_hub.bulk_times_modal_title') }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted small mb-3">{{ trans('planner_hub.bulk_times_modal_hint') }}</p>
          <div class="mb-3">
            <label class="form-label">🛠️ {{ trans('planner_hub.install_time') }}</label>
            <input type="time" class="form-control" id="bulk-sub-install-time">
          </div>
          <div class="mb-3">
            <label class="form-label">🎬 {{ trans('planner_hub.execution_time') }}</label>
            <input type="time" class="form-control" id="bulk-sub-execution-time">
          </div>
          <div class="mb-3">
            <label class="form-label">📦 {{ trans('planner_hub.breakdown_time') }}</label>
            <input type="time" class="form-control" id="bulk-sub-breakdown-time">
          </div>
          <div class="mb-0">
            <label class="form-label">{{ trans('planner_hub.start_time') }}</label>
            <input type="time" class="form-control" id="bulk-sub-start-time">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('planner_hub.agent_close') }}</button>
          <button type="button" class="btn btn-primary" id="bulkTimesApplyBtnSub">{{ trans('planner_hub.apply_to_all_services') }}</button>
        </div>
      </div>
    </div>
  </div>

  {% for service in services %}
    <div class="card mb-4">
      <div class="card-header fw-bold">{{ service.name }}</div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label">{{ trans('planner_hub.custom_notes_for_service') }}</label>
          <textarea name="notes[{{ service.id_service }}]"
                    class="form-control fixed-textarea"
                    maxlength="1200"
                    id="notes-{{ service.id_service }}">{{ service.notes }}</textarea>
        </div>

        <div class="row">
          <div class="col-md-3 mb-2">
            <label class="form-label">🛠️ {{ trans('planner_hub.install_time') }}</label>
            <input type="time" name="install_time[{{ service.id_service }}]" value="{{ service.install_time }}" class="form-control js-service-time-sub" data-field="install_time">
          </div>
          <div class="col-md-3 mb-2">
            <label class="form-label">🎬 {{ trans('planner_hub.execution_time') }}</label>
            <input type="time" name="execution_time[{{ service.id_service }}]" value="{{ service.execution_time }}" class="form-control js-service-time-sub" data-field="execution_time">
          </div>
          <div class="col-md-3 mb-2">
            <label class="form-label">📦 {{ trans('planner_hub.breakdown_time') }}</label>
            <input type="time" name="breakdown_time[{{ service.id_service }}]" value="{{ service.breakdown_time }}" class="form-control js-service-time-sub" data-field="breakdown_time">
          </div>
          <div class="col-md-3 mb-2">
            <label class="form-label">{{ trans('planner_hub.start_time') }}</label>
            <input type="time" name="start_time[{{ service.id_service }}]" value="{{ service.start_time }}" class="form-control js-service-time-sub" data-field="start_time">
          </div>
        </div>

        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="manual[]" value="{{ service.id_service }}" id="manualCheck{{ service.id_service }}"
            {% if service.has_manual_entry %}checked{% endif %}>
          <label class="form-check-label" for="manualCheck{{ service.id_service }}">
            🖊️ {{ trans('planner_hub.manual_entry_checkbox') }}
          </label>
        </div>
      </div>
    </div>
  {% endfor %}

  <button class="btn btn-success">
    <i data-feather="save"></i> {{ trans('planner_hub.save_comments') }}
  </button>
</form>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('textarea[name^="notes["]').forEach(textarea => {
    if (textarea.hasAttribute('data-payroll-notes')) {
      return;
    }
    
    textarea.addEventListener('input', function() {
      this.style.height = 'auto';
      const newHeight = this.scrollHeight;
      const maxHeight = 400;
      
      if (newHeight <= maxHeight) {
        this.style.height = newHeight + 'px';
      } else {
        this.style.height = maxHeight + 'px';
      }
    });
  });

  var applyBtn = document.getElementById('bulkTimesApplyBtnSub');
  if (applyBtn) {
    applyBtn.addEventListener('click', function () {
      var map = {
        install_time: document.getElementById('bulk-sub-install-time').value,
        execution_time: document.getElementById('bulk-sub-execution-time').value,
        breakdown_time: document.getElementById('bulk-sub-breakdown-time').value,
        start_time: document.getElementById('bulk-sub-start-time').value
      };
      Object.keys(map).forEach(function (field) {
        var val = map[field];
        document.querySelectorAll('input.js-service-time-sub[data-field="' + field + '"]').forEach(function (el) {
          el.value = val;
        });
      });
      var modalEl = document.getElementById('bulkTimesModalSub');
      if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        var inst = bootstrap.Modal.getInstance(modalEl);
        if (inst) {
          inst.hide();
        }
      }
    });
  }
});
</script>

{% endblock %}
