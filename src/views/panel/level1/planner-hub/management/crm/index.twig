{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="crm-home-shell mt-4">
    <section class="crm-hero mb-4">
        <div>
            <p class="crm-kicker">{{ trans('planner_hub.crm') }}</p>
            <h1>{{ trans('planner_hub.crm_home_title') }}</h1>
            <p>{{ trans('planner_hub.crm_home_subtitle') }}</p>
        </div>
        <a href="{{ path('panel/planner-hub/management/crm/lead/create') }}" class="btn btn-light btn-lg fw-bold">
            <i data-feather="plus"></i> {{ trans('planner_hub.add_new_lead') }}
        </a>
    </section>

    {{ macros.breadcrumb2() }}

    <section class="crm-stats-grid mb-4">
        <a href="{{ path('panel/planner-hub/management/crm/lead?archived=NO') }}" class="crm-stat-card">
            <span>{{ trans('planner_hub.active_leads') }}</span>
            <strong>{{ active_leads_count }}</strong>
            <small>{{ trans('planner_hub.crm_active_help') }}</small>
        </a>
        <a href="{{ path('panel/planner-hub/management/crm/lead?archived=YES') }}" class="crm-stat-card muted">
            <span>{{ trans('planner_hub.archived_leads') }}</span>
            <strong>{{ archived_leads_count }}</strong>
            <small>{{ trans('planner_hub.crm_archived_help') }}</small>
        </a>
        <a href="{{ path('panel/planner-hub/management/crm/categories') }}" class="crm-stat-card teal">
            <span>{{ trans('planner_hub.categories') }}</span>
            <strong>{{ categories_count }}</strong>
            <small>{{ trans('planner_hub.manage_lead_types') }}</small>
        </a>
        <a href="{{ path('panel/planner-hub/management/crm/lead') }}" class="crm-stat-card dark">
            <span>{{ trans('planner_hub.total_leads') }}</span>
            <strong>{{ total_leads_count }}</strong>
            <small>{{ trans('planner_hub.view_manage_inquiries') }}</small>
        </a>
    </section>

    <section class="crm-actions-panel">
        <div class="crm-panel-head">
            <div>
                <p class="crm-kicker">{{ trans('planner_hub.crm_actions') }}</p>
                <h2>{{ trans('planner_hub.crm_actions_title') }}</h2>
                <p>{{ trans('planner_hub.crm_actions_subtitle') }}</p>
            </div>
        </div>
        <div class="crm-actions-grid">
            <a href="{{ path('panel/planner-hub/management/crm/categories') }}" class="crm-action-card">
                <i data-feather="folder"></i>
                <strong>{{ trans('planner_hub.go_to_categories') }}</strong>
                <span>{{ trans('planner_hub.manage_lead_types') }}</span>
            </a>
            <a href="{{ path('panel/planner-hub/management/crm/lead/create') }}" class="crm-action-card primary">
                <i data-feather="user-plus"></i>
                <strong>{{ trans('planner_hub.add_new_lead') }}</strong>
                <span>{{ trans('planner_hub.crm_add_lead_help') }}</span>
            </a>
            <a href="{{ path('panel/planner-hub/management/crm/lead') }}" class="crm-action-card">
                <i data-feather="list"></i>
                <strong>{{ trans('planner_hub.go_to_leads') }}</strong>
                <span>{{ trans('planner_hub.crm_view_leads_help') }}</span>
            </a>
        </div>
    </section>
</main>
{% endblock %}

{% block style %}
<style>
    .crm-home-shell { color:#0f172a; }
    .crm-hero { align-items:flex-end; background:radial-gradient(circle at 90% 15%, rgba(45,212,191,.22), transparent 34%),linear-gradient(135deg,#102338,#0f766e); border-radius:28px; box-shadow:0 24px 70px rgba(15,23,42,.15); color:#fff; display:flex; gap:1.5rem; justify-content:space-between; padding:clamp(1.4rem,4vw,3rem); }
    .crm-hero h1 { color:#fff; font-size:clamp(2rem,4vw,3.8rem); font-weight:900; letter-spacing:-.04em; margin:0; max-width:820px; }
    .crm-hero p { color:rgba(255,255,255,.84); font-size:1rem; line-height:1.6; margin:.7rem 0 0; max-width:760px; }
    .crm-kicker { color:#5eead4; font-size:.76rem; font-weight:900; letter-spacing:.1em; margin:0 0 .35rem; text-transform:uppercase; }
    .crm-stats-grid { display:grid; gap:1rem; grid-template-columns:repeat(4,minmax(0,1fr)); }
    .crm-stat-card,.crm-actions-panel { background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:22px; box-shadow:0 18px 50px rgba(15,23,42,.07); }
    .crm-stat-card { color:#0f172a; display:block; min-height:160px; padding:1.2rem; text-decoration:none; transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
    .crm-stat-card:hover { border-color:rgba(15,118,110,.32); box-shadow:0 24px 58px rgba(15,23,42,.1); color:#0f172a; transform:translateY(-2px); }
    .crm-stat-card span { color:#64748b; display:block; font-size:.76rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
    .crm-stat-card strong { display:block; font-size:2.4rem; font-weight:950; letter-spacing:-.04em; margin:.45rem 0; }
    .crm-stat-card small { color:#64748b; display:block; line-height:1.35; }
    .crm-stat-card.teal { background:linear-gradient(180deg,#fff,#ecfdf5); border-color:rgba(20,184,166,.24); }
    .crm-stat-card.muted { background:#f8fafc; }
    .crm-stat-card.dark { background:linear-gradient(135deg,#111827,#0f766e); color:#fff; }
    .crm-stat-card.dark span,.crm-stat-card.dark small { color:rgba(255,255,255,.78); }
    .crm-actions-panel { padding:1.25rem; }
    .crm-panel-head h2 { font-weight:900; letter-spacing:-.02em; margin:0; }
    .crm-panel-head p { color:#64748b; margin:.35rem 0 0; }
    .crm-actions-grid { display:grid; gap:1rem; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:1rem; }
    .crm-action-card { align-items:flex-start; background:#f8fafc; border:1px solid rgba(15,23,42,.08); border-radius:18px; color:#0f172a; display:flex; flex-direction:column; gap:.65rem; min-height:150px; padding:1rem; text-decoration:none; }
    .crm-action-card:hover { background:#ecfdf5; color:#0f172a; }
    .crm-action-card i,.crm-action-card svg { color:#0f766e; height:24px; width:24px; }
    .crm-action-card strong { font-size:1.05rem; font-weight:900; }
    .crm-action-card span { color:#64748b; line-height:1.4; }
    .crm-action-card.primary { background:linear-gradient(180deg,#fff,#f0fdfa); border-color:rgba(20,184,166,.28); }
    @media (max-width:992px){ .crm-stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));} .crm-actions-grid{grid-template-columns:1fr;} .crm-hero{align-items:stretch; flex-direction:column;} }
    @media (max-width:576px){ .crm-stats-grid{grid-template-columns:1fr;} }
</style>
{% endblock %}