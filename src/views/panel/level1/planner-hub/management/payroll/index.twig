{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

<main class="payroll-dashboard">
  <section class="payroll-hero mb-4">
    <div>
      <p class="payroll-kicker">{{ trans('payroll_home.badge') }}</p>
      <h1>{{ trans('payroll_home.title') }}</h1>
      <p>{{ trans('payroll_home.subtitle') }}</p>
    </div>
    <div class="payroll-hero-actions">
      <a href="{{ path(current_location ~ '/pending') }}" class="btn btn-light fw-bold">{{ trans('payroll_home.view_pending') }}</a>
      <a href="{{ path(current_location ~ '/paid') }}" class="btn btn-outline-light fw-bold">{{ trans('payroll_home.view_history') }}</a>
    </div>
  </section>

  <section class="payroll-guide mb-4">
    <div class="payroll-guide-icon"><i data-feather="clock"></i></div>
    <div>
      <p class="payroll-kicker">{{ trans('payroll_home.setup_badge') }}</p>
      <h2>{{ trans('payroll_home.setup_title') }}</h2>
      <p>{{ trans('payroll_home.setup_body') }}</p>
      <p class="payroll-guide-note">{{ trans('payroll_home.rate_note') }}</p>
      <div class="payroll-guide-actions">
        <a href="{{ path('panel/planner-hub/management/users/create') }}" class="btn btn-dark fw-bold">{{ trans('payroll_home.create_team_member') }}</a>
        <a href="{{ path('panel/planner-hub/management/orders/orders') }}" class="btn btn-outline-dark fw-bold">{{ trans('payroll_home.manage_orders') }}</a>
      </div>
    </div>
  </section>

  <section class="payroll-stats mb-4">
    <article class="payroll-stat-card">
      <span>{{ trans('payroll_home.pending_payments') }}</span>
      <strong>{{ payrollSummary.pending_count|default(0) }}</strong>
      <small>{{ payrollSummary.pending_hours|default(0)|number_format(2) }}h {{ trans('payroll_home.pending_hours') }}</small>
    </article>
    <article class="payroll-stat-card is-highlighted">
      <span>{{ trans('payroll_home.week_hours') }}</span>
      <strong>{{ payrollSummary.week_hours|default(0)|number_format(2) }}h</strong>
      <small>{{ payrollSummary.week_label|default('') }}</small>
    </article>
  </section>

  <section class="payroll-actions-grid">
    <a class="payroll-action-card" href="{{ path(current_location ~ '/pending') }}">
      <span class="payroll-action-icon"><i data-feather="dollar-sign"></i></span>
      <strong>{{ trans('planner_hub.pending') }}</strong>
      <small>{{ trans('planner_hub.view_manage_pending') }}</small>
      <em>{{ trans('planner_hub.go_to_pending') }}</em>
    </a>
    <a class="payroll-action-card" href="{{ path(current_location ~ '/paid') }}">
      <span class="payroll-action-icon"><i data-feather="check-circle"></i></span>
      <strong>{{ trans('planner_hub.paid') }}</strong>
      <small>{{ trans('planner_hub.review_completed_transactions') }}</small>
      <em>{{ trans('planner_hub.go_to_paid') }}</em>
    </a>
  </section>
</main>

<style>
  .payroll-dashboard { color:#0f172a; }
  .payroll-hero { align-items:flex-end; background:radial-gradient(circle at 90% 10%, rgba(45,212,191,.28), transparent 32%),linear-gradient(135deg,#111827,#0f766e); border-radius:28px; box-shadow:0 26px 72px rgba(15,23,42,.16); color:#fff; display:flex; gap:1.5rem; justify-content:space-between; padding:clamp(1.35rem,4vw,3rem); }
  .payroll-hero h1 { color:#fff; font-size:clamp(2rem,5vw,4rem); font-weight:900; letter-spacing:-.04em; margin:0 0 .75rem; }
  .payroll-hero p { color:rgba(255,255,255,.86); font-size:1.05rem; margin:0; max-width:820px; }
  .payroll-kicker { color:#7dd3fc; font-size:.82rem; font-weight:900; letter-spacing:.18em; margin-bottom:.7rem; text-transform:uppercase; }
  .payroll-hero-actions { display:flex; flex-wrap:wrap; gap:.7rem; }
  .payroll-guide { align-items:flex-start; background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:24px; box-shadow:0 18px 46px rgba(15,23,42,.08); display:flex; gap:1rem; padding:1.35rem; }
  .payroll-guide h2 { color:#0f172a; font-size:clamp(1.35rem,3vw,2rem); font-weight:900; letter-spacing:-.03em; margin:0 0 .45rem; }
  .payroll-guide p { color:#475569; font-size:1rem; margin:0; }
  .payroll-guide-note { color:#00695f !important; font-weight:800; margin-top:.75rem !important; }
  .payroll-guide-actions { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:1rem; }
  .payroll-guide-icon,.payroll-action-icon { align-items:center; background:linear-gradient(135deg,#99f6e4,#10b981); border-radius:18px; color:#052e2b; display:inline-flex; flex:0 0 auto; height:54px; justify-content:center; width:54px; }
  .payroll-stats { display:grid; gap:1rem; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .payroll-stat-card { background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:24px; box-shadow:0 18px 46px rgba(15,23,42,.07); padding:1.25rem; }
  .payroll-stat-card.is-highlighted { background:linear-gradient(135deg,#ecfeff,#fff); border-color:rgba(20,184,166,.35); }
  .payroll-stat-card span { color:#64748b; display:block; font-size:.78rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
  .payroll-stat-card strong { color:#0f172a; display:block; font-size:clamp(2rem,4vw,3.3rem); font-weight:900; line-height:1; margin:.55rem 0; }
  .payroll-stat-card small { color:#64748b; font-weight:700; }
  .payroll-actions-grid { display:grid; gap:1rem; grid-template-columns:repeat(2,minmax(0,1fr)); }
  .payroll-action-card { background:#fff; border:1px solid rgba(15,23,42,.08); border-radius:24px; box-shadow:0 18px 46px rgba(15,23,42,.07); color:#0f172a; display:flex; flex-direction:column; gap:.75rem; min-height:220px; padding:1.35rem; text-decoration:none; transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .payroll-action-card:hover { border-color:rgba(20,184,166,.45); box-shadow:0 24px 60px rgba(15,23,42,.12); color:#0f172a; transform:translateY(-2px); }
  .payroll-action-card strong { font-size:1.35rem; font-weight:900; }
  .payroll-action-card small { color:#64748b; font-size:.98rem; }
  .payroll-action-card em { color:#00695f; font-style:normal; font-weight:900; margin-top:auto; }
  @media (max-width:768px) { .payroll-hero,.payroll-guide { flex-direction:column; } .payroll-hero-actions,.payroll-hero-actions .btn { width:100%; } .payroll-stats,.payroll-actions-grid { grid-template-columns:1fr; } }
</style>

{% endblock %}
