{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="container-fluid py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Affiliate payout details</h1>
      <p class="text-muted mb-0">Review pending/approved commissions and record a manual payout with proof.</p>
    </div>
    <a href="{{ path('panel/planner-hub/management/commissions/pending') }}" class="btn btn-outline-secondary">Back to summary</a>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h2 class="h5 fw-bold mb-3">Affiliate information</h2>
          <div class="row g-3">
            <div class="col-md-4"><strong>{{ trans('ui.name') }}</strong><br>{{ affiliate.name }} {{ affiliate.lastname|default('') }}</div>
            <div class="col-md-4"><strong>{{ trans('ui.email') }}</strong><br>{{ affiliate.email }}</div>
            <div class="col-md-4"><strong>{{ trans('ui.phone') }}</strong><br>{{ affiliate.phone|default('Not provided') }}</div>
            <div class="col-md-4"><strong>{{ trans('ui.status') }}</strong><br>{{ affiliateProfile.application_status|default('PENDING') }}</div>
            <div class="col-md-4"><strong>Commission rate</strong><br>{{ affiliateProfile.commission_rate|default(30)|number_format(0) }}%</div>
            <div class="col-md-4"><strong>Payout method</strong><br>{{ affiliateProfile.payout_method|default('Not set') }}</div>
            <div class="col-md-4"><strong>PayPal</strong><br>{{ affiliateProfile.paypal_email|default('Not set') }}</div>
            <div class="col-md-4"><strong>Bank</strong><br>{{ affiliateProfile.bank_name|default('Not set') }}</div>
            <div class="col-md-4"><strong>Account</strong><br>{{ affiliateProfile.account_number_masked|default('Not set') }}</div>
            <div class="col-md-4"><strong>Routing</strong><br>{{ affiliateProfile.routing_number_masked|default('Not set') }}</div>
            <div class="col-md-4"><strong>Country</strong><br>{{ affiliateProfile.country|default('Not set') }}</div>
            <div class="col-md-4"><strong>Account type</strong><br>{{ affiliateProfile.account_type|default('Not set') }}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted">Total selected payout pool</div>
          <div class="display-6 fw-bold text-success">${{ totalAmount|number_format(2, '.', ',') }}</div>
          <p class="text-muted mb-0">Only pending or approved commissions can be included.</p>
        </div>
      </div>
    </div>
  </div>

  <form method="post" enctype="multipart/form-data">
    <input type="hidden" name="affiliate_id" value="{{ affiliateId }}">

    <section class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <h2 class="h5 fw-bold mb-3">Commissions included</h2>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th><input type="checkbox" id="select-all" checked></th>
                <th>Product</th>
                <th>Referred user</th>
                <th>Gross</th>
                <th>Rate</th>
                <th>Commission</th>
                <th>{{ trans('ui.status') }}</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              {% for commission in commissions %}
                <tr>
                  <td>
                    {% if commission.status in ['pending', 'approved', 'payable'] %}
                      <input type="checkbox" name="selected_ids[]" value="{{ commission.id }}" checked>
                    {% else %}
                      <input type="checkbox" disabled>
                    {% endif %}
                  </td>
                  <td>{{ commission.product_name|default(commission.transaction_type|replace({'_':' '})|title) }}</td>
                  <td>
                    <strong>{{ commission.referred_name }}</strong><br>
                    <small class="text-muted">{{ commission.referred_email }}</small>
                  </td>
                  <td>${{ commission.gross_amount|number_format(2, '.', ',') }}</td>
                  <td>{{ commission.commission_rate|number_format(0) }}%</td>
                  <td><strong class="text-success">${{ commission.commission_amount|number_format(2, '.', ',') }}</strong></td>
                  <td>
                    {% if commission.status == 'approved' %}
                      <span class="badge bg-info">Approved</span>
                    {% elseif commission.status == 'payable' %}
                      <span class="badge bg-success">Payable</span>
                    {% elseif commission.status == 'pending' %}
                      <span class="badge bg-warning text-dark">Pending</span>
                    {% else %}
                      <span class="badge bg-secondary">{{ commission.status|title }}</span>
                    {% endif %}
                  </td>
                  <td><small>{{ commission.created_at|date("M j, Y") }}</small></td>
                </tr>
              {% else %}
                <tr><td colspan="8" class="text-center text-muted py-4">No commissions found.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {% if commissions %}
      <section class="card border-0 shadow-sm">
        <div class="card-body">
          <h2 class="h5 fw-bold mb-3">Record manual payout</h2>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Method used</label>
              <select name="payout_method" class="form-select" required>
                {% for method in ['PAYPAL','ACH','OTHER','MANUAL'] %}
                  <option value="{{ method }}" {{ affiliateProfile.payout_method|default('') == method ? 'selected' : '' }}>{{ method }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Payment reference</label>
              <input name="payment_reference" class="form-control" placeholder="Transaction ID, memo or note">
            </div>
            <div class="col-md-4">
              <label class="form-label">Proof file</label>
              <input type="file" name="payment_proof_file" class="form-control" accept=".pdf,.jpg,.jpeg,.png">
            </div>
            <div class="col-md-6">
              <label class="form-label">Internal notes</label>
              <textarea name="internal_notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label">Affiliate note</label>
              <textarea name="external_notes" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-success btn-lg">Record payout and mark selected as paid</button>
            </div>
          </div>
        </div>
      </section>
    {% endif %}
  </form>
</main>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  const selectAll = document.getElementById('select-all');
  if (!selectAll) return;

  selectAll.addEventListener('change', function () {
    document.querySelectorAll('input[name="selected_ids[]"]:not([disabled])').forEach((checkbox) => {
      checkbox.checked = selectAll.checked;
    });
  });
});
</script>
{% endblock %}
