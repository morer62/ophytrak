{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

    <h1 class="h3 mb-4">
        <i data-feather="plus"></i> {{ trans('planner_hub.edit_service') }}
    </h1>

    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">
            <form method="POST">
                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.service_name') }}</label>
                    <input type="text" name="name" class="form-control" required value="{{ service.name }}" maxlength="50" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.description') }}</label>
                    <input type="text"  name="description" class="form-control"  maxlength="100" value="{{ service.description }}" required>
                </div>

                 <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.external_url') }}</label> <small> {{ trans('planner_hub.more_details_promotions') }}</small>
                    <input type="text"  name="description_url" class="form-control"  maxlength="200" value="{{ service.description_url }}" >
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ trans('planner_hub.variable_price') }}</label>
                    <div class="form-check">
                        <input type="checkbox" name="is_variable" id="is_variable" class="form-check-input" value="YES" {% if service.is_variable == 'YES' %}checked{% endif %}>
                        <label class="form-check-label" for="is_variable">
                            {{ trans('planner_hub.service_variable_pricing') }}
                        </label>
                    </div>
                </div>

                <div class="mb-3" id="price_field">
                    <label class="form-label">{{ trans('planner_hub.price_dollar') }}</label>
                    <input type="number" name="price" step="0.01" class="form-control" value="{{ service.price }}" required {% if service.is_variable == 'YES' %}readonly{% endif %}>
                    <small class="text-muted">{% if service.is_variable == 'YES' %}{{ trans('planner_hub.price_readonly_variable') }}{% else %}{{ trans('planner_hub.leave_zero_variable') }}{% endif %}</small>
                </div>

                <div>
                    <button class="btn btn-primary">💾 {{ trans('planner_hub.update_service') }}</button>
                    {{ macros.back_btn(title=trans('planner_hub.cancel')) }}
                </div>
            </form>
        </div>
    </section>

    <script>
        const translations = {
            price_readonly_variable: "{{ trans('planner_hub.price_readonly_variable') }}",
            leave_zero_variable: "{{ trans('planner_hub.leave_zero_variable') }}"
        };

        document.getElementById('is_variable').addEventListener('change', function() {
            const priceField = document.getElementById('price_field');
            const priceInput = priceField.querySelector('input[name="price"]');
            const helpText = priceField.querySelector('small');
            
            if (this.checked) {
                priceInput.value = '0.00';
                priceInput.readOnly = true;
                priceField.classList.add('text-muted');
                helpText.textContent = translations.price_readonly_variable;
            } else {
                priceInput.value = '';
                priceInput.readOnly = false;
                priceField.classList.remove('text-muted');
                helpText.textContent = translations.leave_zero_variable;
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const isVariableCheckbox = document.getElementById('is_variable');
            const priceField = document.getElementById('price_field');
            const priceInput = priceField.querySelector('input[name="price"]');
            
            if (isVariableCheckbox.checked) {
                priceInput.readOnly = true;
                priceField.classList.add('text-muted');
            }
        });
    </script>
{% endblock %}