{% extends "templates/base.admin.twig" %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
    <h1 class="h3 mb-4">{{ trans('planner_hub.storage_items') }}</h1>
    {{ macros.breadcrumb2() }}



    <section class="card">
        <div class="card-body">

            <a href="{{ path(current_location ~ '/create', { container: containerId }) }}" class="btn btn-primary mb-3">
                <i class="align-middle" data-feather="plus"></i> {{ trans('planner_hub.add_new_item') }}
            </a>

            <h1>{{ container.name }}</h1>
            
            {% if container.img_reference %}
                <p>
                    <a href="#" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#imgModal">
                        {{ trans('planner_hub.click_to_see_reference_image') }}
                    </a>
                </p>

                <!-- Modal -->
                <div class="modal fade" id="imgModal" tabindex="-1" aria-labelledby="imgModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="imgModalLabel">{{ trans('planner_hub.reference_image_title') }} - {{ container.name }}</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center">

                                <img src="{{ asset_for(container.img_reference) }}" alt="{{ trans('planner_hub.reference_image_title') }}" class="img-fluid">
 

                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <hr>

            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle" style="min-width: 500px;">
                    <thead>
                        <tr>
                            <th>{{ trans('planner_hub.name') }}</th>
                            <th>{{ trans('planner_hub.quantity') }}</th>
                            <th>{{ trans('planner_hub.containers') }}</th>
                            <th>{{ trans('planner_hub.edit') }}</th>
                            <th>{{ trans('planner_hub.delete') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ container.name }}</td>
                                <td>
                                    <a href="{{ path(current_location ~ '/edit', { container: containerId, item: item.id }) }}" class="btn btn-primary">{{ trans('planner_hub.edit') }}</a>
                                </td>
                                <td>
                                    {{ macros.delete_form(item.id) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted">{{ trans('planner_hub.no_items_found') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endblock %}

