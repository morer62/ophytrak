{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<style>
  .l4-management-hero {
    border-radius: 8px;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: #fff;
    background:
      radial-gradient(circle at 85% 10%, rgba(121, 242, 223, .18), transparent 34%),
      linear-gradient(135deg, #071513 0%, #102923 58%, #174c43 100%);
  }

  .l4-management-hero h1 {
    color: #fff;
    font-weight: 900;
    margin: .75rem 0 .5rem;
  }

  .l4-management-hero p {
    color: rgba(255, 255, 255, .78);
    margin: 0;
    max-width: 820px;
  }

  .l4-management-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .l4-management-card {
    min-height: 205px;
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    border: 1px solid #dbe7e4;
    padding: 1rem;
    background: #fff;
    box-shadow: 0 18px 44px rgba(15, 23, 42, .07);
  }

  .l4-management-card.is-active {
    color: #f7fffc;
    border-color: rgba(121, 242, 223, .35);
    background: linear-gradient(180deg, #0f2521 0%, #071513 100%);
  }

  .l4-management-card.is-locked {
    background: #f8fafc;
  }

  .l4-management-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    color: #06110f;
    background: linear-gradient(135deg, #79f2df, #50d88f);
    margin-bottom: 1rem;
  }

  .l4-management-card h2 {
    font-size: 1.08rem;
    font-weight: 900;
    color: inherit;
    margin: 0 0 .5rem;
  }

  .l4-management-card p {
    color: #64748b;
    line-height: 1.55;
  }

  .l4-management-card.is-active p {
    color: rgba(247, 255, 252, .72);
  }

  .l4-management-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 42px;
    margin-top: auto;
    border-radius: 8px;
    padding: .65rem .9rem;
    text-decoration: none;
    font-weight: 900;
  }

  .l4-management-action.is-active {
    color: #041411;
    background: #79f2df;
  }

  .l4-management-action.is-locked {
    color: #475569;
    background: #e2e8f0;
  }

  .l4-management-section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 0;
  }

  .l4-management-section-title h2 {
    font-size: 1.3rem;
    font-weight: 900;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .l4-management-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .l4-management-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<main class="mt-4 container">
  {{ macros.breadcrumb2() }}

  <section class="l4-management-hero">
    <span class="badge rounded-pill bg-light text-dark">{{ trans('level4_access_center.sidebar_approved_tools') }}</span>
    <h1>{{ trans('level4_access_center.management_title') }}</h1>
    <p>
      {{ teamContext.selectedInstitution.company_name|default(trans('level4_access_center.no_company')) }}
      · {{ trans('level4_access_center.role_label') }}:
      {{ teamContext.relationship.role_name|default(trans('level4_access_center.team_member')) }}
    </p>
  </section>

  <section>
    <div class="l4-management-section-title">
      <h2>{{ trans('level4_access_center.active_access') }}</h2>
      <a href="{{ path('panel/planner-hub') }}" class="btn btn-outline-secondary fw-bold">
        {{ trans('level4_access_center.sidebar_access_center') }}
      </a>
    </div>

    <div class="l4-management-grid">
      {% for item in accessCenter.activeManagementItems %}
          <article class="l4-management-card is-active">
            <span class="l4-management-icon"><i data-feather="{{ item.icon }}"></i></span>
            <h2>{{ trans(item.title_key) }}</h2>
            <p>{{ trans(item.summary_key) }}</p>
            <a class="l4-management-action is-active" href="{{ path(item.url) }}">
              {{ trans('level4_access_center.open_access') }}
              <i data-feather="arrow-right"></i>
            </a>
          </article>
      {% endfor %}

      {% if not accessCenter.activeManagementItems %}
        <article class="l4-management-card is-locked">
          <span class="l4-management-icon"><i data-feather="lock"></i></span>
          <h2>{{ trans('level4_access_center.locked_access') }}</h2>
          <p>{{ trans('level4_access_center.no_active_access') }}</p>
          <span class="l4-management-action is-locked">{{ trans('level4_access_center.admin_approval_required') }}</span>
        </article>
      {% endif %}
    </div>
  </section>

  <section>
    <div class="l4-management-section-title">
      <h2>{{ trans('level4_access_center.locked_access') }}</h2>
    </div>

    <div class="l4-management-grid">
      {% for item in accessCenter.lockedManagementItems %}
          <article class="l4-management-card is-locked">
            <span class="l4-management-icon"><i data-feather="{{ item.icon }}"></i></span>
            <h2>{{ trans(item.title_key) }}</h2>
            <p>{{ trans(item.reason_key) }}</p>
            <span class="l4-management-action is-locked">{{ trans('level4_access_center.admin_approval_required') }}</span>
          </article>
      {% endfor %}
    </div>
  </section>
</main>
{% endblock %}
