{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
<style>
    .nav-tabs .nav-link {
        border: none;
        border-bottom: 3px solid transparent;
        color: #6c757d;
        font-weight: 500;
        padding: 0.75rem 1.5rem;
        transition: all 0.3s ease;
    }
    
    .nav-tabs .nav-link:hover {
        border-color: #dee2e6;
        color: #495057;
    }
    
    .nav-tabs .nav-link.active {
        border-bottom-color: #0d6efd;
        color: #0d6efd;
        background-color: transparent;
    }
    
    .feather-sm {
        width: 16px;
        height: 16px;
    }
    
    .table-secondary {
        background-color: #f8f9fa !important;
    }
    
    .btn-archive-no-interested {
        background-color: #fff3cd;
        border-color: #ffc107;
        color: #856404;
    }
    
    .btn-archive-no-interested:hover {
        background-color: #ffeaa7;
        border-color: #ffb300;
        color: #6d5200;
    }
    
    .tab-content {
        padding-top: 1rem;
    }
</style>
{% endblock %}

{% block body %}
<h1 class="h3 mb-3">
    <i class="align-middle" data-feather="users"></i>
    {{ trans('planner_hub.crm_leads') }}
</h1>

{{ macros.breadcrumb2() }}

{% if session_message is defined and session_message %}
<div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
    <h6 class="alert-heading">{{ session_message.title ?? 'Error' }}</h6>
    <div style="white-space: pre-line;">{{ session_message.message }}</div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
{% endif %}

<div class="mb-3 d-flex flex-column flex-sm-row gap-2">
    <a href="{{ path('panel/planner-hub/management/crm/lead/create') }}" class="btn btn-primary w-100">
        <i class="align-middle" data-feather="plus"></i> {{ trans('planner_hub.add_new_lead') }}
    </a>
    <a href="?export=1&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&archived={{ filter_archived }}" class="btn btn-outline-success w-100">
        📤 {{ trans('planner_hub.export_leads') }}
    </a>
    <form method="post" enctype="multipart/form-data" class="d-inline w-100">
        <label class="btn btn-outline-primary mb-0 w-100">
            📥 {{ trans('planner_hub.import_csv') }}
            <input type="file" name="csv_file" accept=".csv" hidden onchange="this.form.submit()">
        </label>
    </form>
    <a href="?export_template=1" class="btn btn-outline-secondary d-none d-sm-inline-block w-100">
        🧾 {{ trans('planner_hub.download_template') }}
    </a>
</div>

<div class="alert alert-info mb-3">
    <h6 class="alert-heading">📋 {{ trans('planner_hub.csv_import_export_info') }}</h6>
    <p class="mb-2"><strong>{{ trans('planner_hub.csv_format_includes') }}</strong></p>
    <ul class="mb-0 small">
        <li><strong>{{ trans('planner_hub.required') }}:</strong> {{ trans('planner_hub.name') }}, {{ trans('planner_hub.email') }}, {{ trans('planner_hub.phone') }}, {{ trans('planner_hub.address') }}, {{ trans('planner_hub.status') }}, {{ trans('planner_hub.categories') }}</li>
        <li><strong>{{ trans('planner_hub.optional') }}:</strong> {{ trans('planner_hub.language') }}, {{ trans('planner_hub.comments') }}</li>
        <li><strong>{{ trans('planner_hub.language_options') }}:</strong> english, spanish, portuguese, french, other</li>
        <li><strong>{{ trans('planner_hub.comments') }}:</strong> {{ trans('planner_hub.comments_max') }}</li>
    </ul>
</div>

<div class="card">
    <div class="card-body">

         

        
        <!-- Sistema de Pestañas -->
        <ul class="nav nav-tabs mb-4" id="leadsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link {{ filter_archived == 'NO' ? 'active' : '' }}" 
                        id="active-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#active-leads" 
                        type="button" 
                        role="tab" 
                        aria-controls="active-leads" 
                        aria-selected="{{ filter_archived == 'NO' ? 'true' : 'false' }}">
                    <i data-feather="users" class="feather-sm me-1"></i>
                {{ trans('planner_hub.active_leads') }}
                <span class="badge bg-primary ms-1">{{ active_leads_count }}</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {{ filter_archived == 'YES' ? 'active' : '' }}" 
                        id="archived-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#archived-leads" 
                        type="button" 
                        role="tab" 
                        aria-controls="archived-leads" 
                        aria-selected="{{ filter_archived == 'YES' ? 'true' : 'false' }}">
                                     <i data-feather="archive" class="feather-sm me-1"></i>
                {{ trans('planner_hub.archived_leads') }}
                <span class="badge bg-secondary ms-1">{{ archived_leads_count }}</span>
                </button>
            </li>
        </ul>

        <!-- Contenido de las Pestañas -->
        <div class="tab-content" id="leadsTabsContent">
            <!-- Pestaña de Leads Activos -->
            <div class="tab-pane fade {{ filter_archived == 'NO' ? 'show active' : '' }}" 
                 id="active-leads" 
                 role="tabpanel" 
                 aria-labelledby="active-tab">
                
                <form method="get" class="row g-2 mb-4">
                    <input type="hidden" name="archived" value="NO">
                    <div class="col-md-3">
                        <input type="text" name="name" class="form-control" placeholder="{{ trans('planner_hub.search_by_name') }}" value="{{ filter_name }}">
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="email" class="form-control" placeholder="{{ trans('planner_hub.search_by_email') }}" value="{{ filter_email }}">
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="all">{{ trans('planner_hub.all_statuses') }}</option>
                            {% for status in statuses %}
                                <option value="{{ status.id }}" {{ filter_status == status.id ? 'selected' : '' }}>{{ status.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-dark w-100" type="submit">🔎 {{ trans('planner_hub.filter') }}</button>
                    </div>
                </form>
                
        <div class="text-end mb-3">
            <a href="?archived=NO" class="btn btn-outline-secondary btn-sm">{{ trans('planner_hub.clear_filters') }}</a>
        </div>

        <div class="mb-3" id="bulkActionsContainer" style="display: none;">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted" id="selectedCount">0 {{ trans('planner_hub.leads_selected') }}</span>
                <button type="button" class="btn btn-warning btn-sm" id="bulkArchiveBtn" onclick="bulkArchive()">
                    📁 {{ trans('planner_hub.archive_selected') }}
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearSelection()">
                    {{ trans('planner_hub.clear_selection') }}
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle" style="min-width: 992px;">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input type="checkbox" class="form-check-input" id="selectAll" onchange="toggleSelectAll()">
                        </th>
                        <th>{{ trans('planner_hub.name') }}</th>
                        <th>{{ trans('planner_hub.email') }}</th>
                        <th>{{ trans('planner_hub.status') }}</th>
                        <th>{{ trans('planner_hub.assigned_to') }}</th>
                        <th>{{ trans('planner_hub.language') }}</th>
                        <th>{{ trans('planner_hub.comments') }}</th>
                        <th>{{ trans('planner_hub.actions') }}</th>
                        <th>{{ trans('planner_hub.archive') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% if leads|length > 0 %}
                        {% for lead in leads %}
                            <tr>
                            <td style="width: 40px;">
                                <input type="checkbox" class="form-check-input lead-checkbox" value="{{ lead.id }}" onchange="updateSelection()">
                            </td>
                            <td  style="min-width: 200px;">{{ lead.name }}</td>
                            <td  style="min-width: 100px;">{{ lead.email }}</td>
                            <td  style="min-width: 200px;">
                                {% for status in statuses %}
                                    {% if status.id == lead.id_status %}
                                        {{ status.name }}
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td  style="min-width: 100px;">
                                {% if team_users|length > 0 %}
                                    <form method="post" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="action" value="assign_user">
                                        <input type="hidden" name="lead_id" value="{{ lead.id }}">
                                        <select name="user_id" class="form-select form-select-sm" style="min-width: 200px;" onchange="this.form.submit()">
                                            {% for member in team_users %}
                                                <option value="{{ member.id }}" {% if lead.id_user == member.id %}selected{% endif %}>
                                                    {{ member.name }} ({{ member.email }})
                                                </option>
                                            {% endfor %}
                                            <option value="{{ lead.id_owner }}" {% if lead.id_user == lead.id_owner %}selected{% endif %}>{{ trans('planner_hub.unassigned') }}</option>
                                        </select>
                                    </form>
                                {% else %}
                                    {% if lead.id_user == lead.id_owner %}
                                        <span class="badge bg-secondary">{{ trans('planner_hub.unassigned') }}</span>
                                    {% else %}
                                        <span class="badge bg-info">
                                            {% if users[lead.id_user] is defined %}
                                                {{ users[lead.id_user].name }}<br>
                                                {{ users[lead.id_user].email }}
                                            {% else %}
                                                {{ trans('planner_hub.user') }} #{{ lead.id_user }}
                                            {% endif %}
                                        </span>
                                    {% endif %}
                                {% endif %}
                            </td>

                            <td  style="min-width: 100px;">
                                {{ (lead.languaje ?? 'english')|capitalize }}
                                {% if lead.archived == 'YES' %}
                                    <span class="badge bg-dark ms-1">{{ trans('planner_hub.archived') }}</span>
                                {% endif %}
                            </td>
                            <td class="text-start" style="max-width: 260px;">
                                <div class="text-truncate" title="{{ lead.comments }}">{{ lead.comments }}</div>
                            </td>

                            <td>
                                <div class="btn-group">
                                    {% if session_level in [1, 2, 3] or session_user.id == lead.id_user %}
                                        <a href="{{ path('panel/planner-hub/management/crm/lead/edit?id=' ~ lead.id) }}" class="btn btn-sm btn-outline-warning" title="Edit">✏️</a>
                                        <a href="{{ path('panel/planner-hub/management/crm/lead/history?id=' ~ lead.id) }}" class="btn btn-sm btn-outline-secondary" title="History">📜</a>
                                        

                                        
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="{{ lead.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('{{ trans('planner_hub.are_you_sure') }}')" title="Delete">🗑️</button>
                                        </form>
                                    {% else %}
                                        <button type="button" onclick="alert('⚠️ {{ trans('planner_hub.must_unassign_before_changes') }}')" class="btn btn-sm btn-outline-warning">✏️</button>
                                        <button type="button" onclick="alert('⚠️ {{ trans('planner_hub.must_unassign_before_changes') }}')" class="btn btn-sm btn-outline-secondary">📜</button>
                                        <button type="button" onclick="alert('⚠️ {{ trans('planner_hub.must_unassign_before_changes') }}')" class="btn btn-sm btn-outline-danger">🗑️</button>
                                    {% endif %}
                                </div>
                            </td>

                            <td>
                                {% if lead.archived == 'YES' %}
                                    <span class="badge bg-secondary">YES</span>
                                {% else %}
                                    {% if session_level in [1,2,3] %}
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="action" value="archive_lead">
                                            <input type="hidden" name="id" value="{{ lead.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-dark" onclick="return confirm('{{ trans('planner_hub.archive') }} this lead?')" title="{{ trans('planner_hub.archive') }}">{{ trans('planner_hub.archive') }}</button>
                                        </form>
                                    {% else %}
                                        <button type="button" class="btn btn-sm btn-outline-dark" disabled title="{{ trans('planner_hub.archive') }}">{{ trans('planner_hub.archive') }}</button>
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-muted">{{ trans('planner_hub.no_active_leads_found') }}</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
                    {% if pagination.last_page > 1 %}
                        {% set startPage = current_page > 2 ? current_page - 2 : 1 %}
                        {% set endPage = pagination.last_page > current_page + 2 ? current_page + 2 : pagination.last_page %}
                        <nav class="crm-pagination mt-3" aria-label="CRM leads pagination">
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                                <small class="text-muted">
                                    {{ trans('planner_hub.showing')|default('Showing') }} {{ leads|length }} {{ trans('planner_hub.of')|default('of') }} {{ pagination.total }} {{ trans('planner_hub.leads') }}
                                </small>
                                <ul class="pagination mb-0 flex-wrap">
                                    <li class="page-item {{ current_page <= 1 ? 'disabled' : '' }}">
                                        <a class="page-link" href="?archived={{ filter_archived }}&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&page={{ current_page - 1 }}&per_page={{ per_page }}">{{ trans('planner_hub.previous')|default('Previous') }}</a>
                                    </li>
                                    {% for p in startPage..endPage %}
                                        <li class="page-item {{ p == current_page ? 'active' : '' }}">
                                            <a class="page-link" href="?archived={{ filter_archived }}&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&page={{ p }}&per_page={{ per_page }}">{{ p }}</a>
                                        </li>
                                    {% endfor %}
                                    <li class="page-item {{ current_page >= pagination.last_page ? 'disabled' : '' }}">
                                        <a class="page-link" href="?archived={{ filter_archived }}&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&page={{ current_page + 1 }}&per_page={{ per_page }}">{{ trans('planner_hub.next')|default('Next') }}</a>
                                    </li>
                                </ul>
                            </div>
                        </nav>
                    {% endif %}
        </div>
    </div>

    <!-- Pestaña de Leads Archivados -->
            <div class="tab-pane fade {{ filter_archived == 'YES' ? 'show active' : '' }}" 
                 id="archived-leads" 
                 role="tabpanel" 
                 aria-labelledby="archived-tab">
                
                <form method="get" class="row g-2 mb-4">
                    <input type="hidden" name="archived" value="YES">
                    <div class="col-md-3">
                        <input type="text" name="name" class="form-control" placeholder="{{ trans('planner_hub.search_by_name') }}" value="{{ filter_name }}">
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="email" class="form-control" placeholder="{{ trans('planner_hub.search_by_email') }}" value="{{ filter_email }}">
                    </div>
                    <div class="col-md-3">
                        <select name="status" class="form-select">
                            <option value="all">{{ trans('planner_hub.all_statuses') }}</option>
                            {% for status in statuses %}
                                <option value="{{ status.id }}" {{ filter_status == status.id ? 'selected' : '' }}>{{ status.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-dark w-100" type="submit">🔎 {{ trans('planner_hub.filter') }}</button>
                    </div>
                </form>
                
        <div class="text-end mb-3">
            <a href="?archived=YES" class="btn btn-outline-secondary btn-sm">{{ trans('planner_hub.clear_filters') }}</a>
        </div>

        <div class="mb-3" id="bulkActionsArchivedContainer" style="display: none;">
            <div class="d-flex align-items-center gap-2">
                        <span class="text-muted" id="selectedArchivedCount">0 {{ trans('planner_hub.leads_selected') }}</span>
                        <button type="button" class="btn btn-danger btn-sm" id="bulkDeleteBtn" onclick="bulkDelete()">
                            🗑️ {{ trans('planner_hub.delete_permanently') }}
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearArchivedSelection()">
                            {{ trans('planner_hub.clear_selection') }}
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle" style="min-width: 992px;">
                        <thead>
                            <tr>
                                <th style="width: 40px;">
                                    <input type="checkbox" class="form-check-input" id="selectAllArchived" onchange="toggleSelectAllArchived()">
                                </th>
                                <th>{{ trans('planner_hub.name') }}</th>
                                <th>{{ trans('planner_hub.email') }}</th>
                                <th>{{ trans('planner_hub.status') }}</th>
                                <th>{{ trans('planner_hub.assigned_to') }}</th>
                                <th>{{ trans('planner_hub.language') }}</th>
                                <th>{{ trans('planner_hub.comments') }}</th>
                                <th>{{ trans('planner_hub.actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                    {% if leads|length > 0 %}
                        {% for lead in leads %}
                            <tr class="table-secondary">
                                    <td style="width: 40px;">
                                        <input type="checkbox" class="form-check-input archived-lead-checkbox" value="{{ lead.id }}" onchange="updateArchivedSelection()">
                                    </td>
                                    <td style="min-width: 200px;">{{ lead.name }}</td>
                                    <td style="min-width: 100px;">{{ lead.email }}</td>
                                    <td style="min-width: 200px;">
                                        {% for status in statuses %}
                                            {% if status.id == lead.id_status %}
                                                {{ status.name }}
                                            {% endif %}
                                        {% endfor %}
                                    </td>
                                    <td style="min-width: 100px;">
                                        {% if lead.id_user == lead.id_owner %}
                                            <span class="badge bg-secondary">Unassigned</span>
                                        {% else %}
                                            <span class="badge bg-info">
                                                {{ users[lead.id_user].name }}<br>
                                                {{ users[lead.id_user].email }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="min-width: 100px;">
                                        {{ (lead.languaje ?? 'english')|capitalize }}
                                        <span class="badge bg-dark ms-1">Archived</span>
                                    </td>
                                    <td class="text-start" style="max-width: 260px;">
                                        <div class="text-truncate" title="{{ lead.comments }}">{{ lead.comments }}</div>
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            {% if session_level in [1, 2, 3] %}
                                                <form method="post" class="d-inline me-1">
                                                    <input type="hidden" name="action" value="unarchive_lead">
                                                    <input type="hidden" name="id" value="{{ lead.id }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('{{ trans('planner_hub.unarchive_lead') }}')" title="{{ trans('planner_hub.unarchive') }}">
                                                        <i data-feather="refresh-cw" class="feather-sm"></i> {{ trans('planner_hub.unarchive') }}
                                                    </button>
                                                </form>
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="action" value="delete_archived_lead">
                                                    <input type="hidden" name="id" value="{{ lead.id }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('⚠️ {{ trans('planner_hub.delete_archived_lead') }}')" title="{{ trans('planner_hub.delete_permanently') }}">
                                                        <i data-feather="trash-2" class="feather-sm"></i> {{ trans('planner_hub.delete_permanently') }}
                                                    </button>
                                                </form>
                                            {% else %}
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="{{ trans('planner_hub.no_actions') }}">{{ trans('planner_hub.no_actions') }}</button>
                                            {% endif %}
                                        </div>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-muted">{{ trans('planner_hub.no_archived_leads_found') }}</td>
                        </tr>
                    {% endif %}
                        </tbody>
                    </table>
                    {% if pagination.last_page > 1 %}
                        {% set startPage = current_page > 2 ? current_page - 2 : 1 %}
                        {% set endPage = pagination.last_page > current_page + 2 ? current_page + 2 : pagination.last_page %}
                        <nav class="crm-pagination mt-3" aria-label="CRM leads pagination">
                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                                <small class="text-muted">
                                    {{ trans('planner_hub.showing')|default('Showing') }} {{ leads|length }} {{ trans('planner_hub.of')|default('of') }} {{ pagination.total }} {{ trans('planner_hub.leads') }}
                                </small>
                                <ul class="pagination mb-0 flex-wrap">
                                    <li class="page-item {{ current_page <= 1 ? 'disabled' : '' }}">
                                        <a class="page-link" href="?archived={{ filter_archived }}&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&page={{ current_page - 1 }}&per_page={{ per_page }}">{{ trans('planner_hub.previous')|default('Previous') }}</a>
                                    </li>
                                    {% for p in startPage..endPage %}
                                        <li class="page-item {{ p == current_page ? 'active' : '' }}">
                                            <a class="page-link" href="?archived={{ filter_archived }}&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&page={{ p }}&per_page={{ per_page }}">{{ p }}</a>
                                        </li>
                                    {% endfor %}
                                    <li class="page-item {{ current_page >= pagination.last_page ? 'disabled' : '' }}">
                                        <a class="page-link" href="?archived={{ filter_archived }}&name={{ filter_name }}&email={{ filter_email }}&status={{ filter_status }}&page={{ current_page + 1 }}&per_page={{ per_page }}">{{ trans('planner_hub.next')|default('Next') }}</a>
                                    </li>
                                </ul>
                            </div>
                        </nav>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript para manejo de pestañas y selección múltiple -->
<script>
const translations = {
    leads_selected: "{{ trans('planner_hub.leads_selected') }}",
    archive_selected_leads: "{{ trans('planner_hub.archive_selected_leads') }}",
    selected_lead: "{{ trans('planner_hub.selected_lead') }}",
    delete_selected_archived: "{{ trans('planner_hub.delete_selected_archived') }}",
    selected_archived_lead: "{{ trans('planner_hub.selected_archived_lead') }}",
    are_you_sure: "{{ trans('planner_hub.are_you_sure') }}"
};

document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('[data-bs-toggle="tab"]');
    
    tabs.forEach(tab => {
        tab.addEventListener('click', function (event) {
            event.preventDefault();
            const target = event.target;
            const isArchived = target.id === 'archived-tab';
            
            const url = new URL(window.location);
            url.searchParams.set('archived', isArchived ? 'YES' : 'NO');
            window.location.href = url.toString();
        });
    });
});

// Funciones para leads activos
function toggleSelectAll() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.lead-checkbox');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = selectAll.checked;
    });
    
    updateSelection();
}

function updateSelection() {
    const checkboxes = document.querySelectorAll('.lead-checkbox:checked');
    const container = document.getElementById('bulkActionsContainer');
    const count = document.getElementById('selectedCount');
    
    count.textContent = checkboxes.length + ' ' + translations.leads_selected;
    container.style.display = checkboxes.length > 0 ? 'block' : 'none';
}

function clearSelection() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.lead-checkbox');
    
    selectAll.checked = false;
    checkboxes.forEach(checkbox => {
        checkbox.checked = false;
    });
    
    updateSelection();
}

function bulkArchive() {
    const checkboxes = document.querySelectorAll('.lead-checkbox:checked');
    if (checkboxes.length === 0) return;
    
    if (confirm(translations.archive_selected_leads + ' ' + checkboxes.length + ' ' + translations.selected_lead)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = window.location.href;
        
        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = 'bulk_archive';
        form.appendChild(actionInput);
        
        checkboxes.forEach(checkbox => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'lead_ids[]';
            input.value = checkbox.value;
            form.appendChild(input);
        });
        
        document.body.appendChild(form);
        form.submit();
    }
}

// Funciones para leads archivados
function toggleSelectAllArchived() {
    const selectAll = document.getElementById('selectAllArchived');
    const checkboxes = document.querySelectorAll('.archived-lead-checkbox');
    
    checkboxes.forEach(checkbox => {
        checkbox.checked = selectAll.checked;
    });
    
    updateArchivedSelection();
}

function updateArchivedSelection() {
    const checkboxes = document.querySelectorAll('.archived-lead-checkbox:checked');
    const container = document.getElementById('bulkActionsArchivedContainer');
    const count = document.getElementById('selectedArchivedCount');
    
    count.textContent = checkboxes.length + ' ' + translations.leads_selected;
    container.style.display = checkboxes.length > 0 ? 'block' : 'none';
}

function clearArchivedSelection() {
    const selectAll = document.getElementById('selectAllArchived');
    const checkboxes = document.querySelectorAll('.archived-lead-checkbox');
    
    selectAll.checked = false;
    checkboxes.forEach(checkbox => {
        checkbox.checked = false;
    });
    
    updateArchivedSelection();
}

function bulkDelete() {
    const checkboxes = document.querySelectorAll('.archived-lead-checkbox:checked');
    if (checkboxes.length === 0) return;
    
    if (confirm('⚠️ ' + translations.delete_selected_archived + ' ' + checkboxes.length + ' ' + translations.selected_archived_lead)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = window.location.href;
        
        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = 'bulk_delete_archived';
        form.appendChild(actionInput);
        
        checkboxes.forEach(checkbox => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'lead_ids[]';
            input.value = checkbox.value;
            form.appendChild(input);
        });
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
