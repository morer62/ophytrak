{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
    <main>
        <h1 class="h3 mb-3">
            {{ trans('planner_hub.create_category') }}
        </h1>

        {{ macros.breadcrumb2() }}

        <form method="post" class="card">
            <div class="card-body">

                <div class="mb-3">
                    <label for="name" class="form-label">{{ trans('planner_hub.category_name') }}</label>
                    <input type="text" class="form-control" name="name" id="name" placeholder="{{ trans('planner_hub.enter_category_name') }}" required>
                </div>

                <button type="submit" class="btn btn-primary">💾 {{ trans('planner_hub.save') }}</button>
                <a href="{{ path('panel/planner-hub/management/crm/categories/home') }}" class="btn btn-danger">
                    <i data-feather="arrow-left" ></i> {{ trans('planner_hub.cancel') }}
                </a>
            </div>
        </form>
    </main>
{% endblock %}
