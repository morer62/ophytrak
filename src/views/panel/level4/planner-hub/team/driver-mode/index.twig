function scannedPackageKind(decodedText) {
    try {
        const scannedUrl = new URL(decodedText, window.location.origin);
        if (scannedUrl.pathname.includes('/management/storage/') || scannedUrl.pathname.includes('/team/storage/')) {
            return 'storage';
        }
        return scannedUrl.searchParams.has('token') ? 'order' : 'unknown';
    } catch (error) {
        return 'token';
    }
}

function extractPackageToken(decodedText) {
    const value = String(decodedText || '').trim();
    // Labels generated by this screen contain the token itself, not a URL.
    // A relative URL accepts a bare token without throwing, losing it below.
    if (/^[a-zA-Z0-9_-]+$/.test(value)) return value;
    try {
        const scannedUrl = new URL(value, window.location.origin);
        return scannedUrl.searchParams.get('token') || '';
    } catch (error) {
        return '';
    }
}

function showPackageScanFeedback(message, type) {
    const feedback = document.getElementById('packageQrFeedback');
    feedback.textContent = message;
    feedback.className = 'alert mt-3 alert-' + type;
}

function captureLiveQrFrame() {
    const video=document.querySelector('#packageQrReader video');if(!video||!video.videoWidth)return Promise.resolve(null);
    const canvas=document.createElement('canvas');canvas.width=video.videoWidth;canvas.height=video.videoHeight;canvas.getContext('2d').drawImage(video,0,0);
    return new Promise(function(resolve){canvas.toBlob(resolve,'image/jpeg',0.88);});
}

function resumePackageScanner(){packageScanBusy=false;if(!packageScanner)return;if(packageScanner.getState&&packageScanner.getState()===3){try{packageScanner.resume();return;}catch(error){}}if(!packageScanner.isScanning)startPackageCamera();}

function startPackageCamera(){if(!packageScanner||packageScanner.isScanning)return Promise.resolve();return packageScanner.start({facingMode:'environment'},{fps:15,aspectRatio:1.333333,disableFlip:false,qrbox:function(width,height){const edge=Math.max(220,Math.floor(Math.min(width,height)*0.78));return{width:edge,height:edge};}},openAssignedPackageFromQr).catch(function(){showPackageScanFeedback({{ trans('store_logistics.camera_permission_required')|json_encode|raw }},'warning');});}

function packageScanPosition(){return new Promise(function(resolve){if(!navigator.geolocation){resolve(null);return;}navigator.geolocation.getCurrentPosition(resolve,function(){resolve(null);},{enableHighAccuracy:true,timeout:5000});});}
async function claimCarrierPackage(token,photo){
    if(document.getElementById('detailedCollection')){stageCollectionToken(token);bootstrap.Modal.getInstance(document.getElementById('packageScannerModal'))?.hide();return;}
    if(document.getElementById('agentChange')){stageAgentChangeToken(token);bootstrap.Modal.getInstance(document.getElementById('packageScannerModal'))?.hide();return;}
    showPackageScanFeedback('Paquete detectado. Registrando como recolectado…','info');
    const position=await packageScanPosition();
    const data=new FormData();data.append('action','carrier_qr_claim');data.append('qr_token',token);if(document.getElementById('physicalReception'))data.append('workflow_context','physical_reception');if(document.getElementById('departureManifest'))data.append('workflow_context','departure_manifest');if(photo)data.append('qr_photo',photo,'qr-pickup.jpg');if(position){data.append('latitude',position.coords.latitude);data.append('longitude',position.coords.longitude);}
    const response=await fetch(window.location.href,{method:'POST',body:data,credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}});
    const payload=await response.json();if(!response.ok||!payload.success)throw new Error(payload.message||'No fue posible registrar el paquete');
    showPackageScanFeedback(payload.message,'success');if(document.getElementById('physicalReception')){if(payload.custody_status!=='RECEIVED_AT_HUB')throw new Error('Este paquete no estaba pendiente de recepción física.');incrementReceptionCounter();bootstrap.Modal.getInstance(document.getElementById('packageScannerModal'))?.hide();return;}if(document.getElementById('departureManifest')){bootstrap.Modal.getInstance(document.getElementById('packageScannerModal'))?.hide();setTimeout(()=>window.location.reload(),300);return;}const next=new URL(window.location.href);next.searchParams.set('carrier_stage',payload.list_stage||'collected');next.searchParams.set('view',payload.custody_status==='PICKED_UP'?'collection':'deliveries');if(payload.custody_status==='OUT_FOR_DELIVERY'&&payload.package_id)next.searchParams.set('scanned_package',payload.package_id);else next.searchParams.delete('scanned_package');setTimeout(function(){window.location.href=next.toString();},250);
}

const collectionTokens=[];const collectionScanTimeFormatter=new Intl.DateTimeFormat('es-ES',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
function stageCollectionToken(token){token=String(token||'').trim();if(!token||collectionTokens.includes(token))return;if(token.length>4096||collectionTokens.length>=200)throw new Error('La etiqueta es demasiado larga o la colección llegó a 200 paquetes.');collectionTokens.push(token);document.getElementById('collectionCount').textContent=collectionTokens.length;document.getElementById('collectionListEmpty')?.remove();const item=document.createElement('li');item.className='list-group-item';item.dataset.collectionInput=token;const code=document.createElement('strong');let display=token;try{const label=JSON.parse(token);if(label.id)display=String(label.id);}catch(error){}code.textContent='Código QR: '+display;const scannedAt=document.createElement('div');scannedAt.className='small text-muted mt-1';scannedAt.textContent=collectionScanTimeFormatter.format(new Date())+' · São Paulo · pendiente de confirmar';item.append(code,scannedAt);document.getElementById('collectionList').appendChild(item);document.getElementById('collectionManualCode').value='';}
document.getElementById('recordCollectionCode')?.addEventListener('click',async function(){const input=document.getElementById('collectionManualCode'),value=input.value.trim(),type=document.getElementById('collectionReadType').value,feedback=document.getElementById('collectionFeedback');if(!value)return;this.disabled=true;try{const data=new FormData();data.append('action','collection_reference_resolve');data.append('reference_type',type);data.append('reference_value',value);const response=await fetch(window.location.href,{method:'POST',body:data,headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}});const payload=await response.json();if(!response.ok||!payload.success)throw new Error(payload.message||'No se encontró el paquete.');stageCollectionToken(payload.public_token);feedback.innerHTML='<div class="alert alert-success">'+payload.message+'</div>';}catch(error){feedback.innerHTML='<div class="alert alert-danger">'+error.message+'</div>';}finally{this.disabled=false;}});
const signatureCanvas=document.getElementById('collectionSignature');let signing=false;if(signatureCanvas){const ctx=signatureCanvas.getContext('2d');const clearSignature=document.getElementById('clearSignature');const point=e=>{const r=signatureCanvas.getBoundingClientRect(),p=e.touches?e.touches[0]:e;return{x:(p.clientX-r.left)*(signatureCanvas.width/r.width),y:(p.clientY-r.top)*(signatureCanvas.height/r.height)}};document.getElementById('openSignature').addEventListener('click',()=>{signatureCanvas.hidden=false;clearSignature.hidden=false;});clearSignature.addEventListener('click',()=>{ctx.clearRect(0,0,signatureCanvas.width,signatureCanvas.height);signing=false;});['mousedown','touchstart'].forEach(n=>signatureCanvas.addEventListener(n,e=>{signing=true;const p=point(e);ctx.beginPath();ctx.moveTo(p.x,p.y);e.preventDefault();}));['mousemove','touchmove'].forEach(n=>signatureCanvas.addEventListener(n,e=>{if(!signing)return;const p=point(e);ctx.lineTo(p.x,p.y);ctx.stroke();e.preventDefault();}));['mouseup','mouseleave','touchend'].forEach(n=>signatureCanvas.addEventListener(n,()=>signing=false));}
document.getElementById('confirmCollection')?.addEventListener('click',async function(){
    if(this.disabled)return;this.disabled=true;
    const feedback=document.getElementById('collectionFeedback');
    try{
        const data=new FormData();data.append('action','collection_batch_confirm');data.append('tokens',JSON.stringify(collectionTokens));data.append('handed_by',document.getElementById('collectionHandedBy').value);data.append('signature',signatureCanvas?.toDataURL('image/png')||'');
        const response=await fetch(window.location.href,{method:'POST',body:data,headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}});const payload=await response.json();
        feedback.replaceChildren();const summary=document.createElement('div');summary.className='alert alert-'+(payload.success?(payload.errors?.length?'warning':'success'):'danger');summary.textContent=payload.message||'No se pudo confirmar la colección.';feedback.appendChild(summary);
        for(const error of payload.error_details||[]){const detail=document.createElement('div');detail.className='alert alert-danger';detail.textContent=(error.reference?error.reference+': ':'')+error.message;feedback.appendChild(detail);}
        const confirmed=new Set((payload.packages||[]).map(item=>item.input));
        for(let i=collectionTokens.length-1;i>=0;i--)if(confirmed.has(collectionTokens[i]))collectionTokens.splice(i,1);
        document.querySelectorAll('[data-collection-input]').forEach(item=>{if(confirmed.has(item.dataset.collectionInput))item.remove();});document.getElementById('collectionCount').textContent=collectionTokens.length;
        // Preserve failed scans and signature for retry; never hide a partial failure by reloading.
        if(payload.success&&!payload.errors?.length)setTimeout(()=>window.location.reload(),700);
    }catch(error){feedback.replaceChildren();const message=document.createElement('div');message.className='alert alert-danger';message.textContent='No se pudo confirmar: '+error.message+'. La lista se conserva para reintentar.';feedback.appendChild(message);}
    finally{this.disabled=false;}
});
