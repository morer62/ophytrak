unction(){stage.value=!failure.value?'delivered':(failure.value==='CUSTOMER_ABSENT'?'customer_absent':(failure.value==='CUSTOMER_REJECTED'?'customer_rejected':'delivery_cancelled'));});notes.before(label,failure);});
