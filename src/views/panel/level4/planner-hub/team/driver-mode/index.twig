            const slot=Math.min(captured,canvases.length-1),canvas=canvases[slot],input=inputs[slot],sourceWidth=video.videoWidth||1280,sourceHeight=video.videoHeight||720,scale=Math.min(1,1280/sourceWidth,720/sourceHeight);
