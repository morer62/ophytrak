async function openAssignedPackageFromQr(decodedText,decodedResult,photoOverride) {
    if(packageScanBusy)return;
    const token = extractPackageToken(decodedText);
    // Carrier custody is validated by the server, not by seller DELIVERY rows.
    // Route collection/warehouse/manifest scans before looking up seller tasks.
    if (scannedPackageKind(decodedText) === 'storage') {
        showPackageScanFeedback({{ trans('store_logistics.qr_inventory_label')|json_encode|raw }}, 'warning');
        return;
    }
    // Collection reads native marketplace labels as well as internal secure tokens.
    // Do not send Mercado Livre JSON through seller DELIVERY assignment validation.
    if (isCarrierOrganization && document.getElementById('detailedCollection')) {
        packageScanBusy=true;
        try{if(packageScanner&&packageScanner.pause)packageScanner.pause(true);stageCollectionToken(token||String(decodedText||'').trim());bootstrap.Modal.getInstance(document.getElementById('packageScannerModal'))?.hide();}
        catch(error){showPackageScanFeedback(error.message,'danger');resumePackageScanner();}
        return;
    }
    if (isCarrierOrganization && String(decodedText||'').trim()) {
        packageScanBusy=true;try{if(packageScanner&&packageScanner.pause)packageScanner.pause(true);await claimCarrierPackage(token||String(decodedText).trim(),photoOverride||null);}catch(error){showPackageScanFeedback(error.message,'danger');resumePackageScanner();}
        return;
    }
    const row = Array.from(document.querySelectorAll('[data-public-token]')).find(function (candidate) {
        return candidate.dataset.publicToken && candidate.dataset.publicToken === token;
    });
    if (!row) {
        const assignment = assignedPackageTokens[token] || null;
        if (assignment) {
            showPackageScanFeedback({{ trans('store_logistics.qr_assignment_inactive')|json_encode|raw }}, 'warning');
        } else {
            showPackageScanFeedback({{ trans('store_logistics.qr_not_assigned')|json_encode|raw }}, 'danger');
        }
        return;
    }
    if (packageScanner && packageScanner.isScanning) packageScanner.stop().catch(function () {});
    const scannerModal = bootstrap.Modal.getInstance(document.getElementById('packageScannerModal'));
    const taskModal = document.getElementById('driverTaskModal' + row.dataset.taskId);
    if (!taskModal) return;
    const showAssignedTask = function () {
        bootstrap.Modal.getOrCreateInstance(taskModal).show();
    };
    if (scannerModal) {
        document.getElementById('packageScannerModal').addEventListener('hidden.bs.modal', showAssignedTask, { once: true });
        scannerModal.hide();
    } else {
        showAssignedTask();
    }
}

document.getElementById('packageScannerModal').addEventListener('shown.bs.modal', function () {
    if (!window.Html5Qrcode) {
        showPackageScanFeedback({{ trans('store_logistics.camera_unavailable')|json_encode|raw }}, 'warning');
        return;
    }
    packageScanner = packageScanner || new Html5Qrcode('packageQrReader',{formatsToSupport:[Html5QrcodeSupportedFormats.QR_CODE],verbose:false});
    startPackageCamera();
});

document.getElementById('packageScannerModal').addEventListener('hidden.bs.modal', function () {
    if (packageScanner && packageScanner.isScanning) packageScanner.stop().catch(function () {});
    packageScanBusy=false;
});

function driverPostLocation(taskId, position) {
    const data = new FormData();
    data.append('task_id', taskId);
    data.append('action', 'update_location');
    data.append('location_lat', position.coords.latitude);
    data.append('location_long', position.coords.longitude);
    data.append('location_accuracy', position.coords.accuracy || '');
    data.append('location_platform', 'web_mobile_driver_mode');
    data.append('location_source', 'browser_geolocation_watch');
    data.append('location_permission_status', 'granted');
    data.append('location_context', 'driver_mode_live');

    return fetch('{{ path('panel/planner-hub/team/my-work') }}', {
        method: 'POST',
        body: data,
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    }).catch(function () {});
}

function driverRefreshMap(position) {
    const frame = document.querySelector('.driver-map iframe');
    if (!frame || !position || !position.coords) return;
    frame.src = 'https://maps.google.com/maps?q='
        + encodeURIComponent(position.coords.latitude + ',' + position.coords.longitude)
        + '&z=14&output=embed';
}

function startDriverLiveTracking() {
    const activeCards = Array.from(document.querySelectorAll('[data-order-status="OUT_FOR_DELIVERY"][data-task-id]'));
    if (!activeCards.length || !navigator.geolocation) return;

    const lastSent = new Map();
    navigator.geolocation.watchPosition(function (position) {
        driverRefreshMap(position);
        activeCards.forEach(function (card) {
            const taskId = card.dataset.taskId;
            const now = Date.now();
            const previous = lastSent.get(taskId) || 0;
            if (now - previous < 45000) return;
            lastSent.set(taskId, now);
            driverPostLocation(taskId, position);
        });
    }, function () {}, { enableHighAccuracy: true, maximumAge: 30000, timeout: 15000 });
}

function startCarrierLiveTracking(){
    const packages=Array.from(document.querySelectorAll('[data-carrier-package-status="OUT_FOR_DELIVERY"]'));if(!packages.length||!navigator.geolocation)return;
    let lastSent=0;navigator.geolocation.watchPosition(function(position){const now=Date.now();if(now-lastSent<45000)return;lastSent=now;packages.forEach(function(card){const data=new FormData();data.append('action','carrier_location');data.append('package_id',card.dataset.carrierPackageId);data.append('latitude',position.coords.latitude);data.append('longitude',position.coords.longitude);data.append('accuracy',position.coords.accuracy||'');fetch(window.location.href,{method:'POST',body:data,credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'}}).catch(function(){});});},function(){},{enableHighAccuracy:true,maximumAge:30000,timeout:15000});
}

document.querySelectorAll('.driver-task-form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
        const submitter = event.submitter;
        if (form.dataset.submitting === '1') {
            event.preventDefault();
            return;
        }
        if (submitter && submitter.dataset.driverAction) {
            const actionInput = form.querySelector('[name="action"]');
            if (actionInput) actionInput.value = submitter.dataset.driverAction;
        }
        if (submitter && ['delivery_attempted', 'returned_to_business'].includes(submitter.dataset.driverAction || '')) {
            form.querySelector('[name="notes"]').value = form.querySelector('[data-occurrence-notes]')?.value || '';
        } else if (submitter && submitter.dataset.driverAction === 'delivered') {
            form.querySelector('[name="notes"]').value = form.querySelector('[data-delivery-notes]')?.value || '';
        }
        if (submitter && ['delivery_attempted', 'returned_to_business'].includes(submitter.dataset.driverAction)) {
            const notes = form.querySelector('[name="notes"]');
            const occurrenceRequired=submitter.dataset.driverAction==='delivery_attempted';
            const reason=form.querySelector('[name="occurrence_reason"]');
            const evidence=Array.from(form.querySelectorAll('[name="occurrence_photo_1"],[name="occurrence_photo_2"]'));
            if (!notes || !notes.value.trim() || (occurrenceRequired && (!reason?.value || evidence.some(function(input){return !input.files?.length;})))) {
                event.preventDefault();
                alert({{ trans('store_logistics.attempt_notes_required')|json_encode|raw }});
                return;
            }
        }
        if (form.dataset.locationReady === '1') {
            form.dataset.submitting = '1';
            form.querySelectorAll('button[type="submit"]').forEach(function (button) { button.disabled = true; });
            return;
        }
        event.preventDefault();
        if (!navigator.onLine) {
            alert({{ trans('store_logistics.connection_required')|json_encode|raw }});
            return;
        }
        if (!navigator.geolocation) {
            alert('{{ trans('store_logistics.location_required')|e('js') }}');
            return;
        }
        navigator.geolocation.getCurrentPosition(function (position) {
            form.querySelector('[name="location_lat"]').value = position.coords.latitude;
            form.querySelector('[name="location_long"]').value = position.coords.longitude;
            form.querySelector('[name="location_accuracy"]').value = position.coords.accuracy || '';
            form.querySelector('[name="location_permission_status"]').value = 'granted';
            form.dataset.locationReady = '1';
            form.requestSubmit(submitter || undefined);
        }, function () {
            form.querySelector('[name="location_permission_status"]').value = 'denied';
            alert('{{ trans('store_logistics.location_required')|e('js') }}');
        }, { enableHighAccuracy: true, timeout: 10000 });
    });
});
startDriverLiveTracking();
startCarrierLiveTracking();
document.querySelectorAll('.carrier-stage-form').forEach(function(form){const stage=form.querySelector('[name="carrier_stage"]'),receiver=form.querySelector('.carrier-receiver-fields');const syncReceiver=function(){const delivering=stage&&stage.value==='delivered';if(receiver)receiver.classList.toggle('d-none',!delivering);receiver?.querySelectorAll('[name="receiver_type"],[name="receiver_name"],[name="document_number"]').forEach(function(input){input.required=delivering;});};stage?.addEventListener('change',syncReceiver);syncReceiver();form.addEventListener('submit',function(event){if(form.dataset.locationReady==='1')return;event.preventDefault();if(!navigator.geolocation){form.dataset.locationReady='1';form.requestSubmit();return;}navigator.geolocation.getCurrentPosition(function(position){form.querySelector('[name="latitude"]').value=position.coords.latitude;form.querySelector('[name="longitude"]').value=position.coords.longitude;form.dataset.locationReady='1';form.requestSubmit();},function(){form.dataset.locationReady='1';form.requestSubmit();},{enableHighAccuracy:true,timeout:7000});});});

const occurrenceButtonLabel={{ trans('store_logistics.occurrence_button')|json_encode|raw }};
const occurrencePhotoButtonLabel={{ trans('store_logistics.occurrence_capture_button')|json_encode|raw }};
document.querySelectorAll('.carrier-stage-form').forEach(function(form){
    const stage=form.querySelector('[name="carrier_stage"]');
    if(!stage||stage.value!=='delivered'||form.classList.contains('carrier-occurrence-form'))return;
    const saveButton=form.querySelector('button.driver-action');
    const packageId=form.querySelector('[name="package_id"]')?.value;
    const occurrenceModal=document.getElementById('carrierOccurrence'+packageId);
    if(!saveButton||!occurrenceModal||form.querySelector('.driver-bottom-actions'))return;
    const actions=document.createElement('div');actions.className='driver-bottom-actions';
    saveButton.classList.add('delivered');saveButton.type='submit';
    const occurrenceButton=document.createElement('button');occurrenceButton.type='button';occurrenceButton.className='occurrence';occurrenceButton.textContent=occurrenceButtonLabel;occurrenceButton.setAttribute('data-bs-toggle','modal');occurrenceButton.setAttribute('data-bs-target','#'+occurrenceModal.id);
    saveButton.replaceWith(actions);actions.append(saveButton,occurrenceButton);
});
document.querySelectorAll('.carrier-occurrence-form').forEach(function(form){
    const inputs=[form.querySelector('[name="occurrence_photo_1"]'),form.querySelector('[name="occurrence_photo_2"]')];
    const trigger=form.querySelector('[data-occurrence-photo-capture]');
    const status=form.querySelector('[data-occurrence-photo-status]');
    const video=form.querySelector('.occurrence-camera-video'),canvas=form.querySelector('.occurrence-camera-canvas');let stream=null;
    const stopCamera=function(){stream?.getTracks().forEach(function(track){track.stop();});stream=null;video.hidden=true;};
    trigger?.addEventListener('click',async function(){
        if(!stream){try{if(!navigator.mediaDevices?.getUserMedia)throw new Error('camera-unavailable');stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'}},audio:false});video.srcObject=stream;video.hidden=false;status.textContent={{ trans('store_logistics.occurrence_camera_active')|json_encode|raw }};}catch(error){status.textContent={{ trans('store_logistics.occurrence_camera_required')|json_encode|raw }};}return;}
        const index=inputs.findIndex(function(input){return!input.files||!input.files.length;});if(index<0){stopCamera();return;}
        canvas.width=video.videoWidth||1280;canvas.height=video.videoHeight||720;canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height);
        canvas.toBlob(function(blob){if(!blob)return;const file=new File([blob],'occurrence-live-'+(index+1)+'.jpg',{type:'image/jpeg',lastModified:Date.now()});const transfer=new DataTransfer();transfer.items.add(file);inputs[index].files=transfer.files;const preview=form.querySelector('[data-occurrence-preview="'+(index+1)+'"]');preview.src=URL.createObjectURL(file);preview.style.display='block';const count=inputs.filter(function(item){return item.files&&item.files.length;}).length;status.textContent=count+'/2';if(count===2){form.querySelector('[name="evidence_captured_at"]').value=Math.floor(Date.now()/1000);status.textContent={{ trans('store_logistics.occurrence_camera_complete')|json_encode|raw }};stopCamera();}},'image/jpeg',0.9);
    });
    form.addEventListener('submit',function(event){if(inputs.some(function(input){return!input.files||!input.files.length;})){event.preventDefault();status.textContent={{ trans('store_logistics.occurrence_camera_required')|json_encode|raw }};}});
    form.closest('.modal')?.addEventListener('hidden.bs.modal',stopCamera);
});

document.querySelectorAll('[data-driver-tab]').forEach(function (tab) {
    tab.addEventListener('click', function () {
        document.querySelectorAll('[data-driver-tab]').forEach(function (item) { item.classList.toggle('active', item === tab); });
        document.querySelectorAll('[data-driver-task-tab]').forEach(function (row) { row.hidden = row.dataset.driverTaskTab !== tab.dataset.driverTab; });
    });
});
document.querySelectorAll('[data-driver-flow]').forEach(function (button) {
    button.addEventListener('click', function () {
        const form = button.closest('.driver-delivery-form'); if (!form) return;
        form.querySelectorAll('.driver-flow-panel').forEach(function (panel) { panel.classList.remove('active'); });
        form.querySelector('.driver-' + button.dataset.driverFlow + '-panel')?.classList.add('active');
        form.querySelector('.driver-bottom-actions').style.display = 'none';
    });
});
document.querySelectorAll('[data-driver-back]').forEach(function (button) {
    button.addEventListener('click', function () { const form=button.closest('form');form.querySelectorAll('.driver-flow-panel').forEach(function(panel){panel.classList.remove('active')});form.querySelector('.driver-bottom-actions').style.display='grid'; });
});
document.querySelectorAll('.driver-delivery-form [name="delivery_proof"],.driver-delivery-form [name="occurrence_photo_1"],.driver-delivery-form [name="occurrence_photo_2"]').forEach(function (input) {
    input.addEventListener('change', function () { const file=input.files&&input.files[0];const preview=input.parentElement?.querySelector('.driver-photo-preview')||input.closest('.driver-flow-panel')?.querySelector('.driver-photo-preview');if(!file||!preview)return;preview.src=URL.createObjectURL(file);preview.style.display='block'; });
});

document.querySelectorAll('[data-driver-modal-target]').forEach(function (button) {
    button.addEventListener('click', function () {
        const target = document.querySelector(button.dataset.driverModalTarget);
        if (!target) return;
        if (window.bootstrap && window.bootstrap.Modal) {
            window.bootstrap.Modal.getOrCreateInstance(target).show();
            return;
        }
        target.classList.add('show');
        target.style.display = 'block';
        target.removeAttribute('aria-hidden');
        target.setAttribute('aria-modal', 'true');
        document.body.classList.add('modal-open');
    });
});

document.querySelectorAll('.driver-modal [data-bs-dismiss="modal"], .driver-modal .btn-close').forEach(function (button) {
    button.addEventListener('click', function () {
        const modal = button.closest('.driver-modal');
        if (!modal || (window.bootstrap && window.bootstrap.Modal)) return;
        modal.classList.remove('show');
        modal.style.display = 'none';
        modal.setAttribute('aria-hidden', 'true');
        modal.removeAttribute('aria-modal');
        document.body.classList.remove('modal-open');
    });
});
</script>
