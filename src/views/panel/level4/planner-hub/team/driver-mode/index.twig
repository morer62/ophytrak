document.querySelectorAll('.delivery-live-camera').forEach(function(camera){
    const form=camera.closest('form'),video=camera.querySelector('video'),canvases=Array.from(camera.querySelectorAll('canvas')),inputs=Array.from(camera.querySelectorAll('input[type="file"]')),button=camera.querySelector('.delivery-camera-capture'),status=camera.querySelector('.delivery-camera-status');
    let stream=null,captured=0;
    const message=function(key,params){let value=key;Object.entries(params||{}).forEach(function(entry){value=value.replace(':'+entry[0],String(entry[1]));});return value;};
    button.addEventListener('click',async function(){
        try{
            if(!stream){
                stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'},width:{ideal:1280},height:{ideal:720}},audio:false});video.srcObject=stream;video.hidden=false;
