{% extends 'templates/base.admin.twig' %}

{% block body %}
<style>
.driver-page{--driver-green:#0f8f74;--driver-ink:#13201c;--driver-muted:#667085;--driver-line:#d9e4df;background:#f4f7f6;color:var(--driver-ink);margin:-1.5rem;padding:1.25rem;min-height:calc(100vh - 70px)}
.driver-page svg{display:inline-block;height:18px;vertical-align:-3px;width:18px}
.driver-toolbar{align-items:center;display:flex;gap:12px;justify-content:space-between;margin:0 auto 16px;max-width:1180px}
.driver-toolbar h1{font-size:1.55rem;font-weight:850;letter-spacing:0;margin:0}
.driver-toolbar p{color:var(--driver-muted);font-size:.95rem;margin:.2rem 0 0}
.driver-toolbar-actions{display:flex;gap:8px}
.driver-shell{background:#fff;border:1px solid var(--driver-line);border-radius:18px;box-shadow:0 18px 46px rgba(15,23,42,.08);margin:0 auto;max-width:1180px;overflow:hidden}
.driver-topbar{align-items:center;background:#10231f;color:#fff;display:flex;gap:14px;justify-content:space-between;padding:18px 20px}
.driver-brand{align-items:center;display:flex;font-size:1.15rem;font-weight:900;gap:10px;letter-spacing:0}
.driver-pill{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.16);border-radius:999px;font-size:.85rem;font-weight:800;padding:7px 12px;white-space:nowrap}
.driver-tabs{background:#f8fbfa;border-bottom:1px solid var(--driver-line);display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
.driver-tab{align-items:center;color:#5c6b66;display:flex;font-size:.88rem;font-weight:800;gap:8px;justify-content:center;min-height:54px;padding:10px}
.driver-tab.active{box-shadow:inset 0 -3px 0 var(--driver-green);color:var(--driver-green)}
.driver-map{background:#dfeee9;min-height:280px;position:relative}
.driver-map iframe{border:0;display:block;filter:saturate(.9);height:320px;width:100%}
.driver-map-empty{align-items:center;background:linear-gradient(135deg,#e8f3ef,#d5e8e3);display:flex;justify-content:center;min-height:280px;padding:24px;text-align:center}
.driver-map-label{align-items:center;background:#10231f;border-radius:10px;color:#fff;display:flex;font-size:.82rem;font-weight:900;gap:8px;left:16px;padding:10px 12px;position:absolute;top:16px;z-index:2}
.driver-content{padding:20px}
.driver-summary{display:grid;gap:12px;grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:20px}
.driver-summary-card{background:#f8fbfa;border:1px solid var(--driver-line);border-radius:12px;padding:14px}
.driver-summary-card span{color:var(--driver-muted);display:block;font-size:.72rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}
.driver-summary-card strong{display:block;font-size:1.45rem;margin-top:4px}
.driver-list-title{align-items:flex-end;display:flex;justify-content:space-between;margin-bottom:12px}
.driver-list-title h2{font-size:1.2rem;font-weight:900;margin:0}
.driver-list-title p{color:var(--driver-muted);margin:0}
.driver-table-wrap{border:1px solid var(--driver-line);border-radius:14px;overflow:hidden}
.driver-table{background:#fff;margin:0;width:100%}
.driver-table th{background:#f8fbfa;color:#5f6f69;font-size:.72rem;font-weight:900;letter-spacing:.04em;padding:12px;text-transform:uppercase;white-space:nowrap}
.driver-table td{border-top:1px solid #edf2f0;padding:12px;vertical-align:middle}
.driver-table tr:first-child td{border-top:0}
.driver-table-order{font-weight:900}
.driver-table-customer{color:var(--driver-muted);font-size:.84rem}
.driver-table-address{font-size:.9rem;font-weight:750;line-height:1.35;max-width:360px}
.driver-detail-btn{align-items:center;background:#fff;border:1px solid var(--driver-green);border-radius:10px;color:var(--driver-green);display:inline-flex;font-size:.84rem;font-weight:900;gap:6px;justify-content:center;min-height:36px;padding:7px 10px;text-decoration:none;white-space:nowrap}
.driver-detail-btn:hover{background:#effbf7;color:var(--driver-green);text-decoration:none}
.driver-card{background:#fff;border:1px solid var(--driver-line);border-radius:14px;margin-bottom:12px;padding:16px}
.driver-card-header{align-items:flex-start;display:flex;gap:12px;justify-content:space-between;margin-bottom:14px}
.driver-card-title{align-items:flex-start;display:flex;gap:12px;min-width:0}
.driver-number{align-items:center;background:#e8fbf4;border:1px solid #b8ebd8;border-radius:12px;color:var(--driver-green);display:flex;flex:0 0 44px;font-weight:900;height:44px;justify-content:center}
.driver-shop{color:var(--driver-green);display:block;font-size:.72rem;font-weight:900;letter-spacing:.05em;text-transform:uppercase}
.driver-status{background:#ecfdf5;border:1px solid #bbf7d0;border-radius:999px;color:#047857;font-size:.72rem;font-weight:900;padding:6px 10px;text-transform:uppercase;white-space:nowrap}
.driver-card-body{display:grid;gap:14px;grid-template-columns:minmax(0,1fr) 260px}
.driver-address-label{color:var(--driver-muted);font-size:.78rem;font-weight:800;text-transform:uppercase}
.driver-address{font-size:1rem;font-weight:850;line-height:1.35}
.driver-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
.driver-links a{color:var(--driver-green);font-size:.85rem;font-weight:800;text-decoration:none}
.driver-actions{display:flex;flex-direction:column;gap:9px}
.driver-action{align-items:center;background:var(--driver-green);border:1px solid var(--driver-green);border-radius:10px;color:#fff;display:inline-flex;font-weight:900;gap:8px;justify-content:center;min-height:42px;padding:9px 12px;text-decoration:none;width:100%}
.driver-action.secondary{background:#fff;color:var(--driver-green)}
.driver-action.danger{border-color:#dc2626;color:#dc2626}
.driver-action:hover{filter:brightness(.96);text-decoration:none}
.driver-proof-input{font-size:.86rem}
.driver-proof-hint{color:var(--driver-muted);font-size:.78rem;line-height:1.35}
.driver-fab{display:none}
.driver-modal .modal-content{border:0;border-radius:16px;overflow:hidden}
.driver-modal.show{background:rgba(15,23,42,.5);display:block}
.driver-modal .modal-header{background:#10231f;color:#fff}
.driver-modal .modal-title{font-weight:900}
.driver-modal .btn-close{filter:invert(1)}
.driver-modal-section{border:1px solid var(--driver-line);border-radius:12px;margin-bottom:12px;padding:12px}
.driver-modal-label{color:var(--driver-muted);font-size:.74rem;font-weight:900;text-transform:uppercase}
.driver-tabs button{background:transparent;border:0}.driver-package-code{color:#63716d;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.82rem;font-weight:800}.driver-contact-actions{display:flex;gap:8px;margin-top:10px}.driver-icon-action{align-items:center;background:#eef6f3;border:0;border-radius:50%;color:var(--driver-green);display:inline-flex;height:38px;justify-content:center;width:38px}.driver-proof-panel,.driver-occurrence-panel{display:none}.driver-flow-panel.active{display:block}.driver-proof-choice{display:grid;gap:10px;grid-template-columns:1fr 1fr}.driver-proof-choice label{border:1px solid var(--driver-line);border-radius:10px;padding:10px;text-align:center}.driver-photo-preview{border:1px dashed #9eb8b0;border-radius:12px;display:none;margin-bottom:10px;max-height:180px;object-fit:cover;width:100%}.driver-bottom-actions{display:grid;grid-template-columns:1fr 1fr;margin:-1rem -1rem 0}.driver-bottom-actions button{border-radius:0;min-height:54px}.driver-bottom-actions .occurrence{background:#fff;border:1px solid #e06434;color:#c84d1e}.driver-bottom-actions .delivered{background:#e35420;border:1px solid #e35420;color:#fff}.driver-back{background:none;border:0;color:#52645e;font-weight:800;padding:0 0 14px}
.driver-delivery-tabs{grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width: 767px){
  .driver-page{margin:-1.5rem -1.5rem 0;padding:14px 12px}
  .driver-toolbar{align-items:flex-start;flex-direction:column}
  .driver-toolbar h1{font-size:1.35rem}
  .driver-toolbar-actions{width:100%}
  .driver-toolbar-actions .btn{flex:1}
  .driver-shell{border-radius:14px}
  .driver-topbar{padding:15px}
  .driver-brand{font-size:1rem}
  .driver-tabs{grid-template-columns:repeat(2,1fr)}
  .driver-tab{font-size:.78rem;gap:5px;min-height:50px}
  .driver-map iframe,.driver-map-empty{height:230px;min-height:230px}
  .driver-content{padding:14px}
  .driver-summary{grid-template-columns:1fr 1fr 1fr}
  .driver-summary-card{padding:10px}
  .driver-summary-card span{font-size:.62rem}
  .driver-summary-card strong{font-size:1.18rem}
  .driver-list-title{align-items:flex-start;flex-direction:column;gap:2px}
  .driver-table-wrap{border-radius:12px}
  .driver-table thead{display:none}
  .driver-table,.driver-table tbody,.driver-table tr,.driver-table td{display:block;width:100%}
  .driver-table tr{border-top:1px solid var(--driver-line);padding:10px}
  .driver-table tr:first-child{border-top:0}
  .driver-table td{border:0;padding:4px 0}
  .driver-table td.driver-mobile-inline{align-items:center;display:flex;justify-content:space-between;gap:10px}
  .driver-table-address{max-width:none}
  .driver-card{padding:14px}
  .driver-card-header{gap:10px}
  .driver-card-title{gap:10px}
  .driver-number{flex-basis:38px;height:38px}
  .driver-status{font-size:.64rem;max-width:45%;overflow:hidden;text-overflow:ellipsis}
  .driver-card-body{grid-template-columns:1fr}
  .driver-map{display:none}.driver-summary{display:none}.driver-list-title{margin-top:2px}.driver-table-wrap{border:0;overflow:visible}.driver-table tr{background:#fff;border:0;border-radius:14px;box-shadow:0 5px 18px rgba(20,45,38,.08);margin-bottom:12px;padding:14px}.driver-table td:first-child{display:none}.driver-table td:last-child{padding-top:10px}.driver-detail-btn{width:100%}.driver-fab{align-items:center;background:#e85a1f;border-radius:50%;bottom:24px;box-shadow:0 8px 22px rgba(190,70,24,.4);color:#fff;display:flex;height:58px;justify-content:center;position:fixed;right:22px;width:58px;z-index:1040}.driver-fab svg{height:25px;width:25px}.driver-modal .modal-dialog{align-items:stretch;height:100%;margin:0;max-width:none;min-height:100%;width:100%}.driver-modal .modal-content{border-radius:0;min-height:100vh}.driver-modal .modal-header{background:#fff;color:#17231f}.driver-modal .btn-close{filter:none}.driver-modal .modal-body{padding:18px 16px}.driver-modal-section{border:0;border-bottom:1px solid #e7eeeb;border-radius:0;padding:12px 0}.driver-bottom-actions{bottom:0;position:sticky}.driver-toolbar-actions .desktop-package-scanner{display:none}
}
</style>
<div class="driver-page">
    <div class="driver-toolbar">
        <div>
            <h1>{{ trans('store_logistics.driver_mode') }}</h1>
            <p>{{ trans('store_logistics.driver_mode_subtitle') }}</p>
        </div>
        <div class="driver-toolbar-actions">
            <button type="button" class="btn btn-success desktop-package-scanner" data-bs-toggle="modal" data-bs-target="#packageScannerModal"><i data-feather="camera"></i> {{ trans('store_logistics.scan_package_qr') }}</button>
            <a href="{{ path('panel/planner-hub/team/my-work') }}" class="btn btn-outline-secondary">{{ trans('store_logistics.my_work') }}</a>
            <a href="{{ path('panel/planner-hub/team/chat') }}" class="btn btn-outline-success">{{ trans('store_logistics.team_chat') }}</a>
        </div>
    </div>

    <section class="driver-shell">
        <header class="driver-topbar">
            <div class="d-flex align-items-center gap-3">
                <div class="driver-brand"><i data-feather="navigation"></i>{{ trans('store_logistics.route_board') }}</div>
            </div>
            <div class="driver-pill"><i data-feather="user" class="me-1"></i>{{ deliveryTasks|length }} {{ trans('store_logistics.open') }}</div>
        </header>

        {% if isCarrierOrganization %}
        <section class="p-3 p-md-4 bg-white border-bottom">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-3"><div><span class="badge bg-warning text-dark mb-2">{{ isCarrierOwner?'CENTRAL DE LA TRANSPORTADORA':'OPERACIÓN DEL REPARTIDOR' }}</span><h2 class="h5 fw-bold mb-1">{{ isCarrierOwner?'Control de todos los paquetes':'Mis paquetes y mi ruta' }}</h2><p class="text-muted mb-0">{{ isCarrierOwner?'Consulta toda la custodia, responsables, incidencias y devoluciones de la empresa.':'Aquí sólo aparecen los paquetes asignados a tu usuario. Escanea para avanzar cada movimiento físico.' }}</p></div><button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#packageScannerModal"><i data-feather="maximize"></i> {{ trans('store_logistics.scan_pickup_qr') }}</button></div>
            {% if not isCarrierOwner and carrierView=='deliveries' %}
            <section id="driverDeliveryDashboard">
              <div class="d-flex justify-content-between align-items-center gap-2 mb-3"><div><h3 class="h4 mb-1">Lista de entregas</h3><p class="text-muted mb-0">{{ carrierRoutePackages|length }} paquetes pendientes</p></div><a class="btn btn-outline-success" href="{{ path('panel/planner-hub/team/driver-mode?view=collection') }}">Ir a Coletas</a></div>
              <div class="driver-tabs driver-delivery-tabs mb-4" role="tablist"><button class="driver-tab active" data-delivery-result-tab="open">Abiertas ({{ carrierRoutePackages|length }})</button><button class="driver-tab" data-delivery-result-tab="completed">Concluidas ({{ carrierDeliveredPackages|length }})</button><button class="driver-tab" data-delivery-result-tab="attempts">Intentos ({{ carrierAttemptPackages|length }})</button><button class="driver-tab text-danger" data-delivery-result-tab="returns">Devolución ({{ carrierPendingReturnPackages|length }})</button></div>
              {% set deliveryResultGroups={open:carrierRoutePackages,completed:carrierDeliveredPackages,attempts:carrierAttemptPackages,returns:carrierPendingReturnPackages} %}{% for key,packages in deliveryResultGroups %}<div class="row g-3" data-delivery-result-panel="{{ key }}" {{ key!='open'?'hidden':'' }}>{% for package in packages %}<div class="col-12"><article class="driver-card mb-0"><div class="d-flex gap-3"><span class="driver-number">{{ loop.index }}</span><div class="flex-grow-1"><div class="d-flex justify-content-between gap-2"><strong>{{ package.guest_name ?: package.guest_email }}</strong><span class="driver-status">{{ package.custody_status|replace({'_':' '}) }}</span></div><div class="driver-package-code mt-1">{{ package.package_code }}</div>{% if package.guest_phone %}<a class="small" href="tel:{{ package.guest_phone }}"><i data-feather="phone"></i> {{ package.guest_phone }}</a>{% endif %}<div class="driver-address mt-2"><i data-feather="map-pin"></i> {{ package.shipping_address_1 }}{% if package.shipping_address_2 %}, {{ package.shipping_address_2 }}{% endif %}, {{ package.shipping_city }} - {{ package.shipping_state }}, {{ package.shipping_zip }}</div>{% if key=='open' %}<button class="driver-detail-btn mt-3" data-bs-toggle="modal" data-bs-target="#deliveryPackage{{ package.id }}">Abrir entrega</button>{% endif %}</div></div></article></div>{% else %}<div class="col-12"><div class="text-center text-muted py-5"><h4>No tienes paquetes en esta sección</h4><p class="mb-0">Consulta las demás pestañas para revisar tu jornada.</p></div></div>{% endfor %}</div>{% endfor %}
              {% for package in carrierRoutePackages %}<div class="modal fade driver-modal" id="deliveryPackage{{ package.id }}" tabindex="-1" data-scanned-carrier-package="{{ package.id }}"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><small class="text-muted">Orden #{{ package.id_store_order }}</small><h3 class="modal-title fs-5">{{ package.package_code }}</h3></div><button class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" enctype="multipart/form-data" class="modal-body carrier-stage-form"><input type="hidden" name="action" value="carrier_advance"><input type="hidden" name="package_id" value="{{ package.id }}"><input type="hidden" name="latitude"><input type="hidden" name="longitude"><div class="border rounded-3 p-3 mb-3 bg-light"><strong>{{ package.guest_name ?: package.guest_email }}</strong>{% if package.guest_email %}<div class="small text-muted">{{ package.guest_email }}</div>{% endif %}{% if package.guest_phone %}<div><a href="tel:{{ package.guest_phone }}"><i data-feather="phone"></i> {{ package.guest_phone }}</a></div>{% endif %}<div class="mt-2"><i data-feather="map-pin"></i> {{ package.shipping_address_1 }}{% if package.shipping_address_2 %}, {{ package.shipping_address_2 }}{% endif %}, {{ package.shipping_city }} - {{ package.shipping_state }}, {{ package.shipping_zip }}</div></div><label class="form-label fw-bold">Resultado de la visita</label><select class="form-select mb-3" name="carrier_stage" required><option value="delivered">Entrega concluida</option><option value="customer_absent">Cliente ausente</option><option value="customer_rejected">Cliente rechazó el paquete</option><option value="delivery_cancelled">Cliente canceló el pedido</option></select><label class="form-label">Foto de evidencia *</label><input type="file" class="form-control mb-3" name="evidence_photo" accept="image/jpeg,image/png,image/webp" capture="environment" required><div class="carrier-receiver-fields"><input class="form-control mb-2" name="receiver_name" placeholder="Nombre de quien recibe"><div class="row g-2"><div class="col-6"><select class="form-select" name="document_type"><option value="ID">ID / RG</option><option value="TAX_ID">CPF</option></select></div><div class="col-6"><input class="form-control" name="document_number" placeholder="Documento"></div></div><input type="hidden" name="receiver_type" value="RECIPIENT"></div><textarea class="form-control my-3" name="notes" rows="3" placeholder="Observaciones"></textarea><button class="driver-action">Guardar resultado</button></form></div></div></div>{% endfor %}
            </section>
            {% else %}
            {% if not isCarrierOwner %}<section class="card border-0 shadow-sm text-center mb-4" id="carrierCollectionSummary"><div class="card-body p-4"><span class="badge bg-success-subtle text-success mb-2">COLETAS</span><h3 class="h4">Recepción de paquetes</h3><p class="text-muted">Escanea cada paquete que recibes del almacén del cliente.</p><button class="btn btn-info btn-lg w-100 mb-4" data-bs-toggle="modal" data-bs-target="#packageScannerModal"><i data-feather="maximize"></i> ESCANEAR</button><div class="rounded-4 bg-success text-white p-4 mb-3"><div class="display-4 fw-bold">{{ collectedTodayCount }}</div><div>Paquetes recolectados hoy por ti</div></div><button type="button" class="btn btn-outline-success w-100" id="showCarrierOperations">Ver más</button></div></section>{% endif %}
            {% if not isCarrierOwner and showCarrierDetails and carrierStage=='collected' %}<section class="card border-0 shadow-sm mb-4" id="detailedCollection"><div class="card-body p-4"><div class="text-center mb-4"><strong>{{ user.name }} {{ user.lastname }}</strong><div class="text-muted">Código {{ user.id }}</div><h2 class="h4 mt-3">Coletas</h2></div><label class="form-label">Tipo de lectura</label><select class="form-select mb-3" id="collectionReadType"><option value="remittance">Código (remesas)</option><option value="order">N.º pedido</option><option value="barcode">Código de barras</option></select><button class="btn btn-info btn-lg w-100 mb-3" data-bs-toggle="modal" data-bs-target="#packageScannerModal">ESCANEAR PAQUETE COLETADO</button><div class="input-group mb-3"><input class="form-control" id="collectionManualCode" placeholder="Código QR o código de barras"><button class="btn btn-success" type="button" id="recordCollectionCode">GRABAR</button></div><div class="d-flex justify-content-between align-items-center mb-3"><strong>Paquetes leídos: <span id="collectionCount">0</span></strong><button class="btn btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#collectionList">VER MÁS</button></div><ol class="collapse list-group list-group-numbered mb-3" id="collectionList"></ol><input class="form-control mb-3" id="collectionHandedBy" placeholder="Nombre de quien entrega los paquetes"><button class="btn btn-info w-100 mb-2" type="button" id="openSignature">FIRMAR</button><canvas id="collectionSignature" class="border rounded w-100 mb-3" height="160" hidden></canvas><button class="btn btn-success btn-lg w-100" type="button" id="confirmCollection">CONFIRMAR PAQUETES</button><div id="collectionFeedback" class="mt-3"></div></div></section>{% endif %}
            {% if not isCarrierOwner and showCarrierDetails and carrierStage=='history' %}<section class="card border-0 shadow-sm mb-4" id="collectionHistory"><div class="card-body p-4"><div class="text-center mb-4"><strong>{{ user.name }} {{ user.lastname }}</strong><div class="text-muted">Código {{ user.id }}</div><h2 class="h4 mt-3">Historial de recolección de coletas</h2></div><form method="get" class="row g-3 align-items-end mb-4"><input type="hidden" name="view" value="collection"><input type="hidden" name="details" value="1"><input type="hidden" name="carrier_stage" value="history"><div class="col-6"><label class="form-label">Desde</label><input class="form-control" type="date" name="from" value="{{ historyFrom }}"></div><div class="col-6"><label class="form-label">Hasta</label><input class="form-control" type="date" name="to" value="{{ historyTo }}"></div><div class="col-12"><button class="btn btn-success w-100">Consultar historial</button></div></form><div class="rounded-4 bg-success text-white text-center p-3 mb-3"><strong>Total recolectados: {{ carrierCollectionHistory|length }}</strong></div><div class="list-group">{% for package in carrierCollectionHistory %}<div class="list-group-item d-flex gap-3"><span class="driver-number">{{ loop.index }}</span><div><strong>{{ package.package_code }}</strong><div class="small text-muted">QR: {{ package.public_token }}</div><div>{{ package.collected_at|date('d/m/Y') }} · {{ package.collected_at|date('H:i:s') }} (São Paulo)</div></div></div>{% else %}<div class="alert alert-light border mb-0">No hay paquetes recolectados en estas fechas.</div>{% endfor %}</div></div></section>{% endif %}
            {% if not isCarrierOwner and showCarrierDetails and carrierStage=='warehouse' %}<section class="card border-0 shadow-sm mb-4" id="physicalReception"><div class="card-body p-4"><div class="text-center mb-4"><strong>{{ user.name }} {{ user.lastname }}</strong><div class="text-muted">Código {{ user.id }}</div><h2 class="h4 mt-3">Recepción física</h2></div><label class="form-label">Tipo de lectura</label><select class="form-select mb-3" id="receptionReadType"><option>Código (remesas)</option><option>Código de barra (cliente)</option><option>Código transf.</option><option>N.º pedido</option></select><button class="btn btn-info btn-lg w-100 mb-3" data-bs-toggle="modal" data-bs-target="#packageScannerModal">ESCANEAR PAQUETE RECIBIDO</button><div class="input-group mb-4"><input class="form-control" id="receptionManualCode" placeholder="Digite el código QR o código de barras"><button class="btn btn-success" type="button" id="recordReceptionCode">GRABAR</button></div><div class="rounded-4 bg-warning text-dark text-center p-5 mb-3"><div class="display-1 fw-bold" id="receptionCount">0</div><div>Paquetes recibidos en esta sesión</div></div><button class="btn btn-warning btn-lg w-100" type="button" id="resetReceptionCount">RESETEAR CONTADOR</button><div id="receptionFeedback" class="mt-3"></div></div></section>{% endif %}
            <div id="carrierOperationsDetails" class="{{ isCarrierOwner?'':'d-none' }}">
            <div class="input-group mb-3"><span class="input-group-text"><i data-feather="search"></i></span><input id="carrierPackageSearch" class="form-control" placeholder="Buscar por paquete, cliente, vendedor, dirección o estado"><button type="button" class="btn btn-outline-secondary" id="clearCarrierPackageSearch">Limpiar</button></div>
            <div class="driver-tabs mb-3" role="tablist"><button class="driver-tab active" data-carrier-stage-tab="collected">Colección detallada ({{ carrierCollectedPackages|length }})</button><button class="driver-tab" data-carrier-stage-tab="history">Historial ({{ carrierCollectionHistory|length }})</button><button class="driver-tab" data-carrier-stage-tab="warehouse">{{ trans('delivery_manifest.warehouse') }} ({{ carrierWarehousePackages|length }})</button><button class="driver-tab" data-carrier-stage-tab="route">Preparar ruta / En ruta ({{ carrierRoutePackages|length }})</button><button class="driver-tab text-danger" data-carrier-stage-tab="cancelled">Cancelados ({{ carrierCancelledPackages|length }})</button><button class="driver-tab" data-carrier-stage-tab="closed">{{ trans('delivery_manifest.closed') }} ({{ carrierClosedPackages|length }})</button></div>
            {% set stageGroups={collected:carrierCollectedPackages,history:carrierCollectionHistory,warehouse:carrierWarehousePackages,route:carrierRoutePackages,cancelled:carrierCancelledPackages,closed:carrierClosedPackages} %}{% for key,packages in stageGroups %}<div class="row g-3 mb-3" data-carrier-stage-panel="{{ key }}" {{ key!='collected'?'hidden':'' }}>{% for package in packages %}<div class="col-xl-4 col-md-6"><article class="driver-card h-100 mb-0"><div class="d-flex justify-content-between gap-2"><div><div class="driver-package-code">{{ package.package_code }}</div><strong>{{ package.guest_name ?: package.guest_email }}</strong>{% if package.guest_phone %}<div class="small mt-1"><a href="tel:{{ package.guest_phone }}"><i data-feather="phone"></i> {{ package.guest_phone }}</a></div>{% endif %}</div><span class="driver-status">{{ package.custody_status|replace({'_':' '}) }}</span></div><div class="driver-address mt-3"><i data-feather="map-pin"></i> {{ package.shipping_address_1 }}{% if package.shipping_address_2 %}, {{ package.shipping_address_2 }}{% endif %}, {{ package.shipping_city }} {{ package.shipping_state }} {{ package.shipping_zip }}</div><div class="small text-muted mt-2">{{ package.seller_name }}{% if package.collected_at %} · {{ package.collected_at|date('d/m/Y H:i') }}{% endif %}</div></article></div>{% else %}<div class="col-12"><div class="alert alert-light border">{{ trans('delivery_manifest.empty_stage') }}</div></div>{% endfor %}</div>{% endfor %}
            <div data-carrier-stage-extra="route" hidden>
            {% if activeManifest %}<section class="card border-0 bg-light mb-4"><div class="card-body"><div class="d-flex justify-content-between gap-3 flex-wrap"><div><span class="badge bg-primary">{{ activeManifest.status }}</span><h3 class="h5 mt-2 mb-1">{{ activeManifest.manifest_code }}</h3><p class="text-muted mb-0">{{ manifestItems|length }} {{ trans('delivery_manifest.packages') }} · {{ trans('delivery_manifest.sorted_help') }}</p></div><div class="d-flex gap-2 flex-wrap">{% if activeManifest.status=='DRAFT' %}<form method="post"><input type="hidden" name="action" value="generate_manifest"><input type="hidden" name="manifest_id" value="{{ activeManifest.id }}"><button class="btn btn-danger" {{ manifestItems is empty?'disabled':'' }}>{{ trans('delivery_manifest.generate') }}</button></form>{% else %}<a class="btn btn-success" href="{{ path('panel/planner-hub/team/driver-mode?export_manifest='~activeManifest.id) }}"><i data-feather="download"></i> {{ trans('delivery_manifest.export') }}</a>{% endif %}</div></div><div class="list-group mt-3">{% for item in manifestItems %}<div class="list-group-item d-flex gap-3"><span class="driver-number">{{ item.stop_sequence }}</span><div class="flex-grow-1"><strong>{{ item.guest_name ?: item.guest_email }}</strong><div class="small text-muted mb-1">{{ item.package_code }}</div><div class="d-flex flex-wrap gap-3 small mb-1">{% if item.guest_phone %}<a href="tel:{{ item.guest_phone }}"><i data-feather="phone"></i> {{ item.guest_phone }}</a>{% endif %}{% if item.guest_email %}<a href="mailto:{{ item.guest_email }}"><i data-feather="mail"></i> {{ item.guest_email }}</a>{% endif %}</div><div><i data-feather="map-pin"></i> {{ item.shipping_address_1 }}{% if item.shipping_address_2 %}, {{ item.shipping_address_2 }}{% endif %}, {{ item.shipping_city }} - {{ item.shipping_state }}, {{ item.shipping_zip }}{% if item.shipping_country %}, {{ item.shipping_country }}{% endif %}</div>{% if item.shipping_instructions %}<div class="small text-muted mt-2"><strong>Instrucciones:</strong> {{ item.shipping_instructions }}</div>{% endif %}</div></div>{% endfor %}</div></div></section>{% endif %}
            {% if activeManifest and activeManifest.status!='DRAFT' and manifestItems|length %}{% set routeStart=manifestItems[0] %}<div class="card border-0 overflow-hidden mb-4"><iframe title="{{ trans('store_logistics.optimized_route') }}" loading="lazy" style="border:0;width:100%;height:280px" src="https://maps.google.com/maps?q={{ (routeStart.shipping_address_1~' '~routeStart.shipping_city~' '~routeStart.shipping_state~' '~routeStart.shipping_zip)|url_encode }}&z=12&output=embed"></iframe></div>{% endif %}
            </div>
            <details class="mt-4"><summary class="btn btn-outline-secondary mb-3">Administrar detalles de paquetes</summary>
            <div class="alert alert-info mb-4">{{ trans('carrier_ui.qr_only_custody') }}</div>
            <div class="row g-3">
            {% for package in carrierPackages %}
                <div class="col-xl-4 col-md-6"><article class="driver-card h-100 mb-0" data-carrier-package-id="{{ package.id }}" data-carrier-package-status="{{ package.custody_status }}"><div class="d-flex justify-content-between gap-2"><div><div class="driver-package-code">{{ package.package_code }}</div><strong>{{ package.seller_name }}</strong></div><span class="driver-status">{{ package.custody_status|replace({'_':' '}) }}</span></div><div class="driver-address mt-3"><i data-feather="map-pin"></i> {{ package.shipping_address_1 }}, {{ package.shipping_city }} {{ package.shipping_state }} {{ package.shipping_zip }}</div><div class="small text-muted mt-2">{{ package.guest_name }} · {{ package.guest_phone }}</div><button class="driver-detail-btn w-100 mt-3" data-bs-toggle="modal" data-bs-target="#carrierPackage{{ package.id }}">{{ trans('store_logistics.update_package_stage') }}</button></article></div>
                <div class="modal fade driver-modal" id="carrierPackage{{ package.id }}" tabindex="-1" data-scanned-carrier-package="{{ package.id }}"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><small class="text-muted">{{ trans('store_logistics.store_order') }} #{{ package.id_store_order }}</small><h3 class="modal-title fs-5">{{ package.package_code }}</h3></div><button class="btn-close" data-bs-dismiss="modal"></button></div><form method="post" enctype="multipart/form-data" class="modal-body carrier-stage-form"><input type="hidden" name="action" value="carrier_advance"><input type="hidden" name="package_id" value="{{ package.id }}"><input type="hidden" name="latitude"><input type="hidden" name="longitude"><div class="border rounded-3 p-3 mb-3 bg-light"><div class="d-flex justify-content-between gap-2"><strong>{{ package.guest_name ?: package.guest_email }}</strong><span class="badge bg-primary">{{ package.custody_status|replace({'_':' '}) }}</span></div>{% if package.guest_email %}<div class="small text-muted">{{ package.guest_email }}</div>{% endif %}{% if package.guest_phone %}<div class="small text-muted">{{ package.guest_phone }}</div>{% endif %}<div class="mt-2"><i data-feather="map-pin"></i> {{ package.shipping_address_1 }}{% if package.shipping_address_2 %}, {{ package.shipping_address_2 }}{% endif %}, {{ package.shipping_city }} {{ package.shipping_state }} {{ package.shipping_zip }}</div><div class="small text-muted mt-2">{{ package.seller_name }} · {{ package.current_location_label }}</div></div><label class="form-label fw-bold">{{ trans('store_logistics.next_package_event') }}</label><select class="form-select mb-3" name="carrier_stage" required>{% if package.custody_status in ['PICKUP_ASSIGNED','WITH_SELLER'] %}<option value="picked_up">{{ trans('store_logistics.picked_up_from_seller') }}</option>{% endif %}{% if package.custody_status in ['PICKED_UP','CUSTOMER_ABSENT','CUSTOMER_REJECTED','DELIVERY_CANCELLED'] %}<option value="received_hub">{{ trans('store_logistics.received_at_hub') }}</option>{% endif %}{% if package.custody_status == 'RECEIVED_AT_HUB' %}<option value="sorted_hub">{{ trans('store_logistics.sorted_at_hub') }}</option>{% endif %}{% if package.custody_status in ['SORTED_AT_HUB','CUSTOMER_ABSENT'] %}<option value="out_for_delivery">{{ trans('store_logistics.out_for_delivery') }}</option>{% endif %}{% if package.custody_status == 'OUT_FOR_DELIVERY' %}<option value="delivered">{{ trans('store_logistics.delivered') }}</option><option value="customer_absent">{{ trans('store_logistics.customer_absent') }}</option><option value="customer_rejected">{{ trans('store_logistics.customer_rejected') }}</option><option value="delivery_cancelled">{{ trans('store_logistics.delivery_cancelled') }}</option>{% endif %}</select><label class="form-label">{{ trans('store_logistics.evidence_photo') }} *</label><input type="file" class="form-control mb-3" name="evidence_photo" accept="image/jpeg,image/png,image/webp" capture="environment" required><div class="carrier-receiver-fields"><input class="form-control mb-2" name="receiver_name" placeholder="{{ trans('store_logistics.receiver_name') }}"><div class="row g-2"><div class="col-6"><select class="form-select" name="document_type"><option value="ID">ID / RG</option><option value="TAX_ID">CPF / Tax ID</option></select></div><div class="col-6"><input class="form-control" name="document_number" placeholder="{{ trans('store_logistics.document_number') }}"></div></div><input type="hidden" name="receiver_type" value="RECIPIENT"></div><textarea class="form-control my-3" name="notes" rows="3" placeholder="{{ trans('store_logistics.observations') }}"></textarea><button class="driver-action">{{ trans('ui.save') }}</button></form></div></div></div>
            {% else %}<div class="col-12"><div class="alert alert-light border mb-0">{{ trans('store_logistics.no_carrier_packages') }}</div></div>{% endfor %}
            </div></details>
            </div>
            {% endif %}
        </section>
        {% endif %}

        {% if not isCarrierOrganization %}
        <div class="driver-tabs" role="tablist">
            <button class="driver-tab active" data-driver-tab="pending"><span>{{ trans('store_logistics.pending') }} ({{ deliveryTasks|length }})</span></button>
            <button class="driver-tab" data-driver-tab="incidents"><span>{{ trans('store_logistics.incidents') }} ({{ incidentTasks|length }})</span></button>
            <button class="driver-tab" data-driver-tab="completed"><span>{{ trans('store_logistics.completed') }} ({{ completedTasks|length }})</span></button>
        </div>

        <div class="driver-map">
            <div class="driver-map-label"><i data-feather="map" class="me-1"></i>{{ trans('store_logistics.optimized_route') }}</div>
            {% if deliveryTasks|length > 0 %}
                {% set firstTask = deliveryTasks[0] %}
                {% if firstTask.latest_location %}
                    <iframe loading="lazy" src="https://maps.google.com/maps?q={{ firstTask.latest_location.latitude }},{{ firstTask.latest_location.longitude }}&z=13&output=embed"></iframe>
                {% elseif firstTask.shipping_address_1 %}
                    <iframe loading="lazy" src="https://maps.google.com/maps?q={{ (firstTask.shipping_address_1 ~ ' ' ~ firstTask.shipping_city ~ ' ' ~ firstTask.shipping_state ~ ' ' ~ firstTask.shipping_zip)|url_encode }}&z=12&output=embed"></iframe>
                {% else %}
                    <div class="driver-map-empty">
                        <div><strong>{{ trans('store_logistics.no_route_address') }}</strong><br><span class="text-muted">{{ trans('store_logistics.assigned_addresses_hint') }}</span></div>
                    </div>
                {% endif %}
            {% else %}
                <div class="driver-map-empty">
                    <div><strong>{{ trans('store_logistics.no_open_deliveries') }}</strong><br><span class="text-muted">{{ trans('store_logistics.new_routes_hint') }}</span></div>
                </div>
            {% endif %}
        </div>

        <div class="driver-content">
            <div class="driver-summary">
                <div class="driver-summary-card"><span>{{ trans('store_logistics.open_deliveries') }}</span><strong>{{ deliveryTasks|length }}</strong></div>
                <div class="driver-summary-card"><span>{{ trans('store_logistics.ready_to_start') }}</span><strong>{{ readyToStartCount }}</strong></div>
                <div class="driver-summary-card"><span>{{ trans('store_logistics.on_route') }}</span><strong>{{ onRouteCount }}</strong></div>
            </div>
            <div class="driver-list-title">
                <h2>{{ trans('store_logistics.delivery_list') }}</h2>
                <p>{{ deliveryTasks|length }} {{ trans('store_logistics.pending_delivery_tasks') }}</p>
            </div>

            {% if deliveryTasks|length > 0 %}
                <div class="driver-table-wrap">
                    <table class="driver-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>{{ trans('store_logistics.order') }}</th>
                                <th>{{ trans('store_logistics.customer') }}</th>
                                <th>{{ trans('store_logistics.address') }}</th>
                                <th>{{ trans('ui.status') }}</th>
                                <th>{{ trans('ui.actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for task in allDeliveryTasks %}
                            {% set taskTab = task.order_status in ['DELIVERY_ATTEMPTED','RETURNED_TO_BUSINESS','RETURN_REQUESTED','RETURN_APPROVED'] ? 'incidents' : (task.order_status in ['DELIVERED','COMPLETED','CANCELLED','RETURNED','CLOSED'] or task.status in ['COMPLETED','CANCELED'] ? 'completed' : 'pending') %}
                            <tr data-driver-task-tab="{{ taskTab }}" data-order-status="{{ task.order_status }}" data-task-id="{{ task.id }}" data-public-token="{{ task.public_token }}" data-package-code="{{ task.package_code }}" data-order-id="{{ task.id_store_order }}" {{ taskTab != 'pending' ? 'hidden' : '' }}>
                                <td class="driver-mobile-inline"><span class="driver-number">{{ loop.index }}</span><span class="driver-status d-md-none">{{ task.order_status|replace({'_':' '})|title }}</span></td>
                                <td>
                                    <div class="driver-package-code">{{ task.package_code|default('OPH-' ~ task.id_store_order) }}</div>
                                    <div class="driver-table-customer">{{ trans('store_logistics.store_order') }} #{{ task.id_store_order }}</div>
                                </td>
                                <td>
                                    <div class="driver-table-order">{{ task.guest_name ?: task.guest_email }}</div>
                                    {% if task.guest_name and task.guest_email %}
                                        <div class="driver-table-customer">{{ task.guest_email }}</div>
                                    {% endif %}
                                </td>
                                <td><div class="driver-table-address"><i data-feather="map-pin"></i> {{ task.shipping_address_1 }}, {{ task.shipping_city }} {{ task.shipping_state }} {{ task.shipping_zip }}</div><div class="driver-contact-actions">{% if task.guest_phone %}<a class="driver-icon-action" href="tel:{{ task.guest_phone }}"><i data-feather="phone"></i></a>{% endif %}{% if task.client_user_id %}<a class="driver-icon-action" href="{{ path('panel/planner-hub/team/chat?to=' ~ task.client_user_id) }}"><i data-feather="message-square"></i></a>{% endif %}</div></td>
                                <td><span class="driver-status d-none d-md-inline-flex">{{ task.order_status|replace({'_':' '})|title }}</span></td>
                                <td>
                                    <button type="button" class="driver-detail-btn" data-driver-modal-target="#driverTaskModal{{ task.id }}" data-bs-toggle="modal" data-bs-target="#driverTaskModal{{ task.id }}"><i data-feather="list"></i>{{ trans('ui.details') }}</button>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-dark border-secondary">{{ trans('store_logistics.no_delivery_tasks') }}</div>
            {% endif %}

            {% for task in allDeliveryTasks %}
                <div class="modal fade driver-modal" id="driverTaskModal{{ task.id }}" tabindex="-1" aria-labelledby="driverTaskModalLabel{{ task.id }}" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h3 class="modal-title fs-5" id="driverTaskModalLabel{{ task.id }}">{{ trans('store_logistics.order_information') }}</h3>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ trans('ui.close') }}"></button>
                            </div>
                            <div class="modal-body">
                                <div class="driver-modal-section">
                                    <div class="driver-package-code mb-2">{{ task.package_code|default('OPH-' ~ task.id_store_order) }}</div><div class="driver-modal-label">{{ trans('store_logistics.recipient_information') }}</div>
                                    <div class="fw-bold">{{ task.guest_name ?: task.guest_email }}</div>
                                    {% if task.guest_name and task.guest_email %}<div class="text-muted small">{{ task.guest_email }}</div>{% endif %}
                                </div>
                                <div class="driver-modal-section">
                                    <div class="driver-modal-label">{{ trans('store_logistics.address') }}</div>
                                    <div class="fw-bold">{{ task.shipping_address_1 }}, {{ task.shipping_city }} {{ task.shipping_state }} {{ task.shipping_zip }}</div>
                                    <div class="driver-links">
                                        {% if task.shipping_address_1 %}
                                            <a target="_blank" href="https://www.google.com/maps/search/?api=1&query={{ (task.shipping_address_1 ~ ' ' ~ task.shipping_city ~ ' ' ~ task.shipping_state ~ ' ' ~ task.shipping_zip)|url_encode }}">{{ trans('store_logistics.open_map') }}</a>
                                        {% endif %}
                                        {% if task.public_token %}
                                            <a target="_blank" href="{{ path('store/order-access?token=' ~ task.public_token) }}">{{ trans('store_logistics.open_client_status') }}</a>
                                        {% endif %}
                                        {% if task.latest_location %}
                                            <a target="_blank" href="https://www.google.com/maps?q={{ task.latest_location.latitude }},{{ task.latest_location.longitude }}">{{ trans('store_logistics.latest_gps_ping') }}</a>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="driver-modal-section mb-0">
                                    <div class="driver-modal-label mb-2">{{ trans('ui.actions') }}</div>
                                    <div class="driver-actions">
                                        {% if task.order_status == 'READY_FOR_DELIVERY' or task.order_status == 'REDELIVERY_SCHEDULED' %}
                                            <form method="post" action="{{ path('panel/planner-hub/team/my-work') }}" class="driver-task-form" enctype="multipart/form-data">
                                                <input type="hidden" name="task_id" value="{{ task.id }}">
                                                <input type="hidden" name="action" value="out_for_delivery">
                                                <input type="hidden" name="location_lat">
                                                <input type="hidden" name="location_long">
                                                <input type="hidden" name="location_accuracy">
                                                <input type="hidden" name="location_platform" value="web_mobile_driver_mode">
                                                <input type="hidden" name="location_source" value="browser_geolocation">
