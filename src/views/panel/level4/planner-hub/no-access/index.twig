{% extends 'templates/base.admin.twig' %}
{% set _i18n_ready = trans('common.language') %}

{% block body %}
<main class="mt-4">
    <div class="container">
        <div class="p-4 p-md-5 bg-white rounded-3 shadow-sm">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light text-muted fw-bold mb-3">
                <i data-feather="lock"></i>
                {{ isCompanyModuleLock ? trans('level4_access_center.company_activation_required') : trans('level4_access_center.needs_approval') }}
            </div>
            <h1 class="fw-bold mb-3">
                {{ isCompanyModuleLock ? trans('level4_access_center.company_module_locked') : trans('level4_access_center.locked_access') }}
            </h1>
            <p class="text-muted mb-4">
                {% if isCompanyModuleLock %}
                    {{ trans('level4_access_center.company_module_locked_reason', {'company': companyName ?: trans('level4_access_center.selected_company')}) }}
                {% else %}
                    {{ trans('level4_access_center.admin_locked_reason') }}
                {% endif %}
            </p>
            <a class="btn btn-primary fw-bold" href="{{ path(isCompanyModuleLock ? 'panel/home' : 'panel/planner-hub') }}">
                {{ isCompanyModuleLock ? trans('level4_access_center.back_to_work') : trans('level4_access_center.sidebar_access_center') }}
            </a>
        </div>
    </div>
</main>
{% endblock %}
