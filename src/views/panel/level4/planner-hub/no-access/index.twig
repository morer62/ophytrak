{% extends 'templates/base.admin.twig' %}
{% set _i18n_ready = trans('common.language') %}

{% block body %}
<main class="mt-4">
    <div class="container">
        <div class="p-4 p-md-5 bg-white rounded-3 shadow-sm">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light text-muted fw-bold mb-3">
                <i data-feather="lock"></i>
                {{ trans('level4_access_center.needs_approval') }}
            </div>
            <h1 class="fw-bold mb-3">{{ trans('level4_access_center.locked_access') }}</h1>
            <p class="text-muted mb-4">{{ trans('level4_access_center.admin_locked_reason') }}</p>
            <a class="btn btn-primary fw-bold" href="{{ path('panel/planner-hub') }}">
                {{ trans('level4_access_center.sidebar_access_center') }}
            </a>
        </div>
    </div>
</main>
{% endblock %}
