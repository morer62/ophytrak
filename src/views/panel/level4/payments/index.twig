{% extends 'templates/base.admin.twig' %}
{% block body %}

<main class="container-fluid">
    <h1 class="h3 mb-4">💳 {{ trans('planner_hub.venue_payment_history') }}</h1>

    <div class="card">
        <div class="card-body">
            {% if payments is empty %}
                <div class="alert alert-info">{{ trans('planner_hub.no_payment_history_found') }}</div>
            {% else %}
                <table class="table table-bordered table-striped text-center">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>{{ trans('planner_hub.payment_date') }}</th>
                            <th>{{ trans('planner_hub.renewal_date') }}</th>
                            <th>{{ trans('planner_hub.amount') }}</th>
                            <th>{{ trans('planner_hub.status') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payment in payments %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ payment.payment_date ?: '—' }}</td>
                                <td>{{ payment.renewal ?: '—' }}</td>
                                <td>${{ env.VENUE_PAYMENT_AMOUNT }}</td>
                                <td>
                                    {% if payment.active == 'yes' %}
                                        <span class="badge bg-success">{{ trans('planner_hub.active') }}</span>
                                    {% else %}
                                        <span class="badge bg-danger">{{ trans('planner_hub.expired') }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</main>

{% endblock %}
