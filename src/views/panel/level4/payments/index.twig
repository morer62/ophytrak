{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.earnings{--green:#0c9b72;max-width:1050px;margin:0 auto;padding:8px}.earnings-head{background:#102b25;color:#fff;border-radius:18px 18px 0 0;padding:22px;text-align:center}.earnings-head small{display:block;color:#bcebdd;font-weight:700;margin-top:5px}.earnings-body{background:#fff;border:1px solid #dce8e4;border-top:0;border-radius:0 0 18px 18px;padding:24px;box-shadow:0 16px 40px #102b2512}.service-box,.custom-range,.adjustment-report{border:1px solid #cfdcd8;border-radius:12px;padding:16px}.service-box summary,.custom-range summary,.adjustment-report summary{cursor:pointer;font-weight:800;list-style-position:outside}.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:16px}.service-grid label{display:flex;gap:8px;align-items:center;font-weight:650}.periods{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:22px 0 10px}.periods button{border:2px solid var(--green);border-radius:10px;background:#fff;color:#08785a;font-weight:800;padding:12px 8px}.periods button.active{background:var(--green);color:#fff}.custom-range{margin-bottom:22px}.custom-fields{display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:end;margin-top:14px}.custom-fields label{color:#52625d;font-weight:700}.custom-fields input{display:block;width:100%;border:1px solid #c8d5d1;border-radius:9px;padding:10px;margin-top:5px}.date-range{text-align:center;color:#08785a;font-size:1.15rem;font-weight:850}.earnings-stats{display:grid;grid-template-columns:1fr 1fr;margin:24px 0}.earning-stat{text-align:center;padding:20px;border-right:1px solid #d8e2df}.earning-stat:last-child{border:0}.earning-stat span{display:block;color:#65736f}.earning-stat strong{display:block;color:var(--green);font-size:1.8rem;margin:8px}.ledger{text-align:center;font-size:1.08rem}.ledger .debit{color:#c53e4b}.ledger .credit{color:#07825f}.adjustment-report{margin:15px auto;max-width:760px}.adjustment-row{display:grid;grid-template-columns:100px 1fr auto;gap:12px;border-top:1px solid #e5ece9;padding:12px 0}.adjustment-row:first-of-type{margin-top:12px}.adjustment-type{font-weight:850}.adjustment-type.debit{color:#c53e4b}.adjustment-type.credit{color:#07825f}.total-box{border:2px solid #d6bc3d;border-radius:12px;text-align:center;padding:28px 16px;margin-top:22px}.total-box strong{display:block;font-size:1.8rem}.company-section{margin-top:28px}.company-section h2{text-align:center}.company-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.company-card{border:1px solid #d7e3df;border-radius:14px;padding:17px}.company-card h3{font-size:1.05rem;font-weight:850}.company-values{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.company-values span{color:#687772;font-size:.78rem}.company-values strong{display:block;color:#08785a;margin-top:4px}.apply-filter{background:#102b25;border:0;border-radius:10px;color:#fff;font-weight:800;padding:11px 18px;margin-top:14px}@media(max-width:700px){.service-grid{grid-template-columns:1fr 1fr}.periods{grid-template-columns:1fr 1fr}.custom-fields,.company-grid{grid-template-columns:1fr}.earnings-body{padding:16px}.earnings{padding:0}.earning-stat{padding:12px}.total-box strong{font-size:1.35rem}.company-values{grid-template-columns:1fr}.adjustment-row{grid-template-columns:1fr}}
</style>
<main class="earnings">
 <header class="earnings-head"><h1 class="h3 m-0">Mis Ganancias</h1><small>{{ driverName }} · {{ driverCode }}</small></header>
 <section class="earnings-body">
  <form method="get" id="earningsFilters">
   <details class="service-box" {% if selectedServices is not empty %}open{% endif %}><summary>Servicios prestados por empresa · {% if selectedServices is empty %}Todo{% else %}{{ selectedServices|length }} seleccionados{% endif %}</summary><div class="service-grid">
    <label><input type="checkbox" id="serviceAll" {% if selectedServices is empty %}checked{% endif %}> Todo</label>
    {% for key,label in services %}<label><input type="checkbox" name="services[]" value="{{ key }}" {% if key in selectedServices %}checked{% endif %}> {{ label }}</label>{% endfor %}
   </div><input type="hidden" name="period" value="{{ period }}"><button class="apply-filter" type="submit">Aplicar filtros</button></details>
   <div class="periods">
    {% for key,dates in periods %}<button type="submit" name="period" value="{{ key }}" class="{% if period == key %}active{% endif %}">{% if key == 'today' %}HOY{% elseif key == 'yesterday' %}AYER{% elseif key == 'previous_fortnight' %}PENDIENTE · {{ dates[0]|date('d/m') }} AL {{ dates[1]|date('d/m') }}{% else %}{{ dates[0]|date('d/m') }} AL {{ dates[1]|date('d/m') }}{% endif %}</button>{% endfor %}
   </div>
   <details class="custom-range" {% if period == 'custom' %}open{% endif %}><summary>Elegir otras fechas</summary><div class="custom-fields"><label>Desde<input type="date" name="from" value="{{ from|date('Y-m-d') }}" required></label><label>Hasta<input type="date" name="to" value="{{ to|date('Y-m-d') }}" required></label><button class="apply-filter" type="submit" name="period" value="custom">Consultar entregas y valor</button></div></details>
  </form>
  <div class="date-range">{{ from|date('d/m/Y') }} a {{ to|date('d/m/Y') }}</div>
  <div class="earnings-stats"><div class="earning-stat"><span>Cantidad de ENTREGAS</span><strong>{{ deliveryCount }}</strong><span>Valor total de las ENTREGAS</span><strong>R$ {{ deliveryTotal|number_format(2, ',', '.') }}</strong></div><div class="earning-stat"><span>Cantidad de COLETAS</span><strong>{{ collectionCount }}</strong><span>Valor total de las COLETAS</span><strong>R$ {{ collectionTotal|number_format(2, ',', '.') }}</strong></div></div>
  <div class="ledger"><p class="debit">Valores debitados: R$ {{ debits|number_format(2, ',', '.') }}</p><p class="credit">Valores de créditos: R$ {{ credits|number_format(2, ',', '.') }}</p></div>
  <details class="adjustment-report"><summary>Reportes de débitos y créditos ({{ adjustments|length }})</summary>{% for adjustment in adjustments %}<div class="adjustment-row"><span class="adjustment-type {{ adjustment.adjustment_type|lower }}">{{ adjustment.adjustment_type == 'DEBIT' ? 'Débito' : 'Crédito' }}</span><span><strong>{{ adjustment.reason }}</strong><small class="d-block text-muted">{{ adjustment.effective_local|date('d/m/Y H:i') }} · {{ adjustment.created_by_name }} {{ adjustment.created_by_lastname }}</small></span><strong>R$ {{ adjustment.amount_brl|number_format(2, ',', '.') }}</strong></div>{% else %}<p class="text-muted mt-3 mb-0">La empresa no registró ajustes para este período.</p>{% endfor %}</details>
  <div class="total-box"><strong>TOTAL A RECIBIR: R$ {{ receivable|number_format(2, ',', '.') }}</strong><h2 class="h5 mt-3">Declaración de {{ driverName }} · {{ driverCode }}</h2><small>Revisado el {{ queriedAt|date('d/m/Y') }} a las {{ queriedAt|date('H:i') }} · hora de São Paulo</small></div>
  <section class="company-section"><h2 class="h4">Entregas por empresa</h2><div class="company-grid">{% for company in companyBreakdown %}<article class="company-card"><h3>{{ company.name }}</h3><div class="company-values"><div><span>Total de pedidos</span><strong>{{ company.count }}</strong></div><div><span>Valor por paquete</span><strong>R$ {{ company.rate|number_format(2, ',', '.') }}</strong></div><div><span>Valor a recibir</span><strong>R$ {{ company.total|number_format(2, ',', '.') }}</strong></div></div></article>{% else %}<p class="text-muted">No hay entregas en las fechas y empresas seleccionadas.</p>{% endfor %}</div></section>
 </section>
</main>
<script>document.getElementById('serviceAll')?.addEventListener('change',function(){if(this.checked)document.querySelectorAll('[name="services[]"]').forEach(function(box){box.checked=false;});});document.querySelectorAll('[name="services[]"]').forEach(function(box){box.addEventListener('change',function(){if(this.checked)document.getElementById('serviceAll').checked=false;});});</script>
{% endblock %}
