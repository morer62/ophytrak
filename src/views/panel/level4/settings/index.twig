{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<div class="container-fluid h-100 d-flex flex-column justify-content-center p-3">
    <h1 class="h3 mb-3 text-center">
        <strong>{{ trans('planner_hub.edit_your_profile') }}</strong>
    </h1>



<div class="alert alert-light border d-flex justify-content-between align-items-center">
    <div>
        <strong>{{ trans('planner_hub.want_to_delete_account') }}</strong><br>
        {{ trans('planner_hub.request_deletion_keep_data') }}
    </div>
    <a href="{{ path('panel/settings/user-deletion') }}" class="btn btn-outline-danger">
        <i data-feather="trash-2"></i> {{ trans('planner_hub.delete_account') }}
    </a>
</div>


<div class="alert alert-light border d-flex justify-content-between align-items-center">
    <div>
        <strong>{{ trans('planner_hub.close_your_account') }}</strong><br>
        {{ trans('planner_hub.close_account_data_deleted') }}
    </div>
    <button class="btn btn-danger" onclick="openConfirmModal()">
        <i data-feather="trash-2"></i> {{ trans('planner_hub.delete') }}
    </button>
</div>
<div id="customModal" class="custom-modal-overlay" style="display:none;">
    <div class="custom-modal">
        <h4>{{ trans('planner_hub.confirm_deletion') }}</h4>
        <p>{{ trans('planner_hub.confirm_deletion_message') }}</p>
        <div class="text-right">
            <button class="btn btn-default" onclick="closeConfirmModal()">{{ trans('planner_hub.cancel') }}</button>
            <button class="btn btn-danger" onclick="confirmDeletion()">{{ trans('planner_hub.yes_delete_it') }}</button>
        </div>
    </div>
</div>
<style>
.custom-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
}
.custom-modal {
    background: white;
    padding: 20px;
    border-radius: 5px;
    max-width: 400px;
    width: 90%;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}
</style>

    <div class="d-flex justify-content-center align-items-center">
        <div class="card shadow-lg p-4 w-100 w-md-75">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    {% if isCarrierOrganization %}
                    <div class="d-flex justify-content-end mb-4">
                        <div class="text-center">
                            <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center overflow-hidden mx-auto" style="width:132px;height:132px">
                                {% if driverProfile.profile_photo_url %}<img id="driverProfilePhotoPreview" src="{{ driverProfile.profile_photo_url }}" alt="{{ trans('ophytrack_driver_profile.profile_photo') }}" class="w-100 h-100" style="object-fit:cover">
                                {% else %}<i id="driverProfilePhotoPlaceholder" data-feather="user" style="width:64px;height:64px"></i>{% endif %}
                            </div>
                            <video id="driverProfileCamera" class="rounded border w-100 mt-2 bg-dark" playsinline autoplay muted hidden></video>
                            <canvas id="driverProfileCameraCanvas" hidden></canvas>
                            <button id="driverProfilePhotoCapture" type="button" class="btn btn-outline-primary mt-2 mb-0"><i data-feather="camera"></i> {{ trans('ophytrack_driver_profile.take_photo') }}</button>
                            <input id="driverProfilePhoto" name="profile_photo" type="file" accept="image/jpeg" hidden>
                            <input id="driverProfilePhotoCapturedAt" name="profile_photo_captured_at" type="hidden">
                            <div id="driverProfileCameraStatus" class="small text-muted mt-2" aria-live="polite"></div>
                        </div>
                    </div>
                    {% endif %}
                    <div class="mb-3">
                        <label class="form-label">{{ trans('planner_hub.first_name') }}</label>
                        <input class="form-control" name="name" required type="text" value="{{ user.name }}" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ trans('planner_hub.last_name') }}</label>
                        <input class="form-control" name="lastname" required type="text" value="{{ user.lastname }}" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ trans('planner_hub.email') }}</label>
                        <input class="form-control" name="email" required type="email" value="{{ user.email }}" />
                    </div>

                    <hr>

                    <div class="mb-3">
                        <label class="form-label">{{ trans('planner_hub.new_password') }}</label>
                        <input class="form-control" name="password" type="password" placeholder="{{ trans('planner_hub.leave_blank_keep_current') }}" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ trans('planner_hub.confirm_new_password') }}</label>
                        <input class="form-control" name="password_repeat" type="password" />
                    </div>

                    {% if isCarrierOrganization %}
                    <section class="card border mt-4 mb-4">
                        <div class="card-body">
                            <h2 class="h5 mb-3"><i data-feather="credit-card"></i> {{ trans('ophytrack_driver_profile.bank_data') }}</h2>
                            <div class="row g-3">
                                <div class="col-12"><label class="form-label">{{ trans('ophytrack_driver_profile.name') }}</label><input class="form-control" name="bank_account_name" value="{{ driverProfile.bank_account_name|default('') }}"></div>
                                <div class="col-md-6"><label class="form-label">{{ trans('ophytrack_driver_profile.document_type') }}</label><select class="form-select" name="document_type"><option value="">{{ trans('ophytrack_driver_profile.select') }}</option><option value="CPF" {{ driverProfile.document_type|default('') == 'CPF' ? 'selected' : '' }}>CPF</option><option value="CNPJ" {{ driverProfile.document_type|default('') == 'CNPJ' ? 'selected' : '' }}>CNPJ</option><option value="RG" {{ driverProfile.document_type|default('') == 'RG' ? 'selected' : '' }}>RG</option><option value="OTHER" {{ driverProfile.document_type|default('') == 'OTHER' ? 'selected' : '' }}>{{ trans('ophytrack_driver_profile.other') }}</option></select></div>
                                <div class="col-md-6"><label class="form-label">{{ trans('ophytrack_driver_profile.document_number') }}</label><input class="form-control" name="document_number" value="{{ driverProfile.document_number|default('') }}"></div>
                                <div class="col-md-6"><label class="form-label">{{ trans('ophytrack_driver_profile.bank') }}</label><input class="form-control" name="bank_name" value="{{ driverProfile.bank_name|default('') }}"></div>
                                <div class="col-md-6"><label class="form-label">{{ trans('ophytrack_driver_profile.agency') }}</label><input class="form-control" name="bank_agency" value="{{ driverProfile.bank_agency|default('') }}"></div>
                                <div class="col-md-6"><label class="form-label">{{ trans('ophytrack_driver_profile.account_type') }}</label><select class="form-select" name="bank_account_type"><option value="">{{ trans('ophytrack_driver_profile.select') }}</option><option value="CHECKING" {{ driverProfile.bank_account_type|default('') == 'CHECKING' ? 'selected' : '' }}>{{ trans('ophytrack_driver_profile.checking') }}</option><option value="SAVINGS" {{ driverProfile.bank_account_type|default('') == 'SAVINGS' ? 'selected' : '' }}>{{ trans('ophytrack_driver_profile.savings') }}</option><option value="PAYMENT" {{ driverProfile.bank_account_type|default('') == 'PAYMENT' ? 'selected' : '' }}>{{ trans('ophytrack_driver_profile.payment') }}</option></select></div>
                                <div class="col-md-6"><label class="form-label">{{ trans('ophytrack_driver_profile.account') }}</label><input class="form-control" name="bank_account_number" value="{{ driverProfile.bank_account_number|default('') }}"></div>
                                <div class="col-12"><label class="form-label">{{ trans('ophytrack_driver_profile.pix_key') }}</label><input class="form-control" name="pix_key" value="{{ driverProfile.pix_key|default('') }}"></div>
                            </div>
                        </div>
                    </section>
                    {% endif %}

                    <hr>

                    <h5 class="mb-3">{{ trans('planner_hub.language_settings') }}</h5>

                    <div class="mb-3">
                        <label class="form-label">{{ trans('planner_hub.interface_language') }}</label>
                        <select class="form-select" name="ui_language" required>
                            <option value="en" {{ user.getUiLanguage() == 'en' ? 'selected' : '' }}>English</option>
                            <option value="es" {{ user.getUiLanguage() == 'es' ? 'selected' : '' }}>Español</option>
                            <option value="fr" {{ user.getUiLanguage() == 'fr' ? 'selected' : '' }}>Français</option>
                            <option value="pt" {{ user.getUiLanguage() in ['pt', 'pr'] ? 'selected' : '' }}>Português</option>
                        </select>
                        <small class="form-text text-muted">{{ trans('planner_hub.interface_language_description') }}</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">{{ trans('planner_hub.update_profile') }}</button>
                </form>
            </div>
        </div>
    </div>
</div>

<hr class="my-4">


{% block javascripts %}
<script>
function openConfirmModal() {
    document.getElementById('customModal').style.display = 'flex';
}

const driverProfilePhoto = document.getElementById('driverProfilePhoto');
const driverProfileCamera = document.getElementById('driverProfileCamera');
const driverProfileCanvas = document.getElementById('driverProfileCameraCanvas');
const driverProfileCapture = document.getElementById('driverProfilePhotoCapture');
const driverProfileStatus = document.getElementById('driverProfileCameraStatus');
let driverProfileStream = null;

function stopDriverProfileCamera() {
    driverProfileStream?.getTracks().forEach(track => track.stop());
    driverProfileStream = null;
    if (driverProfileCamera) driverProfileCamera.hidden = true;
}

function previewDriverProfilePhoto(file) {
    let preview = document.getElementById('driverProfilePhotoPreview');
    if (!preview) {
        preview = document.createElement('img');
        preview.id = 'driverProfilePhotoPreview';
        preview.className = 'w-100 h-100';
        preview.style.objectFit = 'cover';
        document.getElementById('driverProfilePhotoPlaceholder')?.replaceWith(preview);
    }
    preview.src = URL.createObjectURL(file);
}

driverProfileCapture?.addEventListener('click', async function () {
    if (!driverProfileStream) {
        try {
            if (!navigator.mediaDevices?.getUserMedia) throw new Error('camera-unavailable');
            driverProfileStream = await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'user'}},audio:false});
            driverProfileCamera.srcObject = driverProfileStream;
            driverProfileCamera.hidden = false;
            driverProfileStatus.textContent = {{ trans('ophytrack_driver_profile.camera_active')|json_encode|raw }};
        } catch (error) {
            driverProfileStatus.textContent = {{ trans('ophytrack_driver_profile.camera_required')|json_encode|raw }};
        }
        return;
    }
    driverProfileCanvas.width = driverProfileCamera.videoWidth || 1280;
    driverProfileCanvas.height = driverProfileCamera.videoHeight || 720;
    driverProfileCanvas.getContext('2d').drawImage(driverProfileCamera, 0, 0, driverProfileCanvas.width, driverProfileCanvas.height);
    driverProfileCanvas.toBlob(function (blob) {
        if (!blob) return;
        const file = new File([blob], 'driver-profile-live.jpg', {type:'image/jpeg', lastModified:Date.now()});
        const transfer = new DataTransfer(); transfer.items.add(file); driverProfilePhoto.files = transfer.files;
        document.getElementById('driverProfilePhotoCapturedAt').value = Math.floor(Date.now()/1000);
        previewDriverProfilePhoto(file);
        driverProfileStatus.textContent = {{ trans('ophytrack_driver_profile.photo_captured')|json_encode|raw }};
        stopDriverProfileCamera();
    }, 'image/jpeg', 0.9);
});
window.addEventListener('beforeunload', stopDriverProfileCamera);

function closeConfirmModal() {
    document.getElementById('customModal').style.display = 'none';
}

async function confirmDeletion() {
    try {
        const response = await fetch("{{ path('panel/settings/update-active-user') }}", {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'confirm_hard_delete=yes',
            credentials: 'include' 
        });

        
        if (response.redirected) {
            window.location.href = response.url;
            return;
        }

        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            const result = await response.json();
            if (result.success && result.redirect) {
                window.location.href = result.redirect;
                return;
            }
            throw new Error(result.message || "{{ trans('planner_hub.operation_error')|e('js') }}");
        }
    
        
        window.location.href = "{{ path('login') }}";
        
    } catch (error) {
        console.error('Error:', error);
        alert('{{ trans('planner_hub.error_processing_request')|e('js') }}: ' + error.message);
        closeConfirmModal();
    }
}
</script>
{% endblock %}
{% endblock %}
