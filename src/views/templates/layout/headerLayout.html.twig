                {% endif %}
              ];

              const labels = {
                empty: '{{ trans('nav.search_empty')|e('js') }}',
                hint: '{{ trans('nav.search_hint')|e('js') }}'
              };

              function normalize(value) {
                return String(value || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
              }

              function distance(a, b) {
                if (!a || !b) return 99;
                if (Math.abs(a.length - b.length) > 3) return 99;
                const dp = Array.from({ length: a.length + 1 }, function (_, i) {
                  return Array.from({ length: b.length + 1 }, function (_, j) { return i === 0 ? j : (j === 0 ? i : 0); });
                });
                for (let i = 1; i <= a.length; i++) {
                  for (let j = 1; j <= b.length; j++) {
                    const cost = a[i - 1] === b[j - 1] ? 0 : 1;
                    dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost);
                  }
                }
                return dp[a.length][b.length];
              }

              function scoreItem(item, query) {
                const haystack = normalize([item.label, item.group, item.terms].join(' '));
                const label = normalize(item.label);
                const words = haystack.split(' ').filter(Boolean);
                const qWords = normalize(query).split(' ').filter(Boolean);
                if (!qWords.length) return 0;
                let score = 0;
                qWords.forEach(function (word) {
                  if (label.startsWith(word)) score += 80;
                  if (haystack.includes(word)) score += 45;
                  words.forEach(function (candidate) {
                    if (candidate.startsWith(word)) score += 20;
                    const d = distance(word, candidate);
                    if (d <= 1) score += 32;
                    else if (d === 2 && word.length >= 5) score += 18;
                  });
                });
                return score;
              }

              function iconSvg(name) {
                if (window.feather && feather.icons[name]) return feather.icons[name].toSvg({ width: 18, height: 18 });
                return '';
              }

              searchForms.forEach(function (search) {
                const input = search.querySelector('[data-ophyra-command-input]');
                const results = search.querySelector('[data-ophyra-command-results]');
                if (!input || !results) return;

                let activeIndex = -1;
                let currentMatches = [];

              function render(matches) {
                activeIndex = -1;
                currentMatches = matches;
                if (!input.value.trim()) {
                  results.innerHTML = '<div class="ophyra-search-hint">' + labels.hint + '</div>';
                  search.classList.add('is-open');
                  return;
                }
                if (!matches.length) {
                  results.innerHTML = '<div class="ophyra-search-empty">' + labels.empty + '</div>';
                  search.classList.add('is-open');
                  return;
                }
                results.innerHTML = matches.map(function (item, index) {
                  const badge = item.badge ? '<span class="ophyra-search-badge ' + (item.tone || 'shared') + '">' + item.badge + '</span>' : '';
                  return '<a class="ophyra-search-result" href="' + item.url + '" data-search-index="' + index + '"><span class="ophyra-search-result-icon">' + iconSvg(item.icon) + '</span><span><strong>' + item.label + badge + '</strong><span>' + item.group + '</span></span></a>';
                }).join('');
                search.classList.add('is-open');
              }

              function runSearch() {
                const query = input.value;
                const matches = knowledge.map(function (item) {
                  return Object.assign({}, item, { score: scoreItem(item, query) });
                }).filter(function (item) {
                  return item.score > 0;
                }).sort(function (a, b) {
                  return b.score - a.score;
                }).slice(0, 8);
                render(matches);
              }

              input.addEventListener('input', runSearch);
              input.addEventListener('focus', runSearch);
              input.addEventListener('keydown', function (event) {
                const items = Array.from(results.querySelectorAll('.ophyra-search-result'));
                if (event.key === 'Escape') {
                  search.classList.remove('is-open');
                  return;
                }
                if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                  event.preventDefault();
                  if (!items.length) return;
                  activeIndex = event.key === 'ArrowDown'
                    ? Math.min(activeIndex + 1, items.length - 1)
                    : Math.max(activeIndex - 1, 0);
                  items.forEach(function (item, index) { item.classList.toggle('is-active', index === activeIndex); });
                  return;
                }
                if (event.key === 'Enter' && currentMatches.length) {
                  event.preventDefault();
                  window.location.href = currentMatches[Math.max(activeIndex, 0)].url;
                }
              });

              document.addEventListener('click', function (event) {
                if (!search.contains(event.target)) search.classList.remove('is-open');
              });
              });
            });
          </script>
