{% set data = block.data|default({}) %}
<section class="cms-block cms-block-cta">
  {% if block.title|default('') %}
    <h2>{{ block.title }}</h2>
  {% endif %}
  {% if data.text|default('') %}
    <p>{{ data.text }}</p>
  {% endif %}
  {% if data.url|default('') %}
    <a href="{{ data.url }}" class="btn btn-primary">{{ data.label|default('Contact us') }}</a>
  {% endif %}
</section>
