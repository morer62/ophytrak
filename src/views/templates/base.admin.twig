<script id="ophytrack-brand-guard">
document.addEventListener('DOMContentLoaded',function(){
  document.title=document.title.replace(/Ophyra/gi,'OPHYTRACK');
  var walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);
  var nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);
  nodes.forEach(function(node){if(node.parentElement&&!['SCRIPT','STYLE','TEXTAREA'].includes(node.parentElement.tagName))node.nodeValue=node.nodeValue.replace(/Ophyra/g,'OPHYTRACK').replace(/ophyra/g,'OPHYTRACK');});
});
