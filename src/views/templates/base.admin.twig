<body>
    <div class="wrapper">
        {% include 'templates/layout/sidebarLayout.html.twig' %}

        <div class="main">
            {% include 'templates/layout/headerLayout.html.twig' %}

            <main class="content">
                <div class="container-fluid p-0" id="content">
                    {% block body %}
                    {% endblock %}
                </div>
            </main>

            {% include 'templates/layout/footerLayout.html.twig' %}
        </div>
    </div>

    {% block aside %}
    {% endblock %}
    {% include 'templates/components/toast-component.twig' %}

    <script src="{{ asset_for('template/js/app.js') }}"></script>
    <script src="{{ asset_for('assets/js/luxon.min.js') }}"></script>
    {% include 'templates/components/i18n-dom-translator.twig' %}
    <script>

    </script>
    <script>

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.content table.table').forEach(table => {
                if (table.closest('.table-responsive') || table.closest('.dataTables_wrapper') || table.dataset.noAutoScroll === 'true') {
                    return;
                }

                const wrapper = document.createElement('div');
                wrapper.className = 'table-responsive ophyra-table-scroll';
                table.parentNode.insertBefore(wrapper, table);
                wrapper.appendChild(table);
            });

            {% if alertMessage is not null %}

                {% if isMobileApp %}
                    if (window.bootstrap) {
                        new bootstrap.Toast(document.getElementById('alertToast')).show();
                    }
                {% else %}
                    setTimeout(() => {
                        alert('{{ alertMessage.message }}')
                    }, 1)
                {% endif %}
            {% endif %}

            document.querySelectorAll("[data-phone]").forEach(elm => {
                elm.addEventListener("input", function (e) {
                    const raw = String(e.target.value || '').trim();
                    const hasPlus = raw.startsWith('+');
                    const digits = raw.replace(/\D/g, '');

                    if (!digits) {
                        e.target.value = '';
                        return;
                    }

                    if (hasPlus && digits.startsWith('1') && digits.length > 1) {
                        let local = digits.slice(1, 11);
                        if (local.length <= 3) {
                            e.target.value = '+1 ' + local;
                        } else if (local.length <= 6) {
                            e.target.value = '+1 (' + local.slice(0, 3) + ') ' + local.slice(3);
                        } else {
                            e.target.value = '+1 (' + local.slice(0, 3) + ') ' + local.slice(3, 6) + '-' + local.slice(6);
                        }
                        return;
                    }

                    const prefix = hasPlus ? '+' : '';
                    e.target.value = prefix + digits.replace(/(\d{3})(?=\d)/g, '$1 ').trim();
                })
            })

            document.querySelectorAll("[form-delete]").forEach(elm => {
                elm.addEventListener("submit",function (e) {
                    e.preventDefault()
                    const isConfirmed = confirm("{{ trans('common.delete_confirm')|e('js') }}")
                    if (isConfirmed) {
                        this.submit()
                    }
                })
            })
        })

        document.addEventListener('DOMContentLoaded', function () {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')

            for (const tooltipTriggerEl of tooltipTriggerList) {
                new bootstrap.Tooltip(tooltipTriggerEl)
            }
        })

        document.addEventListener('DOMContentLoaded', function () {
            const { DateTime } = luxon;
            const localTimes = document.querySelectorAll('[data-local-time]')

            localTimes.forEach(elm => {

                let utcText = elm.innerText
                let utcDateTime = DateTime.fromFormat(utcText, "yyyy-MM-dd HH:mm:ss", { zone: "utc" });
                const local = utcDateTime.setZone(DateTime.local().zoneName);
                elm.innerText = local.toFormat("yyyy-MM-dd HH:mm:ss")
            })
        })

        window.addEventListener('load', function() {
            if (typeof feather !== 'undefined') {
                try {
                    setTimeout(function() {
                        try {
                            feather.replace();
                        } catch (error) {
                            console.error('Error en feather.replace():', error);
                            try {
                                const headerIcons = document.querySelectorAll('nav [data-feather]');
                                headerIcons.forEach(function(icon) {
                                    try {
                                        const iconName = icon.getAttribute('data-feather');
                                        if (iconName && feather.icons[iconName]) {
                                            icon.innerHTML = feather.icons[iconName].toSvg();
                                        }
                                    } catch (e) {
                                        console.warn('Error procesando icono:', icon.getAttribute('data-feather'), e);
                                    }
                                });
                            } catch (e2) {
                                console.error('Error procesando iconos del header:', e2);
                            }
                        }
                    }, 100);
                } catch (error) {
                    console.error('Error inicializando Feather Icons:', error);
                }
            }
        });

    </script>
