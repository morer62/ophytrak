<script id="ophyra-locale-pageshow-guard">
    window.addEventListener('pageshow', function (event) {
        try {
            var match = document.cookie.match(/(?:^|; )app_locale=([^;]+)/);
            var cookieLocale = match ? decodeURIComponent(match[1]) : '';
            var storedLocale = window.localStorage ? (localStorage.getItem('app_locale') || '') : '';
            var preferred = (storedLocale || cookieLocale || '').toLowerCase().substring(0, 2);
            var current = (document.documentElement.getAttribute('lang') || '').toLowerCase().substring(0, 2);
            if (event.persisted && preferred && current && preferred !== current) {
                window.location.reload();
            }
        } catch (error) {}
    });
</script>
