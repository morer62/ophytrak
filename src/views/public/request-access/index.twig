{% extends "templates/base.twig" %}
{% set t = 'ophytrack_public.' %}
{% block styles %}<style>
body{margin:0;background:radial-gradient(circle at 80% 0,#087cff30,transparent 35%),#020a16;color:#fff;font-family:Inter,Arial,sans-serif}.demo-shell{min-height:100vh;padding:42px 20px}.demo-wrap{width:min(1080px,100%);margin:auto}.demo-nav{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:50px}.demo-nav img{width:230px;max-width:55vw}.demo-nav a{color:#dce9f7;text-decoration:none;font-weight:800}.demo-grid{display:grid;grid-template-columns:1fr 1fr;gap:42px;align-items:start}.demo-copy h1{font-size:clamp(2.7rem,5vw,5rem);line-height:1;letter-spacing:-.05em;margin:15px 0 22px}.demo-copy p{color:#b9cada;font-size:1.08rem;line-height:1.75}.kicker{color:#5ee4ff;font-weight:900;letter-spacing:.17em;font-size:.78rem}.demo-list{display:grid;gap:13px;margin-top:28px}.demo-list span{padding:14px 16px;border:1px solid #1d3b5a;border-radius:15px;background:#08182a}.demo-form{background:#fff;color:#0b1728;border-radius:28px;padding:30px;box-shadow:0 35px 90px #0008}.demo-form h2{margin:0 0 8px}.demo-form p{color:#5d7087;line-height:1.55}.fields{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-weight:850}.field input,.field select,.field textarea{width:100%;border:1px solid #cdddec;border-radius:13px;padding:13px;font:inherit}.field textarea{min-height:110px;resize:vertical}.submit{border:0;border-radius:999px;padding:15px 22px;background:linear-gradient(135deg,#03c6f4,#087cff);color:#fff;font-weight:900;cursor:pointer}.notice{border-radius:14px;padding:14px;margin-bottom:18px}.success{background:#dbfbea;color:#08633b}.error{background:#ffe4e6;color:#9f1239}.hp{position:absolute;left:-10000px}@media(max-width:800px){.demo-grid{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.field.full{grid-column:auto}.demo-shell{padding:26px 16px}.demo-form{padding:22px}}
</style>{% endblock %}
{% block body %}<main class="demo-shell"><div class="demo-wrap"><nav class="demo-nav"><a href="{{ path('') }}"><img src="{{ asset_for(brand.logo) }}" alt="OPHYTRACK"></a><a href="{{ path('login') }}">{{ trans(t ~ 'login') }}</a></nav><div class="demo-grid"><section class="demo-copy"><span class="kicker">{{ trans(t ~ 'request_kicker') }}</span><h1>{{ trans(t ~ 'request_title') }}</h1><p>{{ trans(t ~ 'request_lead') }}</p><div class="demo-list"><span>{{ trans(t ~ 'request_point_1') }}</span><span>{{ trans(t ~ 'request_point_2') }}</span><span>{{ trans(t ~ 'request_point_3') }}</span></div></section><section class="demo-form"><h2>{{ trans(t ~ 'request_form_title') }}</h2><p>{{ trans(t ~ 'request_form_text') }}</p>{% if sent %}<div class="notice success">{{ trans(t ~ 'request_success') }}</div>{% elseif error %}<div class="notice error">{{ trans(t ~ 'request_error') }}</div>{% endif %}{% if not sent %}<form method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="hp"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div><div class="fields"><div class="field"><label for="name">{{ trans(t ~ 'field_name') }}</label><input id="name" name="name" required></div><div class="field"><label for="company">{{ trans(t ~ 'field_company') }}</label><input id="company" name="company" required></div><div class="field"><label for="email">{{ trans(t ~ 'field_email') }}</label><input id="email" name="email" type="email" required></div><div class="field"><label for="phone">{{ trans(t ~ 'field_phone') }}</label><input id="phone" name="phone" type="tel"></div><div class="field"><label for="monthly_volume">{{ trans(t ~ 'field_volume') }}</label><input id="monthly_volume" name="monthly_volume" inputmode="numeric"></div><div class="field"><label for="operation">{{ trans(t ~ 'field_operation') }}</label><select id="operation" name="operation"><option value="seller">{{ trans(t ~ 'operation_seller') }}</option><option value="carrier">{{ trans(t ~ 'operation_carrier') }}</option><option value="both">{{ trans(t ~ 'operation_both') }}</option></select></div><div class="field full"><label for="message">{{ trans(t ~ 'field_message') }}</label><textarea id="message" name="message"></textarea></div><div class="field full"><button class="submit" type="submit">{{ trans(t ~ 'request_submit') }}</button></div></div></form>{% endif %}</section></div></div></main>{% endblock %}
