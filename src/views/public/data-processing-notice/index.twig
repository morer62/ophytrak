{% extends "templates/base.twig" %}

{% block body %}
<main class="container py-5 legal-page">
  <h1>{{ trans('legal_data.title') }}</h1>
  <p class="text-muted">{{ trans('legal_data.effective_date') }}</p>

  <p>{{ trans('legal_data.intro') }}</p>

  <h2>{{ trans('legal_data.purposes_title') }}</h2>
  <p>{{ trans('legal_data.purposes_body') }}</p>

  <h2>{{ trans('legal_data.transfers_title') }}</h2>
  <p>{{ trans('legal_data.transfers_body') }}</p>

  <h2>{{ trans('legal_data.owner_title') }}</h2>
  <p>{{ trans('legal_data.owner_body') }}</p>

  <h2>{{ trans('legal_data.location_title') }}</h2>
  <p>{{ trans('legal_data.location_body') }}</p>
</main>
<style>
  .legal-page{max-width:900px;line-height:1.75}
  .legal-page h1,.legal-page h2{font-weight:800}
  .legal-page h2{margin-top:2rem}
</style>
{% endblock %}
