{% extends "templates/base.twig" %}

{% block body %}

<main class="d-flex w-100">
    <div class="container d-flex flex-column">
        <div class="row min-vh-100 align-items-start align-items-md-center">
            <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto">

                <div class="text-center mt-4 mb-3">
                    <img src="{{ asset_for('assets/images/planner-hub-logo-negative.png') }}" width="200px"><br><br>
                    <p class="lead">{{ trans('auth.reset_your_password') }}</p>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <form method="post" id="forgotForm">
                            <div class="mb-3">
                                <label class="form-label">{{ trans('auth.email') }}</label>
                                <input class="form-control form-control-lg" type="email" name="email" placeholder="{{ trans('auth.enter_email') }}" required />
                            </div>
                            <div class="d-grid gap-2 mt-3">
                                <button type="submit" id="submitBtn" class="btn btn-lg btn-dark">
                                    {{ trans('auth.send_reset_link') }}
                                </button>
                            </div>
                        </form>

                        <div class="text-center mt-3">
                            <a href="{{ path('login') }}">{{ trans('auth.back_to_sign_in') }}</a>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3 mb-4">
                    <small>{{ trans('auth.dont_have_account') }} <a href="{{ path('signup') }}">{{ trans('auth.sign_up') }}</a></small>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Social Account Modal -->
<div class="modal fade" id="socialAccountModal" tabindex="-1" aria-labelledby="socialAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-center w-100" id="socialAccountModalLabel">
                    {% if social_account_type == 'google' %}
                        <img src="{{ asset_for('assets/images/google-icon.svg') }}" width="40" height="40" class="me-2">
                        {{ trans('auth.google_account_detected') }}
                    {% elseif social_account_type == 'apple' %}
                        <img src="{{ asset_for('assets/images/apple-icon.svg') }}" width="40" height="40" class="me-2">
                        {{ trans('auth.apple_account_detected') }}
                    {% else %}
                        <i class="fas fa-user-circle text-primary me-2"></i>
                        {{ trans('auth.social_account_detected') }}
                    {% endif %}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ trans('auth.close') }}"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    {% if social_account_type == 'google' %}
                        <img src="{{ asset_for('assets/images/google-icon.svg') }}" width="60" height="60" class="mb-3">
                    {% elseif social_account_type == 'apple' %}
                        <img src="{{ asset_for('assets/images/apple-icon.svg') }}" width="60" height="60" class="mb-3">
                    {% else %}
                        <i class="fas fa-user-circle text-primary" style="font-size: 4rem;"></i>
                    {% endif %}
                </div>
                <h6 class="mb-3">
                    {% if social_account_type == 'google' %}
                        {{ trans('auth.email_registered_google') }}
                    {% elseif social_account_type == 'apple' %}
                        {{ trans('auth.email_registered_apple') }}
                    {% else %}
                        {{ trans('auth.email_registered_social') }}
                    {% endif %}
                </h6>
                <p class="text-muted mb-4">
                    {% if social_account_type == 'google' %}
                        {{ trans('auth.google_access_disabled') }}
                    {% elseif social_account_type == 'apple' %}
                        {{ trans('auth.apple_access_disabled') }}
                    {% else %}
                        {{ trans('auth.social_access_disabled') }}
                    {% endif %}
                </p>
                <div class="d-grid gap-2">
                    <a href="{{ path('login') }}" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        {{ trans('auth.sign_in') }}
                    </a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        {{ trans('auth.close') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("forgotForm");
    const btn = document.getElementById("submitBtn");

    form.addEventListener("submit", function () {
        btn.disabled = true;
        btn.innerHTML = "{{ trans('auth.sending')|e('js') }}";
    });

    {% if show_social_modal %}
        const modal = new bootstrap.Modal(document.getElementById('socialAccountModal'));
        modal.show();
    {% endif %}
});
</script>

{% endblock %}
