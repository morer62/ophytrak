}
.public-currency-form{
    display:flex;
    align-items:center;
    gap:.45rem;
    min-height:2.6rem;
    padding:.42rem .5rem .42rem .75rem;
    border:1px solid rgba(255,255,255,.22);
    border-radius:999px;
    background:rgba(8,19,18,.82);
    color:#fff;
    box-shadow:0 14px 34px rgba(0,0,0,.22);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
}
.public-currency-form i{
    color:#8df4e8;
}
.public-currency-select{
    min-width:5.5rem;
    border:0;
    border-radius:999px;
    background:rgba(255,255,255,.12);
    color:#fff;
    font-weight:850;
    padding:.42rem .7rem;
    outline:0;
}
.public-currency-select option{
    color:#0f172a;
}
.public-currency-note{
    position:absolute;
    top:calc(100% + .45rem);
    left:0;
    min-width:13rem;
    padding:.55rem .7rem;
    border-radius:12px;
    background:rgba(8,19,18,.92);
    color:#d7e6e4;
    font-size:.75rem;
    font-weight:700;
    box-shadow:0 14px 34px rgba(0,0,0,.2);
    display:none;
}
.public-currency-switcher:hover .public-currency-note{
    display:block;
}

/* MOBILE */
@media (max-width: 991px){
    .compare-row{
        font-size:.95rem;
    }
    .plan-model-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
    }
    .module-path-row,
    .module-addon-grid{
        grid-template-columns:1fr;
    }
    .module-connector{
        min-height:34px;
    }
    .module-connector::before{
        width:2px;
        height:28px;
        background:linear-gradient(180deg, transparent, rgba(141,244,232,.65), transparent);
    }
    .tool-sprawl-header,
    .tool-flow-grid{
        grid-template-columns:1fr;
    }
    .tool-bridge{
        min-width:0;
        flex-direction:row;
        justify-content:center;
    }
    .tool-bridge-line{
        width:80px;
        height:2px;
        min-height:0;
        flex:0 1 80px;
        background:linear-gradient(90deg, transparent, rgba(38,166,154,.45), transparent);
    }
    .funnel-link-card{
        min-height:320px;
    }
    .pricing-wrap{
        padding:1.35rem;
    }
}

@media (max-width: 768px){
    html,
    body{
        width:100%;
        max-width:100vw;
        min-width:0;
        overflow-x:hidden;
    }
    @supports (overflow-x: clip){
        html,
        body{
            overflow-x:clip;
        }
    }
    .public-currency-switcher{
        top:.75rem;
        left:.75rem;
        max-width:calc(50vw - .9rem);
    }
    .public-currency-form{
        min-height:2.35rem;
        padding:.32rem .42rem .32rem .58rem;
        max-width:100%;
    }
    .public-currency-select{
        min-width:4.75rem;
        max-width:100%;
        padding:.36rem .5rem;
        font-size:.85rem;
    }
    .public-currency-note{
        display:none !important;
    }
    .section{
        padding:4rem 1rem;
        width:100%;
        max-width:100vw;
        overflow-x:hidden;
    }
    .hero-video{
        min-height:auto;
        padding-top:6.5rem;
        padding-bottom:5rem;
        align-items:flex-start;
        width:100%;
        max-width:100vw;
        overflow:hidden;
        background-position:center top;
    }
    .hero-content{
        width:100%;
        max-width:100vw;
        padding:.5rem 1rem 2rem;
        overflow:hidden;
    }
    .hero-video h1{
        font-size:2.35rem;
        line-height:1.08;
        width:100%;
        max-width:calc(100vw - 2rem);
        margin-left:auto;
        margin-right:auto;
    }
    .hero-lead{
        font-size:1.03rem;
        max-width:calc(100vw - 2rem);
    }
    .venue-title{
        font-size:1.85rem;
    }
    .tool-sprawl-shell{
        padding:1.1rem;
    }
    .tool-sprawl-title{
        font-size:2rem;
    }
    .tool-cloud{
        min-height:310px;
    }
    .inside-proof,
    .module-path-section,
    .funnel-section,
    .pricing-section,
    .affiliate-section,
    .workspace-preview-modal,
    .workspace-preview-shell,
    .workspace-preview-stage,
    .workspace-preview-slide,
    .workspace-preview-slide img{
        max-width:100vw;
        overflow-x:hidden;
    }
    img,
    video,
    svg{
        max-width:100%;
    }
    .tool-flow-panel{
        padding:1rem;
    }
    .funnel-link-card{
        min-height:360px;
    }
    .funnel-card-copy{
        margin-top:5.4rem;
    }
    .funnel-link-card h3{
        font-size:1.22rem;
    }
    .funnel-link-card p{
        font-size:.96rem;
    }
    .funnel-chip{
        font-size:.74rem;
    }
    .pricing-wrap{
        padding:1rem;
    }
    .pricing-card .card-body{
        padding:1.2rem;
    }
    .pricing-popular{
        position:static;
        width:max-content;
        margin-bottom:.75rem;
    }
    .plan-model-grid{
        grid-template-columns:1fr;
    }
    .plan-model-card{
        min-height:0;
    }
    .module-path-shell{
        padding:1rem;
    }
    .module-node{
        min-height:0;
    }
    .compare-wrap{
        padding:1.2rem .85rem;
    }
    .compare-grid{
        overflow:auto;
    }
    .compare-row{
        min-width:720px;
    }
    .modal-content{
        margin:6vh 14px;
        max-width:none;
    }
}

@media (max-width:480px){
    .spm-actions{
        flex-direction:column;
        align-items:stretch;
    }
    .spm-cta,
    .spm-ghost{
        width:100%;
        justify-content:center;
    }
}

.brand-highlight {
    color: #0FAF9A;
    font-weight: 700;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".popup-btn").forEach(button => {
        button.addEventListener("click", () => {
            const modalId = button.getAttribute("data-modal");
            if (modalId) document.getElementById(modalId).style.display = "block";
        });
    });

    document.querySelectorAll(".close-modal").forEach(btn => {
        btn.addEventListener("click", () => {
            btn.closest(".modal").style.display = "none";
        });
    });

    document.querySelectorAll(".modal").forEach(modal => {
        modal.addEventListener("click", function(e){
            if (e.target === modal) modal.style.display = "none";
        });
    });
});
</script>
{% endblock %}

