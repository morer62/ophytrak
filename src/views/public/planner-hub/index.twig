{% extends "templates/base.twig" %}

{% block styles %}
<style>
:root{
    --ophyra-primary:#087568;
    --ophyra-primary-dark:#065f54;
    --ophyra-dark:#081312;
    --ophyra-dark-2:#0d1918;
    --ophyra-text:#1f2937;
    --ophyra-muted:#6b7280;
    --ophyra-light:#f8fafc;
    --ophyra-border:#e5e7eb;
}

*,
*::before,
*::after{
    box-sizing:border-box;
}

body{
    color: var(--ophyra-text);
    background:#fff;
    width:100%;
    max-width:100%;
    overflow-x:hidden;
}

html{
    width:100%;
    max-width:100%;
    overflow-x:hidden;
}

@supports (overflow-x: clip){
    html,
    body{
        overflow-x:clip;
    }
}

.section{
    padding: 5rem 1.25rem;
}

.section-alt{
    background:#f6f8fa;
}

.venue-title{
    font-family:'Poppins', sans-serif;
    font-weight:300;
    font-size:2.3rem;
    line-height:1.2;
    margin-bottom:1rem;
}

.venue-title .highlight{
    color:var(--ophyra-primary);
    font-weight:700;
}

.section-subtitle{
    max-width: 860px;
    margin: 0 auto 2.5rem;
    color: var(--ophyra-muted);
    font-size:1.1rem;
    line-height:1.7;
}

.btn-main{
    background:var(--ophyra-primary);
    color:#fff !important;
    padding:.95rem 2rem;
    font-size:1.05rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:700;
    display:inline-block;
    border:none;
    box-shadow:0 10px 24px rgba(8,117,104,.28);
    transition:all .22s ease;
}
.btn-main:hover{
    background:var(--ophyra-primary-dark);
    transform:translateY(-1px);
}

.btn-outline-secondary{
    padding:.9rem 1.6rem;
    font-size:1rem;
    border-radius:999px;
    font-weight:700;
    border:1.5px solid rgba(255,255,255,.55);
    color:#ffffff !important;
    background:rgba(255,255,255,.10);
    backdrop-filter:blur(6px);
    -webkit-backdrop-filter:blur(6px);
    box-shadow:0 8px 24px rgba(0,0,0,.18);
    transition:all .22s ease;
}

.btn-outline-secondary:hover{
    background:rgba(255,255,255,.18);
    border-color:rgba(255,255,255,.82);
    color:#ffffff !important;
    transform:translateY(-1px);
}

/* HERO VIDEO */
.hero-video{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    background:
        linear-gradient(180deg, rgba(0,0,0,.34), rgba(0,0,0,.34)),
        url("{{ asset_for('assets/images/banner-planner-hub.png') }}") center / cover no-repeat,
        #081312;
    color:#fff;
    text-align:center;
    max-width:100%;
    isolation:isolate;
}

.hero-video-bg{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    z-index:0;
    background:#081312;
}
.hero-video-overlay{
    position:absolute;
    inset:0;
    background:
        linear-gradient(180deg, rgba(0,0,0,.30) 0%, rgba(0,0,0,.30) 35%, rgba(0,0,0,.30) 100%),
        linear-gradient(135deg, rgba(8,19,18,.30) 0%, rgba(13,25,24,.30) 45%, rgba(8,19,18,.30) 100%);
    z-index:1;
}

.hero-content{
    position:relative;
    z-index:2;
    width:100%;
    max-width:1200px;
    padding:2rem 1rem 3rem;
    min-width:0;
    content-visibility:visible;
    contain:none;
}

.hero-kicker{
    display:inline-block;
    padding:.5rem .9rem;
    border:1px solid rgba(255,255,255,.18);
    background:rgba(255,255,255,.08);
    border-radius:999px;
    color:#d7fffa;
    font-weight:700;
    font-size:.92rem;
    margin-bottom:1.2rem;
    backdrop-filter: blur(4px);
}

.hero-chip-row{
    margin-top:1.25rem;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:.65rem;
}

.hero-chip{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    padding:.62rem 1rem;
    border-radius:999px;
    background:rgba(118,255,240,.16);
    border:1px solid rgba(118,255,240,.35);
    color:#eafffb;
    font-weight:800;
    box-shadow:0 18px 45px rgba(0,0,0,.22);
    backdrop-filter:blur(8px);
    max-width:100%;
}

.hero-video h1{
    font-size: clamp(2.4rem, 5vw, 5.3rem);
    font-weight:800;
    line-height:1.03;
    letter-spacing:-1.3px;
    margin-bottom:1.1rem;
    text-shadow:0 8px 30px rgba(0,0,0,.35);
    max-width:100%;
}

.hero-title-main,
.hero-title-tail{
    display:block;
    overflow-wrap:break-word;
}

.hero-title-tail{
    margin-top:.35rem;
    font-size:clamp(1.55rem, 3.1vw, 3.35rem);
    line-height:1.18;
    color:rgba(235,243,242,.82);
    font-weight:700;
    letter-spacing:-.6px;
}

.hero-lead{
    max-width:900px;
    margin:0 auto;
    font-size:clamp(1.18rem, 2vw, 1.45rem);
    line-height:1.7;
    color:#ebf3f2;
    text-shadow:0 2px 8px rgba(0,0,0,.25);
}

.hero-cta-row{
    margin-top:2rem;
    display:flex;
    flex-wrap:wrap;
    gap:.9rem;
    justify-content:center;
    align-items:center;
}

.hero-micro{
    margin-top:.8rem;
    font-size:.96rem;
    color:#d7dddf;
}

.hero-points{
    margin-top:2.4rem;
}

.hero-point-card{
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.12);
    border-radius:18px;
    padding:1.1rem 1rem;
    height:100%;
    backdrop-filter: blur(5px);
    box-shadow:0 10px 30px rgba(0,0,0,.18);
    text-align:left;
}

.hero-point-card i{
    color:#5fe5d6;
    font-size:1.2rem;
    margin-bottom:.7rem;
}

.hero-point-card strong{
    display:block;
    color:#fff;
    margin-bottom:.35rem;
    font-size:1rem;
}

.hero-point-card span{
    color:#e1e7e8;
    font-size:.97rem;
    line-height:1.55;
}

/* GENERIC CARDS */
.benefit-card{
    background:#fff;
    padding:2rem 1.5rem;
    border-radius:18px;
    box-shadow:0 15px 40px rgba(15,23,42,.06);
    text-align:center;
    margin-bottom:1.6rem;
    border:1px solid rgba(15,23,42,.05);
    transition:all .22s ease;
    height:100%;
}
.benefit-card:hover{
    transform:translateY(-4px);
    box-shadow:0 22px 44px rgba(15,23,42,.08);
}
.benefit-card i{
    font-size:2rem;
    margin-bottom:1rem;
    color:var(--ophyra-primary);
}
.benefit-card h3{
    font-size:1.3rem;
    font-weight:700;
    margin-bottom:.8rem;
}
.dark-feature-card h3,
.module-detail-card h3{
    font-size:1.15rem;
    font-weight:800;
    margin-bottom:.65rem;
}
.benefit-card p{
    color:var(--ophyra-muted);
    line-height:1.65;
}

/* TOOL SPRAWL SECTION */
.tool-sprawl-section{
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(820px 360px at 8% 14%, rgba(38,166,154,.13), transparent 62%),
        radial-gradient(760px 360px at 96% 78%, rgba(17,24,39,.08), transparent 58%),
        linear-gradient(180deg,#fffaf3 0%,#f7fbfa 100%);
}
.tool-sprawl-shell{
    position:relative;
    max-width:1180px;
    margin:auto;
    border-radius:8px;
    padding:2rem;
    background:rgba(255,255,255,.76);
    border:1px solid rgba(15,23,42,.08);
    box-shadow:0 30px 80px rgba(15,23,42,.10);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
}
.tool-sprawl-header{
    display:grid;
    grid-template-columns:minmax(0,1fr) minmax(280px,420px);
    gap:2rem;
    align-items:center;
    margin-bottom:1.8rem;
}
.tool-alert-mark{
    width:58px;
    height:58px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:1rem;
    color:#081312;
    background:linear-gradient(135deg,#ffd166,#f59e0b);
    box-shadow:0 16px 34px rgba(245,158,11,.25);
}
.tool-alert-mark i{
    font-size:1.45rem;
}
.tool-sprawl-title{
    font-family:'Poppins', sans-serif;
    font-size:clamp(2rem, 4vw, 3.35rem);
    line-height:1.05;
    font-weight:850;
    color:#081312;
    margin:0 0 1rem;
}
.tool-sprawl-title .highlight{
    color:var(--ophyra-primary);
}
.tool-sprawl-lead{
    max-width:760px;
    margin:0;
    color:#4b5563;
    font-size:1.08rem;
    line-height:1.75;
}
.tool-cloud{
    position:relative;
    min-height:250px;
    border-radius:8px;
    padding:1.1rem;
    background:
        linear-gradient(180deg, rgba(8,19,18,.96), rgba(12,23,22,.92)),
        radial-gradient(360px 180px at 80% 0%, rgba(38,166,154,.22), transparent 62%);
    border:1px solid rgba(255,255,255,.10);
    box-shadow:0 26px 64px rgba(8,19,18,.22);
    color:#fff;
}
.tool-cloud::before{
    content:"";
    position:absolute;
    inset:18px;
    border:1px dashed rgba(141,244,232,.20);
    border-radius:8px;
    pointer-events:none;
}
.tool-cloud-label{
    position:relative;
    z-index:1;
    color:#8df4e8;
    text-transform:uppercase;
    font-weight:850;
    font-size:.78rem;
    margin-bottom:.9rem;
}
.tool-chip-field{
    position:relative;
    z-index:1;
    display:flex;
    flex-wrap:wrap;
    gap:.58rem;
}
.tool-chip{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    padding:.54rem .68rem;
    border-radius:999px;
    color:#e9fffc;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.14);
    font-weight:750;
    font-size:.92rem;
}
.tool-chip i{
    color:#8df4e8;
}
.tool-cloud-base{
    position:relative;
    z-index:1;
    display:flex;
    justify-content:space-between;
    gap:1rem;
    align-items:center;
    margin-top:1rem;
    padding:.85rem .95rem;
    border-radius:8px;
    background:linear-gradient(135deg, rgba(38,166,154,.22), rgba(141,244,232,.08));
    border:1px solid rgba(141,244,232,.22);
}
.tool-cloud-base strong{
    color:#fff;
}
.tool-cloud-base span{
    color:#cfeee9;
    font-size:.88rem;
}
.tool-flow-grid{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:1rem;
    align-items:stretch;
}
.tool-flow-panel{
    border-radius:8px;
    padding:1.15rem;
    background:#fff;
    border:1px solid rgba(15,23,42,.08);
    box-shadow:0 18px 42px rgba(15,23,42,.06);
}
.tool-flow-panel.is-good{
    background:linear-gradient(180deg,#ffffff,#f3fffd);
    border-color:rgba(38,166,154,.22);
}
.tool-flow-panel h3{
    display:flex;
    align-items:center;
    gap:.55rem;
    font-size:1rem;
    font-weight:850;
    margin-bottom:1rem;
    color:#081312;
}
.tool-flow-panel h3 i{
    color:var(--ophyra-primary);
}
.tool-flow-list{
    display:grid;
    gap:.72rem;
}
.tool-flow-item{
    display:flex;
    gap:.68rem;
    align-items:flex-start;
    color:#374151;
    line-height:1.45;
}
.tool-flow-item .mark{
    flex:0 0 auto;
    width:26px;
    height:26px;
    border-radius:7px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-top:.05rem;
    font-size:.82rem;
}
.tool-flow-item.is-bad .mark{
    color:#8a1f35;
    background:#ffe6eb;
}
.tool-flow-item.is-good .mark{
    color:#064e3b;
    background:#d7fbf4;
}
.tool-bridge{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:.65rem;
    color:#0f766e;
    font-weight:850;
    min-width:112px;
}
.tool-bridge-line{
    width:2px;
    flex:1;
    min-height:36px;
    background:linear-gradient(180deg, transparent, rgba(38,166,154,.45), transparent);
}
.tool-bridge-icon{
    width:48px;
    height:48px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#061615;
    background:linear-gradient(135deg,#8df4e8,#26a69a);
    box-shadow:0 16px 34px rgba(38,166,154,.25);
}
.tool-sprawl-note{
    margin:1.25rem auto 0;
    max-width:880px;
    color:#5b6778;
    line-height:1.7;
    text-align:center;
}

.funnel-grid{
    align-items:stretch;
}
.funnel-link-card{
    position:relative;
    display:flex;
    flex-direction:column;
    min-height:342px;
    height:100%;
    overflow:hidden;
    border:1px solid rgba(15,23,42,.10);
    border-radius:8px;
    background:#081312;
    color:#fff;
    text-decoration:none;
    box-shadow:0 24px 54px rgba(15,23,42,.12);
    isolation:isolate;
    transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}
.funnel-link-card:hover{
    transform:translateY(-5px);
    box-shadow:0 30px 70px rgba(15,23,42,.18);
    border-color:rgba(38,166,154,.52);
    color:#fff;
}
.funnel-card-media{
    position:absolute;
    inset:0;
    z-index:-2;
}
.funnel-card-media img{
    width:100%;
    height:100%;
    object-fit:cover;
    transform:scale(1.02);
    filter:saturate(1.04) contrast(1.03);
    transition:transform .35s ease;
}
.funnel-link-card:hover .funnel-card-media img{
    transform:scale(1.08);
}
.funnel-link-card::before{
    content:"";
    position:absolute;
    inset:0;
    z-index:-1;
    background:
        linear-gradient(180deg, rgba(8,19,18,.25) 0%, rgba(8,19,18,.82) 56%, rgba(8,19,18,.97) 100%),
        radial-gradient(520px 240px at 100% 0%, rgba(38,166,154,.34), transparent 58%);
}
.funnel-card-body{
    display:flex;
    flex-direction:column;
    flex:1;
    padding:1.15rem;
}
.funnel-card-top{
    display:flex;
    justify-content:space-between;
    gap:.75rem;
    align-items:flex-start;
    margin-bottom:auto;
}
.funnel-icon{
    width:46px;
    height:46px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.20);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.20), 0 12px 28px rgba(0,0,0,.22);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
}
.funnel-icon i{
    color:#8df4e8;
    font-size:1.2rem;
}
.funnel-badge{
    display:inline-flex;
    align-items:center;
    gap:.4rem;
    min-height:30px;
    padding:.38rem .65rem;
    border-radius:999px;
    color:#dffbf7;
    background:rgba(255,255,255,.11);
    border:1px solid rgba(255,255,255,.18);
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    line-height:1;
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
}
.funnel-card-copy{
    margin-top:4.8rem;
}
.funnel-link-card h3{
    color:#fff;
    font-size:1.36rem;
    font-weight:850;
    line-height:1.15;
    margin-bottom:.65rem;
    text-shadow:0 12px 24px rgba(0,0,0,.34);
}
.funnel-link-card p{
    color:#d7e6e4;
    line-height:1.58;
    margin-bottom:1rem;
    font-size:1rem;
}
.funnel-card-meta{
    display:flex;
    flex-wrap:wrap;
    gap:.45rem;
    margin-bottom:1rem;
}
.funnel-chip{
    display:inline-flex;
    align-items:center;
    gap:.35rem;
    padding:.38rem .55rem;
    border-radius:999px;
    color:#dffbf7;
    background:rgba(38,166,154,.16);
    border:1px solid rgba(141,244,232,.20);
    font-size:.78rem;
    font-weight:700;
    line-height:1.1;
}
.funnel-cta{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:.8rem;
    margin-top:auto;
    padding-top:.95rem;
    border-top:1px solid rgba(255,255,255,.12);
    color:#91fff1;
    font-weight:850;
}
.funnel-cta i{
    width:34px;
    height:34px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#061615;
    background:#8df4e8;
    transition:transform .22s ease;
}
.funnel-link-card:hover .funnel-cta i{
    transform:translateX(3px);
}

/* DARK FEATURE BAND */
.dark-band{
    position:relative;
    background:
        radial-gradient(1000px 500px at 0% 0%, rgba(38,166,154,.15), transparent 60%),
        linear-gradient(135deg, #091514 0%, #0d1918 100%);
    color:#fff;
    overflow:hidden;
}
.dark-band .section-subtitle{
    color:#ccdad9;
}
.dark-feature-card{
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.10);
    border-radius:18px;
    padding:1.4rem;
    height:100%;
}
.dark-feature-card i{
    font-size:1.7rem;
    color:#58e2d3;
    margin-bottom:.7rem;
}
.dark-feature-card h4{
    font-weight:700;
    font-size:1.15rem;
    margin-bottom:.55rem;
    color:#fff;
}
.dark-feature-card p{
    margin:0;
    color:#d6e3e3;
    line-height:1.65;
}

/* COMPARISON */
.compare-wrap{
    background:#111827;
    color:#fff;
    border-radius:24px;
    padding:2rem 1.4rem;
    box-shadow:0 18px 50px rgba(0,0,0,.18);
}
.compare-title{
    font-size:2rem;
    font-weight:800;
    text-align:center;
    margin-bottom:.8rem;
}
.compare-sub{
    text-align:center;
    color:#cbd5e1;
    max-width:860px;
    margin:0 auto 2rem;
}
.compare-grid{
    background:#fff;
    border-radius:18px;
    overflow:hidden;
}
.compare-row{
    display:flex;
    flex-wrap:nowrap;
    border-bottom:1px solid #e5e7eb;
}
.compare-row:last-child{
    border-bottom:none;
}
.compare-cell{
    flex:1;
    padding:1rem;
    text-align:center;
    color:#111827;
    font-weight:600;
}
.compare-cell.label{
    flex:1.5;
    text-align:left;
    font-weight:700;
    background:#f8fafc;
}
.compare-head .compare-cell{
    background:#f1f5f9;
    font-weight:800;
}
.ok{
    color:#16a34a;
    font-size:1.2rem;
}
.no{
    color:#dc2626;
    font-size:1.2rem;
}
.meh{
    color:#6b7280;
    font-size:.98rem;
    font-weight:700;
}

/* PRICING */
.pricing-section{
    background:
        radial-gradient(820px 360px at 80% 8%, rgba(38,166,154,.14), transparent 64%),
        linear-gradient(180deg,#f8fbfb 0%,#eef6f5 100%);
}
.pricing-wrap{
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(900px 430px at 88% 0%, rgba(38,166,154,.24), transparent 62%),
        linear-gradient(135deg,#07100f 0%,#0c1716 52%,#101a1a 100%);
    padding:2.1rem;
    border-radius:8px;
    max-width:1160px;
    margin:auto;
    border:1px solid rgba(255,255,255,.12);
    box-shadow:0 34px 90px rgba(8,19,18,.26);
    color:#fff;
}
.pricing-wrap::before{
    content:"";
    position:absolute;
    inset:-1px;
    pointer-events:none;
    background:
        linear-gradient(115deg, transparent 0 55%, rgba(255,255,255,.08) 55.2% 55.8%, transparent 56% 100%),
        radial-gradient(360px 220px at 22% 0%, rgba(141,244,232,.13), transparent 70%);
}
.pricing-wrap > *{
    position:relative;
    z-index:1;
}
.pricing-wrap .venue-title{
    color:#f5fffd;
}
.pricing-wrap .section-subtitle{
    color:#c8d8d6;
}
.pricing-card{
    position:relative;
    display:flex;
    flex-direction:column;
    height:100%;
    overflow:hidden;
    border-radius:8px;
    border:1px solid rgba(255,255,255,.14);
    background:linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.045));
    color:#fff;
    box-shadow:0 24px 58px rgba(0,0,0,.25);
    transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
}
.pricing-card::before{
    content:"";
    position:absolute;
    inset:0;
    background:
        radial-gradient(280px 160px at 86% 0%, rgba(141,244,232,.18), transparent 64%),
        linear-gradient(135deg, rgba(255,255,255,.10), transparent 46%);
    pointer-events:none;
}
.pricing-card:hover{
    transform:translateY(-5px);
    box-shadow:0 32px 76px rgba(0,0,0,.32);
    border-color:rgba(141,244,232,.36);
}
.pricing-card.featured{
    border-color:rgba(141,244,232,.56);
    box-shadow:0 34px 86px rgba(38,166,154,.20), 0 26px 64px rgba(0,0,0,.32);
}
.pricing-card .card-body{
    position:relative;
    z-index:1;
    display:flex;
    flex-direction:column;
    height:100%;
    padding:1.45rem;
}
.pricing-card .badge{
    width:max-content;
    border-radius:999px;
    padding:.48rem .68rem;
    font-size:.72rem;
    text-transform:uppercase;
}
.pricing-card h3{
    color:#fff;
    font-weight:850;
}
.pricing-kicker{
    color:#8df4e8;
    font-weight:800;
}
.pricing-orb{
    width:54px;
    height:54px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:1rem;
    color:#07100f;
    background:linear-gradient(135deg,#8df4e8,#26a69a);
    box-shadow:0 16px 34px rgba(38,166,154,.32);
}
.pricing-orb i{
    font-size:1.25rem;
}
.pricing-popular{
    position:absolute;
    top:1rem;
    right:1rem;
    display:inline-flex;
    align-items:center;
    gap:.35rem;
    color:#eafffb;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.18);
    border-radius:999px;
    padding:.42rem .65rem;
    font-size:.78rem;
    font-weight:800;
}
.price-big{
    color:#fff;
    font-size:2.25rem;
    font-weight:800;
    line-height:1.1;
}
.pricing-note{
    color:#b7c8c6;
    font-size:.95rem;
}
.pricing-card ul{
    list-style:none;
    padding-left:0;
    line-height:1.55;
    color:#e0ecea;
}
.pricing-card li{
    display:flex;
    gap:.55rem;
    align-items:flex-start;
    margin-bottom:.68rem;
}
.pricing-card li i{
    color:#8df4e8;
    margin-top:.22rem;
}
.pricing-card .btn-main{
    border-radius:8px;
    color:#061615 !important;
    background:linear-gradient(135deg,#8df4e8,#26a69a);
    box-shadow:0 16px 34px rgba(38,166,154,.30);
}
.pricing-footnote{
    color:#b7c8c6;
}

/* BUSINESS PLAN MODEL */
.plan-model-grid{
    display:grid;
    grid-template-columns:repeat(5, minmax(0,1fr));
    gap:1rem;
}
.plan-model-card{
    position:relative;
    min-height:248px;
    padding:1.15rem;
    border-radius:8px;
    background:#fff;
    border:1px solid rgba(15,23,42,.08);
    box-shadow:0 18px 42px rgba(15,23,42,.06);
    overflow:hidden;
}
.plan-model-card::before{
    content:"";
    position:absolute;
    inset:0;
    background:radial-gradient(260px 160px at 90% 0%, rgba(38,166,154,.12), transparent 64%);
    pointer-events:none;
}
.plan-step-number{
    position:relative;
    width:42px;
    height:42px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#061615;
    background:linear-gradient(135deg,#8df4e8,#26a69a);
    font-weight:900;
    box-shadow:0 14px 28px rgba(38,166,154,.20);
    margin-bottom:1.05rem;
}
.plan-model-card h3{
    position:relative;
    font-size:1.08rem;
    font-weight:850;
    color:#081312;
    margin-bottom:.7rem;
}
.plan-model-card p{
    position:relative;
    color:#5b6778;
    line-height:1.58;
    margin:0;
}
.inside-proof{
    position:relative;
    margin:3rem auto 0;
    max-width:1120px;
    overflow:hidden;
    border-radius:24px;
    background:
        radial-gradient(760px 260px at 85% 0%, rgba(68,224,208,.18), transparent 60%),
        linear-gradient(135deg,#071312 0%,#0c2d2a 58%,#0f172a 100%);
    border:1px solid rgba(141,244,232,.18);
    box-shadow:0 34px 90px rgba(8,19,18,.32);
}
.inside-proof-copy{
    display:grid;
    grid-template-columns:minmax(0,1.1fr) auto;
    gap:1.25rem;
    align-items:center;
    padding:1.35rem 1.5rem;
    color:#fff;
}
.inside-proof-copy h3{
    color:#fff;
    font-size:clamp(1.35rem,2.5vw,2rem);
    font-weight:900;
    margin:0 0 .4rem;
}
.inside-proof-copy p{
    color:#d8e8e6;
    line-height:1.62;
    margin:0;
}
.inside-proof-pill{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    padding:.7rem .9rem;
    border-radius:999px;
    color:#061615;
    background:#8df4e8;
    border:0;
    font-weight:900;
    white-space:nowrap;
    cursor:pointer;
    box-shadow:0 14px 32px rgba(68,224,208,.18);
    transition:transform .18s ease, box-shadow .18s ease;
}
.inside-proof-pill:hover,
.inside-proof-pill:focus{
    transform:translateY(-2px);
    box-shadow:0 18px 40px rgba(68,224,208,.28);
    outline:0;
}
.inside-proof img{
    display:block;
    width:100%;
    height:auto;
    background:#f3f7fb;
}
.workspace-preview-modal{
    position:fixed;
    inset:0;
    z-index:9999;
    display:none;
    align-items:center;
    justify-content:center;
    padding:1.25rem;
    background:rgba(2,10,18,.76);
    backdrop-filter:blur(10px);
}
.workspace-preview-modal.is-open{
    display:flex;
}
.workspace-preview-shell{
    width:min(1120px,96vw);
    max-height:92vh;
    overflow:hidden;
    border-radius:28px;
    background:#071312;
    border:1px solid rgba(141,244,232,.22);
    box-shadow:0 34px 90px rgba(0,0,0,.38);
    display:flex;
    flex-direction:column;
}
.workspace-preview-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    padding:1rem 1.1rem;
    color:#fff;
}
.workspace-preview-head h3{
    color:#fff;
    font-size:1.1rem;
    font-weight:900;
    margin:0;
}
.workspace-preview-close,
.workspace-preview-nav{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:42px;
    height:42px;
    border-radius:999px;
    border:1px solid rgba(255,255,255,.18);
    color:#fff;
    background:rgba(255,255,255,.08);
}
.workspace-preview-stage{
    position:relative;
    background:#f3f7fb;
    flex:1 1 auto;
    min-height:0;
    max-height:calc(92vh - 142px);
    overflow:auto;
}
.workspace-preview-slide{
    display:none;
}
.workspace-preview-slide.is-active{
    display:block;
}
.workspace-preview-slide img{
    display:block;
    width:100%;
    max-height:calc(92vh - 142px);
    height:auto;
    object-fit:contain;
}
.workspace-preview-controls{
    flex:0 0 auto;
    display:flex;
    justify-content:center;
    gap:.7rem;
    padding:1rem;
    background:#071312;
}
.workspace-preview-nav{
    width:auto;
    padding:0 1rem;
    font-weight:850;
}
@media (max-width: 768px){
    body,
    html,
    .hero-video,
    .hero-content,
    .section,
    .container{
        max-width:100%;
        overflow-x:hidden;
    }

    .hero-content{
        padding-left:1rem;
        padding-right:1rem;
    }

    .hero-video h1{
        font-size:clamp(2.15rem, 14vw, 4.25rem);
    }

    .hero-title-tail{
        font-size:clamp(1.25rem, 7.5vw, 2rem);
    }

    .hero-chip-row,
    .hero-cta-row{
        width:100%;
        max-width:100%;
    }

    .hero-chip,
    .hero-cta-row .btn{
        max-width:100%;
        white-space:normal;
        text-align:center;
    }

    .inside-proof-copy{
        grid-template-columns:1fr;
    }
    .workspace-preview-shell,
    .workspace-preview-stage,
    .workspace-preview-slide img{
        max-height:none;
    }
    .workspace-preview-stage{
        overflow:auto;
    }
}

/* MODULE ACTIVATION PATH */
.module-path-section{
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(900px 420px at 86% 8%, rgba(38,166,154,.16), transparent 62%),
        linear-gradient(180deg,#f7fbfb 0%,#eef6f5 100%);
}
.module-path-shell{
    max-width:1180px;
    margin:auto;
    padding:2rem;
    border-radius:8px;
    background:
        radial-gradient(900px 430px at 88% 0%, rgba(38,166,154,.22), transparent 62%),
        linear-gradient(135deg,#07100f 0%,#0c1716 58%,#101a1a 100%);
    color:#fff;
    border:1px solid rgba(255,255,255,.12);
    box-shadow:0 34px 90px rgba(8,19,18,.24);
}
.module-path-shell .venue-title{
    color:#fff;
}
.module-path-shell .section-subtitle{
    color:#c8d8d6;
}
.module-path-map{
    display:grid;
    gap:1rem;
    margin-top:2rem;
}
.module-path-row{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    gap:1rem;
    align-items:stretch;
}
.module-node{
    position:relative;
    display:flex;
    flex-direction:column;
    gap:.8rem;
    min-height:210px;
    padding:1.2rem;
    border-radius:8px;
    color:#fff;
    text-align:left;
    border:1px solid rgba(255,255,255,.14);
    background:linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.045));
    box-shadow:0 22px 54px rgba(0,0,0,.24);
    backdrop-filter:blur(10px);
    -webkit-backdrop-filter:blur(10px);
}
.module-node.is-foundation{
    max-width:560px;
    margin:0 auto;
    min-height:0;
    background:linear-gradient(135deg, rgba(101,139,255,.18), rgba(255,255,255,.06));
    border-color:rgba(143,170,255,.38);
}
.module-node.is-core{
    min-height:250px;
    border-color:rgba(141,244,232,.35);
}
.module-node.is-service{
    border-color:rgba(255,84,185,.36);
    background:
        radial-gradient(360px 170px at 90% 0%, rgba(255,84,185,.20), transparent 64%),
        linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.045));
}
.module-node.is-coming-soon{
    background:#f1f3f4 !important;
    border-color:#d7dce1 !important;
    box-shadow:none !important;
    filter:grayscale(.35);
    opacity:1;
    color:#111827 !important;
}
.module-node.is-coming-soon h3,
.module-node.is-coming-soon p,
.module-node.is-coming-soon .module-price{
    color:#111827 !important;
}
.module-node.is-coming-soon .module-node-badge,
.coming-soon-line span{
    background:#ffffff;
    color:#111827;
    border:1px solid #cfd6dd;
}
.coming-soon-line{
    opacity:1;
    color:#111827;
}.module-node.is-store{
    border-color:rgba(86,217,112,.40);
    background:
        radial-gradient(360px 170px at 90% 0%, rgba(86,217,112,.20), transparent 64%),
        linear-gradient(180deg, rgba(255,255,255,.105), rgba(255,255,255,.045));
}
.module-node.is-public{
    max-width:760px;
    margin:0 auto;
    min-height:0;
    background:linear-gradient(135deg, rgba(38,166,154,.20), rgba(255,255,255,.06));
    border-color:rgba(141,244,232,.30);
}
.module-node.is-addon{
    min-height:190px;
}
.module-node.is-addon:nth-child(1){
    border-color:rgba(143,170,255,.32);
}
.module-node.is-addon:nth-child(2){
    border-color:rgba(255,84,185,.34);
}
.module-node.is-addon:nth-child(3){
    border-color:rgba(86,217,112,.34);
}
.module-node.is-addon:nth-child(4){
    border-color:rgba(217,226,236,.34);
}
.module-node.is-marketplace{
    border-color:rgba(236,72,153,.48);
    background:
        radial-gradient(280px 160px at 90% 0%, rgba(236,72,153,.20), transparent 62%),
        linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.035));
}
.module-price{
    display:inline-flex;
    width:max-content;
    align-items:center;
    gap:.4rem;
    margin-top:auto;
    color:#f7fffd;
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.16);
    border-radius:999px;
    padding:.42rem .65rem;
    font-weight:850;
    font-size:.88rem;
}
.module-node-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:.8rem;
}
.module-node-icon{
    width:48px;
    height:48px;
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#061615;
    background:linear-gradient(135deg,#8df4e8,#26a69a);
    box-shadow:0 16px 34px rgba(38,166,154,.25);
}
.module-node-badge{
    color:#dffbf7;
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.16);
    border-radius:999px;
    padding:.38rem .62rem;
    font-size:.72rem;
    font-weight:850;
    text-transform:uppercase;
}
.module-node h3{
    color:#fff;
    font-weight:850;
    font-size:1.34rem;
    margin:0;
}
.module-node p{
    color:#d8e8e6;
    line-height:1.58;
    margin:0;
}
.module-node .popup-btn{
    width:max-content;
    margin-top:auto;
    border-radius:8px;
    padding:.72rem 1rem;
}
.module-connector{
    display:flex;
    align-items:center;
    justify-content:center;
    color:#8df4e8;
    min-width:72px;
}
.module-connector::before{
    content:"";
    width:54px;
    height:2px;
    background:linear-gradient(90deg, transparent, rgba(141,244,232,.65), transparent);
}
.module-addon-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:1rem;
}
.module-modal-actions{
    display:flex;
    flex-wrap:wrap;
    gap:.65rem;
    margin-top:1rem;
}
.module-modal-actions .btn{
    border-radius:8px;
}
.module-modal-disabled{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-height:46px;
    padding:.75rem 1.1rem;
    border-radius:8px;
    border:1px solid #cbd5e1;
    background:#f1f5f9;
    color:#475569;
    font-weight:800;
    cursor:not-allowed;
    box-shadow:none;
}

/* PARALLAX / AI */
.ai-hero{
    position:relative;
    min-height:72vh;
    background:
      linear-gradient(135deg, rgba(8,19,18,.88), rgba(13,25,24,.84)),
      linear-gradient(135deg, rgba(8,19,18,.92), rgba(8,117,104,.74)) no-repeat center center fixed;
    background-size:cover;
    color:#fff;
    text-align:center;
    display:flex;
    align-items:center;
    justify-content:center;
}
.ai-box{
