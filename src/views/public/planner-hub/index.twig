<script>
document.addEventListener("DOMContentLoaded", function () {
    var modal = document.getElementById('signupPitchModal');
    if (!modal) return;

    const KEY_FLAG = 'ph_signup_pitch_dismissed_at';
    const DISMISS_HOURS = 72;

    try {
        const ts = localStorage.getItem(KEY_FLAG);
        if (ts) {
            const hours = (Date.now() - parseInt(ts,10)) / (1000*60*60);
            if (hours < DISMISS_HOURS) return;
        }
    } catch(e){}

    const href = location.pathname.toLowerCase();
    if (href.includes('login') || href.includes('signup')) return;

    setTimeout(function(){ modal.style.display = 'block'; }, 4200);

    const closeBtn = modal.querySelector('.spm-close');
    const ghostBtn = modal.querySelector('[data-spm-dismiss]');

    function dismiss() {
        modal.style.display = 'none';
        try { localStorage.setItem(KEY_FLAG, Date.now().toString()); } catch(e){}
    }

    closeBtn && closeBtn.addEventListener('click', dismiss);
    ghostBtn && ghostBtn.addEventListener('click', dismiss);

    modal.addEventListener('click', function(e){
        if (e.target === modal) dismiss();
    });

    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') dismiss();
    });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const modal = document.querySelector('[data-workspace-preview-modal]');
    const openBtn = document.querySelector('[data-workspace-preview-open]');
    if (!modal || !openBtn) return;

    const closeBtn = modal.querySelector('[data-workspace-preview-close]');
    const slides = Array.from(modal.querySelectorAll('[data-workspace-preview-slide]'));
    const prevBtn = modal.querySelector('[data-workspace-preview-prev]');
    const nextBtn = modal.querySelector('[data-workspace-preview-next]');
    let activeIndex = 0;

    function renderSlide() {
        slides.forEach(function (slide, index) {
            slide.classList.toggle('is-active', index === activeIndex);
        });
    }

    function openModal() {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        closeBtn && closeBtn.focus();
    }

    function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        openBtn.focus();
    }

    function move(delta) {
        if (!slides.length) return;
        activeIndex = (activeIndex + delta + slides.length) % slides.length;
        renderSlide();
    }

    openBtn.addEventListener('click', openModal);
    closeBtn && closeBtn.addEventListener('click', closeModal);
    prevBtn && prevBtn.addEventListener('click', function () { move(-1); });
    nextBtn && nextBtn.addEventListener('click', function () { move(1); });
    modal.addEventListener('click', function (event) {
        if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
        if (event.key === 'ArrowLeft' && modal.classList.contains('is-open')) move(-1);
        if (event.key === 'ArrowRight' && modal.classList.contains('is-open')) move(1);
    });
});
</script>
<script>
(function () {
    let loaded = false;
    const loadFontAwesome = function () {
        if (loaded || document.querySelector('link[data-late-fontawesome]')) return;
        loaded = true;
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css';
        link.crossOrigin = 'anonymous';
        link.referrerPolicy = 'no-referrer';
        link.setAttribute('data-late-fontawesome', 'true');
        document.head.appendChild(link);
    };

    const interactionEvents = ['pointermove', 'scroll', 'keydown', 'touchstart'];
    const startAfterIntent = function () {
        interactionEvents.forEach(function (eventName) {
            window.removeEventListener(eventName, startAfterIntent, { passive: true });
        });
        loadFontAwesome();
    };

    window.addEventListener('load', function () {
        setTimeout(function () {
            interactionEvents.forEach(function (eventName) {
                window.addEventListener(eventName, startAfterIntent, { once: true, passive: true });
            });
            setTimeout(loadFontAwesome, 16000);
        }, 5000);
    }, { once: true });
})();
</script>


