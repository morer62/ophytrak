    gap:.6rem;
    flex-wrap:wrap;
    align-items:center;
}
.spm-cta{
    flex:0 0 auto;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:.55rem;
    background:linear-gradient(135deg,#26a69a,#19b9a8);
    color:#041312 !important;
    font-weight:900;
    border:none;
    border-radius:14px;
    padding:.9rem 1.2rem;
    text-decoration:none;
    letter-spacing:.2px;
    box-shadow:0 12px 28px rgba(38,166,154,.45);
    transition:transform .08s ease;
    cursor:pointer;
}
.spm-cta:hover{
    transform:translateY(-1px);
}
.spm-ghost{
    flex:0 0 auto;
    background:transparent;
    color:#cfeee9;
    border:1px solid rgba(255,255,255,.18);
    border-radius:12px;
    padding:.9rem 1rem;
    font-weight:700;
}
.spm-close{
    position:absolute;
    top:10px;
    right:12px;
    border:none;
    background:transparent;
    color:#cfeee9;
    font-size:1.35rem;
    cursor:pointer;
    opacity:.9;
}

.public-currency-switcher{
