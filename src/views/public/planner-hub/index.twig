}
.ai-box i{
    color:#63e7d9;
    font-size:1.5rem;
    margin-bottom:.75rem;
}
.ai-box p{
    color:#dbe7e7;
    margin:0;
    line-height:1.65;
}

/* TESTIMONIALS */
.testimonial-card{
    background:#fff;
    border:none;
    border-radius:18px;
    box-shadow:0 12px 34px rgba(15,23,42,.06);
}
.testimonial-card .card-body{
    padding:1.7rem;
}
.testimonial-card p{
    color:#374151;
    line-height:1.7;
}

/* FINAL CTA */
.final-cta{
    background:linear-gradient(135deg, #0d1918, #091514);
    color:#fff;
    border-radius:24px;
    padding:3rem 1.5rem;
    box-shadow:0 20px 50px rgba(0,0,0,.15);
}
.final-cta p{
    max-width:820px;
    margin:0 auto 1.6rem;
    color:#d6e3e3;
    font-size:1.08rem;
    line-height:1.75;
}

/* MODALS */
.modal{
    display:none;
    position:fixed;
    z-index:9999;
    top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,0.62);
}
.modal-content{
    background:#fff;
    padding:2rem;
    border-radius:18px;
    max-width:560px;
    margin:8vh auto;
    position:relative;
    box-shadow:0 25px 60px rgba(0,0,0,.20);
}
.modal-content h3{
    font-weight:800;
    margin-bottom:.8rem;
}
.modal-content p, .modal-content li{
    color:#4b5563;
    line-height:1.8;
}
.close-modal{
    position:absolute;
    top:12px;
    right:16px;
    cursor:pointer;
    font-size:1.3rem;
}

/* SIGNUP PITCH MODAL */
#signupPitchModal{
    display:none;
    position:fixed;
    inset:0;
    z-index:10000;
    background:rgba(0,0,0,.7);
    backdrop-filter:blur(3px);
}
#signupPitchModal .spm-dialog{
    width:min(560px,92vw);
    margin:8vh auto;
    border-radius:20px;
    overflow:hidden;
    background:#0d1918;
    color:#eaf5f3;
    box-shadow:0 30px 120px rgba(0,0,0,.45);
    position:relative;
}
.spm-top{
    padding:24px 22px 16px;
    background: radial-gradient(1200px 420px at -20% -10%, #1b3b36 0%, #0d1918 60%);
    border-bottom:1px solid rgba(255,255,255,.06);
}
.spm-eyebrow{
    font-size:.9rem;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:#88e0d1;
    font-weight:800;
}
.spm-title{
    margin:.3rem 0 0;
    font-weight:900;
    line-height:1.1;
    font-size: clamp(1.8rem, 4.6vw, 2.6rem);
    color:#ffffff;
    text-shadow:0 2px 14px rgba(0,0,0,.35);
}
.spm-sub{
    margin:.4rem 0 0;
    opacity:.9;
    font-size:1.05rem;
}
.spm-body{
    padding:18px 22px 6px;
}
.spm-chips{
    display:flex;
    flex-wrap:wrap;
    gap:.5rem;
    margin:.25rem 0 .75rem;
}
.spm-chip{
    background:#112422;
    color:#c7f3eb;
    border:1px solid rgba(120,255,230,.25);
    padding:.45rem .7rem;
    border-radius:999px;
    font-weight:800;
    font-size:.95rem;
}
.spm-list{
    display:grid;
    gap:.55rem;
    margin:.2rem 0 .6rem;
}
.spm-list .rowy{
    display:flex;
    align-items:center;
    gap:.6rem;
}
.spm-ic{
    width:26px;
    height:26px;
    border-radius:7px;
    background:#1a3a35;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:.95rem;
}
.spm-txt{
    font-size:1.02rem;
}
.spm-social{
    display:flex;
    align-items:center;
    gap:.4rem;
