{% for module in moduleModals %}
    <div class="modal" id="{{ module.id }}">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <span class="badge bg-success mb-3" style="width:max-content;">{{ module.badge }}</span>
            <h3>{{ module.title }}</h3>
            <p><strong>{{ module.price }}</strong></p>
            <p>{{ module.description }}</p>
            <h3>{{ trans('public_home.what_it_unlocks') }}</h3>
            <ul>
                {% for feature in module.features %}
                    <li>{{ feature }}</li>
                {% endfor %}
            </ul>
            <div class="module-modal-actions">
                {% if module.route %}
                    <a href="{{ path(module.route) }}" class="btn btn-main">{{ module.cta }}</a>
                {% else %}
                    <span class="module-modal-disabled" aria-disabled="true">{{ module.cta }}</span>
                {% endif %}
                {% if module.related %}
                    <a href="{{ path(module.related) }}" class="btn btn-outline-dark">{{ trans('public_home.more_info') }}</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endfor %}
