{% extends "templates/base.twig" %}
{% set t = 'ophytrack_public.' %}
{% block styles %}<style>
:root{--blue:#087cff;--cyan:#03c6f4;--dark:#020a16;--ink:#0b1728;--muted:#5d7087;--line:#d8e7f5}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ink)}.nav{position:absolute;z-index:5;inset:0 0 auto;display:flex;align-items:center;width:min(1280px,100%);margin:auto;padding:24px}.nav img{width:260px;max-width:42vw}.links{margin-left:auto;display:flex;align-items:center;gap:24px}.links a{color:#dce9f7;text-decoration:none;font-weight:750}.button{display:inline-flex!important;align-items:center;justify-content:center;padding:14px 24px;border-radius:999px;background:linear-gradient(135deg,var(--cyan),var(--blue));color:#fff!important;text-decoration:none;font-weight:850;box-shadow:0 14px 34px #087cff55}.outline{padding:13px 22px;border:1px solid #ffffff66;border-radius:999px;color:#fff;text-decoration:none;font-weight:800}.hero{min-height:100vh;position:relative;display:grid;place-items:center;overflow:hidden;background:var(--dark);color:#fff}.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.34}.veil{position:absolute;inset:0;background:radial-gradient(circle at 72% 35%,#087cff4d,transparent 43%),linear-gradient(90deg,#020a16f5,#020a16a8)}.hero-content{position:relative;z-index:2;width:min(1180px,92%);padding:160px 0 100px}.kicker{letter-spacing:.19em;color:#5ee4ff;font-weight:900;font-size:.8rem}.hero h1{font-size:clamp(3rem,6.2vw,6rem);line-height:.97;max-width:990px;margin:20px 0 26px;letter-spacing:-.055em}.hero p,.lead{font-size:clamp(1.05rem,1.7vw,1.3rem);line-height:1.7;color:#c5d5e6;max-width:790px}.actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line)}.metric{padding:30px 20px;text-align:center;background:#fff}.metric strong{display:block;font-size:1.45rem;color:var(--blue);margin-bottom:5px}.section{padding:104px 24px}.wrap{width:min(1180px,100%);margin:auto}.section h2,.band h2,.final h2{font-size:clamp(2.2rem,4.3vw,4rem);line-height:1.05;letter-spacing:-.045em;max-width:900px;margin:18px 0}.section .lead{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:46px}.four{grid-template-columns:repeat(4,1fr)}.card{border:1px solid var(--line);border-radius:26px;padding:30px;background:linear-gradient(145deg,#fff,#f3f9ff);box-shadow:0 20px 55px #0b37680c}.card h3{font-size:1.38rem;margin:18px 0 8px}.card p{color:var(--muted);line-height:1.72;margin-bottom:0}.icon{width:54px;height:54px;border-radius:17px;display:grid;place-items:center;background:#e8f5ff;color:var(--blue);font-weight:900}.dark{background:#061120;color:#fff}.dark .card{background:#0b1a2c;border-color:#183451}.dark .card p,.dark .lead{color:#adc1d5}.step{color:#5ee4ff;font-weight:900;letter-spacing:.08em}.trust{background:linear-gradient(145deg,#eaf7ff,#fff)}.band{padding:76px 24px;background:linear-gradient(120deg,#087cff,#03bde8);color:#fff}.band-inner{width:min(1180px,100%);margin:auto;display:grid;grid-template-columns:1.5fr .8fr;gap:50px;align-items:center}.band p{max-width:780px;line-height:1.7;font-size:1.08rem}.band .button{background:#020a16;justify-self:end}.pills{display:flex;gap:14px;flex-wrap:wrap;margin-top:32px}.pill{padding:12px 17px;border:1px solid var(--line);border-radius:999px;font-weight:850}.final{padding:100px 24px;text-align:center;background:radial-gradient(circle at 50% 0,#087cff70,transparent 42%),#020a16;color:#fff}.final h2{margin:18px auto}.final p{color:#b8cadb;max-width:760px;margin:0 auto 30px;line-height:1.75}.footer{background:#010711;color:#91a5ba;padding:28px;text-align:center}.footer strong{color:#dce9f7}@media(max-width:980px){.four{grid-template-columns:repeat(2,1fr)}.band-inner{grid-template-columns:1fr}.band .button{justify-self:start}}@media(max-width:760px){.links a:not(.button){display:none}.nav img{width:205px}.grid,.four,.metrics{grid-template-columns:1fr}.hero-content{padding-top:140px}.hero h1{font-size:clamp(2.8rem,13vw,4.2rem)}.section{padding:78px 20px}.metric{padding:22px}.card{padding:25px}}
</style>{% endblock %}
{% block body %}
<nav class="nav" aria-label="OPHYTRACK"><img src="{{ asset_for(brand.logo) }}" alt="OPHYTRACK"><div class="links"><a href="#platform">{{ trans(t ~ 'nav_platform') }}</a><a href="#flow">{{ trans(t ~ 'nav_flow') }}</a><a href="#roles">{{ trans(t ~ 'nav_roles') }}</a><a href="#traceability">{{ trans(t ~ 'nav_security') }}</a><a href="{{ path('login') }}">{{ trans(t ~ 'login') }}</a><a class="button" href="{{ path('signup') }}">{{ trans(t ~ 'start') }}</a></div></nav>
<header class="hero"><video autoplay muted loop playsinline poster="{{ asset_for(brand.hero_logo) }}"><source src="{{ asset_for('assets/video/intro.mp4') }}" type="video/mp4"></video><div class="veil"></div><div class="hero-content"><span class="kicker">{{ trans(t ~ 'hero_kicker') }}</span><h1>{{ trans(t ~ 'hero_title') }}</h1><p>{{ trans(t ~ 'hero_lead') }}</p><div class="actions"><a class="button" href="{{ path('signup') }}">{{ trans(t ~ 'hero_cta') }}</a><a class="outline" href="#flow">{{ trans(t ~ 'hero_secondary') }}</a></div></div></header>
<div class="metrics"><div class="metric"><strong>QR + ID</strong><span>{{ trans(t ~ 'metric_identity') }}</span></div><div class="metric"><strong>LIVE</strong><span>{{ trans(t ~ 'metric_timeline') }}</span></div><div class="metric"><strong>PHOTO</strong><span>{{ trans(t ~ 'metric_evidence') }}</span></div><div class="metric"><strong>4</strong><span>{{ trans(t ~ 'metric_languages') }}</span></div></div>
<section class="section" id="platform"><div class="wrap"><span class="kicker">{{ trans(t ~ 'core_kicker') }}</span><h2>{{ trans(t ~ 'core_title') }}</h2><p class="lead">{{ trans(t ~ 'core_lead') }}</p><div class="grid">{% for item in ['orders','warehouse','delivery'] %}<article class="card"><div class="icon">0{{ loop.index }}</div><h3>{{ trans(t ~ item ~ '_title') }}</h3><p>{{ trans(t ~ item ~ '_text') }}</p></article>{% endfor %}</div></div></section>
<section class="section dark" id="flow"><div class="wrap"><span class="kicker">{{ trans(t ~ 'flow_kicker') }}</span><h2>{{ trans(t ~ 'flow_title') }}</h2><p class="lead">{{ trans(t ~ 'flow_lead') }}</p><div class="grid">{% for step in 1..6 %}<article class="card"><span class="step">{{ trans(t ~ 'step_' ~ step ~ '_title') }}</span><p>{{ trans(t ~ 'step_' ~ step ~ '_text') }}</p></article>{% endfor %}</div></div></section>
<section class="section" id="roles"><div class="wrap"><span class="kicker">{{ trans(t ~ 'roles_kicker') }}</span><h2>{{ trans(t ~ 'roles_title') }}</h2><div class="grid four">{% for role in ['seller','carrier','driver','customer'] %}<article class="card"><h3>{{ trans(t ~ role ~ '_title') }}</h3><p>{{ trans(t ~ role ~ '_text') }}</p></article>{% endfor %}</div></div></section>
<section class="section trust" id="traceability"><div class="wrap"><span class="kicker">{{ trans(t ~ 'trust_kicker') }}</span><h2>{{ trans(t ~ 'trust_title') }}</h2><p class="lead">{{ trans(t ~ 'trust_text') }}</p><div class="grid">{% for item in ['owner','history','exceptions'] %}<article class="card"><h3>{{ trans(t ~ 'trust_' ~ item) }}</h3><p>{{ trans(t ~ 'trust_' ~ item ~ '_text') }}</p></article>{% endfor %}</div></div></section>
<section class="section"><div class="wrap"><span class="kicker">{{ trans(t ~ 'integrations_kicker') }}</span><h2>{{ trans(t ~ 'integrations_title') }}</h2><p class="lead">{{ trans(t ~ 'integrations_text') }}</p><div class="pills">{% for item in ['Shopify','Mercado Libre','TikTok Shop','Webhooks','API'] %}<span class="pill">{{ item }}</span>{% endfor %}</div></div></section>
<section class="band"><div class="band-inner"><div><span class="kicker">OPHYTRACK CARRIERS</span><h2>{{ trans(t ~ 'carrier_cta_title') }}</h2><p>{{ trans(t ~ 'carrier_cta_text') }}</p></div><a class="button" href="{{ path('signup') }}">{{ trans(t ~ 'carrier_cta') }}</a></div></section>
<section class="final"><img src="{{ asset_for(brand.mark) }}" alt="" width="100"><h2>{{ trans(t ~ 'final_title') }}</h2><p>{{ trans(t ~ 'final_text') }}</p><a class="button" href="{{ path('signup') }}">{{ trans(t ~ 'hero_cta') }}</a></section>
<footer class="footer">© {{ 'now'|date('Y') }} <strong>OPHYTRACK</strong> · {{ trans(t ~ 'tagline') }} · {{ trans(t ~ 'footer_product') }}</footer>
{% endblock %}
