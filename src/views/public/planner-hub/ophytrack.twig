{% set c = copy[locale]|default(copy.en) %}
{% block styles %}<style>
:root{--ot-blue:#087cff;--ot-cyan:#03c6f4;--ot-dark:#020a16;--ot-ink:#0b1728;--ot-muted:#64748b}*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;color:var(--ot-ink);background:#fff}.ot-nav{position:absolute;z-index:5;inset:0 0 auto;display:flex;align-items:center;max-width:1240px;margin:auto;padding:22px 24px}.ot-nav img{width:260px;max-width:42vw}.ot-links{margin-left:auto;display:flex;align-items:center;gap:24px}.ot-links a{color:#dce9f7;text-decoration:none;font-weight:700}.ot-button{display:inline-flex!important;align-items:center;justify-content:center;padding:13px 22px;border-radius:999px;background:linear-gradient(135deg,var(--ot-cyan),var(--ot-blue));color:#fff!important;text-decoration:none;font-weight:800;box-shadow:0 12px 32px #087cff55}.ot-hero{min-height:100vh;position:relative;display:grid;place-items:center;overflow:hidden;background:var(--ot-dark);color:#fff}.ot-hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.36}.ot-veil{position:absolute;inset:0;background:radial-gradient(circle at 70% 35%,#087cff44,transparent 42%),linear-gradient(90deg,#020a16f2,#020a16aa)}.ot-hero-content{position:relative;z-index:2;width:min(1180px,92%);padding:150px 0 90px}.ot-kicker{letter-spacing:.2em;color:#5ee4ff;font-weight:900;font-size:.82rem}.ot-hero h1{font-size:clamp(2.8rem,6vw,5.8rem);line-height:.98;max-width:900px;margin:18px 0 24px;letter-spacing:-.05em}.ot-hero p{font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.65;color:#c5d5e6;max-width:770px}.ot-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}.ot-outline{padding:13px 22px;border:1px solid #ffffff55;border-radius:999px;color:#fff;text-decoration:none;font-weight:800}.ot-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#dce7f3}.ot-metric{padding:32px 20px;text-align:center;background:#fff}.ot-metric strong{display:block;font-size:1.5rem;color:var(--ot-blue)}.ot-section{padding:96px 24px}.ot-wrap{width:min(1180px,100%);margin:auto}.ot-section h2{font-size:clamp(2.1rem,4vw,3.5rem);letter-spacing:-.04em;max-width:760px}.ot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:42px}.ot-card{border:1px solid #dce7f3;border-radius:24px;padding:30px;background:linear-gradient(145deg,#fff,#f4f9ff);box-shadow:0 20px 55px #0b37680c}.ot-icon{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:#e8f5ff;color:var(--ot-blue);font-size:1.45rem}.ot-card p{color:var(--ot-muted);line-height:1.7}.ot-flow{background:#061120;color:#fff}.ot-flow .ot-card{background:#0b1a2c;border-color:#183451}.ot-flow .ot-card p{color:#a9bfd4}.ot-step{color:#5ee4ff;font-weight:900;letter-spacing:.14em}.ot-final{padding:90px 24px;text-align:center;background:radial-gradient(circle at 50% 0,#087cff66,transparent 40%),#020a16;color:#fff}.ot-final p{color:#b8cadb;max-width:700px;margin:0 auto 28px;line-height:1.7}.ot-footer{background:#010711;color:#91a5ba;padding:28px;text-align:center}@media(max-width:850px){.ot-links a:not(.ot-button){display:none}.ot-nav img{width:200px}.ot-grid,.ot-metrics{grid-template-columns:1fr}.ot-hero h1{font-size:3.15rem}}
</style>{% endblock %}
{% block body %}
<nav class="ot-nav"><img src="{{ asset_for(brand.logo) }}" alt="OPHYTRACK"><div class="ot-links"><a href="#platform">{{ c.nav }}</a><a href="#flow">{{ c.flow }}</a><a href="#roles">{{ c.who }}</a><a href="{{ path('login') }}">{{ c.login }}</a><a class="ot-button" href="{{ path('signup') }}">{{ c.start }}</a></div></nav>
<header class="ot-hero"><video autoplay muted loop playsinline poster="{{ asset_for('assets/ophytrack/ophytrack-logo-hero.png') }}"><source src="{{ asset_for('assets/video/intro.mp4') }}" type="video/mp4"></video><div class="ot-veil"></div><div class="ot-hero-content"><span class="ot-kicker">{{ c.kicker }}</span><h1>{{ c.title }}</h1><p>{{ c.lead }}</p><div class="ot-actions"><a class="ot-button" href="{{ path('signup') }}">{{ c.cta }}</a><a class="ot-outline" href="#flow">{{ c.demo }}</a></div></div></header>
<div class="ot-metrics"><div class="ot-metric"><strong>QR + ID</strong><span>Package identity</span></div><div class="ot-metric"><strong>Live</strong><span>Custody timeline</span></div><div class="ot-metric"><strong>Photo</strong><span>Delivery evidence</span></div><div class="ot-metric"><strong>4 languages</strong><span>EN · ES · PT · FR</span></div></div>
<section class="ot-section" id="platform"><div class="ot-wrap"><span class="ot-kicker">OPHYTRACK CORE</span><h2>{{ c.features }}</h2><div class="ot-grid"><article class="ot-card"><div class="ot-icon">⌁</div><h3>Orders & marketplace</h3><p>Products, paid orders, labels and synchronized external channels.</p></article><article class="ot-card"><div class="ot-icon">▣</div><h3>Warehouse & custody</h3><p>Pickup, hub reception, regional sorting and a chronological package log.</p></article><article class="ot-card"><div class="ot-icon">➜</div><h3>Delivery & proof</h3><p>Mobile scanning, GPS context, occurrences, receiver identity and photos.</p></article></div></div></section>
<section class="ot-section ot-flow" id="flow"><div class="ot-wrap"><span class="ot-kicker">END-TO-END</span><h2>{{ c.flowtitle }}</h2><div class="ot-grid">{% for item in ['01 · Order & label','02 · Pickup scan','03 · Hub & sorting','04 · Out for delivery','05 · Proof or occurrence','06 · Customer tracking'] %}<article class="ot-card"><span class="ot-step">{{ item }}</span><p>Every action records the organization, responsible user, evidence, place, status and time.</p></article>{% endfor %}</div></div></section>
<section class="ot-section" id="roles"><div class="ot-wrap"><span class="ot-kicker">CONNECTED OPERATIONS</span><h2>{{ c.whoTitle }}</h2><div class="ot-grid"><article class="ot-card"><h3>{{ c.seller }}</h3><p>{{ c.sellerText }}</p></article><article class="ot-card"><h3>{{ c.carrier }}</h3><p>{{ c.carrierText }}</p></article><article class="ot-card"><h3>{{ c.driver }}</h3><p>{{ c.driverText }}</p></article></div></div></section>
<section class="ot-final"><img src="{{ asset_for(brand.mark) }}" alt="" width="100"><h2>{{ c.final }}</h2><p>{{ c.finalText }}</p><a class="ot-button" href="{{ path('signup') }}">{{ c.cta }}</a></section><footer class="ot-footer">© {{ 'now'|date('Y') }} OPHYTRACK · {{ brand.tagline }}</footer>
{% endblock %}
