{% extends "templates/base.twig" %}

{% block body %}
<main class="container py-5 legal-page">
  <h1>{{ trans('legal_cookie.title') }}</h1>
  <p class="text-muted">{{ trans('legal_cookie.effective_date') }}</p>

  <p>{{ trans('legal_cookie.intro') }}</p>

  <h2>{{ trans('legal_cookie.essential_title') }}</h2>
  <p>{{ trans('legal_cookie.essential_body') }}</p>

  <h2>{{ trans('legal_cookie.preference_title') }}</h2>
  <p>{{ trans('legal_cookie.preference_body') }}</p>

  <h2>{{ trans('legal_cookie.security_title') }}</h2>
  <p>{{ trans('legal_cookie.security_body') }}</p>

  <h2>{{ trans('legal_cookie.analytics_title') }}</h2>
  <p>{{ trans('legal_cookie.analytics_body') }}</p>

  <h2>{{ trans('legal_cookie.controls_title') }}</h2>
  <p>{{ trans('legal_cookie.controls_body') }}</p>
</main>
<style>
  .legal-page{max-width:900px;line-height:1.75}
  .legal-page h1,.legal-page h2{font-weight:800}
  .legal-page h2{margin-top:2rem}
</style>
{% endblock %}
